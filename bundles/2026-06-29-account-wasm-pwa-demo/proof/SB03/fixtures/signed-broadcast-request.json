{
  "method": "POST",
  "path": "/api/v1/ledger/transactions",
  "headers": {
    "content-type": "application/json"
  },
  "bodyShape": {
    "ledgerId": { "value": "account-app-ledger" },
    "scenarioId": { "value": "browser-demo" },
    "version": 1,
    "kind": "Transfer",
    "signingMode": "Independent",
    "inputs": [
      {
        "inputIndex": 0,
        "previousOutPoint": {
          "txId": { "value": "tx-source" },
          "outputIndex": 0
        },
        "signatureBundle": {
          "signatures": [
            {
              "algorithm": "EcdsaP256Sha256",
              "keyId": "account-app-key",
              "publicKeyHash": "{public-key-hash}",
              "payloadHash": "{payload-hash}",
              "signatureBytes": "{browser-signature-bytes}",
              "publicKeyMaterial": "{public-key-material}"
            }
          ]
        },
        "signaturePayloadHash": "{payload-hash}"
      }
    ],
    "outputs": [
      {
        "outputIndex": 0,
        "address": "{address}",
        "mainAmount": { "value": 1 }
      }
    ]
  },
  "privateKeyMaterialAllowed": false
}
