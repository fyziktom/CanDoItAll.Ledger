<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <CanDoItAllComponentsPackageVersion>0.1.17</CanDoItAllComponentsPackageVersion>
    <CanDoItAllIpfsPackageVersion>0.1.16</CanDoItAllIpfsPackageVersion>
    <CanDoItAllPackageVersion Condition="'$(CanDoItAllPackageVersion)' == ''">1.0.0</CanDoItAllPackageVersion>
    <Version Condition="'$(Version)' == ''">$(CanDoItAllPackageVersion)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <Authors Condition="'$(Authors)' == ''">fyziktom</Authors>
    <Copyright Condition="'$(Copyright)' == ''">Copyright (c) 2026 fyziktom</Copyright>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://aicandoitall.com</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/fyziktom/CanDoItAll.Ledger</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == '' and '$(PackageLicenseFile)' == ''">MIT</PackageLicenseExpression>
    <PackageReadmeFile Condition="'$(PackageReadmeFile)' == ''">README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
