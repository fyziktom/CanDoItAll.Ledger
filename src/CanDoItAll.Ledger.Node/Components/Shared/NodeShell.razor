@namespace CanDoItAll.Ledger.Node.Components.Shared
@using CanDoItAll.Components.Common
@implements IDisposable
@inject NavigationManager Navigation
@inject SideMenuService SideMenus

<div class="cda-node-shell-theme">
    <Layout FitViewport="true"
            LockOverflow="true"
            Class="cda-node-shell min-w-0"
            data-testid="@TestId">
    <SideMenu MenuId="@MenuId"
              Title="@Title"
              Subtitle="@Subtitle"
              Icon="account_balance"
              AriaLabel="Node workspace sections"
              Items="@NavigationItems"
              BottomItems="@BottomNavigationItems"
              FillHeight="true"
              ItemSelected="NavigateAsync">
        <HeaderContent>
            <a href="/accounts"
               class="cda-node-route-brand-link"
               data-testid="node-route-navigation">
                <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                    <TextBlock TextStyle="TextStyle.Caption" Value="@Subtitle" />
                    <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Title" />
                </Stack>
            </a>
        </HeaderContent>
    </SideMenu>

    <Body FillHeight="true" Scrollable="true" Class="min-w-0 p-3 sm:p-4">
        <PageScaffold MaxWidthClass="max-w-full" Class="cda-node-route-shell">
            <Header>
                <span class="sr-only" data-route-focus>@Heading</span>
                <div data-testid="node-route-header">
                    <PageHeader Eyebrow="@Eyebrow"
                                Title="@Heading"
                                Description="@Description"
                                Actions="@HeaderActions" />
                </div>
            </Header>

            <ChildContent>
                @ChildContent
            </ChildContent>
        </PageScaffold>
    </Body>
    </Layout>
</div>

@code {
    private const string MenuId = "ledger-node-primary";

    private static readonly IReadOnlyList<ISideMenuItem> NavigationItems =
    [
        new SideMenuItemDefinition
        {
            Id = "accounts",
            Text = "Accounts",
            Icon = "account_balance_wallet",
            Description = "Accounts, addresses, balances, and operator actions.",
            Payload = "/accounts",
            OverflowBehavior = SideMenuOverflowBehavior.PreferVisible
        },
        new SideMenuItemDefinition
        {
            Id = "transactions",
            Text = "Transactions",
            Icon = "receipt_long",
            Description = "Inspect and submit ledger transactions.",
            Payload = "/transactions",
            OverflowBehavior = SideMenuOverflowBehavior.PreferVisible
        },
        new SideMenuItemDefinition
        {
            Id = "business-objects",
            Text = "Business objects",
            Icon = "inventory_2",
            Description = "Browse and manage ledger-backed business objects.",
            Payload = "/business-objects"
        },
        new SideMenuItemDefinition
        {
            Id = "analytics",
            Text = "Analytics",
            Icon = "query_stats",
            Description = "Review ledger and account analytics.",
            Payload = "/analytics"
        },
        new SideMenuItemDefinition
        {
            Id = "simulation",
            Text = "Simulation",
            Icon = "travel_explore",
            Description = "Open the economy simulation workspace.",
            Payload = "/economy/simulation-sandbox"
        },
        new SideMenuItemDefinition
        {
            Id = "admin",
            Text = "Node admin",
            Icon = "admin_panel_settings",
            Description = "Node health, verification, security, and maintenance.",
            Payload = "/admin"
        }
    ];

    [Parameter]
    public string Title { get; set; } = "Ledger Node";

    [Parameter]
    public string Subtitle { get; set; } = "Blazor SSR";

    [Parameter]
    public string Eyebrow { get; set; } = "Workspace";

    [Parameter]
    public string Heading { get; set; } = "Node workspace";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? StatusText { get; set; }

    [Parameter]
    public string StatusTone { get; set; } = "info";

    [Parameter]
    public string? StatusDescription { get; set; }

    [Parameter]
    public string TestId { get; set; } = "node-shell";

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? MenuFooter { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private IReadOnlyList<ISideMenuItem> BottomNavigationItems
    {
        get
        {
            var items = new List<ISideMenuItem>();

            if (!string.IsNullOrWhiteSpace(StatusText))
            {
                items.Add(new SideMenuItemDefinition
                {
                    Id = "node-status",
                    Text = "Node status",
                    Icon = "monitor_heart",
                    Description = StatusDescription ?? "Review the current node health status.",
                    BadgeText = StatusText,
                    PanelTitle = "Node status",
                    Activation = SideMenuItemActivation.OpenPanel,
                    PanelContent = StatusPanel
                });
            }

            if (MenuFooter is not null)
            {
                items.Add(new SideMenuItemDefinition
                {
                    Id = "session",
                    Text = "Session",
                    Icon = "account_circle",
                    Description = "Account and session actions.",
                    PanelTitle = "Session",
                    Activation = SideMenuItemActivation.OpenPanel,
                    PanelContent = MenuFooterPanel
                });
            }

            return items;
        }
    }

    private RenderFragment StatusPanel => @<Stack Section="true"
                                                   GapScale="LayoutGap.Small"
                                                   AlignItems="AlignItems.Stretch"
                                                   data-testid="node-route-status">
        <Cluster Gap="LayoutGap.Small"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Caption" Value="Node status" />
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@StatusText" />
            </Stack>
            <StatusBadge Text="@StatusText" Tone="@StatusTone" />
        </Cluster>
        @if (!string.IsNullOrWhiteSpace(StatusDescription))
        {
            <TextBlock TextStyle="TextStyle.Body2" Value="@StatusDescription" />
        }
    </Stack>;

    private RenderFragment MenuFooterPanel => @<Stack GapScale="LayoutGap.Small"
                                                       AlignItems="AlignItems.Stretch"
                                                       data-testid="node-menu-footer">
        @MenuFooter
    </Stack>;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SynchronizeSelectionAsync();
        }
    }

    private Task NavigateAsync(SideMenuSelection selection)
    {
        if (selection.Source == SideMenuSelectionSource.External
            || selection.Item.Payload is not string href
            || string.IsNullOrWhiteSpace(href))
        {
            return Task.CompletedTask;
        }

        if (!string.Equals(CurrentPath, href, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(href);
        }

        return Task.CompletedTask;
    }

    private async Task SynchronizeSelectionAsync()
    {
        string? itemId = ResolveCurrentItemId();
        if (itemId is null
            || string.Equals(SideMenus.GetSnapshot(MenuId).SelectedItemId, itemId, StringComparison.Ordinal))
        {
            return;
        }

        await SideMenus.SelectAsync(MenuId, itemId, SideMenuSelectionSource.External);
    }

    private string? ResolveCurrentItemId()
    {
        if (CurrentPath == "/")
        {
            return "accounts";
        }

        return NavigationItems
            .FirstOrDefault(item => string.Equals(item.Payload as string, CurrentPath, StringComparison.OrdinalIgnoreCase))
            ?.Id;
    }

    private string CurrentPath
    {
        get
        {
            string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
            string path = "/" + relative.Split('?', '#')[0].Trim('/');
            return path == "/" ? path : path.TrimEnd('/');
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
        => _ = InvokeAsync(SynchronizeSelectionAsync);

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
