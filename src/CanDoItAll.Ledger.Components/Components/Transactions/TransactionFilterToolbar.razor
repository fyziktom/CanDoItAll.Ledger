@namespace CanDoItAll.Ledger.Components

<Toolbar data-testid="cda-transaction-filter-toolbar">
    <ToolbarFields>
        <TextBox @bind-Value="search" Placeholder="Search transaction id, address, or payload" aria-label="Search transactions" />
        <DropDown TItem="string"
                  Value="@status"
                  ValueChanged="@((string value) => status = value)"
                  Items="Statuses"
                  aria-label="Transaction status" />
    </ToolbarFields>
    <ToolbarActions>
        <Button Text="Apply" Icon="filter_alt" Variant="Variant.Outlined" />
    </ToolbarActions>
</Toolbar>

@code {
    private string search = string.Empty;
    private string status = "All statuses";
    private static readonly IReadOnlyList<string> Statuses = ["All statuses", "Confirmed", "Pending", "Rejected"];
}
