@namespace CanDoItAll.Ledger.Components

<Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" data-testid="payment-transaction-form">
    <FormSection Title="Send main currency" Description="Choose a receiver, then use the available balance shortcuts or enter an exact amount.">
        <Grid ColumnTemplateLg="minmax(20rem,1.35fr) minmax(12rem,.65fr) minmax(18rem,1fr)" Gap="LayoutGap.Medium" AlignItems="AlignItems.Start">
            <TransactionAddressInput Label="Payment receiver"
                                     Value="@Draft.PaymentReceiverAddress.Value"
                                     ValueChanged="SetPaymentReceiverAddressAsync"
                                     Placeholder="cdia1…"
                                     Bookmarks="Bookmarks"
                                     AccountScope="@AccountScope"
                                     DialogSubtitle="Send"
                                     TestId="cda-send-payment-receiver" />

            <TransactionAmountInput Label="Payment amount"
                                    Value="Draft.PaymentAmount"
                                    ValueChanged="SetPaymentAmountAsync"
                                    MaxAmount="Balance?.MainBalance"
                                    Placeholder="250"
                                    TestId="cda-send-payment-amount" />

            <FormField Text="Memo">
                <TextBox Value="@Draft.ExternalRef"
                         ValueChanged="@(EventCallback.Factory.Create<string?>(this, SetExternalRefAsync))"
                         Immediate="true"
                         Placeholder="What is this payment for?"
                         aria-label="Memo"
                         data-testid="cda-send-payment-memo" />
            </FormField>
        </Grid>
    </FormSection>
</Stack>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-composer";

    [Parameter]
    public LedgerAccountBalance? Balance { get; set; }

    private Task SetPaymentReceiverAddressAsync(string? value)
        => UpdateDraftAsync(Draft with { PaymentReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetPaymentAmountAsync(Amount? value)
        => UpdateDraftAsync(Draft with { PaymentAmount = value ?? Amount.Zero });

    private Task SetExternalRefAsync(string? value)
        => UpdateDraftAsync(Draft with { ExternalRef = value ?? string.Empty });

    private Task UpdateDraftAsync(BusinessObjectTransactionDraft nextDraft)
        => DraftChanged.InvokeAsync(nextDraft);

}
