@namespace CanDoItAll.Ledger.Components

<SurfaceCard data-testid="cda-tx-output-card">
    <Stack GapScale="LayoutGap.Medium">
        <Split Breakpoint="LayoutBreakpoint.None"
               AlignItems="AlignItems.Center"
               Wrap="FlexWrap.Wrap"
               Gap="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@($"Output #{Output.OutputIndex}")" />
            <Cluster Gap="LayoutGap.XSmall">
                @if (!string.IsNullOrWhiteSpace(RoleLabel))
                {
                    <StatusBadge Text="@RoleLabel" Tone="@RoleTone" />
                }
                <StatusBadge Text="@FormatToken(Output.Token)" Tone="neutral" />
            </Cluster>
        </Split>

        <Grid ColumnsSm="3" Gap="LayoutGap.Small">
            <MetricCard Label="Main" Value="@Output.MainAmount.ToString()" />
            <MetricCard Label="Token" Value="@FormatToken(Output.Token)" />
            <MetricCard Label="Metadata">
                <ValueContent>
                    <HashDisplay Value="@(Output.MetadataHash?.Value)" EmptyText="none" />
                </ValueContent>
            </MetricCard>
        </Grid>

        <Grid ColumnTemplateMd="minmax(7rem,0.24fr) minmax(0,1fr)"
              Gap="LayoutGap.Small"
              AlignItems="AlignItems.Center">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Recipient" />
            <CopyableMonoValue Value="@Output.Address.Value" />
        </Grid>

        @if (Output.BusinessObject is not null)
        {
            <SmallText Paragraph="true">
                BO <CopyableMonoValue Value="@OutputBusinessObjectId"
                                      Truncate="false"
                                      AriaLabel="Copy business object UTXO id" /> v@(Output.BusinessObject.Version) (@Output.BusinessObject.Operation)
            </SmallText>
        }
        @if (!string.IsNullOrWhiteSpace(SupportingText))
        {
            <TextBlock TextStyle="TextStyle.Muted" Value="@SupportingText" />
        }
    </Stack>
</SurfaceCard>

@code {
    [Parameter, EditorRequired]
    public LedgerTransactionOutputDetails Output { get; set; } = default!;

    [Parameter]
    public TxId? TransactionId { get; set; }

    [Parameter]
    public string? RoleLabel { get; set; }

    [Parameter]
    public string RoleTone { get; set; } = "neutral";

    [Parameter]
    public string? SupportingText { get; set; }

    private static string FormatToken(TokenTransfer? token)
        => token is null ? "none" : $"{token.Amount} {token.TokenId.Value}";

    private string OutputBusinessObjectId
        => TransactionId is { } txId
            ? BusinessObjectId.FromOutPoint(txId, Output.OutputIndex).Value
            : "Assigned after confirmation";
}
