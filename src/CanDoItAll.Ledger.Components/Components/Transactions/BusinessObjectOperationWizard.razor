@namespace CanDoItAll.Ledger.Components
@inject DialogService DialogService

<Stack GapScale="LayoutGap.Medium"
       AlignItems="AlignItems.Stretch"
       Class="w-full"
       data-testid="bo-operation-wizard">
    <TransactionWorkflowSteps Value="currentStep">
        <StepsItem Text="Source" Icon="travel_explore" Description="Choose where to look">
            <BusinessObjectLookupPanel Mine="BusinessObjects"
                                       AllowExternalSources="@(Mode == BusinessObjectTransactionMode.CloneObject)"
                                       LookupAsync="LookupAsync"
                                       ResultsLoaded="UseLookupResultsAsync" />
        </StepsItem>
        <StepsItem Text="Details" Icon="tune" Description="Configure the transaction">
            <SurfaceCard Soft="true" data-testid="bo-selected-source-summary">
                <Split Breakpoint="LayoutBreakpoint.Md" Gap="LayoutGap.Medium" AlignItems="AlignItems.Center">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Selected source" />
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@SelectedSourceSummary" />
                        <TextBlock TextStyle="TextStyle.Muted" Value="@SelectedSourceDetail" />
                    </Stack>
                    <Button Text="Change selection"
                            Icon="view_module"
                            ButtonStyle="ButtonStyle.Secondary"
                            Variant="Variant.Outlined"
                            Click="ReopenSelectionAsync"
                            data-testid="bo-change-selection" />
                </Split>
            </SurfaceCard>

            @if (Mode == BusinessObjectTransactionMode.CloseObject)
            {
                <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                    Closing is final for this object lineage. Confirm the final state before review.
                </Alert>
            }

            <Grid ColumnTemplateXl="repeat(auto-fit,minmax(27rem,1fr))"
                  Gap="LayoutGap.Medium"
                  AlignItems="AlignItems.Start">
            @switch (Mode)
            {
                case BusinessObjectTransactionMode.TransferObject:
                    <FormSection Title="Transfer details" Description="The selected object is preloaded; choose its next owner and attached main amount.">
                        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                            <TransactionAddressInput Label="Receiver address"
                                                     Value="@ActiveDraft.ReceiverAddress.Value"
                                                     ValueChanged="SetReceiverAddressAsync"
                                                     Placeholder="cdia1…"
                                                     Bookmarks="Bookmarks"
                                                     AccountScope="@AccountScope"
                                                     DialogSubtitle="Transfer object"
                                                     TestId="bo-transfer-receiver" />
                            <TransactionAmountInput Label="Attached main amount"
                                                    Value="ActiveDraft.MainAmount"
                                                    ValueChanged="SetMainAmountAsync"
                                                    MaxAmount="Balance?.MainBalance"
                                                    TestId="bo-transfer-main-amount" />
                        </Grid>
                    </FormSection>
                    @RenderCommonStateFields("State after transfer", false, false)
                    break;

                case BusinessObjectTransactionMode.UpdateObject:
                    @RenderCommonStateFields("Next object state", true, true)
                    break;

                case BusinessObjectTransactionMode.CloseObject:
                    @RenderCommonStateFields("Final object state", true, true)
                    break;

                case BusinessObjectTransactionMode.CloneObject:
                    <FormSection Title="Clone definition" Description="Source metadata and state were preloaded. The clone receives its canonical ID after confirmation.">
                        <div data-testid="bo-clone-object-id-pending">
                            <SummaryTile Label="Clone object ID" Value="Assigned after confirmation" />
                        </div>
                        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                            @RenderTextField("Object type", ActiveDraft.ObjectType, SetObjectTypeAsync, "purchase-order", "bo-clone-object-type")
                            @RenderTextField("Schema version", ActiveDraft.SchemaVersion, SetSchemaVersionAsync, "1.0", "bo-clone-schema")
                        </Grid>
                    </FormSection>
                    @RenderCommonStateFields("Cloned state", true, false)
                    break;

                case BusinessObjectTransactionMode.MergeObjects:
                    <FormSection Title="Merge result" Description="The selected pair will be consumed. The result receives its canonical ID after confirmation.">
                        <div data-testid="bo-merge-object-id-pending">
                            <SummaryTile Label="Result object ID" Value="Assigned after confirmation" />
                        </div>
                    </FormSection>
                    @RenderCommonStateFields("Merged object state", true, false)
                    break;

                case BusinessObjectTransactionMode.SplitBusinessObjectPayment:
                    <FormSection Title="Payment allocation" Description="The first receiver carries the object; both receivers get positive payment outputs.">
                        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                            <TransactionAddressInput Label="Primary receiver"
                                                     Value="@ActiveDraft.PaymentReceiverAddress.Value"
                                                     ValueChanged="SetPrimaryReceiverAsync"
                                                     Placeholder="cdia1…"
                                                     Bookmarks="Bookmarks"
                                                     AccountScope="@AccountScope"
                                                     DialogSubtitle="Primary receiver"
                                                     TestId="bo-split-primary-receiver" />
                            <TransactionAmountInput Label="Primary amount"
                                                    Value="ActiveDraft.PaymentAmount"
                                                    ValueChanged="SetPrimaryAmountAsync"
                                                    TestId="bo-split-primary-amount" />
                            <TransactionAddressInput Label="Secondary receiver"
                                                     Value="@ActiveDraft.ReceiverAddress.Value"
                                                     ValueChanged="SetReceiverAddressAsync"
                                                     Placeholder="cdia1…"
                                                     Bookmarks="Bookmarks"
                                                     AccountScope="@AccountScope"
                                                     DialogSubtitle="Secondary receiver"
                                                     TestId="bo-split-secondary-receiver" />
                            <TransactionAmountInput Label="Secondary amount"
                                                    Value="ActiveDraft.SecondaryPaymentAmount"
                                                    ValueChanged="SetSecondaryAmountAsync"
                                                    AllowEmpty="true"
                                                    TestId="bo-split-secondary-amount" />
                        </Grid>
                    </FormSection>
                    @RenderCommonStateFields("Next object state", false, false)
                    break;
            }
            </Grid>
        </StepsItem>
        <StepsItem Text="Review" Icon="fact_check" Description="Validate before signing">
            @if (selectedObjects.Count > 0)
            {
                <Grid ColumnTemplate="repeat(2,minmax(0,17rem))"
                      Gap="LayoutGap.Small"
                      JustifyContent="JustifyContent.Start">
                    @foreach (IBusinessObjectView selected in selectedObjects)
                    {
                        <BusinessObjectSelectionCard Item="selected" Selected="true" Interactive="false" TestId="bo-review-source" />
                    }
                </Grid>
            }
            <TransactionReviewPanel Draft="ActiveDraft" />
        </StepsItem>
    </TransactionWorkflowSteps>

    @if (currentStep > 0)
    {
        <Split Breakpoint="LayoutBreakpoint.None"
               Gap="LayoutGap.Small"
               Class="w-full items-center justify-between border-t border-slate-200 pt-3">
            <Button Text="Back"
                    Icon="arrow_back"
                    ButtonStyle="ButtonStyle.Secondary"
                    Variant="Variant.Outlined"
                    Click="PreviousStep"
                    data-testid="bo-wizard-back" />
            @if (currentStep < 2)
            {
                <Button Text="@(currentStep == 1 ? "Review transaction" : "Continue")"
                        Icon="arrow_forward"
                        Disabled="@(!CanContinue)"
                        Click="NextStep"
                        data-testid="bo-wizard-next" />
            }
        </Split>
    }
</Stack>

@code {
    private BusinessObjectTransactionDraft? localDraft;
    private IReadOnlyList<IBusinessObjectView> lookupResults = [];
    private IReadOnlyList<IBusinessObjectView> selectedObjects = [];
    private int currentStep;
    private BusinessObjectTransactionMode? observedMode;

    [Parameter, EditorRequired]
    public BusinessObjectTransactionMode Mode { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public IReadOnlyList<IBusinessObjectView> BusinessObjects { get; set; } = [];

    [Parameter]
    public Func<BusinessObjectLookupRequest, Task<IReadOnlyList<IBusinessObjectView>>>? LookupAsync { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-composer";

    [Parameter]
    public LedgerAccountBalance? Balance { get; set; }

    [Parameter]
    public EventCallback<bool> ReviewReadyChanged { get; set; }

    private BusinessObjectTransactionDraft ActiveDraft => localDraft ?? Draft;

    private int RequiredSelectionCount => Mode == BusinessObjectTransactionMode.MergeObjects ? 2 : 1;

    private bool CanContinue
        => currentStep switch
        {
            0 => selectedObjects.Count == RequiredSelectionCount,
            1 => Validation.IsValid,
            _ => true
        };

    private TransactionFlowValidation Validation
        => TransactionDraftValidator.Validate(
            ActiveDraft with { SelectedMode = Mode },
            new TransactionDraftValidationContext(
                Balance,
                BusinessObjects: BusinessObjects
                    .Concat(selectedObjects)
                    .DistinctBy(item => item.CurrentOutPoint)
                    .ToArray()));

    private string SelectedSourceSummary
        => selectedObjects.Count switch
        {
            0 => "No object selected",
            1 => BusinessObjectCardDisplay.DisplayName(selectedObjects[0]),
            _ => $"{selectedObjects.Count} compatible objects"
        };

    private string SelectedSourceDetail
        => string.Join(" · ", selectedObjects.Select(item => $"{item.ObjectType} / v{item.Version} / {ShortOutPoint(item.CurrentOutPoint)}"));

    protected override void OnParametersSet()
    {
        localDraft = Draft with { SelectedMode = Mode };
        if (observedMode != Mode)
        {
            observedMode = Mode;
            lookupResults = [];
            selectedObjects = [];
            currentStep = 0;
        }
    }

    private async Task UseLookupResultsAsync(IReadOnlyList<IBusinessObjectView> results)
    {
        lookupResults = results;
        await OpenSelectionAsync(results);
    }

    private Task ReopenSelectionAsync()
        => OpenSelectionAsync(lookupResults.Count > 0 ? lookupResults : BusinessObjects);

    private async Task OpenSelectionAsync(IReadOnlyList<IBusinessObjectView> items)
    {
        object? result = await DialogService.OpenAsync<BusinessObjectPickerDialogContent>(
            RequiredSelectionCount == 2 ? "Select business objects to merge" : "Select a business object",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectPickerDialogContent.Items)] = items,
                [nameof(BusinessObjectPickerDialogContent.InitialSelected)] = selectedObjects,
                [nameof(BusinessObjectPickerDialogContent.MinimumSelections)] = RequiredSelectionCount,
                [nameof(BusinessObjectPickerDialogContent.MaximumSelections)] = RequiredSelectionCount,
                [nameof(BusinessObjectPickerDialogContent.RequireCompatibleSelection)] = Mode == BusinessObjectTransactionMode.MergeObjects
            },
            new DialogOptions
            {
                Subtitle = "Search by name, object ID, type, state, or tags.",
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog",
                TestId = "bo-selection-dialog"
            });

        if (result is not IEnumerable<IBusinessObjectView> selection)
        {
            return;
        }

        IReadOnlyList<IBusinessObjectView> selected = selection.Take(RequiredSelectionCount).ToArray();
        if (selected.Count != RequiredSelectionCount)
        {
            return;
        }

        await SetSelectedObjectsAsync(selected);
        currentStep = 1;
    }

    private async Task SetSelectedObjectsAsync(IReadOnlyList<IBusinessObjectView> selected)
    {
        selectedObjects = selected;
        if (selected.Count == 0)
        {
            return;
        }

        IBusinessObjectView first = selected[0];
        BusinessObjectId firstId = BusinessObjectId.FromOutPoint(first.CurrentOutPoint);
        BusinessObjectTransactionDraft next = ActiveDraft with
        {
            SelectedMode = Mode,
            ObjectId = firstId,
            ObjectType = first.ObjectType,
            SchemaVersion = first.SchemaVersion,
            StateJson = first.StateJson ?? "{}"
        };

        next = Mode switch
        {
            BusinessObjectTransactionMode.CloneObject => next with
            {
                SourceObjectId = firstId
            },
            BusinessObjectTransactionMode.MergeObjects when selected.Count == 2 => next with
            {
                SourceObjectId = firstId,
                SecondObjectId = BusinessObjectId.FromOutPoint(selected[1].CurrentOutPoint)
            },
            _ => next
        };

        await UpdateDraftAsync(next);
    }

    private async Task PreviousStep()
    {
        currentStep = Math.Max(0, currentStep - 1);
        await NotifyReviewReadyAsync();
    }

    private async Task NextStep()
    {
        if (CanContinue)
        {
            currentStep = Math.Min(2, currentStep + 1);
            await NotifyReviewReadyAsync();
        }
    }

    private Task NotifyReviewReadyAsync()
        => ReviewReadyChanged.InvokeAsync(currentStep == 2);

    private Task SetReceiverAddressAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetPrimaryReceiverAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { PaymentReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetMainAmountAsync(Amount? value)
        => UpdateDraftAsync(ActiveDraft with { MainAmount = value ?? Amount.Zero });

    private Task SetPrimaryAmountAsync(Amount? value)
        => UpdateDraftAsync(ActiveDraft with { PaymentAmount = value ?? Amount.Zero });

    private Task SetSecondaryAmountAsync(Amount? value)
        => UpdateDraftAsync(ActiveDraft with { SecondaryPaymentAmount = value });

    private Task SetObjectTypeAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ObjectType = value ?? string.Empty });

    private Task SetSchemaVersionAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { SchemaVersion = value ?? string.Empty });

    private Task SetStateJsonAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { StateJson = value ?? string.Empty });

    private Task SetExternalRefAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ExternalRef = value ?? string.Empty });

    private async Task UpdateDraftAsync(BusinessObjectTransactionDraft next)
    {
        localDraft = next;
        await DraftChanged.InvokeAsync(next);
    }

    private RenderFragment RenderCommonStateFields(string stateLabel, bool required, bool expanded)
        => @<FormSection Title="State and audit" Description="Preloaded from the selected object. JSON stays available as an advanced field.">
            @RenderTextField("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "erp://object/1042", "bo-operation-external-ref")
            <details class="min-w-0 rounded-xl border border-slate-200 bg-slate-50 p-3" open="@expanded">
                <summary class="cursor-pointer font-semibold text-slate-700">@stateLabel @(required ? "(required)" : "(optional)")</summary>
                <FormField Text="@stateLabel" Class="mt-3">
                    <TextArea Value="@ActiveDraft.StateJson"
                              ValueChanged="@(EventCallback.Factory.Create<string?>(this, SetStateJsonAsync))"
                              Immediate="true"
                              Rows="4"
                              aria-label="@stateLabel"
                              data-testid="bo-operation-state-json" />
                </FormField>
            </details>
        </FormSection>;

    private RenderFragment RenderTextField(
        string label,
        string? value,
        Func<string?, Task> changed,
        string placeholder,
        string testId)
        => @<FormField Text="@label">
            <TextBox Value="@value"
                     ValueChanged="@(EventCallback.Factory.Create<string?>(this, changed))"
                     Immediate="true"
                     Placeholder="@placeholder"
                     aria-label="@label"
                     data-testid="@testId" />
        </FormField>;

    private static string ShortOutPoint(OutPoint outPoint)
    {
        string value = outPoint.ToString();
        return value.Length <= 22 ? value : $"{value[..11]}...{value[^7..]}";
    }
}
