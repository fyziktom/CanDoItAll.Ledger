@namespace CanDoItAll.Ledger.Components

<DialogScaffold Eyebrow="Token authority"
                Title="Mint token"
                Description="Permission-backed token minting stays separated from payment composition."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                Footer="@RenderFooter"
                data-testid="cda-token-mint-dialog">
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsMd="3" Gap="LayoutGap.Medium">
            <FormField Text="Namespace">
                <TextBox @bind-Value="tokenNamespace" />
            </FormField>
            <FormField Text="Token name">
                <TextBox @bind-Value="tokenName" />
            </FormField>
            <FormField Text="Amount">
                <TextBox @bind-Value="amount" />
            </FormField>
        </Grid>
        <FormField Text="Description">
            <TextArea @bind-Value="description" Rows="3" />
        </FormField>
    </Stack>
</DialogScaffold>

@code {
    private string tokenNamespace = "ops.credit";
    private string tokenName = "Q2-CREDIT";
    private string amount = "500";
    private string description = "Operational credit source minted under a permission grant.";

    [Parameter]
    public IReadOnlyList<LedgerTokenCreationAuthority> Authorities { get; set; } = [];

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<PermissionSourcePanel>(0);
        builder.AddAttribute(1, nameof(PermissionSourcePanel.Sources), Array.Empty<LedgerPermissionSource>());
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<ActionReviewPanel>(0);
        builder.AddAttribute(1, nameof(ActionReviewPanel.Title), "Authority review");
        builder.AddAttribute(2, nameof(ActionReviewPanel.Items), Authorities.Select(item =>
            new ActionReviewFact(item.Namespace, item.GrantObjectId.Value)).ToArray());
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Save draft");
        builder.AddAttribute(2, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(3);
        builder.AddAttribute(4, nameof(Button.Text), "Review mint");
        builder.AddAttribute(5, nameof(Button.Icon), "token");
        builder.CloseComponent();
    };
}
