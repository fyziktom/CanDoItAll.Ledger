@namespace CanDoItAll.Ledger.Components

<InspectorDialogLayout Eyebrow="Transaction inspector"
                       Title="@(Details?.TxId.Value ?? "No transaction selected")"
                       Description="Inputs, outputs, signatures, payload, and flow are split into reusable primitives."
                       InspectorRail="@RenderSummary"
                       HeaderActions="@RenderActions"
                       TestId="cda-transaction-inspector-dialog">
    @if (Details is null)
    {
        <EmptyState Eyebrow="Transaction" Title="No details" Description="Select a transaction to inspect full ledger details." />
    }
    else
    {
        <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
            <TransactionInputOutputFlow Inputs="Details.Inputs"
                                        Outputs="Details.Outputs"
                                        TransactionId="Details.TxId"
                                        DetailLevel="TransactionFlowDetailLevel.Detailed" />
            <TxDataPayloadViewer Data="Details.Data"
                                 Outputs="Details.Outputs"
                                 TransactionId="Details.TxId" />
            <TransactionTimeline Details="Details" />
            <TransactionSignatureList Inputs="Details.Inputs" />
        </Stack>
    }
</InspectorDialogLayout>

@code {
    [Parameter]
    public LedgerTransactionDetailsModel? Details { get; set; }

    private RenderFragment RenderSummary => builder =>
    {
        builder.OpenComponent<StatusCheckList>(0);
        builder.AddAttribute(1, nameof(StatusCheckList.Title), "Detail checks");
        builder.AddAttribute(2, nameof(StatusCheckList.Items), Details is null ? Array.Empty<StatusCheckItem>() : new[]
        {
            new StatusCheckItem { Label = "Inputs", Status = Details.Inputs.Count.ToString(), Tone = "info", Complete = true },
            new StatusCheckItem { Label = "Outputs", Status = Details.Outputs.Count.ToString(), Tone = "info", Complete = true },
            new StatusCheckItem { Label = "Signatures", Status = Details.Inputs.Sum(item => item.SignatureCount).ToString(), Tone = "success", Complete = true }
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderActions => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Copy tx id");
        builder.AddAttribute(2, nameof(Button.Icon), "content_copy");
        builder.AddAttribute(3, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
    };
}
