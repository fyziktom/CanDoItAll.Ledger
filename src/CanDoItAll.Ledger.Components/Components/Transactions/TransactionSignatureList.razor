@namespace CanDoItAll.Ledger.Components

<div class="min-w-0" data-testid="@TestId">
    <SurfaceCard Soft="true">
        <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
            <ListPanelHeader Title="@Title"
                             Description="@EffectiveDescription"
                             Count="@($"{rows.Count} recorded")"
                             Dense="true" />

            @if (rows.Count == 0)
            {
                <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center">
                    <Icon Name="key_off" />
                    <TextBlock TextStyle="TextStyle.Muted" Value="No input signatures were recorded." />
                </Cluster>
            }
            else
            {
                <DataGrid TItem="TransactionSignatureRow"
                          Data="@rows"
                          AllowPaging="false"
                          data-testid="cda-tx-signature-grid">
                    <Columns>
                        <DataGridColumn TItem="TransactionSignatureRow" Title="Input">
                            <Template Context="row">
                                <div data-testid="cda-tx-signature-row">
                                    <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap">
                                        <StatusBadge Text="@($"#{row.Input.InputIndex}")" Tone="info" />
                                        <TextBlock TextStyle="TextStyle.Caption" Value="@($"signature {row.SignatureIndex + 1}")" />
                                    </Cluster>
                                </div>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="TransactionSignatureRow" Title="Algorithm / key">
                            <Template Context="row">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <TextBlock TextStyle="TextStyle.Caption" Value="@row.Signature.Algorithm.ToString()" />
                                    <CopyableMonoValue Value="@row.Signature.KeyId"
                                                       StartChars="16"
                                                       EndChars="6"
                                                       AriaLabel="@($"Copy signature key id for input #{row.Input.InputIndex}")" />
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="TransactionSignatureRow" Title="Verification hashes">
                            <Template Context="row">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.NoWrap">
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Public key" />
                                        <HashDisplay Value="@row.Signature.PublicKeyHash.Value"
                                                     StartChars="10"
                                                     EndChars="6"
                                                     AriaLabel="@($"Copy public key hash for input #{row.Input.InputIndex}")" />
                                    </Cluster>
                                    <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.NoWrap">
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Payload" />
                                        <HashDisplay Value="@ResolvePayloadHash(row)"
                                                     StartChars="10"
                                                     EndChars="6"
                                                     AriaLabel="@($"Copy signature payload hash for input #{row.Input.InputIndex}")" />
                                    </Cluster>
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="TransactionSignatureRow" Title="Input binding">
                            <Template Context="row">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <StatusBadge Text="@($"{row.Signature.SignatureBytes.Length} bytes")" Tone="neutral" />
                                    @if (row.Input.OutPointKey is { } outPointKey)
                                    {
                                        <HashDisplay Value="@outPointKey.Value.Value"
                                                     StartChars="10"
                                                     EndChars="6"
                                                     AriaLabel="@($"Copy outpoint key for input #{row.Input.InputIndex}")" />
                                    }
                                    else
                                    {
                                        <TextBlock TextStyle="TextStyle.Muted" Value="No outpoint key" />
                                    }
                                </Stack>
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </Stack>
    </SurfaceCard>
</div>

@code {
    private IReadOnlyList<TransactionSignatureRow> rows = [];

    [Parameter]
    public IReadOnlyList<LedgerTransactionInputDetails> Inputs { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Signatures";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string TestId { get; set; } = "cda-transaction-signature-list";

    private string EffectiveDescription
        => Description ?? $"Across {Inputs.Count} input(s)";

    protected override void OnParametersSet()
    {
        rows = Inputs
            .OrderBy(input => input.InputIndex)
            .SelectMany(input => input.SignatureBundle.Signatures.Select(
                (signature, signatureIndex) => new TransactionSignatureRow(input, signature, signatureIndex)))
            .ToArray();
    }

    private static string ResolvePayloadHash(TransactionSignatureRow row)
        => row.Input.SignaturePayloadHash?.Value ?? row.Signature.PayloadHash.Value;

    private sealed record TransactionSignatureRow(
        LedgerTransactionInputDetails Input,
        SignatureEnvelope Signature,
        int SignatureIndex);
}
