@namespace CanDoItAll.Ledger.Components

<SurfaceCard Class="grid min-w-0 gap-2"
             Style="padding:0.75rem;box-shadow:none;align-self:start;align-content:start"
             role="region"
             aria-label="Transaction timeline"
             data-testid="cda-transaction-timeline">
    <Split Breakpoint="LayoutBreakpoint.None"
           AlignItems="AlignItems.Center"
           Wrap="FlexWrap.Wrap"
           Gap="LayoutGap.Small">
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap">
            <Icon Name="timeline" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Transaction timeline" />
        </Cluster>
        <StatusBadge Text="@($"{Items.Count} events")" Tone="neutral" NoWrap="true" />
    </Split>

    <ol class="m-0 flex min-w-0 list-none flex-col gap-0 p-0">
        @foreach (TimelineItem item in Items)
        {
            <li class="transaction-event-timeline__item relative flex min-w-0 gap-2 py-1.5"
                data-tone="@item.Tone"
                data-testid="cda-transaction-timeline-event">
                <span class="transaction-event-timeline__marker z-10 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-slate-200 bg-slate-50 text-slate-500" aria-hidden="true">
                    <Icon Name="@(item.Icon ?? "circle")" />
                </span>
                <div class="grid min-w-0 flex-1 content-center gap-0.5">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           AlignItems="AlignItems.Center"
                           Wrap="FlexWrap.Wrap"
                           Gap="LayoutGap.XSmall">
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@item.Label" />
                        @if (item.Timestamp is { } timestamp)
                        {
                            <time class="whitespace-nowrap text-xs text-slate-500" datetime="@timestamp.ToString("O")">@FormatTimestamp(timestamp)</time>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Meta))
                        {
                            <StatusBadge Text="@item.Meta" Tone="@item.Tone" NoWrap="true" />
                        }
                    </Split>
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <TextBlock TextStyle="TextStyle.Caption" Value="@item.Description" />
                    }
                </div>
            </li>
        }
    </ol>
</SurfaceCard>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public LedgerTransactionDetailsModel? Details { get; set; }

    private IReadOnlyList<TimelineItem> Items
        => Details is not null
            ? BuildDetailsTimeline()
            : LedgerTransactionOrdering
                .NewestFirst(Transactions)
                .Select(item => new TimelineItem
                {
                    Label = item.TxId.Value,
                    Description = $"{TransactionUiPresentation.KindLabel(item.Kind)} · {item.Status}",
                    Timestamp = item.Timestamp,
                    Icon = item.Kind == TransactionKind.BusinessObject ? "inventory_2" : "receipt_long",
                    Tone = TransactionUiPresentation.StatusTone(item.Status)
                })
                .ToArray();

    private IReadOnlyList<TimelineItem> BuildDetailsTimeline()
    {
        var items = new List<TimelineItem>
        {
            new()
            {
                Label = "Recorded",
                Timestamp = Details!.Timestamp,
                Icon = "edit_note",
                Tone = "info"
            }
        };

        int signatureCount = Details.Inputs.Sum(input => input.SignatureCount);
        if (signatureCount > 0)
        {
            items.Add(new TimelineItem
            {
                Label = "Signed",
                Meta = $"{signatureCount} signature(s)",
                Icon = "draw",
                Tone = "info"
            });
        }

        items.Add(new TimelineItem
        {
            Label = "Ledger status",
            Meta = Details.Status.ToString(),
            Icon = TransactionUiPresentation.StatusIcon(Details.Status),
            Tone = TransactionUiPresentation.StatusTone(Details.Status)
        });

        return items;
    }

    private static string FormatTimestamp(DateTimeOffset value)
        => TransactionUiPresentation.FormatLocalTimestamp(value);

}
