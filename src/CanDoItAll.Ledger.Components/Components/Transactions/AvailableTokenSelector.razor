@namespace CanDoItAll.Ledger.Components

<Stack AlignItems="AlignItems.Stretch"
       GapScale="LayoutGap.Small"
       Class="@SelectorClass"
       data-testid="@DataTestId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <TextBlock TextStyle="TextStyle.Eyebrow" Value="@Label" />
    }

    <div class="available-token-selector__cards" role="radiogroup" aria-label="@AriaLabel">
        <Grid Columns="2" Gap="LayoutGap.Small">
            @foreach (LedgerTokenOption option in OrderedOptions)
            {
                <Button Look="ButtonLook.SheetCardGhost"
                        Class="w-full min-w-0 items-start justify-start text-left"
                        Style="@ChoiceCardStyle(option.Key == SelectedKey)"
                        role="radio"
                        aria-checked="@(option.Key == SelectedKey ? "true" : "false")"
                        Click="@(() => SelectAsync(option.Key))">
                    <Stack AlignItems="AlignItems.Stretch" GapScale="LayoutGap.Tiny" Class="w-full">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               Gap="LayoutGap.Tiny"
                               AlignItems="AlignItems.Center"
                               JustifyContent="JustifyContent.SpaceBetween"
                               Wrap="FlexWrap.Wrap">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="@option.AssetLabel" />
                            @if (option.CanCreateMore)
                            {
                                <StatusBadge Text="Mintable" Tone="info" NoWrap="true" />
                            }
                        </Split>
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@option.AvailableAmount.ToString()" />
                        @if (!option.IsMain)
                        {
                            <TextBlock TextStyle="TextStyle.Note" Value="@TokenShape(option)" />
                        }
                    </Stack>
                </Button>
            }
        </Grid>
    </div>

    <div class="available-token-selector__dropdown">
        <DropDown TValue="string"
                  Data="DropdownOptions"
                  TextProperty="Text"
                  ValueProperty="Key"
                  Value="@SelectedKey"
                  ValueChanged="SelectAsync"
                  Placeholder="Select asset"
                  aria-label="@AriaLabel" />
    </div>
</Stack>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<LedgerTokenOption> Options { get; set; } = [];

    [Parameter]
    public string? SelectedKey { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedKeyChanged { get; set; }

    [Parameter]
    public string Label { get; set; } = "Available tokens";

    [Parameter]
    public string AriaLabel { get; set; } = "Available tokens";

    [Parameter]
    public string? DataTestId { get; set; }

    [Parameter]
    public bool Compact { get; set; }

    private string SelectorClass
        => Compact ? "available-token-selector--compact" : string.Empty;

    private IReadOnlyList<LedgerTokenOption> OrderedOptions
        => Options
            .OrderByDescending(option => option.IsMain)
            .ThenBy(option => option.AssetLabel, StringComparer.Ordinal)
            .ToArray();

    private IReadOnlyList<TokenDropDownOption> DropdownOptions
        => OrderedOptions
            .Select(option => new TokenDropDownOption(option.Key, $"{option.AssetLabel} - {option.AvailableAmount} {TokenShape(option)}"))
            .ToArray();

    private Task SelectAsync(string? key)
        => SelectedKeyChanged.InvokeAsync(key);

    private static string? ChoiceCardStyle(bool selected)
        => selected
            ? "border-color:var(--cad-tone-info-soft-border);background:var(--cad-tone-info-soft-bg);color:var(--cad-tone-info-soft-fg);box-shadow:var(--cad-shadow-soft);"
            : null;

    private static string TokenShape(LedgerTokenOption option)
    {
        if (option.IsMain)
        {
            return string.Empty;
        }

        return $"source {option.SourceAmount} / unique {option.UniqueAmount}";
    }

    private sealed record TokenDropDownOption(string Key, string Text);
}
