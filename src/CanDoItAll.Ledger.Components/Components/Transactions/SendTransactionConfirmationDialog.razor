@namespace CanDoItAll.Ledger.Components

<DialogScaffold Eyebrow="Signing boundary"
                Title="Confirm transaction"
                Description="A signed transaction may move assets or mutate business-object state."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                ValidationContent="@RenderValidation"
                Footer="@RenderFooter"
                data-testid="cda-send-transaction-confirmation">
    <TransactionReviewPanel Draft="Draft" />
</DialogScaffold>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<StatusCheckList>(0);
        builder.AddAttribute(1, nameof(StatusCheckList.Title), "Pre-submit checks");
        builder.AddAttribute(2, nameof(StatusCheckList.Items), new[]
        {
            new StatusCheckItem { Label = "Mode is explicit", Status = Draft.SelectedMode.ToString(), Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Receiver present", Status = "Ready", Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Review required", Status = "Required", Tone = "warning" }
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<ActionReviewPanel>(0);
        builder.AddAttribute(1, nameof(ActionReviewPanel.Title), "Impact");
        builder.AddAttribute(2, nameof(ActionReviewPanel.Items), new[]
        {
            new ActionReviewFact("Main", Draft.MainAmount.ToString()),
            new ActionReviewFact("Payment", Draft.PaymentAmount.ToString()),
            new ActionReviewFact("Token", Draft.TokenId?.Value ?? "none")
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderValidation => builder =>
    {
        builder.OpenComponent<Alert>(0);
        builder.AddAttribute(1, nameof(Alert.AlertStyle), AlertStyle.Warning);
        builder.AddAttribute(2, nameof(Alert.ChildContent), (RenderFragment)(content =>
        {
            content.AddContent(0, "Confirming here should call the host-provided signing/submission callback.");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Keep editing");
        builder.AddAttribute(2, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(3);
        builder.AddAttribute(4, nameof(Button.Text), "Sign and submit");
        builder.AddAttribute(5, nameof(Button.Icon), "draw");
        builder.AddAttribute(6, nameof(Button.ButtonStyle), ButtonStyle.Danger);
        builder.CloseComponent();
    };
}
