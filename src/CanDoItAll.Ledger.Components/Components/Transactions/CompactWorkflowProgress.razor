@namespace CanDoItAll.Ledger.Components

<Stack GapScale="LayoutGap.Tiny"
       AlignItems="AlignItems.Stretch"
       Class="w-full min-w-0"
       @attributes="AdditionalAttributes">
    <Cluster Gap="LayoutGap.XSmall"
             AlignItems="AlignItems.Center"
             Wrap="FlexWrap.Wrap"
             Class="w-full min-w-0">
        @for (int index = 0; index < Steps.Count; index++)
        {
            int stepIndex = index;
            @if (CanSelect)
            {
                <Button Text="@StepText(stepIndex)"
                        Size="ButtonSize.Small"
                        ButtonStyle="ButtonStyle.Secondary"
                        Variant="@(stepIndex == CurrentValue ? Variant.Filled : Variant.Outlined)"
                        Click="@(() => SelectStepAsync(stepIndex))"
                        aria-current="@(stepIndex == CurrentValue ? "step" : null)" />
            }
            else
            {
                <StatusBadge Text="@StepText(stepIndex)"
                             Tone="@StepTone(stepIndex)" />
            }
        }
    </Cluster>

    <ProgressBar Value="@ProgressValue"
                 Max="@ProgressMaximum"
                 aria-label="@ProgressLabel" />
</Stack>

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Steps { get; set; } = [];

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public bool CanSelect { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private int CurrentValue
        => Steps.Count == 0 ? 0 : Math.Clamp(Value, 0, Steps.Count - 1);

    private double ProgressValue
        => Steps.Count == 0 ? 0 : CurrentValue + 1;

    private double ProgressMaximum
        => Math.Max(1, Steps.Count);

    private string ProgressLabel
        => Steps.Count == 0
            ? "Workflow progress"
            : $"Step {CurrentValue + 1} of {Steps.Count}: {Steps[CurrentValue]}";

    private string StepText(int index)
        => $"{index + 1}. {Steps[index]}";

    private string StepTone(int index)
        => index == CurrentValue ? "info" : index < CurrentValue ? "success" : "neutral";

    private Task SelectStepAsync(int index)
        => CanSelect && index != CurrentValue
            ? ValueChanged.InvokeAsync(index)
            : Task.CompletedTask;
}
