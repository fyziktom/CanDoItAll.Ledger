@namespace CanDoItAll.Ledger.Components

<Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch" Class="w-full min-w-0" data-testid="transaction-type-step">
    <Toolbar>
        <ToolbarRow>
            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Choose a transaction type" />
                <TextBlock TextStyle="TextStyle.Muted" Value="Select the ledger operation to assemble its required steps." />
            </Stack>
            <StatusBadge Text="Step 1" Tone="info" />
        </ToolbarRow>
    </Toolbar>

    <SecondaryTabs Items="FamilyItems"
                   SelectedKey="@selectedFamilyKey"
                   SelectedKeyChanged="SelectFamilyAsync"
                   Dense="true" />

    <Grid ColumnsLg="4" Gap="LayoutGap.Small" data-testid="transaction-operation-chooser">
        @foreach (TransactionFlowDefinition definition in VisibleDefinitions)
        {
            <SelectionListItem Title="@definition.Label"
                               Eyebrow="@FamilyLabel(definition.Family)"
                               Summary="@definition.Description"
                               IsSelected="@(definition.Mode == SelectedMode)"
                               Dense="true"
                               OnSelect="@(() => SelectModeAsync(definition.Mode))"
                               DataTestId="@($"transaction-mode-{definition.Mode}")">
                <Status>
                    <Icon Name="@definition.Icon" />
                </Status>
            </SelectionListItem>
        }
    </Grid>
</Stack>

@code {
    private static readonly IReadOnlyList<SecondaryTabItem> FamilyItems =
    [
        new(nameof(TransactionFlowFamily.Payment), "Payments", Description: "Main-currency transfers"),
        new(nameof(TransactionFlowFamily.Token), "Tokens", Description: "Token transfers and creation"),
        new(nameof(TransactionFlowFamily.Utxo), "UTXOs", Description: "Explicit output management"),
        new(nameof(TransactionFlowFamily.BusinessObject), "Business objects", Description: "Create, change, and combine objects")
    ];

    private string selectedFamilyKey = nameof(TransactionFlowFamily.Payment);
    private BusinessObjectTransactionMode? observedMode;

    [Parameter]
    public BusinessObjectTransactionMode SelectedMode { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionMode> SelectedModeChanged { get; set; }

    private TransactionFlowFamily SelectedFamily
        => Enum.TryParse(selectedFamilyKey, out TransactionFlowFamily family)
            ? family
            : TransactionFlowFamily.Payment;

    private IReadOnlyList<TransactionFlowDefinition> VisibleDefinitions
        => TransactionFlowCatalog.ForFamily(SelectedFamily);

    protected override void OnParametersSet()
    {
        if (observedMode != SelectedMode)
        {
            selectedFamilyKey = TransactionFlowCatalog.Get(SelectedMode).Family.ToString();
            observedMode = SelectedMode;
        }
    }

    private Task SelectFamilyAsync(string key)
    {
        selectedFamilyKey = key;
        return Task.CompletedTask;
    }

    private Task SelectModeAsync(BusinessObjectTransactionMode mode)
        => SelectedModeChanged.InvokeAsync(mode);

    private static string FamilyLabel(TransactionFlowFamily family)
        => family switch
        {
            TransactionFlowFamily.Payment => "Payment",
            TransactionFlowFamily.Token => "Token",
            TransactionFlowFamily.Utxo => "UTXO",
            _ => "Business object"
        };
}
