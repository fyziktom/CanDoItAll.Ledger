@namespace CanDoItAll.Ledger.Components

<DialogScaffold Eyebrow="Transaction workbench"
                Title="Compose ledger transaction"
                Description="Mode-aware composition with selectors, review, confirmation, and receipt slots."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                ValidationContent="@RenderValidation"
                Footer="@RenderFooter"
                data-testid="cda-transaction-workbench-dialog">
    <TransactionComposerShell Draft="Draft"
                              TokenOptions="TokenOptions"
                              SpendableOutputs="SpendableOutputs"
                              Bookmarks="Bookmarks"
                              AccountScope="@AccountScope"
                              DraftChanged="DraftChanged"
                              SubmitRequested="SubmitRequested"
                              Dense="true" />
</DialogScaffold>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<LedgerTokenOption> TokenOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<LedgerSpendableOutput> SpendableOutputs { get; set; } = [];

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> SubmitRequested { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-workbench";

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<AddressBookPicker>(0);
        builder.AddAttribute(1, nameof(AddressBookPicker.Bookmarks), Bookmarks);
        builder.CloseComponent();
        builder.OpenComponent<AssetSourceSelector>(2);
        builder.AddAttribute(3, nameof(AssetSourceSelector.TokenOptions), TokenOptions);
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<TransactionReviewPanel>(0);
        builder.AddAttribute(1, nameof(TransactionReviewPanel.Draft), Draft);
        builder.CloseComponent();
    };

    private RenderFragment RenderValidation => builder =>
    {
        builder.OpenComponent<Alert>(0);
        builder.AddAttribute(1, nameof(Alert.AlertStyle), AlertStyle.Info);
        builder.AddAttribute(2, nameof(Alert.ChildContent), (RenderFragment)(content =>
        {
            content.AddContent(0, "Unsupported host modes should remain visible with disabled submit states.");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Assemble");
        builder.AddAttribute(2, nameof(Button.Icon), "build");
        builder.AddAttribute(3, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(4);
        builder.AddAttribute(5, nameof(Button.Text), "Review");
        builder.AddAttribute(6, nameof(Button.Icon), "fact_check");
        builder.CloseComponent();
    };
}
