@namespace CanDoItAll.Ledger.Components

<SurfaceCard Class="grid min-w-0 gap-2"
             Style="padding:0.75rem;box-shadow:none"
             role="group"
             aria-label="Inputs to outputs"
             data-detail-level="@DetailLevel.ToString().ToLowerInvariant()"
             data-testid="cda-transaction-io-flow">
    <Split Breakpoint="LayoutBreakpoint.None"
           AlignItems="AlignItems.Center"
           Wrap="FlexWrap.Wrap"
           Gap="LayoutGap.Small">
        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap">
            <Icon Name="account_tree" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Heading" />
        </Cluster>
        <StatusBadge Text="@($"{Inputs.Count} input(s) → {Outputs.Count} output(s)")" Tone="info" NoWrap="true" />
    </Split>

    <Grid ColumnTemplateLg="minmax(0, 1fr) 2.75rem minmax(0, 1fr)"
          Gap="LayoutGap.Small"
          AlignItems="AlignItems.Center"
          Class="min-w-0">
        <div class="grid min-w-0 content-center gap-2" data-testid="cda-transaction-input-lane">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Sources" />
            @if (Inputs.Count == 0)
            {
                <div class="grid min-h-16 min-w-0 place-items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <TextBlock TextStyle="TextStyle.Muted" Value="No spend inputs" />
                </div>
            }
            else
            {
                @foreach (LedgerTransactionInputDetails input in Inputs)
                {
                    TransactionFlowItemPresentation? presentation = InputPresentationSelector?.Invoke(input);
                    <article class="grid min-w-0 gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3" data-testid="cda-transaction-input-node">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               AlignItems="AlignItems.Center"
                               Wrap="FlexWrap.Wrap"
                               Gap="LayoutGap.XSmall">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@($"Input #{input.InputIndex}")" />
                            <Cluster Gap="LayoutGap.XSmall">
                                @if (!string.IsNullOrWhiteSpace(presentation?.Label))
                                {
                                    <StatusBadge Text="@presentation.Label" Tone="@presentation.Tone" NoWrap="true" />
                                }
                                <StatusBadge Text="@FormatMain(input.MainAmount)" Tone="neutral" NoWrap="true" />
                                @if (input.Token is not null)
                                {
                                    <StatusBadge Text="@FormatToken(input.Token)" Tone="info" NoWrap="true" />
                                }
                                <StatusBadge Text="@($"{input.SignatureCount} sig")" Tone="success" NoWrap="true" />
                            </Cluster>
                        </Split>
                        <TransactionFlowAddress Address="input.Address"
                                                DirectoryEntries="DirectoryEntries"
                                                DirectionLabel="From" />
                        @if (IsDetailed)
                        {
                            <div class="grid min-w-0 gap-1 border-t border-slate-200 pt-2" data-testid="cda-transaction-input-technical-details">
                                <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Previous" />
                                    <CopyableMonoValue Value="@input.PreviousOutPoint.ToString()"
                                                       StartChars="12"
                                                       EndChars="8"
                                                       AriaLabel="Copy previous outpoint" />
                                </Cluster>
                                @if (input.BusinessObject is not null)
                                {
                                    <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                        <StatusBadge Text="@($"BO {input.BusinessObject.Operation} · v{input.BusinessObject.Version}")" Tone="info" NoWrap="true" />
                                        <HashDisplay Value="@input.BusinessObject.DataHash.Value" StartChars="10" EndChars="6" AriaLabel="Copy input business object data hash" />
                                    </Cluster>
                                }
                                @if (input.SignaturePayloadHash is not null)
                                {
                                    <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Signed payload" />
                                        <HashDisplay Value="@input.SignaturePayloadHash?.Value" StartChars="10" EndChars="6" AriaLabel="Copy signed payload hash" />
                                    </Cluster>
                                }
                                @if (input.OutPointKey is not null)
                                {
                                    <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Output key" />
                                        <HashDisplay Value="@input.OutPointKey?.Value.Value" StartChars="10" EndChars="6" AriaLabel="Copy input output key" />
                                    </Cluster>
                                }
                                @if (!string.IsNullOrWhiteSpace(presentation?.SupportingText))
                                {
                                    <TextBlock TextStyle="TextStyle.Caption" Value="@presentation.SupportingText" />
                                }
                            </div>
                        }
                    </article>
                }
            }
        </div>

        <div class="transaction-io-flow__connector grid w-full min-w-0 place-items-center gap-1 text-sky-700" aria-hidden="true">
            <span class="rounded-full border border-sky-300 bg-sky-100 px-1.5 py-0.5 text-xs font-bold leading-none">@Inputs.Count→@Outputs.Count</span>
            <div class="transaction-io-flow__direction flex w-full items-center justify-center">
                <span class="transaction-io-flow__connector-line"></span>
                <span class="transaction-io-flow__arrow"><Icon Name="east" /></span>
            </div>
        </div>

        <div class="grid min-w-0 content-center gap-2" data-testid="cda-transaction-output-lane">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Destinations" />
            @if (Outputs.Count == 0)
            {
                <div class="grid min-h-16 min-w-0 place-items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3">
                    <TextBlock TextStyle="TextStyle.Muted" Value="No transaction outputs" />
                </div>
            }
            else
            {
                @foreach (LedgerTransactionOutputDetails output in Outputs)
                {
                    TransactionFlowItemPresentation? presentation = OutputPresentationSelector?.Invoke(output);
                    <article class="grid min-w-0 gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3" data-testid="cda-transaction-output-node">
                        <Split Breakpoint="LayoutBreakpoint.None"
                               AlignItems="AlignItems.Center"
                               Wrap="FlexWrap.Wrap"
                               Gap="LayoutGap.XSmall">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@($"Output #{output.OutputIndex}")" />
                            <Cluster Gap="LayoutGap.XSmall">
                                @if (!string.IsNullOrWhiteSpace(presentation?.Label))
                                {
                                    <StatusBadge Text="@presentation.Label" Tone="@presentation.Tone" NoWrap="true" />
                                }
                                <StatusBadge Text="@($"{output.MainAmount} main")" Tone="neutral" NoWrap="true" />
                                @if (output.Token is not null)
                                {
                                    <StatusBadge Text="@FormatToken(output.Token)" Tone="info" NoWrap="true" />
                                }
                                @if (output.BusinessObject is not null && !IsDetailed)
                                {
                                    <StatusBadge Text="BO" Tone="success" NoWrap="true" />
                                }
                            </Cluster>
                        </Split>
                        <TransactionFlowAddress Address="output.Address"
                                                DirectoryEntries="DirectoryEntries"
                                                DirectionLabel="To" />
                        @if (IsDetailed)
                        {
                            <div class="grid min-w-0 gap-1 border-t border-slate-200 pt-2" data-testid="cda-transaction-output-technical-details">
                                @if (output.MetadataHash is not null)
                                {
                                    <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Metadata" />
                                        <HashDisplay Value="@output.MetadataHash?.Value" StartChars="10" EndChars="6" AriaLabel="Copy output metadata hash" />
                                    </Cluster>
                                }
                                @if (output.BusinessObject is not null)
                                {
                                    <Cluster Gap="LayoutGap.XSmall" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                        <StatusBadge Text="@($"BO {output.BusinessObject.Operation} · v{output.BusinessObject.Version}")" Tone="success" NoWrap="true" />
                                        @if (TransactionId is not null)
                                        {
                                            <CopyableMonoValue Value="@OutputBusinessObjectId(output)"
                                                               StartChars="12"
                                                               EndChars="8"
                                                               AriaLabel="Copy output business object id" />
                                        }
                                        <HashDisplay Value="@output.BusinessObject.DataHash.Value" StartChars="10" EndChars="6" AriaLabel="Copy output business object data hash" />
                                    </Cluster>
                                }
                                @if (!string.IsNullOrWhiteSpace(presentation?.SupportingText))
                                {
                                    <TextBlock TextStyle="TextStyle.Caption" Value="@presentation.SupportingText" />
                                }
                            </div>
                        }
                    </article>
                }
            }
        </div>
    </Grid>
</SurfaceCard>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionInputDetails> Inputs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<LedgerTransactionOutputDetails> Outputs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<AddressDirectoryEntry> DirectoryEntries { get; set; } = [];

    [Parameter]
    public TxId? TransactionId { get; set; }

    [Parameter]
    public TransactionFlowDetailLevel DetailLevel { get; set; } = TransactionFlowDetailLevel.Compact;

    [Parameter]
    public Func<LedgerTransactionInputDetails, TransactionFlowItemPresentation?>? InputPresentationSelector { get; set; }

    [Parameter]
    public Func<LedgerTransactionOutputDetails, TransactionFlowItemPresentation?>? OutputPresentationSelector { get; set; }

    private bool IsDetailed => DetailLevel == TransactionFlowDetailLevel.Detailed;

    private string Heading => IsDetailed ? "Ledger inputs & outputs" : "Inputs to outputs";

    private static string FormatMain(Amount? amount)
        => amount is null ? "main unknown" : $"{amount} main";

    private static string FormatToken(TokenTransfer token)
        => $"{token.Amount} {token.TokenId.Value}";

    private string OutputBusinessObjectId(LedgerTransactionOutputDetails output)
        => TransactionId is { } transactionId
            ? BusinessObjectId.FromOutPoint(transactionId, output.OutputIndex).Value
            : "Assigned after confirmation";
}
