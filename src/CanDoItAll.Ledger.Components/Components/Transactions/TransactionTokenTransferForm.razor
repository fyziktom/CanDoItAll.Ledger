@namespace CanDoItAll.Ledger.Components

<Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" data-testid="token-transfer-form">
    <Grid ColumnTemplateXl="minmax(18rem,.7fr) minmax(0,1.3fr)" Gap="LayoutGap.Medium" AlignItems="AlignItems.Start">
        <FormSection Title="Choose token" Description="Only balances available to this account are offered.">
            @if (TransferOptions.Count == 0)
            {
                <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
                    No transferable token balance is available for this account.
                </Alert>
            }
            else
            {
                <AvailableTokenSelector Options="TransferOptions"
                                        SelectedKey="@SelectedKey"
                                        SelectedKeyChanged="SetTokenAsync"
                                        Label="Token to send"
                                        DataTestId="composer-token-selector" />
            }
        </FormSection>

        <FormSection Title="Receiver and amounts" Description="The token amount is checked against the selected balance; attached main currency is optional.">
            <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <TransactionAmountInput Label="Token amount"
                                    Value="Draft.TokenAmount"
                                    ValueChanged="SetTokenAmountAsync"
                                    MaxAmount="SelectedOption?.AvailableAmount"
                                    TestId="composer-token-amount" />
            <TransactionAddressInput Label="Receiver address"
                                     Value="@Draft.PaymentReceiverAddress.Value"
                                     ValueChanged="SetReceiverAsync"
                                     Placeholder="cdia1…"
                                     Bookmarks="Bookmarks"
                                     AccountScope="@AccountScope"
                                     DialogSubtitle="Token transfer"
                                     TestId="composer-token-receiver" />
            <TransactionAmountInput Label="Attached main amount"
                                    Value="Draft.MainAmount"
                                    ValueChanged="SetMainAmountAsync"
                                    MaxAmount="Balance?.MainBalance"
                                    AllowEmpty="true"
                                    TestId="composer-token-main-amount" />
                <FormField Text="Memo">
                    <TextBox Value="@Draft.ExternalRef"
                             ValueChanged="@(EventCallback.Factory.Create<string?>(this, SetMemoAsync))"
                             Immediate="true"
                             Placeholder="Token transfer purpose"
                             aria-label="Memo"
                             data-testid="composer-token-memo" />
                </FormField>
            </Grid>
        </FormSection>
    </Grid>
</Stack>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerTokenOption> Options { get; set; } = [];

    [Parameter]
    public IReadOnlyList<LedgerAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-composer";

    [Parameter]
    public LedgerAccountBalance? Balance { get; set; }

    private IReadOnlyList<LedgerTokenOption> TransferOptions
        => Options
            .Where(option => !option.IsMain && option.TokenId is not null && option.AvailableAmount.Value > 0m)
            .ToArray();

    private string? SelectedKey => Draft.TokenId?.Value;

    private LedgerTokenOption? SelectedOption => TransferOptions.FirstOrDefault(option => option.Key == SelectedKey);

    private Task SetTokenAsync(string? key)
    {
        LedgerTokenOption? selected = TransferOptions.FirstOrDefault(option => option.Key == key);
        return UpdateAsync(Draft with
        {
            TokenId = selected?.TokenId,
            TokenAmount = Draft.TokenAmount is null || (selected is not null && Draft.TokenAmount.Value.Value > selected.AvailableAmount.Value)
                ? selected is null ? null : Amount.FromDecimal(Math.Min(1m, selected.AvailableAmount.Value))
                : Draft.TokenAmount
        });
    }

    private Task SetTokenAmountAsync(Amount? value)
        => UpdateAsync(Draft with { TokenAmount = value });

    private Task SetReceiverAsync(string? value)
        => UpdateAsync(Draft with { PaymentReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetMainAmountAsync(Amount? value)
        => UpdateAsync(Draft with { MainAmount = value ?? Amount.Zero });

    private Task SetMemoAsync(string? value)
        => UpdateAsync(Draft with { ExternalRef = value ?? string.Empty });

    private Task UpdateAsync(BusinessObjectTransactionDraft next)
        => DraftChanged.InvokeAsync(next);
}
