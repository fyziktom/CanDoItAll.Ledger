@namespace CanDoItAll.Ledger.Components

<CdaChart Title="Account balance trend"
          Description="Generic account-level balance projection from ledger activity."
          Series="Series"
          Options="Options"
          data-testid="cda-account-balance-trend-chart" />

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    private IReadOnlyList<CdaChartSeries> Series
    {
        get
        {
            DateTimeOffset start = Workspace.ViewedAtUtc.AddDays(-4);
            decimal baseValue = Math.Max(0, Workspace.Balance.MainBalance.Value - 4000m);
            return
            [
                new CdaChartSeries
                {
                    Name = "Main",
                    Type = CdaChartType.Area,
                    Color = "#0f766e",
                    Points = Enumerable.Range(0, 5)
                        .Select(index => new CdaChartPoint(start.AddDays(index).UtcDateTime, baseValue + (index * 1000m)))
                        .ToArray()
                }
            ];
        }
    }

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Area,
        XAxisType = CdaChartAxisType.DateTime,
        Curve = CdaChartCurve.Smooth,
        Unit = "main",
        DateTimeLabelFormat = "MM.dd",
        TooltipDateTimeFormat = "MM.dd.yyyy",
        LegendPosition = CdaChartLegendPosition.Bottom,
        ShowToolbar = false
    };
}
