@namespace CanDoItAll.Ledger.Components

<CdaChart Title="Permission sources"
          Description="Permission token amounts by namespace."
          Series="Series"
          Options="Options"
          data-testid="cda-permission-use-chart" />

@code {
    [Parameter]
    public IReadOnlyList<LedgerPermissionSource> Sources { get; set; } = [];

    private IReadOnlyList<CdaChartSeries> Series
        =>
        [
            new CdaChartSeries
            {
                Name = "Permissions",
                Type = CdaChartType.Bar,
                Points = Sources
                    .GroupBy(item => item.Grant.Namespace)
                    .Select(group => new CdaChartPoint(group.Key, group.Sum(item => item.Amount.Value)))
                    .ToArray()
            }
        ];

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "permission",
        ShowToolbar = false
    };
}
