@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-ledger-analytics-dashboard">
<SectionCard Title="Analytics dashboard" Description="Ledger analytics">
    <HeaderActions>
        <StatusBadge Text="CdaChart" Tone="success" />
    </HeaderActions>
    <ChildContent>
        <ChartFilterToolbar />

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
            <AccountBalanceTrendChart Workspace="Workspace" />
            <TokenAllocationDonut TokenOptions="Workspace.TokenOptions" />
            <TransactionVolumeBarChart Transactions="Workspace.Transactions" />
            <TransactionKindStackedChart Transactions="Workspace.Transactions" />
            <UtxoAgeDistributionChart Outputs="Workspace.SpendableOutputsOrEmpty" ViewedAtUtc="Workspace.ViewedAtUtc" />
            <PermissionUseChart Sources="Workspace.PermissionSourcesOrEmpty" />
            <BusinessObjectLifecycleChart Objects="Workspace.BusinessObjects" />
            <BusinessObjectVersionVelocityChart Objects="Workspace.BusinessObjects" />
            <ScenarioComparisonChart CurrentScenario="@(Workspace.Context.ScenarioId?.Value ?? "live")" CurrentValue="Workspace.Balance.MainBalance.Value" />
            <ChartInsightSummary Title="Ledger facts" Insights="Insights" />
        </Grid>
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    private IReadOnlyList<(string Label, string Value)> Insights
        =>
        [
            ("Ledger", Workspace.Context.LedgerId.Value),
            ("Scenario", Workspace.Context.ScenarioId?.Value ?? "live"),
            ("Token types", Workspace.TokenTypesOrEmpty.Count.ToString()),
            ("Permissions", Workspace.PermissionSourcesOrEmpty.Count.ToString())
        ];
}
