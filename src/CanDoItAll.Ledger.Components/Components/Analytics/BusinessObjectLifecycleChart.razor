@namespace CanDoItAll.Ledger.Components

<CdaChart Title="Business-object lifecycle"
          Description="Object counts by last operation."
          Series="Series"
          Options="Options"
          data-testid="cda-bo-lifecycle-chart" />

@code {
    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Objects { get; set; } = [];

    private IReadOnlyList<CdaChartSeries> Series
        =>
        [
            new CdaChartSeries
            {
                Name = "Objects",
                Type = CdaChartType.Donut,
                Points = Objects
                    .GroupBy(item => item.Operation)
                    .Select(group => new CdaChartPoint(group.Key.ToString(), group.Count()))
                    .ToArray()
            }
        ];

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Donut,
        XAxisType = CdaChartAxisType.Category,
        ShowToolbar = false,
        ShowDataLabels = true
    };
}
