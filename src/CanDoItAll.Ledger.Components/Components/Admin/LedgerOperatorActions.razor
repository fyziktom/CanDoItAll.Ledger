@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-ledger-operator-actions">
    <SectionCard Title="Guarded ledger operations" Description="Operator actions">
        <HeaderActions>
            <StatusBadge Text="Confirmation required" Tone="warning" />
        </HeaderActions>
        <ChildContent>
            <Grid ColumnTemplate="repeat(auto-fit, minmax(min(100%, 22rem), 1fr))"
                  Gap="LayoutGap.Medium"
                  AlignItems="AlignItems.Start">
                <TimeControlPanel />
                <SnapshotAdminPanel />
                <ProjectionMaintenancePanel />
                <LedgerResetDialog />
            </Grid>
        </ChildContent>
    </SectionCard>
</div>
