@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-bo-state-editor">
<SectionCard Title="@ObjectType" Description="State editor">
    <HeaderActions>
        <StatusBadge Text="@SchemaVersion" Tone="neutral" />
    </HeaderActions>
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium">
            <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                <FormField Text="Object type">
                    <TextBox @bind-Value="ObjectType" />
                </FormField>
                <FormField Text="Schema version">
                    <TextBox @bind-Value="SchemaVersion" />
                </FormField>
            </Grid>
            <FormField Text="State JSON">
                <TextArea @bind-Value="StateJson" Rows="8" />
            </FormField>
        </Stack>
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter]
    public string ObjectType { get; set; } = "business-object";

    [Parameter]
    public string SchemaVersion { get; set; } = "1.0";

    [Parameter]
    public string StateJson { get; set; } = "{}";
}
