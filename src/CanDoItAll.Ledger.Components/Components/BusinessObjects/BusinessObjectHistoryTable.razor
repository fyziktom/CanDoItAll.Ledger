@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-bo-history-table">
<SectionCard Title="Object transaction history" Description="History">
    <HeaderActions>
        <StatusBadge Text="@($"{Rows.Count} rows")" Tone="info" />
    </HeaderActions>
    <ChildContent>
        @if (Rows.Count == 0)
        {
            <EmptyState Eyebrow="History" Title="No related transactions" Description="No related history rows are available." />
        }
        else
        {
            <DataGrid TItem="LedgerTransactionSummary" Data="@Rows" Caption="Business object transaction history" EmptyText="No related history rows are available.">
                <Columns>
                    <DataGridColumn TItem="LedgerTransactionSummary" Title="Tx">
                        <Template Context="row">
                            <CopyableMonoValue Value="@row.TxId.Value" StartChars="10" EndChars="6" AriaLabel="Copy transaction id" />
                        </Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="LedgerTransactionSummary" Property="Kind" Title="Kind" />
                    <DataGridColumn TItem="LedgerTransactionSummary" Title="Status">
                        <Template Context="row">
                            <StatusBadge Text="@row.Status.ToString()" Tone="@(row.Status == TransactionStatus.Confirmed ? "success" : "warning")" NoWrap="true" />
                        </Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="LedgerTransactionSummary" Title="Time">
                        <Template Context="row">@row.Timestamp.ToString("MM.dd HH:mm")</Template>
                    </DataGridColumn>
                </Columns>
            </DataGrid>
        }
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    private IReadOnlyList<LedgerTransactionSummary> Rows
        => Object is null
            ? []
            : LedgerTransactionOrdering
                .NewestFirst(BusinessObjectTransactionHistory
                    .SelectVersions(Object.ObjectId, Transactions)
                    .Select(version => version.Transaction)
                    .DistinctBy(transaction => transaction.TxId))
                .ToArray();
}
