@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-business-object-explorer">
<SectionCard Title="Explorer" Description="Business objects">
    <HeaderActions>
        <StatusBadge Text="@($"{Objects.Count} objects")" Tone="info" />
    </HeaderActions>
    <ChildContent>
        <Grid ColumnTemplateLg="minmax(16rem, .8fr) minmax(0, 1.2fr)" Gap="LayoutGap.Medium" AlignItems="AlignItems.Start">
            @if (Objects.Count == 0)
            {
                <EmptyState Eyebrow="Business objects" Title="No objects" Description="Business objects will appear here after they are projected from the ledger." />
            }
            else
            {
                <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                    @foreach (IBusinessObjectView item in Objects)
                    {
                        <SurfaceCard Soft="true">
                            <Cluster AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap">
                                <Icon Name="inventory_2" />
                                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                    <TextBlock TextStyle="TextStyle.Mono" Value="@item.ObjectId.Value" />
                                    <TextBlock TextStyle="TextStyle.Body2">@item.ObjectType v@item.Version - @item.Operation</TextBlock>
                                    <TextBlock TextStyle="TextStyle.Caption" Value="@item.CurrentOutPoint.ToString()" />
                                </Stack>
                                @if (item.ObjectId == SelectedObjectId)
                                {
                                    <StatusBadge Text="Selected" Tone="success" />
                                }
                            </Cluster>
                        </SurfaceCard>
                    }
                </Stack>
            }
            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                <BusinessObjectStateViewer Object="SelectedObject" />
                <BusinessObjectDataItemStrip Object="SelectedObject" />
            </Stack>
        </Grid>
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Objects { get; set; } = [];

    [Parameter]
    public BusinessObjectId? SelectedObjectId { get; set; }

    private IBusinessObjectView? SelectedObject
        => Objects.FirstOrDefault(item => item.ObjectId == SelectedObjectId) ?? Objects.FirstOrDefault();
}
