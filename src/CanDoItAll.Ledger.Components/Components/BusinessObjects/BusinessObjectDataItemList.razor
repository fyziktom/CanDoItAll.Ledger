@namespace CanDoItAll.Ledger.Components
@inherits BusinessObjectDataItemAddressComponentBase

<SurfaceCard Soft="true" Class="min-w-0" data-testid="@TestId">
    <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
        <ListPanelHeader Title="@Title"
                         Description="@Description"
                         Count="@($"{Items.Count} item(s)")"
                         Dense="true" />

        @if (Items.Count == 0)
        {
            <EmptyState Eyebrow="Data items"
                        Title="No attached data"
                        Description="No data items are attached to this business object." />
        }
        else
        {
            <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.Stretch">
                @foreach (BusinessObjectDataItem item in Items)
                {
                    <SelectionListItem Title="@item.Name"
                                       Eyebrow="@item.Type.ToString()"
                                       Meta="@($"{StorageLabel(item.Storage)} / {FormatSize(item.Size)}")"
                                       Summary="@(item.Description ?? item.FileName ?? ShortHash(item.Hash))"
                                       Dense="true"
                                       IsSelected="@IsSelected(item)"
                                       DataTestId="cda-bo-data-item-select"
                                       OnSelect="@(() => SelectItemAsync(item))">
                        <Status>
                            @if (item.IsMain)
                            {
                                <StatusBadge Text="Main" Tone="info" />
                            }
                        </Status>
                        <Actions>
                            <BusinessObjectDataItemActions Item="item" />
                        </Actions>
                    </SelectionListItem>
                }
            </Stack>
        }
    </Stack>
</SurfaceCard>

@code {
    [Parameter]
    public string Title { get; set; } = "Data items";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public IReadOnlyList<BusinessObjectDataItem> Items { get; set; } = [];

    [Parameter]
    public BusinessObjectDataItem? SelectedItem { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectDataItem> ItemSelected { get; set; }

    private Task SelectItemAsync(BusinessObjectDataItem item)
        => ItemSelected.InvokeAsync(item);

    private bool IsSelected(BusinessObjectDataItem item)
        => SelectedItem is not null
            && item.Name.Equals(SelectedItem.Name, StringComparison.OrdinalIgnoreCase)
            && item.Hash.Equals(SelectedItem.Hash, StringComparison.Ordinal);

    private static string FormatSize(long? size)
        => size is null ? "unknown size" : $"{size.Value:N0} bytes";

    private static string StorageLabel(BusinessObjectDataItemStorage storage)
        => storage switch
        {
            BusinessObjectDataItemStorage.Ipfs => "IPFS",
            BusinessObjectDataItemStorage.Url => "URL",
            _ => "Inline"
        };

    private static string ShortHash(string hash)
        => hash.Length > 24 ? $"{hash[..14]}...{hash[^6..]}" : hash;
}
