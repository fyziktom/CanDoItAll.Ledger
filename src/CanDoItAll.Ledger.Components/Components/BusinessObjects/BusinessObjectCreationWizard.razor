@namespace CanDoItAll.Ledger.Components
@using Microsoft.Extensions.DependencyInjection
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IServiceProvider Services
@inject ITagOccurrenceService TagOccurrences

<Stack Section="true" GapScale="LayoutGap.Small" data-testid="bo-create-wizard">
    <Toolbar Class="gap-2! rounded-xl! p-2! shadow-none!">
        <ToolbarRow Class="gap-2!">
            <CompactWorkflowProgress Value="@(currentStep - 1)"
                                     ValueChanged="SetStepIndex"
                                     CanSelect="true"
                                     Steps="@CreateSteps"
                                     aria-label="Create BusinessObject steps" />

            <ToolbarActions Class="gap-1.5!">
                <StatusBadge Text="@WizardModeLabel" Tone="info" />
                <Button Text="Load Template" Icon="folder_open" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" />
                <Button Text="Back" Icon="arrow_back" Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="@(currentStep == 1)" Click="@PreviousStep" />
                <Button Text="@NextButtonText" Icon="@NextButtonIcon" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="@NextStepAsync" />
            </ToolbarActions>
        </ToolbarRow>
    </Toolbar>

    @if (currentStep == 1)
    {
        <section class="cda-bo-wizard-step cda-bo-wizard-step--upload"
                 aria-label="Upload data items"
                 data-testid="bo-wizard-step">
            <div class="cda-bo-upload-gallery" data-testid="bo-upload-item-list">
                <div class="cda-bo-upload-gallery__header">
                    <div class="cda-bo-upload-gallery__copy">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Data items" />
                        <TextBlock TextStyle="TextStyle.Caption" Value="Select a thumbnail to set the gallery and detail preview." />
                    </div>
                    <Cluster Gap="LayoutGap.XSmall"
                             Wrap="FlexWrap.Wrap"
                             Class="cda-bo-wizard-statuses"
                             data-testid="bo-upload-statuses">
                        <StatusBadge Text="@LoadedDataItemLabel" Tone="info" NoWrap="true" />
                        <StatusBadge Text="@SelectedDefinition.DisplayName" Tone="neutral" NoWrap="true" />
                        <StatusBadge Text="@UploadStorageLabel" Tone="neutral" NoWrap="true" />
                        @if (MainDataItem is not null)
                        {
                            <StatusBadge Text="Main selected" Tone="info" NoWrap="true" />
                        }
                    </Cluster>
                </div>

                @if (DisplayDataItems.Count == 0)
                {
                    <div class="cda-bo-upload-gallery__empty">No files loaded yet.</div>
                }
                else
                {
                    <div class="cda-bo-upload-items" role="list" aria-label="Uploaded data items">
                        @for (int index = 0; index < DisplayDataItems.Count; index++)
                        {
                            BusinessObjectDataItem item = DisplayDataItems[index];
                            int itemIndex = index;
                            <div @key="itemIndex"
                                 class="@UploadItemClass(item.IsMain)"
                                 role="listitem"
                                 data-item-name="@item.Name"
                                 data-item-hash="@item.Hash"
                                 data-testid="bo-upload-item">
                                <div class="cda-bo-upload-item__thumbnail">
                                    <BusinessObjectDataItemPreview Item="item" Thumbnail="true" Flush="true" />
                                    <button type="button"
                                            class="cda-bo-upload-item__select"
                                            @onclick="@(() => SelectMainDataItem(itemIndex))"
                                            aria-pressed="@(item.IsMain ? "true" : "false")"
                                            aria-controls="bo-upload-main-viewer"
                                            aria-label="@($"Use {item.Name} as the main data item")"
                                            data-item-name="@item.Name"
                                            data-testid="bo-upload-item-select">
                                        <span class="sr-only">Use @item.Name as the main data item</span>
                                    </button>
                                </div>
                                <span class="cda-bo-upload-item__copy">
                                    <strong title="@item.Name">@item.Name</strong>
                                    <span>@item.Type / @item.Storage</span>
                                </span>
                                <span class="cda-bo-upload-item__status">
                                    @if (item.IsMain)
                                    {
                                        <StatusBadge Text="Main" Tone="info" NoWrap="true" />
                                    }
                                </span>
                                <Button Text="Remove"
                                        Icon="delete"
                                        Size="ButtonSize.Small"
                                        Variant="Variant.Outlined"
                                        ButtonStyle="ButtonStyle.Danger"
                                        Click="@(() => RemoveDataItem(itemIndex))"
                                        aria-label="@($"Remove {item.Name}")"
                                        data-item-name="@item.Name"
                                        data-testid="bo-upload-item-remove" />
                            </div>
                        }
                    </div>
                }
            </div>

            <Grid ColumnsLg="2"
                  ColumnTemplateLg="minmax(17rem, 0.58fr) minmax(0, 1.42fr)"
                  Gap="LayoutGap.Small">
                <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                    <div class="cda-bo-upload-note">
                        <Icon Name="cloud_upload" />
                        <TextBlock TextStyle="TextStyle.Note"
                                   Value="Files upload to IPFS immediately; the transaction stores only CIDs and metadata." />
                    </div>
                    <FileUpload PrimaryText="Drop or choose files"
                                SecondaryText="Images, media, documents, or text."
                                ButtonText="Choose files"
                                Icon=""
                                Compact="true"
                                Disabled="@uploadInProgress"
                                Multiple="true"
                                Change="HandleUploadChangeAsync"
                                Accept="image/*,.svg,.pdf,.json,.txt,.html,.mmd,.mp3,.mp4"
                                InputTestHookId="bo-upload-input"
                                RootTestHookId="bo-upload"
                                DropZoneTestHookId="bo-upload-zone" />
                </Stack>

                <div id="bo-upload-main-viewer"
                     class="cda-bo-wizard-viewer cda-bo-wizard-viewer--upload"
                     data-testid="bo-upload-main-preview">
                    @if (MainDataItem is not null)
                    {
                        <BusinessObjectDataItemInteractivePreview Item="MainDataItem" />
                    }
                    else
                    {
                        <EmptyState Eyebrow="Preview"
                                    Title="No preview yet"
                                    Description="Choose a file to inspect it before staging the transaction." />
                    }
                </div>
            </Grid>
        </section>
    }
    else if (currentStep == 2)
    {
        <section class="cda-bo-wizard-step"
                 aria-label="Data information"
                 data-testid="bo-wizard-step">
                <Grid ColumnsLg="2" Gap="LayoutGap.Small">
                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <FormField Text="Type">
                            <DropDown TValue="string"
                                      Data="ObjectTypeOptions"
                                      TextProperty="Text"
                                      ValueProperty="Value"
                                      Value="@selectedObjectType"
                                      ValueChanged="SelectObjectType"
                                      aria-label="BusinessObject type" />
                        </FormField>
                        <FormField Text="Name">
                            <TextBox Value="@name" ValueChanged="@(value => name = value ?? string.Empty)" Immediate="true" aria-label="BusinessObject name" />
                        </FormField>
                        <FormField Text="Tags">
                            <TagEditor Value="@tagValues"
                                       ValueChanged="UpdateTagsAsync"
                                       Suggestions="@tagSuggestions"
                                       Placeholder="Add tag"
                                       InputTestId="bo-tag-editor-input"
                                       TestId="bo-tag-editor" />
                        </FormField>
                        <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                            @foreach (string tag in Tags)
                            {
                                <TagBadge Tag="@tag" AccountScope="@TagAccountScope" TestId="bo-tag-badge" />
                            }
                        </Cluster>
                        <FormField Text="Short description">
                            <TextBox Value="@description" ValueChanged="@(value => description = value ?? string.Empty)" Immediate="true" aria-label="BusinessObject description" />
                        </FormField>
                        @if (IsTicketSelected)
                        {
                            <SurfaceCard Soft="true" data-testid="cda-ticket-event-panel">
                                <Cluster Gap="LayoutGap.Medium"
                                         JustifyContent="JustifyContent.SpaceBetween"
                                         Wrap="FlexWrap.Wrap"
                                         Class="w-full">
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap" Class="min-w-0 flex-1">
                                        <Icon Name="event" />
                                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0 flex-1">
                                            <TextBlock TextStyle="TextStyle.Subtitle2"
                                                       Value="@(selectedTicketEvent is null ? "No event selected" : TicketEventDisplayName)" />
                                            <TextBlock TextStyle="TextStyle.Muted"
                                                       Value="@(selectedTicketEvent?.ObjectId.Value ?? "Select an event BO or load it by transaction hash.")" />
                                        </Stack>
                                    </Cluster>
                                    <Button Text="Select Event"
                                            Icon="travel_explore"
                                            Size="ButtonSize.Small"
                                            ButtonStyle="ButtonStyle.Secondary"
                                            Click="OpenTicketEventPickerAsync"
                                            data-testid="cda-ticket-select-event" />
                                </Cluster>
                            </SurfaceCard>
                            <SurfaceCard data-testid="cda-ticket-multimint-panel">
                                <Stack GapScale="LayoutGap.Medium">
                                    <label class="inline-flex items-center gap-3">
                                        <CheckBox TValue="bool"
                                                  Value="@multimintEnabled"
                                                  ValueChanged="@(value => multimintEnabled = value)"
                                                  data-testid="cda-ticket-multimint-enabled" />
                                        <TextBlock TextStyle="TextStyle.Body2" Value="Multimint tickets" />
                                    </label>
                                @if (multimintEnabled)
                                {
                                    <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                        @if (!IsManualRecipientMode)
                                        {
                                            <FormField Text="Ticket count">
                                                <input type="number"
                                                       class="rz-numeric min-w-0 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800"
                                                       min="1"
                                                       max="@MaxTicketMultimintCount"
                                                       value="@ticketMultimintCount"
                                                       @oninput="OnTicketMultimintCountInput"
                                                       data-testid="cda-ticket-multimint-count" />
                                            </FormField>
                                        }
                                        <FormField Text="Recipients">
                                            <DropDown TValue="string"
                                                      Data="@RecipientModeOptions"
                                                      TextProperty="Text"
                                                      ValueProperty="Value"
                                                      Value="@recipientMode"
                                                      ValueChanged="SelectRecipientMode"
                                                      aria-label="Ticket multimint recipients"
                                                      data-testid="cda-ticket-multimint-recipient-mode" />
                                        </FormField>
                                    </Grid>
                                    @if (IsSubAccountRecipientMode)
                                    {
                                        <FormField Text="Subaccount">
                                            @if (SubAccountOptions.Count == 0)
                                            {
                                                <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                                    No linked subaccounts are available in this workspace.
                                                </Alert>
                                            }
                                            else
                                            {
                                                <DropDown TValue="string"
                                                          Data="@SubAccountOptions"
                                                          TextProperty="Text"
                                                          ValueProperty="Value"
                                                          Value="@selectedSubAccountAddress"
                                                          ValueChanged="SelectSubAccountAddress"
                                                          aria-label="Ticket multimint subaccount"
                                                          data-testid="cda-ticket-multimint-subaccount" />
                                            }
                                        </FormField>
                                    }
                                    else if (IsAddressBookRecipientMode)
                                    {
                                        <FormField Text="Address book">
                                            @if (AddressBookOptions.Count == 0)
                                            {
                                                <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                                    No address-book entries are available in this workspace.
                                                </Alert>
                                            }
                                            else
                                            {
                                                <DropDown TValue="string"
                                                          Data="@AddressBookOptions"
                                                          TextProperty="Text"
                                                          ValueProperty="Value"
                                                          Value="@selectedAddressBookAddress"
                                                          ValueChanged="SelectAddressBookAddress"
                                                          aria-label="Ticket multimint address book"
                                                          data-testid="cda-ticket-multimint-address-book" />
                                            }
                                            <PageHeaderActionButton Icon="contacts"
                                                                    Label="Directory"
                                                                    TooltipText="Choose recipient from address directory"
                                                                    Variant="Variant.Outlined"
                                                                    Click="OpenRecipientAddressDirectoryAsync"
                                                                    TestId="cda-ticket-multimint-address-directory" />
                                        </FormField>
                                    }
                                    else if (IsManualRecipientMode)
                                    {
                                        <FormField Text="Recipient addresses">
                                            <TextArea Value="@recipientListText"
                                                      ValueChanged="@(value => recipientListText = value ?? string.Empty)"
                                                      Immediate="true"
                                                      Rows="4"
                                                      Placeholder="One address per line. A single address repeats by ticket count."
                                                      aria-label="Ticket multimint recipient addresses"
                                                      data-testid="cda-ticket-multimint-recipient-list" />
                                        </FormField>
                                    }
                                    <div data-testid="cda-ticket-multimint-summary">
                                        <SummaryTile Label="Batch preview" Value="@TicketMultimintSummary" />
                                    </div>
                                }
                                </Stack>
                            </SurfaceCard>
                        }
                    </Stack>
                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <FormField Text="Long description">
                            <TextArea Value="@text" ValueChanged="@(value => text = value ?? string.Empty)" Immediate="true" Rows="10" aria-label="BusinessObject text" />
                        </FormField>
                        @if (SelectedDefinition.Fields.Count > 0)
                        {
                            <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                @foreach (BusinessObjectFieldDefinition field in SelectedDefinition.Fields)
                                {
                                    <FormField Text="@field.Label">
                                        @if (IsAutoMintAuthorField(field))
                                        {
                                            <TextBox Value="@FieldValue(field.Key)"
                                                     ReadOnly="true"
                                                     aria-label="@field.Label"
                                                     data-testid="@AutoFieldTestId(field.Key)" />
                                        }
                                        else if (IsDateTimeField(field))
                                        {
                                            <input type="datetime-local"
                                                   class="rz-input min-w-0 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800"
                                                   value="@DateTimeInputValue(field.Key)"
                                                   @onchange="@(args => OnDateTimeFieldChanged(field.Key, args))"
                                                   aria-label="@field.Label"
                                                   data-testid="@DateTimeFieldTestId(field.Key)" />
                                        }
                                        else if (HasFieldOptions(field))
                                        {
                                            <div data-testid="@DropdownFieldTestId(field.Key)">
                                                <DropDown TValue="string"
                                                          Data="@FieldOptions(field)"
                                                          TextProperty="Text"
                                                          ValueProperty="Value"
                                                          Value="@FieldValue(field.Key)"
                                                          ValueChanged="@(value => SetFieldValue(field.Key, value))"
                                                          aria-label="@field.Label" />
                                            </div>
                                        }
                                        else if (field.Kind == BusinessObjectFieldKind.LongText)
                                        {
                                            <TextArea Value="@FieldValue(field.Key)"
                                                      ValueChanged="@(value => SetFieldValue(field.Key, value))"
                                                      Immediate="true"
                                                      Rows="4"
                                                      aria-label="@field.Label" />
                                        }
                                        else
                                        {
                                            <TextBox Value="@FieldValue(field.Key)"
                                                     ValueChanged="@(value => SetFieldValue(field.Key, value))"
                                                     Immediate="true"
                                                     Placeholder="@field.Placeholder"
                                                     aria-label="@field.Label" />
                                        }
                                    </FormField>
                                }
                            </Grid>
                        }
                    </Stack>
                </Grid>
        </section>
    }
    else
    {
        <section class="cda-bo-wizard-step cda-bo-wizard-step--finish"
                 aria-label="Finish"
                 data-testid="bo-wizard-step">
            <Cluster Gap="LayoutGap.XSmall"
                     Wrap="FlexWrap.Wrap"
                     Class="cda-bo-wizard-statuses"
                     data-testid="bo-finish-statuses">
                <StatusBadge Text="@SelectedDefinition.DisplayName" Tone="info" NoWrap="true" />
                <StatusBadge Text="@LoadedDataItemLabel" Tone="neutral" NoWrap="true" />
                @foreach (BusinessObjectDisplayFact fact in TypedFacts.Take(4))
                {
                    <StatusBadge Text="@($"{fact.Label}: {fact.Value}")" Tone="neutral" />
                }
                @if (IsEditMode && Model.EditSource is not null)
                {
                    <span data-testid="bo-edit-source">
                        <StatusBadge Text="@($"Update {ShortObjectId(Model.EditSource.ObjectId)}")" Tone="neutral" />
                    </span>
                }
            </Cluster>

            <div class="cda-bo-finish-layout" data-testid="bo-finish-preview">
                <Grid ColumnsLg="2"
                      ColumnTemplateLg="minmax(0, 1.35fr) minmax(18rem, 0.65fr)"
                      Gap="LayoutGap.Small">
                    <div class="cda-bo-wizard-viewer cda-bo-wizard-viewer--finish">
                        @if (MainDataItem is not null)
                        {
                            <BusinessObjectDataItemInteractivePreview Item="MainDataItem" />
                        }
                        else
                        {
                            <EmptyState Eyebrow="Preview"
                                        Title="@ShortType(selectedObjectType)"
                                        Description="No main data item is attached." />
                        }
                    </div>

                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <div class="cda-bo-finish-summary">
                            <TextBlock TextStyle="TextStyle.H3" Value="@name" />
                            <TextBlock TextStyle="TextStyle.Body2" Value="@description" />
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                @foreach (string tag in Tags)
                                {
                                    <TagBadge Tag="@tag" AccountScope="@TagAccountScope" />
                                }
                            </Cluster>
                        </div>

                        @if (!IsEditMode && Workspace is not null)
                        {
                            <AvailableTokenSelector Options="Workspace.TokenOptions"
                                                    SelectedKey="@selectedTokenKey"
                                                    SelectedKeyChanged="@(key => selectedTokenKey = key)"
                                                    Label="Creation asset"
                                                    Compact="true"
                                                    DataTestId="bo-create-token-selector" />
                            <TextBlock TextStyle="TextStyle.Note" Value="@CreationAssetHint" />
                        }

                        <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap" Class="cda-bo-finish-actions">
                            <Button Text="@StageButtonText"
                                    Icon="receipt_long"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Disabled="@(!CanStageSelectedAsset)"
                                    Click="StageBusinessObjectAsync" />
                            <Button Text="Preview Details"
                                    Icon="info"
                                    Size="ButtonSize.Small"
                                    Variant="Variant.Outlined"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Click="OpenFinishDetailsAsync"
                                    data-testid="bo-finish-preview-details" />
                        </Cluster>
                    </Stack>
                </Grid>
            </div>
        </section>
    }
</Stack>

@code {
    private static readonly IReadOnlyList<string> CreateSteps = ["Upload", "Data Info", "Finish"];

    [Parameter, EditorRequired]
    public BusinessObjectCreationWizardModel Model { get; set; } = default!;

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> StageBusinessObjectRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectBatchTransactionRequest> StageBusinessObjectBatchRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectEventLookupRequest, Task<BusinessObjectEventLookupResult>>? EventBusinessObjectLookupRequested { get; set; }

    private const string RecipientModeOwn = "own";
    private const string RecipientModeSubAccount = "subaccount";
    private const string RecipientModeAddressBook = "addressbook";
    private const string RecipientModeManual = "manual";
    private const int MaxTicketMultimintCount = 100;
    private int currentStep = 1;
    private string? currentModelKey;
    private string? selectedTokenKey;
    private string selectedObjectType = "post";
    private string name = string.Empty;
    private IReadOnlyList<string> tagValues = [];
    private IReadOnlyList<string> tagSuggestions = [];
    private string description = string.Empty;
    private string text = string.Empty;
    private Dictionary<string, string> fieldValues = new(StringComparer.Ordinal);
    private IReadOnlyList<BusinessObjectDataItem> dataItems = [];
    private bool uploadInProgress;
    private IBusinessObjectView? selectedTicketEvent;
    private bool multimintEnabled;
    private int ticketMultimintCount = 5;
    private string recipientMode = RecipientModeOwn;
    private string selectedSubAccountAddress = string.Empty;
    private string selectedAddressBookAddress = string.Empty;
    private string recipientListText = string.Empty;

    private bool IsEditMode => Model.EditSource is not null;

    protected override async Task OnParametersSetAsync()
    {
        string modelKey = $"{Model.ObjectType}:{Model.Name}:{Model.EditSource?.ObjectId.Value}:{Model.EditSource?.EffectiveTimeUtc:o}";
        if (currentModelKey == modelKey)
        {
            ApplyCreateDefaults();
            await LoadTagSuggestionsAsync();
            return;
        }

        currentModelKey = modelKey;
        currentStep = Math.Clamp(Model.Step, 1, 3);
        BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(Model.ObjectType);
        if (!definition.IsUserMintable && !IsEditMode)
        {
            definition = BusinessObjectFamilyCatalog.UserMintableFamilies.First();
        }

        BusinessObjectMediaPayload? editPayload = Model.EditSource is null
            ? null
            : BusinessObjectPayloadBuilder.TryParseMediaPayload(Model.EditSource.StateJson, out BusinessObjectMediaPayload? parsedPayload)
                ? parsedPayload
                : null;

        selectedObjectType = definition.ObjectType;
        name = Model.Name;
        tagValues = ParseTags(Model.Tags);
        description = Model.Description;
        text = Model.Text;
        fieldValues = new Dictionary<string, string>(
            BusinessObjectPayloadBuilder.NormalizeFields(definition, editPayload?.Fields),
            StringComparer.Ordinal);
        dataItems = NormalizeMainDataItem(Model.DataItems);
        EnsureFieldKeys();
        ApplyCreateDefaults();
        selectedTicketEvent = null;
        multimintEnabled = false;
        ticketMultimintCount = 5;
        recipientMode = RecipientModeOwn;
        selectedSubAccountAddress = string.Empty;
        selectedAddressBookAddress = string.Empty;
        recipientListText = string.Empty;
        selectedTokenKey = IsEditMode
            ? LedgerTokenOption.MainKey
            : BusinessObjectCarrierTokenPolicy.GetDefaultCarrierTokenKey(Workspace?.TokenOptions)
                ?? Workspace?.TokenOptions.FirstOrDefault()?.Key
                ?? LedgerTokenOption.MainKey;
        await LoadTagSuggestionsAsync();
    }

    private IReadOnlyList<BusinessObjectDataItem> DisplayDataItems
        => dataItems;

    private BusinessObjectDataItem? MainDataItem
        => DisplayDataItems.FirstOrDefault(item => item.IsMain) ?? DisplayDataItems.FirstOrDefault();

    private BusinessObjectFamilyDefinition SelectedDefinition
        => BusinessObjectFamilyCatalog.FindOrDefault(selectedObjectType);

    private IReadOnlyList<BusinessObjectDisplayFact> TypedFacts
        => BusinessObjectPayloadBuilder.CreateFacts(SelectedDefinition, fieldValues);

    private IReadOnlyList<FilterOption> ObjectTypeOptions
    {
        get
        {
            FilterOption[] options = BusinessObjectFamilyCatalog.UserMintableFamilies
                .Select(family => new FilterOption(family.ObjectType, family.DisplayName))
                .ToArray();
            if (!IsEditMode || options.Any(option => option.Value.Equals(selectedObjectType, StringComparison.OrdinalIgnoreCase)))
            {
                return options;
            }

            return new[] { new FilterOption(SelectedDefinition.ObjectType, SelectedDefinition.DisplayName) }
                .Concat(options)
                .ToArray();
        }
    }

    private IReadOnlyList<FilterOption> RecipientModeOptions
        =>
        [
            new(RecipientModeOwn, "Own account"),
            new(RecipientModeSubAccount, "Subaccount"),
            new(RecipientModeAddressBook, "Address book"),
            new(RecipientModeManual, "Recipient list")
        ];

    private IReadOnlyList<FilterOption> SubAccountOptions
        => Workspace?.SubAccounts
            .OrderBy(item => item.Name, StringComparer.Ordinal)
            .Select(item => new FilterOption(item.Address.Value, $"{item.Name} - {ShortAddress(item.Address.Value)}"))
            .ToArray()
            ?? [];

    private IReadOnlyList<FilterOption> AddressBookOptions
        => Workspace?.AddressBookmarks
            .Select(item => new FilterOption(item.Address.Value, $"{item.Name} - {ShortAddress(item.Address.Value)}"))
            .DistinctBy(item => item.Value)
            .ToArray()
            ?? [];

    private LedgerTokenOption? SelectedToken
        => Workspace?.TokenOptions.FirstOrDefault(option => option.Key == selectedTokenKey);

    private bool CanStageSelectedAsset
        => IsEditMode || SelectedToken is null || SelectedToken.IsMain || SelectedToken.HasReusableSource;

    private string CreationAssetHint
        => SelectedToken is null || SelectedToken.IsMain
            ? "Main amount only"
            : SelectedToken.HasReusableSource
                ? $"Uses reusable source UTXO automatically ({SelectedToken.SourceAmount} across {SelectedToken.SourceUtxoCount} source UTXO(s))."
                : $"No reusable source UTXO for {SelectedToken.AssetLabel}; unique token cards cannot be reused as sources.";

    private string UploadStorageLabel
        => uploadInProgress
            ? "IPFS uploading"
            : DisplayDataItems.Count == 0
                ? "IPFS required"
                : "IPFS CID";

    private string LoadedDataItemLabel
        => DisplayDataItems.Count == 1
            ? "1 file"
            : $"{DisplayDataItems.Count} files";

    private bool IsTicketSelected
        => selectedObjectType.Equals("ticket", StringComparison.OrdinalIgnoreCase);

    private bool IsSubAccountRecipientMode
        => recipientMode.Equals(RecipientModeSubAccount, StringComparison.Ordinal);

    private bool IsAddressBookRecipientMode
        => recipientMode.Equals(RecipientModeAddressBook, StringComparison.Ordinal);

    private bool IsManualRecipientMode
        => recipientMode.Equals(RecipientModeManual, StringComparison.Ordinal);

    private bool ShouldStageTicketBatch
        => !IsEditMode && IsTicketSelected && multimintEnabled;

    private int ResolvedTicketMultimintCount
        => Math.Clamp(ticketMultimintCount, 1, MaxTicketMultimintCount);

    private string TicketMultimintSummary
    {
        get
        {
            IReadOnlyList<Address> recipients = ResolveTicketMultimintRecipients();
            if (recipients.Count == 0)
            {
                return "No valid recipients selected.";
            }

            Address[] distinctRecipients = recipients.Distinct().ToArray();
            return distinctRecipients.Length == 1
                ? $"{recipients.Count} ticket(s) to {ShortAddress(distinctRecipients[0].Value)}"
