    private async Task HandleUploadChangeAsync(InputFileChangeEventArgs args)
    {
        IBusinessObjectDataItemUploadService? uploadService = Services.GetService<IBusinessObjectDataItemUploadService>();
        if (uploadService is null)
        {
            Notifications.Error("IPFS storage missing", "Configure BusinessObjects:IpfsApiUrl and BusinessObjects:IpfsGatewayUrl before uploading BO files.", position: NotificationPosition.BottomCenter);
            return;
        }

        var items = new List<BusinessObjectDataItem>();
        uploadInProgress = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            foreach (IBrowserFile file in args.GetMultipleFiles(8))
            {
                try
                {
                    items.Add(await CreateIpfsDataItemAsync(uploadService, file, dataItems.Count == 0 && items.Count == 0));
                }
                catch (Exception exception)
                {
                    Notifications.Error("IPFS upload failed", $"{file.Name}: {exception.Message}", position: NotificationPosition.BottomCenter);
                }
            }

            if (items.Count > 0)
            {
                dataItems = NormalizeMainDataItem(dataItems.Concat(items).ToArray());
                Notifications.Success("Uploaded to IPFS", $"Added {items.Count} CID-backed DataItem(s).", position: NotificationPosition.BottomCenter);
            }
        }
        finally
        {
            uploadInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task<BusinessObjectDataItem> CreateIpfsDataItemAsync(
        IBusinessObjectDataItemUploadService uploadService,
        IBrowserFile file,
        bool isMain)
    {
        const long maxUploadBytes = 128 * 1024 * 1024;
        string contentType = string.IsNullOrWhiteSpace(file.ContentType)
            ? "application/octet-stream"
            : file.ContentType;
        await using Stream stream = file.OpenReadStream(maxUploadBytes);
        return await uploadService.SaveToIpfsAsync(
            new BusinessObjectDataItemUploadRequest(
                stream,
                file.Name,
                contentType,
                file.Size,
                isMain,
                "Uploaded through BO wizard"),
            CancellationToken.None);
    }

    private void SelectMainDataItem(int selectedIndex)
    {
        if (selectedIndex < 0 || selectedIndex >= dataItems.Count)
        {
            return;
        }

        dataItems = dataItems
            .Select((item, index) => item.IsMain == (index == selectedIndex)
                ? item
                : item with { IsMain = index == selectedIndex })
            .ToArray();
    }

    private void RemoveDataItem(int removedIndex)
    {
        if (removedIndex < 0 || removedIndex >= dataItems.Count)
        {
            return;
        }

        var remainingItems = dataItems.ToList();
        bool removedMainItem = remainingItems[removedIndex].IsMain;
        remainingItems.RemoveAt(removedIndex);

        if (remainingItems.Count > 0 && (removedMainItem || remainingItems.All(item => !item.IsMain)))
        {
            int fallbackIndex = Math.Min(removedIndex, remainingItems.Count - 1);
            for (int index = 0; index < remainingItems.Count; index++)
            {
                remainingItems[index] = remainingItems[index] with { IsMain = index == fallbackIndex };
            }
        }

        dataItems = remainingItems;
    }

    private static IReadOnlyList<BusinessObjectDataItem> NormalizeMainDataItem(IReadOnlyList<BusinessObjectDataItem> items)
    {
        if (items.Count == 0)
        {
            return [];
        }

        int mainIndex = -1;
        for (int index = 0; index < items.Count; index++)
        {
            if (items[index].IsMain)
            {
                mainIndex = index;
                break;
            }
        }

        mainIndex = mainIndex < 0 ? 0 : mainIndex;
        return items
            .Select((item, index) => item.IsMain == (index == mainIndex)
                ? item
                : item with { IsMain = index == mainIndex })
            .ToArray();
    }

