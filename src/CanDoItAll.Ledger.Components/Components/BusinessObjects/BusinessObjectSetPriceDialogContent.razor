@namespace CanDoItAll.Ledger.Components
@using System.Globalization
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject NotificationService Notifications

<Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
        @if (CurrentSale is not null)
        {
            <PriceBar Tone="PriceBarTone.Success" data-testid="bo-current-sale">
                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="@CurrentSale.Status.ToString()" />
                    <TextBlock TextStyle="TextStyle.Subtitle2"
                               Value="@($"{CurrentSale.Mode} / {FormatPrice(CurrentSale.PriceAmount, CurrentSale.TokenId)}")" />
                @if (CurrentSale.MaxClones is not null)
                {
                        <TextBlock TextStyle="TextStyle.Small"
                                   Value="@($"{CurrentSale.SoldCount} / {CurrentSale.MaxClones} copies")" />
                }
                </Stack>
            </PriceBar>
        }

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <FormField Text="Sale mode">
                <DropDown TValue="string"
                          Data="@SaleModeOptions"
                          TextProperty="Text"
                          ValueProperty="Value"
                          Value="@saleModeKey"
                          ValueChanged="@(value => saleModeKey = value ?? nameof(BusinessObjectSaleMode.Original))"
                          data-testid="bo-sale-mode"
                          aria-label="Sale mode" />
            </FormField>

            <FormField Text="Price amount">
                <TextBox Value="@priceAmount"
                         ValueChanged="@(value => priceAmount = value ?? string.Empty)"
                         Immediate="true"
                         Placeholder="100"
                         data-testid="bo-sale-price"
                         aria-label="Price amount" />
            </FormField>
        </Grid>

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <AvailableTokenSelector Options="TokenOptions"
                                    SelectedKey="@selectedTokenKey"
                                    SelectedKeyChanged="@(key => selectedTokenKey = key)"
                                    Label="Price asset"
                                    DataTestId="bo-price-token-selector" />

            @if (IsCopyMode)
            {
                <FormField Text="Max copies">
                    <TextBox Value="@maxClones"
                             ValueChanged="@(value => maxClones = value ?? string.Empty)"
                             Immediate="true"
                             Placeholder="10"
                             data-testid="bo-sale-max-clones"
                             aria-label="Max copies" />
                </FormField>
            }
        </Grid>

        <Toolbar data-testid="bo-sale-share-link">
            <ToolbarRow>
                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap" Class="min-w-0">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Buy link" />
                    <CopyableMonoValue Value="@BuyLink" StartChars="48" EndChars="16" AriaLabel="Copy buy link" />
                </Cluster>
                <ToolbarActions>
                    <CopyButton Text="Copy" Value="@BuyLink" ButtonStyle="ButtonStyle.Secondary" />
                </ToolbarActions>
            </ToolbarRow>
        </Toolbar>

        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
            <Button Text="Set Sale" Icon="sell" Click="SubmitAsync" data-testid="bo-set-sale-submit" />
            <Button Text="Clear Sale" Icon="money_off" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Warning" Click="ClearAsync" data-testid="bo-clear-sale" />
            <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="CancelAsync" />
        </Cluster>
</Stack>

@code {
    private string priceAmount = "100";
    private string maxClones = "10";
    private string saleModeKey = nameof(BusinessObjectSaleMode.Original);
    private string? selectedTokenKey = LedgerTokenOption.MainKey;
    private BusinessObjectId? initializedObjectId;

    private static readonly IReadOnlyList<SaleModeOption> SaleModeOptions =
    [
        new(nameof(BusinessObjectSaleMode.Original), "Original"),
        new(nameof(BusinessObjectSaleMode.Copy), "Copies")
    ];

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerTokenOption> TokenOptions { get; set; } = [];

    [Parameter]
    public EventCallback<BusinessObjectPriceRequest> SubmitRequested { get; set; }

    private BusinessObjectSaleTerms? CurrentSale
    {
        get
        {
            if (Object is null)
            {
                return null;
            }

            return BusinessObjectCommercePayloadBuilder.TryGetSaleTerms(Object.StateJson, out BusinessObjectSaleTerms? terms)
                ? terms
                : null;
        }
    }

    private BusinessObjectSaleMode SaleMode
        => Enum.TryParse(saleModeKey, out BusinessObjectSaleMode mode) ? mode : BusinessObjectSaleMode.Original;

    private bool IsCopyMode => SaleMode == BusinessObjectSaleMode.Copy;

    private string BuyPath
        => Object is null
            ? "/buy-bo"
            : BuyPathFor(Object.CurrentOutPoint);

    private string BuyLink => Navigation.ToAbsoluteUri(BuyPath).ToString();

    protected override void OnParametersSet()
    {
        selectedTokenKey ??= TokenOptions.FirstOrDefault()?.Key ?? LedgerTokenOption.MainKey;
        if (Object is null || initializedObjectId == Object.ObjectId)
        {
            return;
        }

        initializedObjectId = Object.ObjectId;
        if (CurrentSale is { } sale)
        {
            priceAmount = sale.PriceAmount.ToString("0.#############################", CultureInfo.InvariantCulture);
            saleModeKey = sale.Mode.ToString();
            maxClones = (sale.MaxClones ?? 10).ToString(CultureInfo.InvariantCulture);
            selectedTokenKey = string.IsNullOrWhiteSpace(sale.TokenId) ? LedgerTokenOption.MainKey : sale.TokenId;
        }
        else
        {
            priceAmount = "100";
            saleModeKey = nameof(BusinessObjectSaleMode.Original);
            maxClones = "10";
            selectedTokenKey = TokenOptions.FirstOrDefault()?.Key ?? LedgerTokenOption.MainKey;
        }
    }

    private async Task SubmitAsync()
    {
        if (Object is null)
        {
            Notifications.Error("Cannot set sale", "No BusinessObject is selected.", position: NotificationPosition.BottomCenter);
            return;
        }

        if (!decimal.TryParse(priceAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsed) || parsed <= 0m)
        {
            Notifications.Warning("Price required", "Enter a positive price amount.", position: NotificationPosition.BottomCenter);
            return;
        }

        int? parsedMaxClones = null;
        if (IsCopyMode)
        {
            if (!int.TryParse(maxClones, NumberStyles.Integer, CultureInfo.InvariantCulture, out int clones) || clones <= 0)
            {
                Notifications.Warning("Max copies required", "Enter a positive copy limit.", position: NotificationPosition.BottomCenter);
                return;
            }

            parsedMaxClones = clones;
        }

        TokenId? tokenId = TokenOptions.FirstOrDefault(option => option.Key == selectedTokenKey)?.TokenId;
        var request = new BusinessObjectPriceRequest(
            Object.ObjectId,
            new Amount(parsed),
            tokenId,
            Object.StateJson ?? "{}",
            ExternalRef: null,
            SaleMode: SaleMode,
            MaxClones: parsedMaxClones,
            ClearSale: false,
            SharePath: BuyPath);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private async Task ClearAsync()
    {
        if (Object is null)
        {
            await CancelAsync();
            return;
        }

        var request = new BusinessObjectPriceRequest(
            Object.ObjectId,
            Amount.FromInt64(1),
            null,
            Object.StateJson ?? "{}",
            ExternalRef: null,
            SaleMode: BusinessObjectSaleMode.Original,
            MaxClones: null,
            ClearSale: true,
            SharePath: null);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private Task CancelAsync() => DialogService.CloseAsync();

    private static string FormatPrice(decimal amount, string? tokenId)
        => $"{amount.ToString("0.#############################", CultureInfo.InvariantCulture)} {(string.IsNullOrWhiteSpace(tokenId) ? BusinessObjectCommercePayloadBuilder.MainCurrencyCode : tokenId)}";

    private static string BuyPathFor(OutPoint outPoint)
        => $"/buy-bo/tx/{Uri.EscapeDataString(outPoint.TxId.Value)}/{outPoint.OutputIndex}";

    private sealed record SaleModeOption(string Value, string Text);
}
