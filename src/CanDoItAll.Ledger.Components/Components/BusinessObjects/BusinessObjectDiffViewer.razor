@namespace CanDoItAll.Ledger.Components

<section data-testid="cda-bo-diff-viewer">
    <DiffViewer Title="Current state diff"
                BeforeLabel="Previous"
                AfterLabel="Current"
                BeforeText="@PreviousStateJson"
                AfterText="@CurrentStateJson" />
</section>

@code {
    [Parameter]
    public string PreviousStateJson { get; set; } = "{\"status\":\"draft\"}";

    [Parameter]
    public string CurrentStateJson { get; set; } = "{\"status\":\"approved\"}";
}
