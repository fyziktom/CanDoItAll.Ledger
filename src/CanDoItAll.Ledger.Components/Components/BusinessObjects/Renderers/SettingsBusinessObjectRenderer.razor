@namespace CanDoItAll.Ledger.Components

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny">
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Object.ObjectId.Value" />
        <TextBlock TextStyle="TextStyle.Caption" Value="@($"{Settings.Count} account settings")" />
        <StatusBadge Tone="neutral" Text="settings renderer" />
    </Stack>
}
else
{
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <SummaryTile Label="Renderer" Value="@Descriptor.DisplayName" Compact="true" />
            <SummaryTile Label="Settings count" Value="@Settings.Count.ToString()" Compact="true" />
            <SummaryTile Label="Object id" Value="@Object.ObjectId.Value" Compact="true" />
            <SummaryTile Label="Owner" Value="@Object.OwnerAddress.Value" Compact="true" />
        </Grid>

        <Stack GapScale="LayoutGap.Small">
            @foreach (KeyValuePair<string, string> item in Settings)
            {
                <SummaryTile Label="@item.Key" Value="@item.Value" Compact="true" />
            }
        </Stack>
    </Stack>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private IReadOnlyDictionary<string, string> Settings
        => Object is AccountSettingsBusinessObjectView settings
            ? settings.Settings
            : new Dictionary<string, string>(StringComparer.Ordinal);
}
