@namespace CanDoItAll.Ledger.Components
@inject DialogService DialogService

<div data-testid="cda-address-bookmark-manager">
    <SectionCard Title="Directory" Description="Address book">
        <HeaderActions>
            <PageHeaderActionButton Icon="contacts"
                                    Label="Manage"
                                    TooltipText="Manage address directory"
                                    Variant="Variant.Outlined"
                                    Click="OpenAsync" />
        </HeaderActions>

        <ChildContent>
            <SurfaceCard Soft="true">
                <Split Breakpoint="LayoutBreakpoint.Md" Gap="LayoutGap.Small" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <TextBlock TextStyle="TextStyle.Body2">@Bookmarks.Count bookmark(s)</TextBlock>
                    <Button Text="Open directory" Icon="open_in_new" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="OpenAsync" />
                </Split>
            </SurfaceCard>
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LedgerAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    private Task OpenAsync()
        => DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Address Directory",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Workspace)] = Workspace,
                [nameof(AddressDirectoryDialogContent.Bookmarks)] = Bookmarks,
                [nameof(AddressDirectoryDialogContent.AccountScope)] = Workspace?.Address.Value ?? "bookmarks",
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Manage
            },
            new DialogOptions
            {
                Subtitle = "Manage own and external addresses.",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-address-directory-dialog"
            });
}
