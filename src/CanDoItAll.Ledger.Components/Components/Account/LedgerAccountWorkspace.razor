@namespace CanDoItAll.Ledger.Components
@inject DialogService DialogService
@inject IAddressDirectoryService AddressDirectory

<Stack Section="true" GapScale="LayoutGap.Medium" data-testid="economy-account-home">
    <Toolbar>
        <ToolbarRow>
            <Cluster Gap="LayoutGap.Small" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap" Class="min-w-0">
                <Avatar ImageUrl="@ProfileImageLink"
                        Alt="@Workspace.AccountName"
                        FallbackText="@ProfileInitials"
                        UseDefaultImageWhenMissing="false"
                        Size="AvatarSize.Medium"
                        Shape="AvatarShape.Rounded" />
                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                    <TextBlock TextStyle="TextStyle.H4" Value="@Workspace.AccountName" />
                    <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                        <CopyableMonoValue Value="@Workspace.Address.Value" StartChars="10" EndChars="5" AriaLabel="Copy account address" />
                        <QrCodeButton Payload="@AccountAddressQrPayload"
                                      Label="Show account address QR"
                                      TooltipText="Show account address as QR code"
                                      TestId="cda-account-address-qr-button" />
                        <PageHeaderActionButton Icon="badge"
                                                Label="Profile"
                                                TooltipText="Open account profile"
                                                Variant="Variant.Outlined"
                                                Click="ValidateRequested"
                                                TestId="cda-account-profile-button" />
                    </Cluster>
                </Stack>
            </Cluster>

            <CompactStatStrip Class="max-w-3xl justify-end">
                <CompactStat Label="main" Value="@FormatAmount(Workspace.Balance.MainBalance)" Tone="info" />
                <CompactStat Label="token types" Value="@Workspace.TokenTypesOrEmpty.Count.ToString()" />
                <CompactStat Label="BOs" Value="@Workspace.BusinessObjects.Count.ToString()" />
                <CompactStat Label="UTXOs" Value="@Workspace.Balance.UtxoCount.ToString()" />
                <CompactStat Label="txs" Value="@Workspace.Transactions.Count.ToString()" />
                <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.NoWrap">
                    <CompactStat Text="@($"Ledger {Workspace.Context.LedgerId.Value}")"
                                 TooltipText="@($"Ledger: {Workspace.Context.LedgerId.Value}")" />
                    <CopyButton Value="@Workspace.Context.LedgerId.Value"
                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                Size="CopyButtonSize.Small"
                                AriaLabel="Copy ledger id" />
                </Cluster>
                <Cluster Gap="LayoutGap.Tiny" Wrap="FlexWrap.NoWrap">
                    <CompactStat Text="@($"Scenario {ScenarioLabel}")"
                                 TooltipText="@($"Scenario: {ScenarioLabel}")" />
                    <CopyButton Value="@ScenarioLabel"
                                DisplayMode="CopyButtonDisplayMode.IconOnly"
                                Size="CopyButtonSize.Small"
                                AriaLabel="Copy scenario id" />
                </Cluster>
                <CompactStat Text="@(Workspace.NodeBaseUri is null ? "Node local" : "Node connected")"
                             TooltipText="@($"Node: {NodeLabel}")" />
            </CompactStatStrip>
        </ToolbarRow>

        <Grid ColumnsSm="2" ColumnsMd="4" ColumnsXl="8" Gap="LayoutGap.Small">
            <Button Class="w-full" Icon="send" Text="Send" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="AddTransactionRequested" title="Send transaction" aria-label="Send transaction" data-testid="cda-action-send" />
            <Button Class="w-full" Icon="add_circle" Text="Token" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="CreateTokenRequested" title="Create token" aria-label="Create token" data-testid="cda-action-token" />
            <Button Class="w-full" Icon="contacts" Text="Addresses" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenAddressDirectoryAsync" title="Manage address directory" aria-label="Manage address directory" data-testid="cda-action-address-directory" />
            <Button Class="w-full" Icon="security" Text="Security" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenMessageSecurityDialogAsync" title="Open message security" aria-label="Open message security" data-testid="cda-action-security" />
            <Button Class="w-full" Icon="tune" Text="Settings" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenSettingsDialogAsync" title="Open account settings" aria-label="Open account settings" data-testid="cda-action-settings" />
            <Button Class="w-full" Icon="archive" Text="Backup" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenSettingsBackupDialogAsync" title="Import or export browser-local settings" aria-label="Import or export browser-local settings" data-testid="cda-action-settings-backup" />
            <Button Class="w-full" Icon="refresh" Text="Refresh" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="RefreshRequested" title="Refresh workspace" aria-label="Refresh workspace" data-testid="cda-action-refresh" />
            <Button Class="w-full" Icon="add" Text="Subaccount" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="CreateSubAccountRequested" title="Create subaccount" aria-label="Create subaccount" data-testid="cda-action-subaccount" />
        </Grid>
    </Toolbar>

    <Tabs Variant="TabsVariant.WorkspaceSecondary"
          BorderMode="TabsBorderMode.Soft"
          OverflowMode="TabsOverflowMode.Scroll"
          PanelOverflowMode="TabsPanelOverflowMode.Visible"
          data-testid="cda-account-home-tabs"
          AriaLabel="Account home sections">
        <TabsItem Text="Overview" Icon="query_stats">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="3" Gap="LayoutGap.Medium" data-testid="cda-account-analytics">
                    <AccountBalanceTrendChart Workspace="Workspace" />
                    <TokenAllocationDonut TokenOptions="Workspace.TokenOptions" />
                    <TransactionKindStackedChart Transactions="Workspace.Transactions" />
                </Grid>
            </Stack>
        </TabsItem>

        <TabsItem Text="Balances" Icon="account_balance_wallet">
            <Stack GapScale="LayoutGap.Medium"
                   AlignItems="AlignItems.Stretch"
                   Class="w-full min-w-0">
                <SectionCard Title="Balances" Description="Native, token, and source outputs available to this account.">
                    <HeaderActions>
                        <QrCodeButton Payload="@AccountAddressQrPayload"
                                      Label="Show account address QR"
                                      TooltipText="Show account address as QR code"
                                      TestId="cda-balance-address-qr-button" />
                    </HeaderActions>
                    <ChildContent>
                        <Grid ColumnsLg="@(SourceRows.Count > 0 ? 2 : 1)"
                              Gap="LayoutGap.Small"
                              AlignItems="AlignItems.Start"
                              Class="w-full min-w-0"
                              data-testid="cda-balance-layout">
                            <SurfaceCard Soft="true"
                                         Class="w-full min-w-0"
                                         Style="padding:0.75rem"
                                         data-testid="cda-balance-summary-lane">
                                <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch" Class="w-full min-w-0">
                                    <SectionHead>
                                        <Stack GapScale="LayoutGap.Tiny">
                                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Asset balances" />
                                            <SmallText Text="Available native and token amounts." />
                                        </Stack>
                                        <Pill Text="@($"{BalanceRows.Count} asset(s)")" Tone="PillTone.Info" />
                                    </SectionHead>
                                    <DataGrid TItem="AccountBalanceRow"
                                              Data="@BalanceRows"
                                              Caption="Account balances"
                                              EmptyText="No balances are available for this account.">
                                        <Columns>
                                            <DataGridColumn TItem="AccountBalanceRow" Property="Asset" Title="Asset" />
                                            <DataGridColumn TItem="AccountBalanceRow" Property="Amount" Title="Amount" />
                                            <DataGridColumn TItem="AccountBalanceRow" Property="Shape" Title="Shape" />
                                        </Columns>
                                    </DataGrid>
                                </Stack>
                            </SurfaceCard>
                            @if (SourceRows.Count > 0)
                            {
                                <SurfaceCard Soft="true"
                                             Class="w-full min-w-0"
                                             Style="padding:0.75rem"
                                             data-testid="cda-balance-sources-lane">
                                    <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch" Class="w-full min-w-0">
                                        <SectionHead>
                                            <Stack GapScale="LayoutGap.Tiny">
                                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Source UTXOs" />
                                                <SmallText Text="Spendable token outputs available for new transactions." />
                                            </Stack>
                                            <Pill Text="@($"{SourceRows.Count} source(s)")" Tone="PillTone.Ok" />
                                        </SectionHead>
                                        <DataGrid TItem="AccountBalanceRow"
                                                  Data="@SourceRows"
                                                  Caption="Source UTXOs">
                                            <Columns>
                                                <DataGridColumn TItem="AccountBalanceRow" Title="Asset">
                                                    <Template Context="row">
                                                        <Stack GapScale="LayoutGap.Tiny">
                                                            <strong>@row.Asset</strong>
                                                            <CopyableMonoValue Value="@row.OutPoint" StartChars="8" EndChars="6" AriaLabel="Copy token source outpoint" />
                                                        </Stack>
                                                    </Template>
                                                </DataGridColumn>
                                                <DataGridColumn TItem="AccountBalanceRow" Property="Amount" Title="Amount" />
                                                <DataGridColumn TItem="AccountBalanceRow" Title="Shape">
                                                    <Template Context="row">
                                                        <StatusBadge Text="Source" Tone="info" />
                                                    </Template>
                                                </DataGridColumn>
                                            </Columns>
                                        </DataGrid>
                                    </Stack>
                                </SurfaceCard>
                            }
                        </Grid>
                    </ChildContent>
                </SectionCard>
            </Stack>
        </TabsItem>

        <TabsItem Text="Commerce" Icon="payments" BadgeText="@CommerceRecordCount.ToString()">
            <Stack GapScale="LayoutGap.Medium"
                   AlignItems="AlignItems.Stretch"
                   Class="w-full min-w-0"
                   data-testid="cda-commerce-tab-panel">
                <BusinessObjectCommerceDashboard Workspace="Workspace"
                                                 DirectoryEntries="@addressDirectoryEntries"
                                                 EditRequested="TransactionSubmitRequested"
                                                 TransactionDetailsRequested="BusinessObjectTransactionDetailsRequested" />
            </Stack>
        </TabsItem>

        <TabsItem Text="Transactions history" Icon="receipt_long" BadgeText="@Workspace.Transactions.Count.ToString()">
            <Stack GapScale="LayoutGap.Small"
                   AlignItems="AlignItems.Stretch"
                   Class="w-full min-w-0"
                   data-testid="cda-recent-transactions">
                <SectionHead>
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.H4" Value="Transactions history" />
                        <SmallText Text="The 10 most recent account-visible ledger transactions. Open the full history for older activity." />
                    </Stack>
                    <PageHeaderActionButton Icon="open_in_full"
                                            Label="Show all transactions"
                                            TooltipText="Show all transactions"
                                            Variant="Variant.Outlined"
                                            Click="OpenAllTransactionsAsync"
                                            TestId="cda-show-all-transactions" />
                </SectionHead>

                @if (Workspace.Transactions.Count == 0)
                {
                    <EmptyState Title="No transactions yet"
                                Description="No account-visible transactions have been loaded for this workspace." />
                }
                else
                {
                    <TransactionHistoryList Items="@Workspace.Transactions"
                                            AccountAddress="@Workspace.Address"
                                            AccountName="@Workspace.AccountName"
                                            Bookmarks="@Workspace.AddressBookmarks"
                                            DirectoryEntries="@addressDirectoryEntries"
                                            MaxItems="10"
                                            TransactionDetailsRequested="@TransactionDetailsRequested" />
                }
            </Stack>
        </TabsItem>
    </Tabs>
</Stack>

@code {
    private IReadOnlyList<AddressDirectoryEntry> addressDirectoryEntries = [];
    private BusinessObjectWorkspaceModel? addressDirectoryWorkspace;

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }

    [Parameter]
    public EventCallback ValidateRequested { get; set; }

    [Parameter]
    public EventCallback AddTransactionRequested { get; set; }

    [Parameter]
    public EventCallback CreateTokenRequested { get; set; }

    [Parameter]
    public EventCallback<LedgerTransactionSummary> TransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> BusinessObjectTransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> TransactionSubmitRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? BusinessObjectTicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<LedgerTransactionExecutionResult>>? BusinessObjectTicketUseRequested { get; set; }

    [Parameter]
    public Func<MessageSecuritySignRequest, Task<MessageSecurityActionResult>>? MessageSignRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityVerifyRequest, Task<MessageSecurityActionResult>>? MessageVerifyRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityEncryptRequest, Task<MessageSecurityActionResult>>? MessageEncryptRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityDecryptRequest, Task<MessageSecurityActionResult>>? MessageDecryptRequested { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (ReferenceEquals(addressDirectoryWorkspace, Workspace))
        {
            return;
        }

        addressDirectoryWorkspace = Workspace;
        await ReloadAddressDirectoryAsync();
    }

    private IEnumerable<KeyValuePair<TokenId, Amount>> OrderedTokenBalances
        => Workspace.Balance.TokenBalances.OrderBy(token => token.Key.Value, StringComparer.Ordinal);

    private IReadOnlyList<LedgerTokenType> DisplayTokenTypes
        => Workspace.TokenTypesOrEmpty
            .OrderBy(token => token.TokenId.Value, StringComparer.Ordinal)
            .Take(6)
            .ToArray();

    private IReadOnlyList<KeyValuePair<TokenId, Amount>> BalanceOnlyTokens
        => OrderedTokenBalances
            .Where(token => Workspace.TokenTypesOrEmpty.All(type => type.TokenId != token.Key))
            .Take(4)
            .ToArray();

    private IReadOnlyList<LedgerSpendableOutput> TokenSourceOutputs
        => Workspace.SpendableOutputsOrEmpty
            .Where(IsTokenSourceOutput)
            .OrderBy(output => output.Token!.TokenId.Value, StringComparer.Ordinal)
            .ThenByDescending(output => output.Token!.Amount.Value)
            .Take(5)
            .ToArray();

    private IReadOnlyList<AccountBalanceRow> BalanceRows
        =>
        [
            new("Main", FormatAmount(Workspace.Balance.MainBalance), "native"),
            .. DisplayTokenTypes.Select(tokenType => new AccountBalanceRow(
                tokenType.TokenId.Value,
                tokenType.TotalAmount.ToString(),
                $"{tokenType.SourceAmount} source / {tokenType.UniqueAmount} unique")),
            .. BalanceOnlyTokens.Select(token => new AccountBalanceRow(
                token.Key.Value,
                FormatAmount(token.Value),
                "balance"))
        ];

    private IReadOnlyList<AccountBalanceRow> SourceRows
        =>
        [
            .. TokenSourceOutputs.Select(output => new AccountBalanceRow(
                output.Token!.TokenId.Value,
                output.Token.Amount.ToString(),
                "source",
                output.OutPoint.ToString(),
                true))
        ];

    private int CommerceRecordCount
        => Workspace.BusinessObjects
            .OfType<ICommerceBusinessObjectView>()
            .Count(item => item.Commerce.Payment is not null
                || item.Commerce.Purchase is not null
                || item.Commerce.Receipt is not null);

    private string ScenarioLabel
        => Workspace.Context.ScenarioId?.Value ?? "live";

    private string NodeLabel
        => Workspace.NodeBaseUri?.ToString() ?? "local";

    private QrCodePayload AccountAddressQrPayload
        => new(
            Workspace.Address.Value,
            QrPayloadKind.Address,
            "Account address",
            $"Address for {Workspace.AccountName}");

    private string? ProfileImageLink
    {
        get
        {
            IBusinessObjectView? profile = Workspace.BusinessObjects.FirstOrDefault(item =>
                item.ObjectType.Equals("profile", StringComparison.OrdinalIgnoreCase));
            if (profile is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.ImageLink))
            {
                return media.ImageLink;
            }

            return BusinessObjectPayloadBuilder.TryParseMediaPayload(profile?.StateJson, out BusinessObjectMediaPayload? payload)
                ? payload?.ImageLink
                : null;
        }
    }

    private string ProfileInitials
    {
        get
        {
            string[] parts = Workspace.AccountName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            string initials = string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
            return string.IsNullOrWhiteSpace(initials) ? "BO" : initials;
        }
    }

    private Task OpenSettingsDialogAsync()
        => DialogService.OpenAsync<AccountSettingsDialogContent>(
            "Account Settings",
            new Dictionary<string, object?>
            {
                [nameof(AccountSettingsDialogContent.Workspace)] = Workspace
            },
            new DialogOptions
            {
                Subtitle = Workspace.Address.Value,
                Size = ModalSize.Compact,
                DenseChrome = true,
                Class = "cda-ledger-dialog max-w-lg",
                TestId = "cda-account-settings-dialog"
            });

    private Task OpenSettingsBackupDialogAsync()
        => DialogService.OpenAsync<SettingsBackupDialogContent>(
            "Browser Settings Backup",
            new Dictionary<string, object?>
            {
                [nameof(SettingsBackupDialogContent.AccountScope)] = Workspace.Address.Value
            },
            new DialogOptions
            {
                Subtitle = $"{Workspace.AccountName} - local browser settings",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-settings-backup-dialog"
            });

    private async Task OpenAddressDirectoryAsync()
    {
        await DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Address Directory",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Workspace)] = Workspace,
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Manage
            },
            new DialogOptions
            {
                Subtitle = "Own and external address management",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-address-directory-dialog"
            });

        await ReloadAddressDirectoryAsync();
    }

    private async Task ReloadAddressDirectoryAsync()
    {
        AddressDirectorySeed seed = AddressDirectorySeed.FromWorkspace(Workspace);
        try
        {
            addressDirectoryEntries = await AddressDirectory.GetEntriesAsync(seed);
        }
        catch (Exception)
        {
            // The transaction surface remains usable when browser-local directory storage is unavailable.
            addressDirectoryEntries = seed.Entries;
        }
    }

    private Task OpenMessageSecurityDialogAsync()
        => DialogService.OpenAsync<MessageSecurityPanel>(
            "Message Security",
            new Dictionary<string, object?>
            {
                [nameof(MessageSecurityPanel.Workspace)] = Workspace,
                [nameof(MessageSecurityPanel.SignRequested)] = MessageSignRequested,
                [nameof(MessageSecurityPanel.VerifyRequested)] = MessageVerifyRequested,
                [nameof(MessageSecurityPanel.EncryptRequested)] = MessageEncryptRequested,
                [nameof(MessageSecurityPanel.DecryptRequested)] = MessageDecryptRequested,
                [nameof(MessageSecurityPanel.SendRequested)] = BusinessObjectSendRequested,
                [nameof(MessageSecurityPanel.SetPriceRequested)] = BusinessObjectSetPriceRequested,
                [nameof(MessageSecurityPanel.EditRequested)] = TransactionSubmitRequested,
                [nameof(MessageSecurityPanel.TransactionDetailsRequested)] = BusinessObjectTransactionDetailsRequested,
                [nameof(MessageSecurityPanel.TicketVerificationRequested)] = BusinessObjectTicketVerificationRequested,
                [nameof(MessageSecurityPanel.TicketUseRequested)] = BusinessObjectTicketUseRequested
            },
            new DialogOptions
            {
                Subtitle = $"Signing and encryption tools for {Workspace.AccountName}",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-message-security-dialog"
            });

    private Task OpenAllTransactionsAsync()
        => DialogService.OpenAsync<TransactionHistoryDialogContent>(
            "All Transactions",
            new Dictionary<string, object?>
            {
                [nameof(TransactionHistoryDialogContent.Transactions)] = Workspace.Transactions,
                [nameof(TransactionHistoryDialogContent.AccountAddress)] = Workspace.Address,
                [nameof(TransactionHistoryDialogContent.AccountName)] = Workspace.AccountName,
                [nameof(TransactionHistoryDialogContent.Bookmarks)] = Workspace.AddressBookmarks,
                [nameof(TransactionHistoryDialogContent.DirectoryEntries)] = addressDirectoryEntries,
                [nameof(TransactionHistoryDialogContent.TransactionDetailsRequested)] = TransactionDetailsRequested
            },
            new DialogOptions
            {
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog cda-ledger-dialog--compact",
                TestId = "cda-transaction-history-dialog"
            });

    private static string FormatAmount(Amount amount) => amount.ToString();

    private static bool IsTokenSourceOutput(LedgerSpendableOutput output)
        => output.BusinessObject is null
            && output.Token is not null
            && output.Token.Amount.Value > 1m;

    private sealed record AccountBalanceRow(
        string Asset,
        string Amount,
        string Shape,
        string? OutPoint = null,
        bool IsSource = false);
}
