@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-subaccount-directory">
    <SectionCard Title="Account directory" Description="Subaccounts linked to this account">
        <HeaderActions>
            <StatusBadge Text="@($"{Workspace.SubAccounts.Count} linked")" Tone="info" />
        </HeaderActions>

        <ChildContent>
            @if (Workspace.SubAccounts.Count == 0)
            {
                <EmptyState Eyebrow="Subaccounts" Title="No linked accounts" Description="Create a child account or connect an account alias to populate this directory." />
            }
            else
            {
                <Grid ColumnsMd="2" ColumnsXl="3" Gap="LayoutGap.Small">
                    @foreach (BusinessObjectSubAccountSummary item in Workspace.SubAccounts)
                    {
                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Medium">
                                <Split Breakpoint="LayoutBreakpoint.None" Gap="LayoutGap.Small" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap">
                                    <TextBlock TextStyle="TextStyle.Subtitle2" Value="@item.Name" />
                                    <StatusBadge Text="@($"{item.UtxoCount} UTXO")" Tone="neutral" />
                                </Split>
                                <CopyableMonoValue Value="@item.Address.Value" />
                                <SummaryTiles ColumnsSm="3" ColumnsXl="3" GapScale="LayoutGap.Small">
                                    <SummaryTile Label="Main" Value="@item.MainBalance.ToString()" Compact="true" />
                                    <SummaryTile Label="Objects" Value="@item.BusinessObjectCount.ToString()" Compact="true" />
                                    <SummaryTile Label="Activity" Value="@item.LastActivityUtc.ToString("MM.dd HH:mm")" Compact="true" />
                                </SummaryTiles>
                            </Stack>
                        </SurfaceCard>
                    }
                </Grid>
            }
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;
}
