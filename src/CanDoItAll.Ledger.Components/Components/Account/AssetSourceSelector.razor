@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-asset-source-selector">
    <SectionCard Title="Asset source selector" Description="Source selection">
        <EntityPicker Title="Spend from"
                      Description="Token options stay decoupled from transaction submission."
                      Items="PickerItems"
                      SelectedId="@SelectedTokenKey"
                      SelectedIdChanged="SelectedTokenKeyChanged"
                      EmptyText="No spendable assets." />
    </SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTokenOption> TokenOptions { get; set; } = [];

    [Parameter]
    public string? SelectedTokenKey { get; set; }

    [Parameter]
    public EventCallback<string> SelectedTokenKeyChanged { get; set; }

    private IReadOnlyList<EntityPickerItem> PickerItems
        => TokenOptions
            .Select(item => new EntityPickerItem
            {
                Id = item.Key,
                Label = item.AssetLabel,
                Description = $"{item.AvailableAmount} available",
                Meta = item.CanCreateMore ? "mintable" : null,
                Icon = item.IsMain ? "paid" : "token"
            })
            .ToArray();
}
