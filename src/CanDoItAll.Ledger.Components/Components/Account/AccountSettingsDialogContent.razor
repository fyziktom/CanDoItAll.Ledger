@namespace CanDoItAll.Ledger.Components
@inject ITagOccurrenceService TagOccurrences
@inject NotificationService Notifications

<Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
    <Toolbar>
        <ToolbarRow>
            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap" Class="min-w-0">
                <CopyableMonoValue Value="@Workspace.Address.Value"
                                   StartChars="12"
                                   EndChars="8"
                                   AriaLabel="Copy account address" />
            </Cluster>
            <CompactStatStrip Class="justify-end">
                <CompactStat Label="Account" Value="@Workspace.AccountName" />
                <CompactStat Label="Alias" Value="@(Workspace.AccountAlias ?? "none")" />
                <CompactStat Label="Ledger" Value="@Workspace.Context.LedgerId.Value" />
                <CompactStat Label="Scenario" Value="@(Workspace.Context.ScenarioId?.Value ?? "live")" />
                <CompactStat Label="Viewed" Value="@Workspace.ViewedAtUtc.ToString("MM.dd HH:mm")" />
                <CompactStat Label="Connection" Value="@Workspace.ConnectionLabel" Tone="info" />
            </CompactStatStrip>
        </ToolbarRow>
    </Toolbar>
    <FormField Text="Frequent tag source">
        <DropDown TValue="TagSuggestionSource"
                  Data="SuggestionSourceOptions"
                  TextProperty="Text"
                  ValueProperty="Value"
                  Value="@suggestionSource"
                  ValueChanged="@((TagSuggestionSource value) => OnSuggestionSourceChanged(value))"
                  aria-label="Frequent tag source" />
    </FormField>
</Stack>

@code {
    private static readonly SuggestionSourceOption[] SuggestionSourceOptions =
    [
        new(TagSuggestionSource.Unique, "Unique BO occurrence"),
        new(TagSuggestionSource.General, "General view occurrence")
    ];

    private TagSuggestionSource suggestionSource = TagSuggestionSource.Unique;

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        suggestionSource = await TagOccurrences.GetSuggestionSourceAsync(Workspace.Address.Value);
    }

    private async Task OnSuggestionSourceChanged(TagSuggestionSource source)
    {
        suggestionSource = source;
        await TagOccurrences.SetSuggestionSourceAsync(Workspace.Address.Value, suggestionSource);
        Notifications.Success("Tag suggestion source updated", suggestionSource.ToString(), position: NotificationPosition.BottomCenter);
    }

    private sealed record SuggestionSourceOption(TagSuggestionSource Value, string Text);
}
