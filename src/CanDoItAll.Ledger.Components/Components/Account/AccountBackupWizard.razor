@namespace CanDoItAll.Ledger.Components

<div data-testid="cda-account-backup-wizard">
    <SectionCard Title="Backup wizard" Description="Account safety">
        <HeaderActions>
            <StatusBadge Text="Required" Tone="warning" />
        </HeaderActions>

        <ChildContent>
            <AccountBackupPanel Model="Model"
                                CreateAccountRequested="CreateAccountRequested"
                                UnlockAccountRequested="UnlockAccountRequested"
                                BackupAccountRequested="BackupAccountRequested"
                                ImportBackupRequested="ImportBackupRequested"
                                ImportPastedPrivateKeyRequested="ImportPastedPrivateKeyRequested"
                                CreateSubAccountRequested="CreateSubAccountRequested" />
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter, EditorRequired]
    public AccountBackupWorkflowModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback CreateAccountRequested { get; set; }

    [Parameter]
    public EventCallback UnlockAccountRequested { get; set; }

    [Parameter]
    public EventCallback BackupAccountRequested { get; set; }

    [Parameter]
    public EventCallback ImportBackupRequested { get; set; }

    [Parameter]
    public EventCallback ImportPastedPrivateKeyRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }
}
