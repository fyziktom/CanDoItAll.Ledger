@namespace CanDoItAll.Economy.Node.Components.Shared
@inject NavigationManager Navigation

<section class="cda-sdk-section cda-node-route-shell min-w-0" data-testid="@TestId">
    <span class="sr-only" data-route-focus>@Heading</span>
    <Grid ColumnsLg="2"
          ColumnTemplateLg="minmax(15rem, 0.32fr) minmax(0, 1.68fr)"
          Gap="LayoutGap.Medium"
          Class="cda-node-route-grid min-w-0">
        <aside class="cda-sdk-panel cda-sdk-panel--compact cda-node-main-menu" data-testid="node-route-navigation">
            <a class="cda-node-main-menu__brand" href="/accounts">
                <span class="cda-node-main-menu__eyebrow">@Subtitle</span>
                <span class="cda-node-main-menu__title">@Title</span>
            </a>

            <nav class="cda-node-main-menu__nav" aria-label="Node workspace sections">
                @foreach (NodeNavItem item in NavigationItems)
                {
                    <Button Text="@item.Label"
                            Icon="@item.Icon"
                            Href="@item.Href"
                            Variant="@(IsActive(item) ? Variant.Filled : Variant.Outlined)"
                            ButtonStyle="@(IsActive(item) ? ButtonStyle.Info : ButtonStyle.Secondary)" />
                }
            </nav>

            @if (!string.IsNullOrWhiteSpace(StatusText))
            {
                <section class="cda-node-main-menu__status" data-testid="node-route-status">
                    <div>
                        <span>Node status</span>
                        <strong>@StatusText</strong>
                    </div>
                    <StatusBadge Text="@StatusText" Tone="@StatusTone" />
                    @if (!string.IsNullOrWhiteSpace(StatusDescription))
                    {
                        <p>@StatusDescription</p>
                    }
                </section>
            }

            @if (MenuFooter is not null)
            {
                <footer class="cda-node-main-menu__footer" data-testid="node-menu-footer">
                    @MenuFooter
                </footer>
            }
        </aside>

        <Stack GapScale="LayoutGap.Medium" Class="min-w-0">
            <header class="cda-sdk-panel cda-sdk-panel--compact" data-testid="node-route-header">
                <Cluster Gap="LayoutGap.Medium">
                    <div class="min-w-0">
                        <span>@Eyebrow</span>
                        <h1>@Heading</h1>
                        @if (!string.IsNullOrWhiteSpace(Description))
                        {
                            <p>@Description</p>
                        }
                    </div>

                    @if (HeaderActions is not null)
                    {
                        <div class="min-w-0">@HeaderActions</div>
                    }
                </Cluster>
            </header>

            @ChildContent
        </Stack>
    </Grid>
</section>

@code {
    private static readonly IReadOnlyList<NodeNavItem> NavigationItems =
    [
        new("Accounts", "account_balance_wallet", "/accounts"),
        new("Transactions", "receipt_long", "/transactions"),
        new("Business objects", "inventory_2", "/business-objects"),
        new("Analytics", "query_stats", "/analytics"),
        new("Simulation", "travel_explore", "/economy/simulation-sandbox"),
        new("Node admin", "admin_panel_settings", "/admin")
    ];

    [Parameter]
    public string Title { get; set; } = "Economy Node";

    [Parameter]
    public string Subtitle { get; set; } = "Blazor SSR";

    [Parameter]
    public string Eyebrow { get; set; } = "Workspace";

    [Parameter]
    public string Heading { get; set; } = "Node workspace";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? StatusText { get; set; }

    [Parameter]
    public string StatusTone { get; set; } = "info";

    [Parameter]
    public string? StatusDescription { get; set; }

    [Parameter]
    public string TestId { get; set; } = "node-shell";

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public RenderFragment? MenuFooter { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool IsActive(NodeNavItem item)
    {
        string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        string path = "/" + relative.Split('?', '#')[0].Trim('/');
        if (path == "/" && item.Href == "/accounts")
        {
            return true;
        }

        return string.Equals(path, item.Href, StringComparison.OrdinalIgnoreCase);
    }

    private sealed record NodeNavItem(string Label, string Icon, string Href);
}
