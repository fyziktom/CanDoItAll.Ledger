@namespace CanDoItAll.Economy.Node.Components.Shared

<section class="min-h-dvh flex items-center justify-center px-4 py-8" data-testid="@TestId">
    <span class="sr-only" data-route-focus>@Heading</span>
    <div class="w-full max-w-lg mx-auto">
        <Stack GapScale="LayoutGap.Medium" Class="min-w-0 w-full">
            <div class="text-center">
                <span class="cda-economy-eyebrow">@Eyebrow</span>
                <h1 class="cda-economy-title">@Heading</h1>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="cda-economy-subtitle">@Description</p>
                }
            </div>

            <div class="w-full">
                @ChildContent
            </div>
        </Stack>
    </div>
</section>

@code {
    [Parameter]
    public string Eyebrow { get; set; } = "Economy Node";

    [Parameter]
    public string Heading { get; set; } = "Operator access";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string TestId { get; set; } = "node-auth-shell";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
