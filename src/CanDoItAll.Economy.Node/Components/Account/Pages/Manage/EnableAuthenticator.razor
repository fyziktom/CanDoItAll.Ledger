@page "/Account/Manage/EnableAuthenticator"
@attribute [Authorize(Policy = EconomyNodeAuthPolicies.Administrator)]

<PageTitle>Authenticator</PageTitle>

<NodeAuthShell Heading="Authenticator setup" Description="Use the ASP.NET Core Identity authenticator flow for production operator accounts before returning to the console." TestId="node-enable-authenticator">
    <section class="cda-sdk-panel">
        <EmptyState Eyebrow="Two-factor" Title="Authenticator setup is required" Description="Use the ASP.NET Core Identity authenticator flow for production operator accounts before returning to the console." />
        <Button Text="Back to account" Icon="arrow_back" Href="/Account/Manage" Variant="Variant.Outlined" />
    </section>
</NodeAuthShell>
