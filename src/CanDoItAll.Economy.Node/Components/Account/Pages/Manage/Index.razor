@page "/Account/Manage"
@attribute [Authorize(Policy = EconomyNodeAuthPolicies.Administrator)]
@using Microsoft.AspNetCore.Identity
@inject UserManager<EconomyNodeUser> UserManager

<PageTitle>Account</PageTitle>

<NodeAuthShell Heading="Administrator account" Description="Review the signed-in operator account and identity posture." TestId="node-account-manage">
    <SectionCard Title="@(currentUser?.Email ?? "Administrator")" Description="Identity">
        <HeaderActions>
            <StatusBadge Text="Signed in" Tone="success" />
        </HeaderActions>
        <ChildContent>
            <SummaryTiles ColumnsSm="2" ColumnsXl="4" GapScale="LayoutGap.Small">
                <SummaryTile Label="User id" Value="@(currentUser?.Id ?? "unknown")" Compact="true" />
                <SummaryTile Label="Email confirmed" Value="@(currentUser?.EmailConfirmed == true ? "yes" : "no")" Compact="true" />
                <SummaryTile Label="Two-factor" Value="@twoFactorLabel" Compact="true" />
                <SummaryTile Label="Role" Value="@EconomyNodeAuthPolicies.AdministratorRole" Compact="true" />
            </SummaryTiles>
            <Button Text="Authenticator setup" Icon="security" Href="/Account/Manage/EnableAuthenticator" Variant="Variant.Outlined" />
        </ChildContent>
    </SectionCard>
</NodeAuthShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private EconomyNodeUser? currentUser;
    private string twoFactorLabel = "not configured";
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthenticationStateTask.ConfigureAwait(false);
        currentUser = await UserManager.GetUserAsync(state.User).ConfigureAwait(false);
        if (currentUser is not null)
        {
            twoFactorLabel = await UserManager.GetTwoFactorEnabledAsync(currentUser).ConfigureAwait(false)
                ? "enabled"
                : "disabled";
        }
    }
}
