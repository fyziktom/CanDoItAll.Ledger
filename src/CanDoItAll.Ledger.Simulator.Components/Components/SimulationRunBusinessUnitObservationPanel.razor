@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<ListDetailShell Dense="true"
                 ListPaneWidth="17rem"
                 ListPaneClass="min-h-[27rem]"
                 DetailPaneClass="min-h-[27rem]"
                 data-testid="simulation-run-bu-tab">
    <ListHeader>
        <ListPanelHeader Title="Observed units"
                         Count="@Observation.AccountSnapshots.Count.ToString(CultureInfo.InvariantCulture)"
                         HelpText="Select a business unit for its account rollup or an account for rule and issue evidence."
                         Dense="true">
            <Actions>
                <StatusBadge Text="@Observation.Summary.Status" Tone="@StatusTone(Observation.Summary.Status)" />
            </Actions>
        </ListPanelHeader>
    </ListHeader>
    <ListContent>
        <div class="max-h-[36rem] min-h-0 overflow-y-auto pr-1">
            <TreeView Items="BusinessUnitNodes"
                      Style="TreeViewStyle.Workbench"
                      AriaLabel="Run observation business unit and account tree"
                      OnSelect="SelectNode"
                      OnToggle="ToggleNode" />
        </div>
    </ListContent>
    <DetailHeader>
        @if (SelectedSnapshot is not null)
        {
            <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium" Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.H4" Value="@SelectedSnapshot.BusinessUnitName" />
                    <TooltipTarget Text="@SelectedSnapshot.AccountAddress.Value" Position="TooltipPosition.Right" TabIndex="0">
                        <MonoText Text="@Short(SelectedSnapshot.AccountAddress.Value)" />
                    </TooltipTarget>
                </Stack>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Text="@SelectedSnapshot.AccountRole.ToString()" Tone="info" />
                    <StatusBadge Text="@SelectedSnapshot.BindingStatus.ToString()" Tone="@StatusTone(SelectedSnapshot.BindingStatus)" />
                </Cluster>
            </Split>
        }
        else if (SelectedBusinessUnit is not null)
        {
            <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium" Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.H4" Value="@SelectedBusinessUnit.DisplayName" />
                    <SmallText Text="@SelectedBusinessUnit.Path" />
                </Stack>
                <StatusBadge Text="@SelectedBusinessUnit.Kind.ToString()" Tone="info" />
            </Split>
        }
    </DetailHeader>
    <DetailContent>
        @if (SelectedSnapshot is not null)
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="simulation-run-selected-account-detail">
                <CompactStatStrip>
                    <CompactStat Label="Balance" Value="@Money(SelectedSnapshot.Balance)" Tone="info" />
                    <CompactStat Label="Current BOs" Value="@SelectedSnapshot.CurrentBusinessObjectIds.Count.ToString(CultureInfo.InvariantCulture)" />
                    <CompactStat Label="Processed" Value="@SelectedSnapshot.ProcessedTriggerCount.ToString(CultureInfo.InvariantCulture)" />
                    <CompactStat Label="Failed/skipped" Value="@($"{SelectedSnapshot.FailedActionCount}/{SelectedSnapshot.SkippedActionCount}")" />
                    <CompactStat Label="Rule token" Value="@(SelectedSnapshot.HasRuleToken ? "Present" : "Missing")" Tone="@(SelectedSnapshot.HasRuleToken ? "success" : "warning")" />
                    <CompactStat Label="Snapshot" Value="@SelectedSnapshot.SnapshotId" Position="TooltipPosition.Right" />
                </CompactStatStrip>

                <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                    <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-3" aria-label="Current business objects">
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock TextStyle="TextStyle.Subtitle1" Value="Current business objects" />
                            @foreach (string objectId in SelectedSnapshot.CurrentBusinessObjectIds.DefaultIfEmpty("None"))
                            {
                                <TooltipTarget Text="@objectId" Position="TooltipPosition.Right" TabIndex="0"><MonoText Text="@objectId" /></TooltipTarget>
                            }
                        </Stack>
                    </section>

                    <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-3" aria-label="Related issues">
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock TextStyle="TextStyle.Subtitle1" Value="Related issues" />
                        <DataGrid TItem="SimulationIssue" Data="SelectedSnapshotIssues">
                            <DataGridColumn TItem="SimulationIssue" Property="Code" Title="Code" />
                            <DataGridColumn TItem="SimulationIssue" Title="Severity">
                                <Template Context="issue">
                                    <StatusBadge Text="@issue.Severity" Tone="@StatusTone(issue.Severity)" />
                                </Template>
                            </DataGridColumn>
                            <DataGridColumn TItem="SimulationIssue" Property="Message" Title="Message" />
                        </DataGrid>
                        </Stack>
                    </section>
                </Grid>
            </Stack>
        }
        else if (SelectedBusinessUnit is not null)
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="simulation-run-selected-bu-detail">
                <CompactStatStrip>
                    <CompactStat Label="Accounts" Value="@SelectedBusinessUnitSnapshots.Count.ToString(CultureInfo.InvariantCulture)" />
                    <CompactStat Label="Total balance" Value="@Money(Amount.FromDecimal(SelectedBusinessUnitSnapshots.Sum(x => x.Balance.Value)))" Tone="info" />
                    <CompactStat Label="Issues" Value="@SelectedBusinessUnitIssues.Count.ToString(CultureInfo.InvariantCulture)" Tone="@(SelectedBusinessUnitIssues.Count == 0 ? "success" : "warning")" />
                    <CompactStat Label="Status" Value="@SelectedBusinessUnit.Status.ToString()" />
                </CompactStatStrip>

                <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-3" aria-label="Account snapshots">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Subtitle1" Value="Account snapshots" />
                    <DataGrid TItem="SimulationBusinessUnitAccountSnapshot" Data="SelectedBusinessUnitSnapshots">
                        <DataGridColumn TItem="SimulationBusinessUnitAccountSnapshot" Title="Role">
                            <Template Context="snapshot">
                                <StatusBadge Text="@snapshot.AccountRole.ToString()" Tone="info" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="SimulationBusinessUnitAccountSnapshot" Title="Address">
                            <Template Context="snapshot">
                                <MonoText Text="@Short(snapshot.AccountAddress.Value)" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="SimulationBusinessUnitAccountSnapshot" Title="Balance">
                            <Template Context="snapshot">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Money(snapshot.Balance)" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="SimulationBusinessUnitAccountSnapshot" Title="Rules">
                            <Template Context="snapshot">
                                <SmallText Text="@($"{snapshot.ProcessedTriggerCount} processed, {snapshot.FailedActionCount} failed, {snapshot.SkippedActionCount} skipped")" />
                            </Template>
                        </DataGridColumn>
                    </DataGrid>
                    </Stack>
                </section>
            </Stack>
        }
    </DetailContent>
</ListDetailShell>

@code {
    private readonly HashSet<string> expandedNodeIds = new(StringComparer.Ordinal);
    private string? selectedNodeId;
    private string renderedRunKey = string.Empty;

    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    [Parameter, EditorRequired]
    public SimulationRunObservationState Observation { get; set; } = default!;

    private string SelectedId => selectedNodeId
        ?? Project.BusinessUnits.FirstOrDefault(unit => unit.ParentBusinessUnitId is null)?.BusinessUnitId.Value
        ?? Observation.AccountSnapshots.FirstOrDefault()?.SnapshotId
        ?? string.Empty;

    private SimulationBusinessUnitAccountSnapshot? SelectedSnapshot => Observation.AccountSnapshots.FirstOrDefault(snapshot => SnapshotNodeId(snapshot) == SelectedId || snapshot.SnapshotId == SelectedId);

    private BusinessUnitState? SelectedBusinessUnit => Project.BusinessUnits.FirstOrDefault(x => x.BusinessUnitId.Value == SelectedId);

    private IReadOnlyList<SimulationBusinessUnitAccountSnapshot> SelectedBusinessUnitSnapshots => SelectedBusinessUnit is null
        ? []
        : Observation.AccountSnapshots.Where(snapshot => snapshot.BusinessUnitId == SelectedBusinessUnit.BusinessUnitId).ToArray();

    private IReadOnlyList<SimulationIssue> SelectedBusinessUnitIssues => SelectedBusinessUnit is null
        ? []
        : Observation.Issues.Where(issue => issue.BusinessUnitId == SelectedBusinessUnit.BusinessUnitId).ToArray();

    private IReadOnlyList<SimulationIssue> SelectedSnapshotIssues => SelectedSnapshot is null
        ? []
        : Observation.Issues.Where(issue => SelectedSnapshot.RelatedIssueIds.Contains(issue.IssueId, StringComparer.Ordinal)).ToArray();

    private IReadOnlyList<TreeViewNode> BusinessUnitNodes
        => BuildBusinessUnitNodes(Project.BusinessUnits.Where(x => x.ParentBusinessUnitId is null).OrderBy(x => x.Path, StringComparer.Ordinal));

    protected override void OnParametersSet()
    {
        string runKey = $"{Observation.Summary.RunId}:{Observation.Summary.CurrentStep}";
        if (!string.Equals(renderedRunKey, runKey, StringComparison.Ordinal))
        {
            renderedRunKey = runKey;
            expandedNodeIds.Clear();
            selectedNodeId = Project.BusinessUnits.FirstOrDefault(unit => unit.ParentBusinessUnitId is null)?.BusinessUnitId.Value
                ?? Project.BusinessUnits.FirstOrDefault()?.BusinessUnitId.Value
                ?? Observation.AccountSnapshots.FirstOrDefault()?.SnapshotId;
        }

        EnsureSelectedAncestryExpanded();
    }

    private IReadOnlyList<TreeViewNode> BuildBusinessUnitNodes(IEnumerable<BusinessUnitState> businessUnits)
        => businessUnits
            .Select(businessUnit =>
            {
                IReadOnlyList<TreeViewNode> children = Project.BusinessUnits
                    .Where(x => x.ParentBusinessUnitId == businessUnit.BusinessUnitId)
                    .OrderBy(x => x.Path, StringComparer.Ordinal)
                    .SelectMany(child => BuildBusinessUnitNodes([child]))
                    .Concat(Observation.AccountSnapshots
                        .Where(snapshot => snapshot.BusinessUnitId == businessUnit.BusinessUnitId)
                        .OrderBy(snapshot => snapshot.AccountRole)
                        .Select(snapshot => new TreeViewNode
                        {
                            Id = SnapshotNodeId(snapshot),
                            Text = snapshot.AccountRole.ToString(),
                            Icon = "account_balance_wallet",
                            BadgeText = Money(snapshot.Balance),
                            Tooltip = $"{snapshot.AccountRole} · {snapshot.BusinessUnitName} · balance {Money(snapshot.Balance)} · {snapshot.BindingStatus} · address {snapshot.AccountAddress.Value} · {snapshot.CurrentBusinessObjectIds.Count} BO(s) · {snapshot.ProcessedTriggerCount} trigger(s) · {snapshot.FailedActionCount} failed",
                            IsSelected = SnapshotNodeId(snapshot) == SelectedId || snapshot.SnapshotId == SelectedId,
                            DataTestId = $"simulation-run-account-node-{snapshot.AccountRole}"
                        }))
                    .ToArray();

                return new TreeViewNode
                {
                    Id = businessUnit.BusinessUnitId.Value,
                    Text = businessUnit.DisplayName,
                    Icon = businessUnit.Kind == BusinessUnitKind.RevenueCenter ? "trending_up" : businessUnit.Kind == BusinessUnitKind.CostCenter ? "payments" : "business",
                    BadgeText = businessUnit.Kind.ToString(),
                    Tooltip = $"{businessUnit.DisplayName} · {businessUnit.Kind} · {businessUnit.Path} · {businessUnit.Status} · {businessUnit.CurrencyCode ?? "project currency"}",
                    Children = children,
                    IsExpanded = expandedNodeIds.Contains(businessUnit.BusinessUnitId.Value),
                    IsSelected = businessUnit.BusinessUnitId.Value == SelectedId,
                    DataTestId = $"simulation-run-bu-node-{businessUnit.Path}"
                };
            })
            .ToArray();

    private Task SelectNode(string nodeId)
    {
        selectedNodeId = nodeId;
        EnsureSelectedAncestryExpanded();
        return Task.CompletedTask;
    }

    private Task ToggleNode(string nodeId)
    {
        if (!expandedNodeIds.Add(nodeId))
        {
            expandedNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private static string SnapshotNodeId(SimulationBusinessUnitAccountSnapshot snapshot)
        => $"snapshot:{snapshot.SnapshotId}";

    private void EnsureSelectedAncestryExpanded()
    {
        BusinessUnitId? currentId = SelectedSnapshot?.BusinessUnitId ?? SelectedBusinessUnit?.BusinessUnitId;
        while (currentId is not null)
        {
            expandedNodeIds.Add(currentId.Value.Value);
            currentId = Project.BusinessUnits.FirstOrDefault(unit => unit.BusinessUnitId == currentId.Value)?.ParentBusinessUnitId;
        }
    }

    private string Money(Amount amount)
        => amount.Value.ToString($"{Project.Model.BaseCurrencyCode} #,0;{Project.Model.BaseCurrencyCode} (#,0)", CultureInfo.InvariantCulture);

    private static string Short(string value)
        => value.Length <= 28 ? value : $"{value[..12]}...{value[^10..]}";

    private static string StatusTone(BusinessUnitAddressBindingStatus status)
        => status == BusinessUnitAddressBindingStatus.Active ? "success" : "warning";

    private static string StatusTone(string status)
        => status.Equals("Completed", StringComparison.OrdinalIgnoreCase) || status.Equals("Executed", StringComparison.OrdinalIgnoreCase)
            ? "success"
            : status.Equals("Warning", StringComparison.OrdinalIgnoreCase) || status.Equals("Skipped", StringComparison.OrdinalIgnoreCase)
                ? "warning"
                : status.Equals("Failed", StringComparison.OrdinalIgnoreCase) || status.Equals("Error", StringComparison.OrdinalIgnoreCase)
                    ? "danger"
                    : "info";
}
