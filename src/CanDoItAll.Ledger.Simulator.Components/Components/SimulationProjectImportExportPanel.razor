@namespace CanDoItAll.Ledger.Simulator.Components.Components
@using System.Globalization

<Stack GapScale="LayoutGap.Medium" data-testid="simulation-import-export-tab">
    <Split Breakpoint="LayoutBreakpoint.Md"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Gap="LayoutGap.Medium"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.H4" Value="Project transfer" />
            <SmallText Text="Export the selected project or validate an incoming JSON manifest before it changes the workspace." />
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            <StatusBadge Text="@EffectiveManifest.SchemaVersion" Tone="info" />
            <a class="inline-flex min-h-9 items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50"
               href="@DownloadHref"
               download="@DownloadFileName"
               data-testid="simulation-download-manifest">
                <span class="rz-icon cda-material-icon material-icons text-[1.1rem]" aria-hidden="true">download</span>
                Download JSON
            </a>
        </Cluster>
    </Split>

    <CompactStatStrip>
        <CompactStat Label="Project" Value="@EffectiveManifest.ProjectId" TooltipText="Manifest project identifier" Position="TooltipPosition.Right" />
        <CompactStat Label="Exported" Value="@EffectiveManifest.ExportedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)" TooltipText="UTC export timestamp" Position="TooltipPosition.Right" />
        <CompactStat Label="Sections" Value="@EffectiveManifest.ContentHashes.Count.ToString(CultureInfo.InvariantCulture)" TooltipText="Deterministically hashed manifest sections" Position="TooltipPosition.Right" />
        <CompactStat Label="Import" Value="@ImportStatus" Tone="@ImportStatusTone" TooltipText="Paste JSON and validate it before accepting" Position="TooltipPosition.Right" />
    </CompactStatStrip>

    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
        <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="export-manifest-title">
            <Stack GapScale="LayoutGap.Medium">
                <div>
                    <TextBlock TextStyle="TextStyle.Subtitle1" Value="Export manifest" id="export-manifest-title" />
                    <SmallText Text="Canonical JSON for the currently selected project." />
                </div>
                <TextArea Value="@ManifestJson" ReadOnly="true" Rows="10" aria-label="Export manifest JSON" />
                <details class="rounded-md border border-slate-200 bg-slate-50 p-3">
                    <summary class="cursor-pointer text-sm font-semibold text-slate-800">Content hashes (@HashRows.Count)</summary>
                    <div class="mt-3">
                        <DataGrid TItem="KeyValuePair<string, string>" Data="HashRows">
                            <DataGridColumn TItem="KeyValuePair<string, string>" Property="Key" Title="Section" />
                            <DataGridColumn TItem="KeyValuePair<string, string>" Title="Hash">
                                <Template Context="hash">
                                    <TooltipTarget Text="@hash.Value" Position="TooltipPosition.Right" TabIndex="0">
                                        <MonoText Text="@Short(hash.Value)" />
                                    </TooltipTarget>
                                </Template>
                            </DataGridColumn>
                        </DataGrid>
                    </div>
                </details>
            </Stack>
        </section>

        <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="import-manifest-title">
            <Stack GapScale="LayoutGap.Medium">
                <div>
                    <TextBlock TextStyle="TextStyle.Subtitle1" Value="Import manifest" id="import-manifest-title" />
                    <SmallText Text="Paste project JSON. Acceptance stays disabled until validation succeeds." />
                </div>
                <TextArea Value="@importJson"
                          ValueChanged="@(value => OnImportJsonChanged(value ?? string.Empty))"
                          Immediate="true"
                          Rows="10"
                          Placeholder="Paste a simulation project manifest..."
                          aria-label="Incoming project manifest JSON" />
                <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                    <Button Text="Validate"
                            Icon="rule"
                            ButtonStyle="ButtonStyle.Secondary"
                            Variant="Variant.Outlined"
                            Size="ButtonSize.Small"
                            Disabled="@string.IsNullOrWhiteSpace(importJson)"
                            Click="@ValidateImport"
                            data-testid="simulation-validate-import" />
                    <Button Text="Accept import"
                            Icon="check_circle"
                            Size="ButtonSize.Small"
                            Disabled="@(!CanAcceptImport)"
                            Click="@AcceptImportAsync"
                            data-testid="simulation-accept-import" />
                </Cluster>

                @if (validatedImport is not null)
                {
                    <Alert AlertStyle="@(validatedImport.CanImport ? AlertStyle.Success : AlertStyle.Warning)">
                        <strong>@(validatedImport.CanImport ? "Ready to import" : "Import blocked")</strong>
                        <span>@ImportSummary</span>
                    </Alert>
                    @if (validatedImport.Manifest is not null)
                    {
                        <CompactStatStrip>
                            <CompactStat Label="Incoming project" Value="@validatedImport.Manifest.ProjectId" />
                            <CompactStat Label="Warnings" Value="@validatedImport.Warnings.Count.ToString(CultureInfo.InvariantCulture)" />
                            <CompactStat Label="Messages" Value="@validatedImport.Validation.Messages.Count.ToString(CultureInfo.InvariantCulture)" />
                        </CompactStatStrip>
                    }
                    <ValidationList Messages="validatedImport.Validation.Messages" />
                }
            </Stack>
        </section>
    </Grid>
</Stack>

@code {
    private string renderedProjectId = string.Empty;
    private string importJson = string.Empty;
    private SimulationProjectExportManifest? effectiveManifest;
    private SimulationProjectImportPreview? validatedImport;
    private bool importAccepted;

    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    [Parameter, EditorRequired]
    public SimulationProjectExportManifest Manifest { get; set; } = default!;

    [Parameter, EditorRequired]
    public SimulationProjectImportPreview ImportPreview { get; set; } = default!;

    [Parameter, EditorRequired]
    public ISimulationProjectImportExportService ImportExportService { get; set; } = default!;

    [Parameter]
    public EventCallback<SimulationProjectState> ProjectImported { get; set; }

    private SimulationProjectExportManifest EffectiveManifest => effectiveManifest ?? Manifest;

    private string ManifestJson => ImportExportService.SerializeManifest(EffectiveManifest);

    private string DownloadHref => $"data:application/json;charset=utf-8,{Uri.EscapeDataString(ManifestJson)}";

    private string DownloadFileName => $"{EffectiveManifest.ProjectId}-manifest.json";

    private IReadOnlyList<KeyValuePair<string, string>> HashRows => EffectiveManifest.ContentHashes
        .OrderBy(x => x.Key, StringComparer.Ordinal)
        .ToArray();

    private bool CanAcceptImport => validatedImport?.CanImport == true && validatedImport.Manifest is not null && !importAccepted;

    private string ImportStatus => importAccepted
        ? "Accepted"
        : validatedImport is null
            ? "Waiting"
            : validatedImport.CanImport
                ? "Ready"
                : "Blocked";

    private string ImportStatusTone => importAccepted || validatedImport?.CanImport == true
        ? "success"
        : validatedImport is null
            ? "muted"
            : "warning";

    private string ImportSummary => validatedImport?.Validation.Messages.Count == 0
        ? "No validation messages were reported for this manifest."
        : $"{validatedImport?.Validation.Messages.Count ?? 0} validation message(s) were reported.";

    protected override void OnParametersSet()
    {
        DateTimeOffset exportedAtUtc = string.Equals(Manifest.ProjectId, Project.Summary.ProjectId, StringComparison.Ordinal)
            ? Manifest.ExportedAtUtc
            : Project.Summary.UpdatedAtUtc;
        effectiveManifest = ImportExportService.CreateManifest(Project, exportedAtUtc);

        if (string.Equals(renderedProjectId, Project.Summary.ProjectId, StringComparison.Ordinal))
        {
            return;
        }

        renderedProjectId = Project.Summary.ProjectId;
        importJson = string.Empty;
        validatedImport = null;
        importAccepted = false;
    }

    private void OnImportJsonChanged(string value)
    {
        importJson = value;
        validatedImport = null;
        importAccepted = false;
    }

    private void ValidateImport()
    {
        validatedImport = ImportExportService.PreviewImport(importJson);
        importAccepted = false;
    }

    private async Task AcceptImportAsync()
    {
        if (!CanAcceptImport || validatedImport?.Manifest is null)
        {
            return;
        }

        await ProjectImported.InvokeAsync(validatedImport.Manifest.Project);
        importAccepted = true;
    }

    private static string Short(string value)
        => value.Length <= 30 ? value : $"{value[..14]}...{value[^12..]}";
}
