@namespace CanDoItAll.Ledger.Simulator.Components.Components
@using System.Globalization

<ListDetailShell Dense="true"
                 ListPaneWidth="17rem"
                 ListPaneClass="min-h-[28rem]"
                 DetailPaneClass="min-h-[28rem]"
                 data-testid="simulation-planned-financial-schedules-tab">
    <ListHeader>
        <ListPanelHeader Title="Financial schedules"
                         Count="@ScheduleCountText"
                         HelpText="Revenue, funding, payroll, expense, CapEx, reserve, and custom schedules are grouped by BU. Use the queue for approval-gated outflows."
                         Dense="true" />
    </ListHeader>
    <ListContent>
        <Stack GapScale="LayoutGap.Small" Class="w-full min-w-0">
            <TextBox Value="@scheduleSearch"
                     ValueChanged="@(value => scheduleSearch = value ?? string.Empty)"
                     Immediate="true"
                     Placeholder="Search schedules..."
                     aria-label="Search financial schedules" />
            <Cluster Gap="LayoutGap.Small">
                <StatusBadge Text="@ApprovalCountText" Tone="info" />
                @if (invalidScheduleCount > 0)
                {
                    <StatusBadge Text="@($"{invalidScheduleCount} invalid")" Tone="danger" />
                }
            </Cluster>
            @if (FilteredSchedules.Count == 0)
            {
                <Alert AlertStyle="AlertStyle.Info">
                    <strong>No matching schedules</strong>
                    <span>Clear the search or choose another project.</span>
                </Alert>
            }
            else
            {
                <div class="max-h-[36rem] min-h-0 w-full min-w-0 overflow-y-auto pr-1">
                    <TreeView Items="ScheduleNodes"
                              Style="TreeViewStyle.Workbench"
                              AriaLabel="Financial schedule hierarchy"
                              OnSelect="SelectNode"
                              OnToggle="ToggleNode" />
                </div>
            }
        </Stack>
    </ListContent>
    <DetailHeader>
        @if (SelectedSchedule is not null)
        {
            <Split Breakpoint="LayoutBreakpoint.Md"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Gap="LayoutGap.Medium"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.H4" Value="@SelectedSchedule.DisplayName" />
                    <SmallText Text="@BusinessUnitName(SelectedSchedule.BusinessUnitId)" />
                </Stack>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Text="@SelectedSchedule.Kind.ToString()" Tone="muted" />
                    <StatusBadge Text="@ApprovalText(SelectedSchedule)" Tone="@ApprovalTone(ApprovalText(SelectedSchedule))" />
                    <StatusBadge Text="@($"{Project.Model.BaseCurrencyCode} {FormatAmount(ScheduleTotal(SelectedSchedule))}")" Tone="info" />
                </Cluster>
            </Split>
        }
    </DetailHeader>
    <DetailContent>
        <Tabs Variant="TabsVariant.WorkspaceTertiary"
              OverflowMode="TabsOverflowMode.Scroll"
              RenderMode="TabRenderMode.Client"
              SelectedIndex="@selectedScheduleViewIndex"
              SelectedIndexChanged="@(index => selectedScheduleViewIndex = index)"
              AriaLabel="Financial schedule workspace">
            <TabsItem Text="Schedule" Icon="event_note">
                @if (SelectedSchedule is not null)
                {
                    <Stack GapScale="LayoutGap.Medium">
                        <CompactStatStrip>
                            <CompactStat Label="Business unit" Value="@BusinessUnitName(SelectedSchedule.BusinessUnitId)" Position="TooltipPosition.Right" />
                            <CompactStat Label="Kind" Value="@SelectedSchedule.Kind.ToString()" Position="TooltipPosition.Right" />
                            <CompactStat Label="Section" Value="@SelectedSchedule.Section.ToString()" Position="TooltipPosition.Right" />
                            <CompactStat Label="Periods" Value="@SelectedSchedule.Amounts.Count.ToString(CultureInfo.InvariantCulture)" Position="TooltipPosition.Right" />
                            <CompactStat Label="Approval" Value="@ApprovalText(SelectedSchedule)" Position="TooltipPosition.Right" Tone="info" />
                            <CompactStat Label="Total" Value="@($"{Project.Model.BaseCurrencyCode} {FormatAmount(ScheduleTotal(SelectedSchedule))}")" Position="TooltipPosition.Right" />
                        </CompactStatStrip>

                        <TooltipTarget Position="TooltipPosition.Right" TriggerClass="min-w-0" TabIndex="0">
                            <ChildContent>
                                <div class="flex min-w-0 items-center gap-2 rounded-md border border-slate-200 bg-slate-50 px-3 py-2">
                                    <span class="text-[0.68rem] font-semibold uppercase tracking-[0.13em] text-slate-500">Details</span>
                                    <MonoText Text="@SelectedSchedule.ScheduleId" />
                                </div>
                            </ChildContent>
                            <TooltipContent>
                                <Stack GapScale="LayoutGap.Tiny">
                                    <TextBlock TextStyle="TextStyle.Subtitle2" Value="@SelectedSchedule.DisplayName" />
                                    <SmallText Text="@($"ID: {SelectedSchedule.ScheduleId}")" />
                                    <SmallText Text="@($"Source: {PlanSourceText(SelectedSchedule)}")" />
                                    <SmallText Text="@($"Approval: {ApprovalText(SelectedSchedule)}")" />
                                </Stack>
                            </TooltipContent>
                        </TooltipTarget>

                        <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-3" aria-labelledby="scheduled-amounts-title">
                            <Stack GapScale="LayoutGap.Small">
                                <TextBlock TextStyle="TextStyle.Subtitle1" Value="Scheduled amounts" id="scheduled-amounts-title" />
                                <DataGrid TItem="ScenarioFinancialScheduleAmountState" Data="SelectedSchedule.Amounts" AllowPaging="true" PageSize="10">
                                    <DataGridColumn TItem="ScenarioFinancialScheduleAmountState" Title="Month">
                                        <Template Context="amount">
                                            <SmallText Text="@amount.EconomicDate.ToString("yyyy-MM", CultureInfo.InvariantCulture)" />
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="ScenarioFinancialScheduleAmountState" Title="Amount">
                                        <Template Context="amount">
                                            <TextBlock Value="@($"{Project.Model.BaseCurrencyCode} {FormatAmount(amount.Amount.Value)}")" />
                                        </Template>
                                    </DataGridColumn>
                                </DataGrid>
                            </Stack>
                        </section>
                    </Stack>
                }
            </TabsItem>
            <TabsItem Text="Approval queue" Icon="approval" BadgeText="@FilteredTimelineRows.Count.ToString(CultureInfo.InvariantCulture)">
                <Stack GapScale="LayoutGap.Medium">
                    <Grid ColumnTemplate="repeat(auto-fit, minmax(10rem, 1fr))" Gap="LayoutGap.Small">
                        <TextBox Value="@queueSearch"
                                 ValueChanged="@(value => queueSearch = value ?? string.Empty)"
                                 Immediate="true"
                                 Placeholder="Search queue..."
                                 aria-label="Search approval queue" />
                        <DropDown TValue="string"
                                  Data="QueueBusinessUnitOptions"
                                  TextProperty="Text"
                                  ValueProperty="Value"
                                  Placeholder="All business units"
                                  AllowClear="true"
                                  Value="@selectedQueueBusinessUnit"
                                  ValueChanged="@(value => selectedQueueBusinessUnit = value)"
                                  aria-label="Filter queue by business unit" />
                        <DropDown TValue="string"
                                  Data="QueueApprovalOptions"
                                  Placeholder="All approval states"
                                  AllowClear="true"
                                  Value="@selectedQueueApproval"
                                  ValueChanged="@(value => selectedQueueApproval = value)"
                                  aria-label="Filter queue by approval state" />
                        <label class="min-w-0 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                            From
                            <input type="date"
                                   class="mt-1 min-h-9 w-full min-w-0 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm font-normal normal-case tracking-normal text-slate-900"
                                   min="@FormatDate(Project.Summary.PlanningStartDate)"
                                   max="@FormatDate(Project.Summary.PlanningEndDate)"
                                   value="@queueFromDate"
                                   @onchange="OnQueueFromChanged" />
                        </label>
                        <label class="min-w-0 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                            To
                            <input type="date"
                                   class="mt-1 min-h-9 w-full min-w-0 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm font-normal normal-case tracking-normal text-slate-900"
                                   min="@FormatDate(Project.Summary.PlanningStartDate)"
                                   max="@FormatDate(Project.Summary.PlanningEndDate)"
                                   value="@queueToDate"
                                   @onchange="OnQueueToChanged" />
                        </label>
                    </Grid>

                    @if (QueueDateRangeError is { } queueDateRangeError)
                    {
                        <Alert AlertStyle="AlertStyle.Warning">
                            <strong>Check date range</strong>
                            <span>@queueDateRangeError</span>
                        </Alert>
                    }

                    <CompactStatStrip>
                        <CompactStat Label="Periods" Value="@FilteredTimelineRows.Count.ToString(CultureInfo.InvariantCulture)" />
                        <CompactStat Label="Total" Value="@($"{Project.Model.BaseCurrencyCode} {FormatAmount(FilteredTimelineRows.Sum(row => row.Amount))}")" Tone="info" />
                    </CompactStatStrip>

                    <DataGrid TItem="FinancialScheduleTimelineRow" Data="FilteredTimelineRows" AllowPaging="true" PageSize="10" data-testid="simulation-planned-expense-timeline">
                    <DataGridColumn TItem="FinancialScheduleTimelineRow" Title="Date">
                        <Template Context="row">
                            <SmallText Text="@row.Date.ToString("yyyy-MM", CultureInfo.InvariantCulture)" />
                        </Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="FinancialScheduleTimelineRow" Property="BusinessUnit" Title="BU" />
                    <DataGridColumn TItem="FinancialScheduleTimelineRow" Title="Schedule">
                        <Template Context="row">
                            <Button Text="@row.Schedule"
                                    ButtonStyle="ButtonStyle.Info"
                                    Variant="Variant.Text"
                                    Size="ButtonSize.Small"
                                    Click="@(() => SelectSchedule(row.ScheduleId))"
                                    data-testid="@($"simulation-planned-expense-row-{row.ScheduleId}")" />
                        </Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="FinancialScheduleTimelineRow" Title="Amount">
                        <Template Context="row">
                            <TextBlock Value="@($"{Project.Model.BaseCurrencyCode} {FormatAmount(row.Amount)}")" />
                        </Template>
                    </DataGridColumn>
                    <DataGridColumn TItem="FinancialScheduleTimelineRow" Title="Approval">
                        <Template Context="row">
                            <TooltipTarget Text="@($"{row.ApprovalStatus} · scope {row.ApprovalScope}")" Position="TooltipPosition.Right" TabIndex="0">
                                <StatusBadge Text="@TimelineApprovalLabel(row.ApprovalStatus)" Tone="@ApprovalTone(row.ApprovalStatus)" />
                            </TooltipTarget>
                        </Template>
                    </DataGridColumn>
                    </DataGrid>
                </Stack>
            </TabsItem>
        </Tabs>
    </DetailContent>
</ListDetailShell>

@code {
    private static readonly ILedgerSimulatorJsonSerializer Serializer = new LedgerSimulatorJsonSerializer();
    private readonly HashSet<string> expandedNodeIds = new(StringComparer.Ordinal);
    private IReadOnlyList<ScenarioFinancialScheduleState> schedules = [];
    private string? selectedNodeId;
    private string renderedProjectKey = string.Empty;
    private string scheduleSearch = string.Empty;
    private string queueSearch = string.Empty;
    private string? selectedQueueBusinessUnit;
    private string? selectedQueueApproval;
    private string queueFromDate = string.Empty;
    private string queueToDate = string.Empty;
    private int invalidScheduleCount;
    private int selectedScheduleViewIndex;

    [Parameter]
    public SimulationProjectState Project { get; set; } = default!;

    private IReadOnlyList<ScenarioFinancialScheduleState> Schedules => schedules;

    private IReadOnlyList<ScenarioFinancialScheduleState> FilteredSchedules => string.IsNullOrWhiteSpace(scheduleSearch)
        ? Schedules
        : Schedules.Where(schedule => schedule.DisplayName.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase)
            || schedule.ScheduleId.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase)
            || schedule.Kind.ToString().Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase)
            || BusinessUnitName(schedule.BusinessUnitId).Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase)
            || schedule.Metadata.Values.Any(value => value.Contains(scheduleSearch, StringComparison.OrdinalIgnoreCase)))
        .ToArray();

    private string ScheduleCountText => FilteredSchedules.Count == Schedules.Count
        ? Schedules.Count.ToString(CultureInfo.InvariantCulture)
        : $"{FilteredSchedules.Count}/{Schedules.Count}";

    private IReadOnlyList<TreeViewNode> ScheduleNodes
        => FilteredSchedules
            .GroupBy(schedule => schedule.BusinessUnitId)
            .OrderBy(group => BusinessUnitName(group.Key), StringComparer.Ordinal)
            .Select(group => new TreeViewNode
            {
                Id = $"bu:{group.Key.Value}",
                Text = BusinessUnitName(group.Key),
                Icon = "account_tree",
                BadgeText = group.Count().ToString(CultureInfo.InvariantCulture),
                Tooltip = $"{BusinessUnitName(group.Key)} · business unit {group.Key.Value} · {group.Count()} scheduled item(s)",
                IsExpanded = !string.IsNullOrWhiteSpace(scheduleSearch) || expandedNodeIds.Contains($"bu:{group.Key.Value}"),
                Children = group
                    .GroupBy(schedule => schedule.Metadata.GetValueOrDefault("uiGroup", "schedule"), StringComparer.Ordinal)
                    .OrderBy(scheduleGroup => scheduleGroup.Key, StringComparer.Ordinal)
                    .Select(scheduleGroup => new TreeViewNode
                    {
                        Id = $"group:{group.Key.Value}:{scheduleGroup.Key}",
                        Text = CultureInfo.InvariantCulture.TextInfo.ToTitleCase(scheduleGroup.Key.Replace('-', ' ')),
                        Icon = GroupIcon(scheduleGroup.Key),
                        BadgeText = scheduleGroup.Count().ToString(CultureInfo.InvariantCulture),
                        Tooltip = $"{CultureInfo.InvariantCulture.TextInfo.ToTitleCase(scheduleGroup.Key.Replace('-', ' '))} · {BusinessUnitName(group.Key)} · {scheduleGroup.Count()} scheduled item(s)",
                        IsExpanded = !string.IsNullOrWhiteSpace(scheduleSearch) || expandedNodeIds.Contains($"group:{group.Key.Value}:{scheduleGroup.Key}"),
                        Children = scheduleGroup
                            .OrderBy(schedule => schedule.DisplayName, StringComparer.Ordinal)
                            .Select(schedule => new TreeViewNode
                            {
                                Id = schedule.ScheduleId,
                                Text = schedule.DisplayName,
                                Icon = ScheduleIcon(schedule),
                                BadgeText = schedule.RequiresApproval ? ApprovalText(schedule) : schedule.Kind.ToString(),
                                Tooltip = ScheduleTooltip(schedule),
                                IsSelected = schedule.ScheduleId == SelectedId,
                                DataTestId = $"simulation-financial-schedule-node-{schedule.ScheduleId}"
                            })
                            .ToArray()
                    })
                    .ToArray()
            })
            .ToArray();

    private string SelectedId => selectedNodeId
        ?? Schedules.FirstOrDefault(schedule => schedule.RequiresApproval)?.ScheduleId
        ?? Schedules.FirstOrDefault()?.ScheduleId
        ?? string.Empty;

    private ScenarioFinancialScheduleState? SelectedSchedule => Schedules.FirstOrDefault(schedule => schedule.ScheduleId == SelectedId);

    private IReadOnlyList<FinancialScheduleTimelineRow> TimelineRows
        => Schedules
            .Where(schedule => schedule.PostsToSimulation)
            .Where(IsTimelineSchedule)
            .SelectMany(schedule => schedule.Amounts.Select(amount => new FinancialScheduleTimelineRow(
                amount.EconomicDate,
                schedule.BusinessUnitId.Value,
                BusinessUnitName(schedule.BusinessUnitId),
                schedule.DisplayName,
                amount.Amount.Value,
                schedule.Kind.ToString(),
                ApprovalText(schedule),
                schedule.Approval?.RequiredScope.ToString() ?? "None",
                PeriodCodeFor(amount),
                schedule.ScheduleId)))
            .OrderBy(row => row.Date)
            .ThenBy(row => row.BusinessUnit, StringComparer.Ordinal)
            .ThenBy(row => row.Schedule, StringComparer.Ordinal)
            .ToArray();

    private IReadOnlyList<FinancialScheduleTimelineRow> FilteredTimelineRows => TimelineRows
        .Where(row => string.IsNullOrWhiteSpace(queueSearch)
            || row.Schedule.Contains(queueSearch, StringComparison.OrdinalIgnoreCase)
            || row.BusinessUnit.Contains(queueSearch, StringComparison.OrdinalIgnoreCase)
            || row.Kind.Contains(queueSearch, StringComparison.OrdinalIgnoreCase))
        .Where(row => string.IsNullOrWhiteSpace(selectedQueueBusinessUnit)
            || string.Equals(row.BusinessUnitId, selectedQueueBusinessUnit, StringComparison.Ordinal))
        .Where(row => string.IsNullOrWhiteSpace(selectedQueueApproval)
            || string.Equals(row.ApprovalStatus, selectedQueueApproval, StringComparison.Ordinal))
        .Where(row => !TryParseDate(queueFromDate, out DateOnly fromDate) || row.Date >= fromDate)
        .Where(row => !TryParseDate(queueToDate, out DateOnly toDate) || row.Date <= toDate)
        .ToArray();

    private IReadOnlyList<QueueBusinessUnitOption> QueueBusinessUnitOptions => TimelineRows
        .GroupBy(row => row.BusinessUnitId, StringComparer.Ordinal)
        .Select(group => new QueueBusinessUnitOption(group.Key, group.First().BusinessUnit))
        .OrderBy(option => option.Text, StringComparer.Ordinal)
        .ToArray();

    private string? QueueDateRangeError => TryParseDate(queueFromDate, out DateOnly fromDate)
        && TryParseDate(queueToDate, out DateOnly toDate)
        && fromDate > toDate
            ? "The From date must be on or before the To date."
            : null;

    private IReadOnlyList<string> QueueApprovalOptions => TimelineRows
        .Select(row => row.ApprovalStatus)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal)
        .ToArray();

    private string ApprovalCountText => $"{Schedules.Count(schedule => schedule.RequiresApproval).ToString(CultureInfo.InvariantCulture)} gated";

    protected override void OnParametersSet()
    {
        string projectKey = $"{Project.Summary.ProjectId}:{Project.Summary.UpdatedAtUtc.UtcTicks}";
        if (string.Equals(renderedProjectKey, projectKey, StringComparison.Ordinal))
        {
            return;
        }

        renderedProjectKey = projectKey;
        LoadSchedules();
        expandedNodeIds.Clear();
        selectedNodeId = Schedules.FirstOrDefault(schedule => schedule.RequiresApproval)?.ScheduleId
            ?? Schedules.FirstOrDefault()?.ScheduleId;
        RevealSelectedSchedule();
        scheduleSearch = string.Empty;
        queueSearch = string.Empty;
        selectedQueueBusinessUnit = null;
        selectedQueueApproval = null;
        queueFromDate = string.Empty;
        queueToDate = string.Empty;
        selectedScheduleViewIndex = 0;
    }

    private Task SelectNode(string nodeId)
    {
        if (Schedules.Any(schedule => schedule.ScheduleId == nodeId))
        {
            selectedNodeId = nodeId;
            RevealSelectedSchedule();
        }
        else if (!expandedNodeIds.Add(nodeId))
        {
            expandedNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private void SelectSchedule(string scheduleId)
    {
        if (Schedules.Any(schedule => string.Equals(schedule.ScheduleId, scheduleId, StringComparison.Ordinal)))
        {
            selectedNodeId = scheduleId;
            RevealSelectedSchedule();
            selectedScheduleViewIndex = 0;
        }
    }

    private Task ToggleNode(string nodeId)
    {
        if (!expandedNodeIds.Add(nodeId))
        {
            expandedNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private void LoadSchedules()
    {
        List<ScenarioFinancialScheduleState> loaded = [];
        invalidScheduleCount = 0;
        foreach (SimulationBusinessObjectDefinitionState definition in Project.BusinessObjectDefinitions
                     .Where(definition => definition.ObjectType == LedgerSimulatorObjectTypes.PlannedFinancialSchedule))
        {
            ScenarioFinancialScheduleState? schedule = TryDeserialize(definition.StateJson);
            if (schedule is null)
            {
                invalidScheduleCount++;
                continue;
            }

            loaded.Add(schedule);
        }

        schedules = loaded
            .OrderBy(schedule => BusinessUnitName(schedule.BusinessUnitId), StringComparer.Ordinal)
            .ThenBy(schedule => schedule.Metadata.GetValueOrDefault("uiGroup"), StringComparer.Ordinal)
            .ThenBy(schedule => schedule.DisplayName, StringComparer.Ordinal)
            .ToArray();
    }

    private void RevealSelectedSchedule()
    {
        if (SelectedSchedule is null)
        {
            return;
        }

        string group = SelectedSchedule.Metadata.GetValueOrDefault("uiGroup", "schedule");
        expandedNodeIds.Add($"bu:{SelectedSchedule.BusinessUnitId.Value}");
        expandedNodeIds.Add($"group:{SelectedSchedule.BusinessUnitId.Value}:{group}");
    }

    private void OnQueueFromChanged(ChangeEventArgs args)
        => queueFromDate = Convert.ToString(args.Value, CultureInfo.InvariantCulture) ?? string.Empty;

    private void OnQueueToChanged(ChangeEventArgs args)
        => queueToDate = Convert.ToString(args.Value, CultureInfo.InvariantCulture) ?? string.Empty;

    private static bool TryParseDate(string value, out DateOnly date)
        => DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out date);

    private static ScenarioFinancialScheduleState? TryDeserialize(string json)
    {
        try
        {
            return Serializer.Deserialize<ScenarioFinancialScheduleState>(json);
        }
        catch
        {
            return null;
        }
    }

    private BusinessUnitState? BusinessUnit(BusinessUnitId id)
        => Project.BusinessUnits.FirstOrDefault(unit => unit.BusinessUnitId == id);

    private string BusinessUnitName(BusinessUnitId id)
        => BusinessUnit(id)?.DisplayName ?? id.Value;

    private static bool IsTimelineSchedule(ScenarioFinancialScheduleState schedule)
        => schedule.RequiresApproval &&
            schedule.Kind is ScenarioFinancialScheduleKind.Expense
                or ScenarioFinancialScheduleKind.Capex
                or ScenarioFinancialScheduleKind.Reserve;

    private static decimal ScheduleTotal(ScenarioFinancialScheduleState schedule)
        => schedule.Amounts.Sum(amount => amount.Amount.Value);

    private string ScheduleTooltip(ScenarioFinancialScheduleState schedule)
        => $"{schedule.DisplayName} · {schedule.ScheduleId} · BU {BusinessUnitName(schedule.BusinessUnitId)} · {schedule.Kind} · {schedule.Section} · approval {ApprovalText(schedule)} · source {PlanSourceText(schedule)} · total {FormatAmount(ScheduleTotal(schedule))} {Project.Model.BaseCurrencyCode}";

    private string PlanSourceText(ScenarioFinancialScheduleState schedule)
    {
        string source = schedule.Metadata.GetValueOrDefault("assemblySource", "simulator assembly");
        string section = schedule.Metadata.GetValueOrDefault("planSection", schedule.Metadata.GetValueOrDefault("uiGroup", "schedule"));
        return $"{source} / {section}";
    }

    private static string PeriodCodeFor(ScenarioFinancialScheduleAmountState amount)
        => string.IsNullOrWhiteSpace(amount.PeriodCode)
            ? amount.EconomicDate.ToString("yyyy-MM", CultureInfo.InvariantCulture)
            : amount.PeriodCode;

    private static string ApprovalText(ScenarioFinancialScheduleState schedule)
        => schedule.Approval?.Status.ToString() ?? (schedule.RequiresApproval ? "Requested" : "NotRequired");

    private static string ApprovalTone(string approval)
        => approval switch
        {
            nameof(ScenarioApprovalStatus.ManagementApproved) => "success",
            nameof(ScenarioApprovalStatus.BusinessUnitApproved) => "info",
            nameof(ScenarioApprovalStatus.Requested) => "warning",
            nameof(ScenarioApprovalStatus.Rejected) => "danger",
            _ => "muted"
        };

    private static string TimelineApprovalLabel(string approval)
        => approval switch
        {
            nameof(ScenarioApprovalStatus.ManagementApproved) => "Mgmt",
            nameof(ScenarioApprovalStatus.BusinessUnitApproved) => "BU",
            nameof(ScenarioApprovalStatus.NotRequired) => "None",
            nameof(ScenarioApprovalStatus.Requested) => "Req",
            _ => approval
        };

    private static string FormatAmount(decimal amount)
        => amount.ToString("#,0.##", CultureInfo.InvariantCulture);

    private static string FormatDate(DateOnly date)
        => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string GroupIcon(string group)
        => group switch
        {
            "marketing" => "campaign",
            "material" => "precision_manufacturing",
            "equipment" => "devices",
            "travel" => "travel_explore",
            "payroll" => "groups",
            _ => "folder"
        };

    private static string ScheduleIcon(ScenarioFinancialScheduleState schedule)
        => schedule.Kind switch
        {
            ScenarioFinancialScheduleKind.Capex => "account_balance",
            ScenarioFinancialScheduleKind.Payroll => "badge",
            ScenarioFinancialScheduleKind.Funding => "savings",
            ScenarioFinancialScheduleKind.Revenue => "trending_up",
            _ => schedule.RequiresApproval ? "approval" : "event_note"
        };

    private sealed record FinancialScheduleTimelineRow(
        DateOnly Date,
        string BusinessUnitId,
        string BusinessUnit,
        string Schedule,
        decimal Amount,
        string Kind,
        string ApprovalStatus,
        string ApprovalScope,
        string PeriodCode,
        string ScheduleId);

    private sealed record QueueBusinessUnitOption(string Value, string Text);
}
