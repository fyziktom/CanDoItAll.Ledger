@namespace CanDoItAll.Ledger.Simulator.Components.Components
@using System.Globalization

<Stack GapScale="LayoutGap.Medium" data-testid="simulation-definition-settings-panel">
    @if (RuleProcess is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Process" Value="@RuleProcess.ProcessCode" HelperText="@RuleProcess.FinanceControlPurpose" Position="TooltipPosition.Right" />
            <CompactStat Label="Rule" Value="@RuleProcess.RuleId" Position="TooltipPosition.Right" />
            <CompactStat Label="Kind" Value="@RuleProcess.Kind.ToString()" />
            <CompactStat Label="Trigger BO" Value="@RuleProcess.TriggerObjectType" Position="TooltipPosition.Right" />
        </CompactStatStrip>
    }

    @if (Definition.RuleDefinition is not null)
    {
        <AccountRuleLogicPreview Rule="Definition.RuleDefinition"
                                 ValidationErrors="RuleValidationErrors"
                                 Compact="true" />
    }
    else if (PlannedSchedule is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Business unit" Value="@OwnerName(PlannedSchedule.BusinessUnitId)" Position="TooltipPosition.Right" />
            <CompactStat Label="Kind" Value="@PlannedSchedule.Kind.ToString()" />
            <CompactStat Label="Approval" Value="@ApprovalText" Tone="info" />
            <CompactStat Label="Total" Value="@FormatAmount(PlannedSchedule.Amounts.Sum(amount => amount.Amount.Value))" />
            <CompactStat Label="First month" Value="@FormatDate(PlannedSchedule.Amounts.MinBy(amount => amount.EconomicDate)?.EconomicDate)" />
            <CompactStat Label="Last month" Value="@FormatDate(PlannedSchedule.Amounts.MaxBy(amount => amount.EconomicDate)?.EconomicDate)" />
        </CompactStatStrip>

        <details class="rounded-lg border border-slate-200 bg-white p-3">
            <summary class="cursor-pointer text-sm font-semibold text-slate-900">Scheduled amounts (@PlannedSchedule.Amounts.Count)</summary>
            <div class="mt-3">
            <DataGrid TItem="ScenarioFinancialScheduleAmountState" Data="PlannedSchedule.Amounts" AllowPaging="true" PageSize="6">
                <DataGridColumn TItem="ScenarioFinancialScheduleAmountState" Title="Date">
                    <Template Context="amount">
                        <SmallText Text="@amount.EconomicDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                    </Template>
                </DataGridColumn>
                <DataGridColumn TItem="ScenarioFinancialScheduleAmountState" Title="Amount">
                    <Template Context="amount">
                        <TextBlock Value="@FormatAmount(amount.Amount.Value)" />
                    </Template>
                </DataGridColumn>
                <DataGridColumn TItem="ScenarioFinancialScheduleAmountState" Property="PeriodCode" Title="Period" />
            </DataGrid>
            </div>
        </details>
    }
    else if (BusinessUnit is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Kind" Value="@BusinessUnit.Kind.ToString()" />
            <CompactStat Label="Path" Value="@BusinessUnit.Path" Position="TooltipPosition.Right" />
            <CompactStat Label="Primary address" Value="@BusinessUnit.PrimaryAddress.Value" Position="TooltipPosition.Right" />
            <CompactStat Label="Cost center" Value="@(BusinessUnit.CostCenterCode ?? "None")" />
            <CompactStat Label="Revenue center" Value="@(BusinessUnit.RevenueCenterCode ?? "None")" />
        </CompactStatStrip>
    }
    else if (RuleAutomationPlan is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Scenario" Value="@RuleAutomationPlan.ScenarioCode" />
            <CompactStat Label="Namespace" Value="@RuleAutomationPlan.RuleNamespace" Position="TooltipPosition.Right" />
            <CompactStat Label="Rules" Value="@RuleAutomationPlan.RuleIds.Count.ToString(CultureInfo.InvariantCulture)" TooltipText="@string.Join(", ", RuleAutomationPlan.RuleIds)" Position="TooltipPosition.Right" />
        </CompactStatStrip>
    }
    else if (Model is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Model" Value="@Model.Name" Position="TooltipPosition.Right" />
            <CompactStat Label="Currency" Value="@Model.BaseCurrencyCode" />
            <CompactStat Label="Calendar" Value="@Model.CalendarCode" />
            <CompactStat Label="Planning start" Value="@Model.PlanningStartDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            <CompactStat Label="Planning end" Value="@Model.PlanningEndDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </CompactStatStrip>
    }
    else if (ScenarioModel is not null)
    {
        <CompactStatStrip>
            <CompactStat Label="Scenario" Value="@ScenarioModel.DisplayName" Position="TooltipPosition.Right" />
            <CompactStat Label="Code" Value="@ScenarioModel.ScenarioCode" />
            <CompactStat Label="Business units" Value="@ScenarioModel.BusinessUnits.Count.ToString(CultureInfo.InvariantCulture)" />
            <CompactStat Label="Products/services" Value="@((ScenarioModel.ProductSkus.Count + ScenarioModel.Offerings.Count).ToString(CultureInfo.InvariantCulture))" />
            <CompactStat Label="Schedules" Value="@ScenarioModel.FinancialSchedules.Count.ToString(CultureInfo.InvariantCulture)" />
        </CompactStatStrip>
    }
    else
    {
        <CompactStatStrip>
            <CompactStat Label="Object type" Value="@Definition.ObjectType" Position="TooltipPosition.Right" />
            <CompactStat Label="Owner" Value="@(Definition.OwnerBusinessUnitId is null ? "Project" : OwnerName(Definition.OwnerBusinessUnitId.Value))" Position="TooltipPosition.Right" />
        </CompactStatStrip>
    }

    <details class="rounded-lg border border-slate-200 bg-white p-3">
        <summary class="cursor-pointer text-sm font-semibold text-slate-900">Payload JSON</summary>
        <div class="mt-3">
            <TextArea Value="@Definition.StateJson" ReadOnly="true" Rows="6" />
        </div>
    </details>
</Stack>

@code {
    private static readonly ILedgerSimulatorJsonSerializer Serializer = new LedgerSimulatorJsonSerializer();

    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    [Parameter, EditorRequired]
    public SimulationBusinessObjectDefinitionState Definition { get; set; } = default!;

    private RuleProcessTemplateState? RuleProcess => TryDeserialize<RuleProcessTemplateState>();

    private ScenarioFinancialScheduleState? PlannedSchedule => Definition.ObjectType == LedgerSimulatorObjectTypes.PlannedFinancialSchedule
        ? TryDeserialize<ScenarioFinancialScheduleState>()
        : null;

    private BusinessUnitState? BusinessUnit => Definition.ObjectType == LedgerSimulatorObjectTypes.BusinessUnit
        ? TryDeserialize<BusinessUnitState>()
        : null;

    private RuleAutomationPlanState? RuleAutomationPlan => Definition.ObjectType == LedgerSimulatorObjectTypes.RuleAutomationPlan
        ? TryDeserialize<RuleAutomationPlanState>()
        : null;

    private LedgerSimulatorModelState? Model => Definition.ObjectType == LedgerSimulatorObjectTypes.ProjectConfiguration
        ? TryDeserialize<LedgerSimulatorModelState>()
        : null;

    private ScenarioBusinessModelState? ScenarioModel => Definition.ObjectType == LedgerSimulatorObjectTypes.Template
        ? TryDeserialize<ScenarioBusinessModelState>()
        : null;

    private string RuleTriggerText => Definition.RuleDefinition?.Trigger is { } trigger
        ? string.IsNullOrWhiteSpace(trigger.ObjectType) ? trigger.Kind.ToString() : $"{trigger.Kind} / {trigger.ObjectType}"
        : "n/a";

    private string ApprovalText => PlannedSchedule?.Approval is { } approval
        ? $"{approval.Status} / {approval.RequiredScope}"
        : "Not required";

    private IReadOnlyList<string> RuleValidationErrors
        => Definition.RuleDefinition is null
            ? []
            : RuleTokenAuthority.TryValidate(Definition.RuleDefinition, out IReadOnlyList<string> errors)
                ? []
                : errors;

    private T? TryDeserialize<T>()
    {
        try
        {
            return Serializer.Deserialize<T>(Definition.StateJson);
        }
        catch
        {
            return default;
        }
    }

    private string OwnerName(BusinessUnitId id)
        => Project.BusinessUnits.FirstOrDefault(unit => unit.BusinessUnitId == id)?.DisplayName ?? id.Value;

    private static string FormatAmount(decimal amount)
        => amount.ToString("#,0.##", CultureInfo.InvariantCulture);

    private static string FormatDate(DateOnly? date)
        => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "n/a";
}
