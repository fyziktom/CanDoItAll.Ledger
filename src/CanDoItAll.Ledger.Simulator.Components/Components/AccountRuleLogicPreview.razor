@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<section class="min-w-0 rounded-lg border border-slate-200 bg-white @(Compact ? "p-3" : "p-4")" aria-label="Rule logic">
    <Stack GapScale="@(Compact ? LayoutGap.Small : LayoutGap.Medium)">
        <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
            <TextBlock TextStyle="TextStyle.Subtitle1" Value="Rule logic" />
            <TooltipTarget Text="@Rule.RuleId" Position="TooltipPosition.Right" TabIndex="0">
                <MonoText Text="@Rule.RuleId" />
            </TooltipTarget>
        </Split>
        @if (ValidationErrors.Count > 0)
        {
            <Alert AlertStyle="AlertStyle.Warning">
                <strong>Rule validation</strong>
                <span>
                    @foreach (string error in ValidationErrors)
                    {
                        @error
                    }
                </span>
            </Alert>
        }

        <CompactStatStrip>
            <CompactStat Label="Namespace" Value="@Rule.RuleNamespace" Position="TooltipPosition.Right" />
            <CompactStat Label="Enabled" Value="@(Rule.Enabled ? "Yes" : "No")" Tone="@(Rule.Enabled ? "success" : "warning")" />
            <CompactStat Label="Trigger" Value="@TriggerText" Position="TooltipPosition.Right" />
            <CompactStat Label="Processing" Value="@ProcessingText" Position="TooltipPosition.Right" />
            <CompactStat Label="Conditions" Value="@Rule.Conditions.Count.ToString(CultureInfo.InvariantCulture)" />
            <CompactStat Label="Actions" Value="@Rule.Actions.Count.ToString(CultureInfo.InvariantCulture)" />
        </CompactStatStrip>

        @if (Rule.Conditions.Count > 0)
        {
            <details class="rounded-md border border-slate-200 bg-slate-50 p-2.5">
                <summary class="cursor-pointer text-sm font-semibold text-slate-800">Conditions (@Rule.Conditions.Count)</summary>
                <div class="mt-2 space-y-1">
                @foreach (string condition in Rule.Conditions)
                {
                    <MonoText Text="@condition" />
                }
                </div>
            </details>
        }

        <DataGrid TItem="AccountRuleAction" Data="Rule.Actions">
            <DataGridColumn TItem="AccountRuleAction" Property="Kind" Title="Action" />
            <DataGridColumn TItem="AccountRuleAction" Title="Target">
                <Template Context="action">
                    <SmallText Text="@TargetText(action)" />
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="AccountRuleAction" Title="Amount">
                <Template Context="action">
                    <MonoText Text="@(action.AmountExpression ?? "-")" />
                </Template>
            </DataGridColumn>
        </DataGrid>
    </Stack>
</section>

@code {
    [Parameter]
    public AccountRuleDefinition Rule { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<string> ValidationErrors { get; set; } = [];

    [Parameter]
    public bool Compact { get; set; }

    private string TriggerText => Rule.Trigger is null
        ? "default"
        : string.IsNullOrWhiteSpace(Rule.Trigger.ObjectType)
            ? Rule.Trigger.Kind.ToString()
            : $"{Rule.Trigger.Kind}: {Rule.Trigger.ObjectType}";

    private string ProcessingText
    {
        get
        {
            AccountRuleProcessingOptions processing = Rule.Processing ?? AccountRuleProcessingOptions.Default;
            return $"{processing.MaxActionsPerRefresh.ToString(CultureInfo.InvariantCulture)} actions, processed={processing.MarkTriggerProcessed.ToString(CultureInfo.InvariantCulture)}";
        }
    }

    private static string TargetText(AccountRuleAction action)
        => action.ReceiverAddress
            ?? action.ObjectIdExpression
            ?? action.TokenId
            ?? "-";
}
