@namespace CanDoItAll.Economy.Simulator.Components.Components

<SectionCard Title="External Settlement" Description="P0 policy uses external-clearing transfers instead of burn helpers.">
    <Grid ColumnsMd="3">
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Policy" />
            <MonoText Text="external-clearing-transfer" />
        </StatBox>
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Inflow" />
            <SmallText Text="External clearing to internal BU." />
        </StatBox>
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="Outflow" />
            <SmallText Text="Internal BU to external clearing." />
        </StatBox>
    </Grid>
</SectionCard>
