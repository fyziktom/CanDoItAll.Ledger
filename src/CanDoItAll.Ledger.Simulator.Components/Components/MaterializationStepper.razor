@namespace CanDoItAll.Ledger.Simulator.Components.Components

<SectionCard Title="Materialization Plan" Description="Preview the command drafts and requirements before any SDK submission.">
    <Grid ColumnsMd="3">
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="1. Select" />
            <SmallText Text="Choose template and parameters." />
        </StatBox>
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="2. Validate" />
            <SmallText Text="Check addresses, tokens and rule providers." />
        </StatBox>
        <StatBox Simple="true">
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="3. Draft" />
            <SmallText Text="Create SDK BusinessObject command drafts." />
        </StatBox>
    </Grid>
    <Button Text="Build plan" Icon="playlist_add_check" ButtonStyle="ButtonStyle.Secondary" />
</SectionCard>
