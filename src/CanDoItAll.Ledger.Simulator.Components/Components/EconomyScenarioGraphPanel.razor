@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<div class="space-y-4" data-testid="economy-scenario-graph-panel">
    <Split Breakpoint="LayoutBreakpoint.Lg"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween"
           Gap="LayoutGap.Medium"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Scenario graphs" />
            <TextBlock TextStyle="TextStyle.H3" Value="BU and account analytics" />
            <SmallText Text="Cash flow, revenue/income, and expense views use the projection graph DTOs." />
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            @foreach (GraphMetricOption option in MetricOptions)
            {
                <Button Text="@option.Label"
                        Icon="@option.Icon"
                        ButtonStyle="@ResolveMetricButtonStyle(option.Metric)"
                        Variant="@ResolveMetricVariant(option.Metric)"
                        Size="ButtonSize.Small"
                        Click="@(() => SelectMetric(option.Metric))" />
            }
        </Cluster>
    </Split>

    <Grid ColumnsLg="3">
        <FormField Text="Business unit">
            <DropDown TValue="string"
                      Data="BusinessUnitOptions"
                      TextProperty="@nameof(GraphFilterOption.Label)"
                      ValueProperty="@nameof(GraphFilterOption.Value)"
                      Placeholder="All business units"
                      AllowClear="true"
                      Value="selectedBusinessUnit"
                      ValueChanged="OnBusinessUnitChanged" />
        </FormField>
        <FormField Text="Account">
            <DropDown TValue="string"
                      Data="AccountOptions"
                      TextProperty="@nameof(GraphFilterOption.Label)"
                      ValueProperty="@nameof(GraphFilterOption.Value)"
                      Placeholder="All accounts"
                      AllowClear="true"
                      Value="selectedAccountAddress"
                      ValueChanged="OnAccountChanged" />
        </FormField>
        <FormField Text="Rows">
            <TextBox Value="@($"{FilteredDrilldownRows.Count} drilldown rows")" ReadOnly="true" />
        </FormField>
    </Grid>

    <Grid ColumnsMd="4">
        <SectionCard Title="Inflow" Description="@SelectedMetricLabel">
            <TextBlock TextStyle="TextStyle.H4" Value="@Money(TotalInflow)" />
        </SectionCard>
        <SectionCard Title="Outflow" Description="@SelectedMetricLabel">
            <TextBlock TextStyle="TextStyle.H4" Value="@Money(TotalOutflow)" />
        </SectionCard>
        <SectionCard Title="P&L" Description="Accrual and non-cash">
            <TextBlock TextStyle="TextStyle.H4" Value="@Money(TotalPnl)" />
        </SectionCard>
        <SectionCard Title="Net cash" Description="Filtered cash movement">
            <TextBlock TextStyle="TextStyle.H4" Value="@Money(NetCashFlow)" />
        </SectionCard>
    </Grid>

    <CdaChart Title="@($"{SelectedMetricLabel} by category")"
              Description="@SelectedFilterSummary"
              Series="ChartSeries"
              Options="ChartOptions"
              Height="360"
              EmptyText="No graph rows match the current filters." />

    <div class="cda-sim-chart-fallback" data-testid="economy-graph-fallback-chart" aria-label="@($"{SelectedMetricLabel} chart summary")">
        @foreach (FallbackChartRow row in FallbackChartRows)
        {
            <div class="cda-sim-chart-fallback__row">
                <span>@row.Name</span>
                <div class="cda-sim-chart-fallback__track">
                    <div class="@($"cda-sim-chart-fallback__bar cda-sim-chart-fallback__bar--{row.Tone}")"
                         style="@($"width:{FallbackWidth(row.Value)}")"></div>
                </div>
                <strong>@Money(row.Value)</strong>
            </div>
        }
    </div>

    <SectionCard Title="Graph drilldown" Description="Source economic events behind the selected graph.">
        <DataGrid TItem="EconomyGraphDrilldownRow" Data="FilteredDrilldownRows" AllowPaging="true" PageSize="8">
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Title="Date">
                <Template Context="row">
                    <TextBlock TextStyle="TextStyle.Body2" Value="@FormatDate(row.Date)" />
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Title="BU">
                <Template Context="row">
                    <MonoText Text="@TrimMiddle(row.BusinessUnitId)" />
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Property="CategoryCode" Title="Category" />
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Property="FinancialStatementSection" Title="Section" />
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Title="Amount">
                <Template Context="row">
                    <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Money(row.Amount)" />
                </Template>
            </DataGridColumn>
            <DataGridColumn TItem="EconomyGraphDrilldownRow" Property="Description" Title="Description" />
        </DataGrid>
    </SectionCard>
</div>

@code {
    private static readonly IReadOnlyList<GraphMetricOption> MetricOptions =
    [
        new("Cash flow", "account_balance_wallet", ScenarioGraphMetric.CashFlow),
        new("Revenue", "trending_up", ScenarioGraphMetric.Revenue),
        new("Expense", "trending_down", ScenarioGraphMetric.Expense)
    ];

    [Parameter]
    public IReadOnlyList<EconomyGraphData> Graphs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<BusinessUnitNodeItem> BusinessUnits { get; set; } = [];

    [Parameter]
    public IReadOnlyList<AddressBindingItem> AddressBindings { get; set; } = [];

    private ScenarioGraphMetric selectedMetric = ScenarioGraphMetric.CashFlow;
    private string? selectedBusinessUnit;
    private string? selectedAccountAddress;

    private EconomyGraphData? SelectedGraph => Graphs.FirstOrDefault(x => x.Filter.Metric == selectedMetric) ?? Graphs.FirstOrDefault();

    private string SelectedMetricLabel => MetricOptions.First(x => x.Metric == selectedMetric).Label;

    private IReadOnlyList<GraphFilterOption> BusinessUnitOptions => BusinessUnits
        .Select(item => new GraphFilterOption($"{item.DisplayName} ({item.Role})", EconomySimulatorIdentifiers.BusinessUnitId(ProjectId, item.Path).Value))
        .DistinctBy(item => item.Value)
        .ToArray();

    private IReadOnlyList<GraphFilterOption> AccountOptions => AddressBindings
        .Select(item => new GraphFilterOption($"{item.BusinessUnit} - {item.Role}", item.Address))
        .DistinctBy(item => item.Value)
        .ToArray();

    private string ProjectId => SelectedGraph?.Filter.ProjectId ?? "project-alpha";

    private IReadOnlyList<EconomyGraphPoint> FilteredPoints => SelectedGraph?.Series
        .SelectMany(series => series.Points)
        .Where(MatchesFilters)
        .ToArray() ?? [];

    private IReadOnlyList<EconomyGraphDrilldownRow> FilteredDrilldownRows => SelectedGraph?.DrilldownRows
        .Where(MatchesFilters)
        .Take(250)
        .ToArray() ?? [];

    private IReadOnlyList<CdaChartSeries> ChartSeries => FilteredPoints
        .GroupBy(point => point.CategoryCode, StringComparer.Ordinal)
        .OrderBy(group => group.Key, StringComparer.Ordinal)
        .Select(group => new CdaChartSeries
        {
            Name = group.Key,
            Type = selectedMetric == ScenarioGraphMetric.CashFlow ? CdaChartType.Area : CdaChartType.Line,
            Points = group
                .GroupBy(point => point.PeriodStart)
                .OrderBy(pointGroup => pointGroup.Key)
                .Select(pointGroup => new CdaChartPoint(pointGroup.Key.ToDateTime(TimeOnly.MinValue), pointGroup.Sum(ValueForMetric)))
                .ToArray()
        })
        .ToArray();

    private CdaChartOptions ChartOptions => new()
    {
        Type = selectedMetric == ScenarioGraphMetric.CashFlow ? CdaChartType.Area : CdaChartType.Line,
        XAxisType = CdaChartAxisType.DateTime,
        Curve = selectedMetric == ScenarioGraphMetric.CashFlow ? CdaChartCurve.Straight : CdaChartCurve.Smooth,
        Unit = "EUR",
        YAxisTitle = SelectedMetricLabel,
        DateTimeLabelFormat = "MMM yy",
        TooltipDateTimeFormat = "yyyy-MM-dd",
        ShowToolbar = false,
        EnableZoom = false,
        Animate = true,
        FillOpacity = 0.22,
        StrokeWidth = 2
    };

    private decimal TotalInflow => FilteredPoints.Sum(point => point.PlannedInflow + point.CommittedInflow + point.ActualInflow + point.SimulatedInflow);
    private decimal TotalOutflow => FilteredPoints.Sum(point => point.PlannedOutflow + point.CommittedOutflow + point.ActualOutflow + point.SimulatedOutflow);
    private decimal TotalPnl => FilteredPoints.Sum(point => point.NonCashIncome - point.NonCashExpense);
    private decimal NetCashFlow => TotalInflow - TotalOutflow;

    private IReadOnlyList<FallbackChartRow> FallbackChartRows => ChartSeries
        .Select((series, index) => new FallbackChartRow(series.Name, series.Points.Sum(point => point.Value), ToneForIndex(index)))
        .ToArray();

    private decimal FallbackMax => Math.Max(1m, FallbackChartRows.Select(row => Math.Abs(row.Value)).DefaultIfEmpty(1m).Max());

    private string SelectedFilterSummary
    {
        get
        {
            string businessUnit = string.IsNullOrWhiteSpace(selectedBusinessUnit) ? "all business units" : BusinessUnitOptions.FirstOrDefault(x => x.Value == selectedBusinessUnit)?.Label ?? "selected business unit";
            string account = string.IsNullOrWhiteSpace(selectedAccountAddress) ? "all accounts" : AccountOptions.FirstOrDefault(x => x.Value == selectedAccountAddress)?.Label ?? "selected account";
            return $"{businessUnit}; {account}";
        }
    }

    private void SelectMetric(ScenarioGraphMetric metric)
    {
        selectedMetric = metric;
    }

    private Task OnBusinessUnitChanged(string? value)
    {
        selectedBusinessUnit = value;
        return Task.CompletedTask;
    }

    private Task OnAccountChanged(string? value)
    {
        selectedAccountAddress = value;
        return Task.CompletedTask;
    }

    private bool MatchesFilters(EconomyGraphPoint point)
        => (string.IsNullOrWhiteSpace(selectedBusinessUnit) || string.Equals(point.BusinessUnitId, selectedBusinessUnit, StringComparison.Ordinal))
            && (string.IsNullOrWhiteSpace(selectedAccountAddress) || string.Equals(point.AccountAddress, selectedAccountAddress, StringComparison.Ordinal));

    private bool MatchesFilters(EconomyGraphDrilldownRow row)
        => (string.IsNullOrWhiteSpace(selectedBusinessUnit) || string.Equals(row.BusinessUnitId, selectedBusinessUnit, StringComparison.Ordinal))
            && (string.IsNullOrWhiteSpace(selectedAccountAddress) || string.Equals(row.AccountAddress, selectedAccountAddress, StringComparison.Ordinal));

    private decimal ValueForMetric(EconomyGraphPoint point)
        => selectedMetric switch
        {
            ScenarioGraphMetric.Revenue => point.PlannedInflow + point.CommittedInflow + point.ActualInflow + point.SimulatedInflow + point.NonCashIncome,
            ScenarioGraphMetric.Expense => point.PlannedOutflow + point.CommittedOutflow + point.ActualOutflow + point.SimulatedOutflow + point.NonCashExpense,
            _ => point.PlannedInflow + point.CommittedInflow + point.ActualInflow + point.SimulatedInflow - point.PlannedOutflow - point.CommittedOutflow - point.ActualOutflow - point.SimulatedOutflow
        };

    private ButtonStyle ResolveMetricButtonStyle(ScenarioGraphMetric metric)
        => selectedMetric == metric ? ButtonStyle.Info : ButtonStyle.Secondary;

    private Variant ResolveMetricVariant(ScenarioGraphMetric metric)
        => selectedMetric == metric ? Variant.Filled : Variant.Outlined;

    private static string Money(decimal value)
        => value.ToString("EUR #,0;EUR (#,0)", CultureInfo.InvariantCulture);

    private string FallbackWidth(decimal value)
    {
        double percent = (double)(Math.Abs(value) / FallbackMax * 100m);
        return $"{Math.Clamp(percent, 4d, 100d).ToString("0.##", CultureInfo.InvariantCulture)}%";
    }

    private static string ToneForIndex(int index)
        => (index % 3) switch
        {
            1 => "green",
            2 => "amber",
            _ => "blue"
        };

    private static string FormatDate(DateOnly value)
        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string TrimMiddle(string value)
        => value.Length <= 28 ? value : string.Concat(value.AsSpan(0, 12), "...", value.AsSpan(value.Length - 10));

    private sealed record GraphMetricOption(string Label, string Icon, ScenarioGraphMetric Metric);

    private sealed record GraphFilterOption(string Label, string Value);

    private sealed record FallbackChartRow(string Name, decimal Value, string Tone);
}
