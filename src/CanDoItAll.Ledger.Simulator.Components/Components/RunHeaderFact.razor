@namespace CanDoItAll.Economy.Simulator.Components.Components

<MetricCard Label="@Label">
    <ValueContent>
        @if (!string.IsNullOrWhiteSpace(BadgeTone))
        {
            <StatusBadge Text="@Value" Tone="@BadgeTone" />
        }
        else if (Monospace)
        {
            <MonoText Text="@Value" />
        }
        else
        {
            @Value
        }
    </ValueContent>
</MetricCard>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public bool Monospace { get; set; }

    [Parameter]
    public string? BadgeTone { get; set; }

}
