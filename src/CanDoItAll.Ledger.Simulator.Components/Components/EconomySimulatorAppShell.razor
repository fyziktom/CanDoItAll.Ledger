@namespace CanDoItAll.Economy.Simulator.Components.Components

<div class="cda-sim-app-shell" data-testid="simulation-app-shell">
    <aside class="cda-sim-app-nav" aria-label="Economy simulator navigation">
        <a class="cda-sim-app-brand" href="/" aria-label="CanDoItAll Economy Simulator">
            <span class="cda-sim-brand-bars" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            <span class="cda-sim-brand-copy">
                <span>CanDoItAll</span>
                <span>Economy Simulator</span>
            </span>
        </a>

        <nav class="cda-sim-app-nav-items">
            <a class="@NavClass("projects")" href="/" data-testid="simulation-nav-projects" title="Projects" aria-label="Projects">
                <span class="material-icons" aria-hidden="true">folder_open</span>
                <span>Projects</span>
            </a>
            <a class="@NavClass("runs")" href="/runs" data-testid="simulation-nav-runs" title="Runs" aria-label="Runs">
                <span class="material-icons" aria-hidden="true">play_circle</span>
                <span>Runs</span>
            </a>
        </nav>
    </aside>

    <main class="cda-sim-app-main">
        @ChildContent
    </main>
</div>

@code {
    [Parameter]
    public string ActivePage { get; set; } = "projects";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string NavClass(string page)
        => string.Equals(ActivePage, page, StringComparison.Ordinal)
            ? "cda-sim-app-nav-link cda-sim-app-nav-link--active"
            : "cda-sim-app-nav-link";
}
