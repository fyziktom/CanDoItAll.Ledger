@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<Stack GapScale="LayoutGap.Medium" data-testid="simulation-basic-info-tab">
    <Split Breakpoint="LayoutBreakpoint.Md"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Gap="LayoutGap.Medium"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.H4" Value="Project settings" />
            <SmallText Text="@Project.Summary.ProjectId" />
        </Stack>
        <CompactStatStrip>
            <CompactStat Label="Schema" Value="@Project.Model.SchemaVersion" />
            <CompactStat Label="Calendar" Value="@Project.Model.CalendarCode" />
            <CompactStat Label="Storage" Value="@Project.Summary.StorageMode.ToString()" />
            <CompactStat Label="Updated" Value="@Project.Summary.UpdatedAtUtc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)" />
        </CompactStatStrip>
    </Split>

    <Grid ColumnTemplateLg="minmax(18rem,0.75fr) minmax(0,1.25fr)" Gap="LayoutGap.Medium">
        <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="scenario-defaults-title">
            <Stack GapScale="LayoutGap.Medium">
                <div>
                    <TextBlock TextStyle="TextStyle.Subtitle1" Value="Scenario defaults" id="scenario-defaults-title" />
                    <SmallText Text="Inherited by new run setups unless explicitly overridden." />
                </div>
                <dl class="grid min-w-0 grid-cols-1 gap-x-5 gap-y-3 sm:grid-cols-2">
                    @Fact("Currency", Project.Model.BaseCurrencyCode)
                    @Fact("Planning start", FormatDate(Project.Summary.PlanningStartDate))
                    @Fact("Planning end", FormatDate(Project.Summary.PlanningEndDate))
                    @Fact("Treasury BU", BusinessUnitName(Project.Model.TreasuryBusinessUnitId))
                    @Fact("External clearing", BusinessUnitName(Project.Model.ExternalClearingBusinessUnitId))
                    @Fact("Tax rules", Project.Model.DefaultTaxRuleSetId ?? "Not configured")
                    @Fact("Payroll rules", Project.Model.DefaultPayrollRuleSetId ?? "Not configured")
                    @Fact("Open issues", Project.Summary.IssueCount.ToString(CultureInfo.InvariantCulture))
                </dl>
            </Stack>
        </section>

        <section class="min-w-0 rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="metadata-title">
            <Stack GapScale="LayoutGap.Medium">
                <div>
                    <TextBlock TextStyle="TextStyle.Subtitle1" Value="Metadata and assumptions" id="metadata-title" />
                    <SmallText Text="Duplicate keys use assumption, model, then project precedence." />
                </div>
                <DataGrid TItem="MetadataRow" Data="MetadataRows">
                    <DataGridColumn TItem="MetadataRow" Property="Key" Title="Key" />
                    <DataGridColumn TItem="MetadataRow" Property="Value" Title="Value" />
                    <DataGridColumn TItem="MetadataRow" Property="Source" Title="Source" />
                </DataGrid>
            </Stack>
        </section>
    </Grid>

    <ValidationList Messages="Project.ValidationMessages" />
</Stack>

@code {
    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    private IReadOnlyList<MetadataRow> MetadataRows
    {
        get
        {
            Dictionary<string, MetadataRow> rows = new(StringComparer.Ordinal);
            Merge(Project.Metadata, "Project");
            Merge(Project.Model.Metadata, "Model");
            Merge(Project.Model.Assumptions, "Assumption");
            return rows.Values.OrderBy(row => row.Key, StringComparer.Ordinal).ToArray();

            void Merge(IReadOnlyDictionary<string, string> values, string source)
            {
                foreach ((string key, string value) in values)
                {
                    rows[key] = new MetadataRow(key, value, source);
                }
            }
        }
    }

    private string BusinessUnitName(BusinessUnitId id)
        => Project.BusinessUnits.FirstOrDefault(unit => unit.BusinessUnitId == id)?.DisplayName ?? id.Value;

    private static RenderFragment Fact(string label, string value) => builder =>
    {
        int sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "min-w-0 border-b border-slate-100 pb-2");
        builder.OpenElement(sequence++, "dt");
        builder.AddAttribute(sequence++, "class", "text-[0.68rem] font-semibold uppercase tracking-[0.13em] text-slate-500");
        builder.AddContent(sequence++, label);
        builder.CloseElement();
        builder.OpenElement(sequence++, "dd");
        builder.AddAttribute(sequence++, "class", "mt-1 truncate text-sm font-semibold text-slate-900");
        builder.AddAttribute(sequence++, "title", value);
        builder.AddContent(sequence++, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string FormatDate(DateOnly value)
        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private sealed record MetadataRow(string Key, string Value, string Source);
}
