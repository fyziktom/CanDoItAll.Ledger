@namespace CanDoItAll.Ledger.Simulator.Components.Components
@using System.Globalization

<Stack GapScale="LayoutGap.Medium" data-testid="simulation-period-summary-panel">
    <Split Breakpoint="LayoutBreakpoint.Lg"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween"
           Gap="LayoutGap.Medium"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.H4" Value="@($"{GranularityLabel} management summary")" />
            <SmallText Text="@($"{FormatDate(Summary.PeriodStart)}–{FormatDate(Summary.PeriodEnd)} · {Summary.CurrencyCode}")" />
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            <Button Text="Quarter"
                    Icon="calendar_view_month"
                    ButtonStyle="@GranularityButtonStyle(SimulationPeriodSummaryGranularity.Quarter)"
                    Variant="@GranularityVariant(SimulationPeriodSummaryGranularity.Quarter)"
                    Size="ButtonSize.Small"
                    Click="@(() => SelectGranularity(SimulationPeriodSummaryGranularity.Quarter))" />
            <Button Text="Year"
                    Icon="calendar_today"
                    ButtonStyle="@GranularityButtonStyle(SimulationPeriodSummaryGranularity.Year)"
                    Variant="@GranularityVariant(SimulationPeriodSummaryGranularity.Year)"
                    Size="ButtonSize.Small"
                    Click="@(() => SelectGranularity(SimulationPeriodSummaryGranularity.Year))" />
        </Cluster>
    </Split>

    <SummaryTiles ColumnsSm="2" ColumnsMd="3" ColumnsXl="6" GapScale="LayoutGap.Small">
        <SummaryTile Label="Cash flow" Value="@Money(Summary.TotalCashFlow)" HelperText="@($"{Summary.Periods.Count} period(s)")" Tone="info" Compact="true" ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Income" Value="@Money(Summary.TotalIncome)" HelperText="@($"{Summary.IncomeDistribution.Count} category(s)")" Tone="success" Compact="true" ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Expenses" Value="@Money(Summary.TotalExpenses)" HelperText="@($"{Summary.ExpenseDistribution.Count} category(s)")" Tone="warning" Compact="true" ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Profit" Value="@Money(Summary.TotalProfit)" HelperText="@ProfitTone" Tone="@ProfitStatusTone" Compact="true" ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="Own capital" Value="@Money(Summary.EndingOwnCapital)" HelperText="Ending cash funded" Tone="secondary" Compact="true" ShowHelperTextAsTooltip="true" />
        <SummaryTile Label="External capital" Value="@Money(Summary.EndingExternalCapital)" HelperText="@($"Floor {Money(Summary.MinimumCashFloor)}")" Compact="true" ShowHelperTextAsTooltip="true" />
    </SummaryTiles>

    <CdaChart Title="@($"{GranularityLabel} CFO trend")"
              Description="@($"{Summary.Periods.Count} period(s) in {Summary.CurrencyCode}")"
              AriaLabel="@($"{GranularityLabel} cash flow, income, expenses, profit, own capital, and external capital trend")"
              Series="@TrendChartSeries"
              Options="@TrendChartOptions"
              Height="250"
              EmptyText="Run the simulation to build period summary rows."
              data-testid="simulation-period-summary-trend" />

    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
        @DistributionChart("Income distribution", Summary.TotalIncome, Summary.IncomeDistribution, "simulation-period-summary-income")
        @DistributionChart("Expense distribution", Summary.TotalExpenses, Summary.ExpenseDistribution, "simulation-period-summary-expense")
    </Grid>

    <PanelCard data-testid="simulation-period-summary-table">
        <Stack GapScale="LayoutGap.Medium">
            <PanelHeading Title="@($"{GranularityLabel} rows")" LinkText="@($"{Summary.CurrencyCode} values")" />
            <DataGrid TItem="SimulationPeriodSummaryPeriod"
                      Data="Summary.Periods"
                      Caption="@($"{GranularityLabel} simulation period summary")">
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Property="DisplayName" Title="Period" />
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="Cash flow">
                    <Template Context="period"><TextBlock Value="@Money(period.CashFlow)" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="Income">
                    <Template Context="period"><TextBlock Value="@Money(period.Income)" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="Expenses">
                    <Template Context="period"><TextBlock Value="@Money(period.Expenses)" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="Profit">
                    <Template Context="period"><StatusBadge Text="@Money(period.Profit)" Tone="@ProfitToneFor(period.Profit)" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="Own capital">
                    <Template Context="period"><TextBlock Value="@Money(period.OwnCapital)" /></Template>
                </DataGridColumn>
                <DataGridColumn TItem="SimulationPeriodSummaryPeriod" Title="External capital">
                    <Template Context="period"><TextBlock Value="@Money(period.ExternalCapital)" /></Template>
                </DataGridColumn>
            </DataGrid>
        </Stack>
    </PanelCard>
</Stack>

@code {
    private static readonly IReadOnlyList<string> TrendPalette =
    [
        "#2563eb",
        "#059669",
        "#dc2626",
        "#7c3aed",
        "#0f766e",
        "#b45309"
    ];

    private static readonly IReadOnlyList<string> DistributionPalette =
    [
        "#0f766e",
        "#2563eb",
        "#b45309",
        "#7c3aed",
        "#be123c",
        "#64748b",
        "#0891b2"
    ];

    private SimulationPeriodSummaryGranularity selectedGranularity = SimulationPeriodSummaryGranularity.Quarter;

    [Parameter]
    public SimulationRunConsoleState? Run { get; set; }

    private SimulationRunConsoleState CurrentRun => Run ?? LedgerSimulatorSampleData.CreateRunConsole().SelectedRun;

    private SimulationPeriodSummarySnapshot Summary => SimulationPeriodSummaryCalculator.Build(CurrentRun, selectedGranularity);

    private string GranularityLabel => selectedGranularity == SimulationPeriodSummaryGranularity.Year ? "Yearly" : "Quarterly";

    private string ProfitTone => Summary.TotalProfit < 0m ? "Loss" : "Positive";

    private string ProfitStatusTone => ProfitToneFor(Summary.TotalProfit);

    private IReadOnlyList<CdaChartSeries> TrendChartSeries =>
    [
        TrendSeries("Cash flow", period => period.CashFlow, TrendPalette[0]),
        TrendSeries("Income", period => period.Income, TrendPalette[1]),
        TrendSeries("Expenses", period => period.Expenses, TrendPalette[2]),
        TrendSeries("Profit", period => period.Profit, TrendPalette[3]),
        TrendSeries("Own capital", period => period.OwnCapital, TrendPalette[4]),
        TrendSeries("External capital", period => period.ExternalCapital, TrendPalette[5])
    ];

    private CdaChartOptions TrendChartOptions => new()
    {
        Type = CdaChartType.Line,
        XAxisType = CdaChartAxisType.Category,
        Curve = CdaChartCurve.Straight,
        Unit = Summary.CurrencyCode,
        YAxisTitle = $"Value ({Summary.CurrencyCode})",
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Animate = true,
        StrokeWidth = 3,
        Palette = TrendPalette
    };

    private static readonly CdaChartOptions DistributionChartOptions = new()
    {
        Type = CdaChartType.Donut,
        XAxisType = CdaChartAxisType.Category,
        ShowDataLabels = true,
        ShowToolbar = false,
        EnableZoom = false,
        LegendPosition = CdaChartLegendPosition.Bottom,
        Palette = DistributionPalette
    };

    private RenderFragment DistributionChart(
        string title,
        decimal total,
        IReadOnlyList<SimulationPeriodSummaryDistributionSlice> slices,
        string testId)
        => @<CdaChart Title="@title"
                       Description="@($"{Money(total)} total")"
                       AriaLabel="@($"{title} in {Summary.CurrencyCode}")"
                       Series="@DistributionSeries(slices)"
                       Options="@DistributionChartOptions"
                       Height="220"
                       EmptyText="This run has no values in the selected period."
                       data-testid="@testId" />;

    private void SelectGranularity(SimulationPeriodSummaryGranularity granularity)
    {
        selectedGranularity = granularity;
    }

    private ButtonStyle GranularityButtonStyle(SimulationPeriodSummaryGranularity granularity)
        => selectedGranularity == granularity ? ButtonStyle.Info : ButtonStyle.Secondary;

    private Variant GranularityVariant(SimulationPeriodSummaryGranularity granularity)
        => selectedGranularity == granularity ? Variant.Filled : Variant.Outlined;

    private CdaChartSeries TrendSeries(
        string name,
        Func<SimulationPeriodSummaryPeriod, decimal> valueSelector,
        string color)
        => new()
        {
            Name = name,
            Type = CdaChartType.Line,
            Color = color,
            Points = Summary.Periods
                .Select(period => new CdaChartPoint(period.DisplayName, valueSelector(period), color))
                .ToArray()
        };

    private static IReadOnlyList<CdaChartSeries> DistributionSeries(
        IReadOnlyList<SimulationPeriodSummaryDistributionSlice> slices)
        =>
        [
            new CdaChartSeries
            {
                Name = "Distribution",
                Type = CdaChartType.Donut,
                Points = slices
                    .Select((slice, index) => new CdaChartPoint(
                        slice.DisplayName,
                        slice.Amount,
                        DistributionPalette[index % DistributionPalette.Count]))
                    .ToArray()
            }
        ];

    private string Money(decimal value)
    {
        string amount = Math.Abs(value).ToString("#,0", CultureInfo.InvariantCulture);
        return value < 0m ? $"{Summary.CurrencyCode} ({amount})" : $"{Summary.CurrencyCode} {amount}";
    }

    private static string ProfitToneFor(decimal value) => value < 0m ? "danger" : "success";

    private static string FormatDate(DateOnly value)
        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

}
