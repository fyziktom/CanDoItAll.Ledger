@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization
@using System.Net

<div class="cda-sim-period-summary" data-testid="simulation-period-summary-panel">
    <Split Breakpoint="LayoutBreakpoint.Lg"
           AlignItems="AlignItems.Start"
           JustifyContent="JustifyContent.SpaceBetween"
           Gap="LayoutGap.Medium"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Management summary" />
            <TextBlock TextStyle="TextStyle.H3" Value="@($"{GranularityLabel} view")" />
            <SmallText Text="@($"{FormatDate(Summary.PeriodStart)} to {FormatDate(Summary.PeriodEnd)}")" />
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            <Button Text="Quarter"
                    Icon="calendar_view_month"
                    ButtonStyle="@GranularityButtonStyle(SimulationPeriodSummaryGranularity.Quarter)"
                    Variant="@GranularityVariant(SimulationPeriodSummaryGranularity.Quarter)"
                    Size="ButtonSize.Small"
                    Click="@(() => SelectGranularity(SimulationPeriodSummaryGranularity.Quarter))" />
            <Button Text="Year"
                    Icon="calendar_today"
                    ButtonStyle="@GranularityButtonStyle(SimulationPeriodSummaryGranularity.Year)"
                    Variant="@GranularityVariant(SimulationPeriodSummaryGranularity.Year)"
                    Size="ButtonSize.Small"
                    Click="@(() => SelectGranularity(SimulationPeriodSummaryGranularity.Year))" />
        </Cluster>
    </Split>

    <div class="cda-sim-summary-kpis">
        <section class="cda-sim-kpi-tile">
            <span>Cash flow</span>
            <strong>@Money(Summary.TotalCashFlow)</strong>
            <small>@Summary.Periods.Count period(s)</small>
        </section>
        <section class="cda-sim-kpi-tile">
            <span>Income</span>
            <strong>@Money(Summary.TotalIncome)</strong>
            <small>@($"{Summary.IncomeDistribution.Count} category(s)")</small>
        </section>
        <section class="cda-sim-kpi-tile">
            <span>Expenses</span>
            <strong>@Money(Summary.TotalExpenses)</strong>
            <small>@($"{Summary.ExpenseDistribution.Count} category(s)")</small>
        </section>
        <section class="cda-sim-kpi-tile">
            <span>Profit</span>
            <strong>@Money(Summary.TotalProfit)</strong>
            <small class="@TrendClass(Summary.TotalProfit)">@ProfitTone</small>
        </section>
        <section class="cda-sim-kpi-tile">
            <span>Own capital</span>
            <strong>@Money(Summary.EndingOwnCapital)</strong>
            <small>Ending cash funded</small>
        </section>
        <section class="cda-sim-kpi-tile">
            <span>External capital</span>
            <strong>@Money(Summary.EndingExternalCapital)</strong>
            <small>@($"Floor {Money(Summary.MinimumCashFloor)}")</small>
        </section>
    </div>

    <section class="cda-sim-panel cda-sim-summary-chart" data-testid="simulation-period-summary-trend">
        <PanelHeading Title="@($"{GranularityLabel} CFO trend")" LinkText="@($"{Summary.Periods.Count} period(s)")" />
        @if (Summary.Periods.Count == 0)
        {
            <EmptyState Eyebrow="Summary" Title="No period data" Description="Run the simulation to build period summary rows." />
        }
        else
        {
            <svg class="cda-sim-summary-trend-svg"
                 viewBox="0 0 @ChartWidth @ChartHeight"
                 role="img"
                 aria-label="@($"{GranularityLabel} cash flow, income, expenses, profit, own capital, and external capital trend")">
                @foreach (TrendGridLine line in TrendGridLines)
                {
                    <line x1="@ChartLeft" y1="@FormatNumber(line.Y)" x2="@ChartRight" y2="@FormatNumber(line.Y)" class="cda-sim-summary-gridline" />
                    @SvgText(8, line.Y + 4, CompactMoney(line.Value), "cda-sim-summary-axis-label")
                }

                <line x1="@ChartLeft" y1="@ChartBottom" x2="@ChartRight" y2="@ChartBottom" class="cda-sim-summary-axis" />
                <line x1="@ChartLeft" y1="@ChartTop" x2="@ChartLeft" y2="@ChartBottom" class="cda-sim-summary-axis" />
                <line x1="@ChartLeft" y1="@FormatNumber(TrendY(0m))" x2="@ChartRight" y2="@FormatNumber(TrendY(0m))" class="cda-sim-summary-zero-line" />

                @foreach (TrendLine series in TrendLines)
                {
                    <polyline points="@TrendPoints(series.Values)" class="cda-sim-summary-trend-line" stroke="@series.Color" />
                    @foreach (TrendPoint point in TrendPointMarkers(series.Values))
                    {
                        <circle cx="@FormatNumber(point.X)" cy="@FormatNumber(point.Y)" r="3.5" fill="@series.Color" />
                    }
                }

                @foreach (TrendAxisLabel label in TrendAxisLabels)
                {
                    @SvgText(label.X, 268, label.Text, "cda-sim-summary-axis-label cda-sim-summary-axis-label--x", "middle")
                }
            </svg>
            <div class="cda-sim-summary-chart-legend">
                @foreach (TrendLine series in TrendLines)
                {
                    <span><i style="@($"background:{series.Color}")"></i>@series.Name</span>
                }
            </div>
        }
    </section>

    <div class="cda-sim-summary-distribution-grid">
        @DistributionChart("Income distribution", Summary.TotalIncome, Summary.IncomeDistribution, "simulation-period-summary-income")
        @DistributionChart("Expense distribution", Summary.TotalExpenses, Summary.ExpenseDistribution, "simulation-period-summary-expense")
    </div>

    <section class="cda-sim-panel" data-testid="simulation-period-summary-table">
        <PanelHeading Title="@($"{GranularityLabel} rows")" LinkText="@($"{Summary.CurrencyCode} values")" />
        <table class="cda-sim-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Cash flow</th>
                    <th>Income</th>
                    <th>Expenses</th>
                    <th>Profit</th>
                    <th>Own capital</th>
                    <th>External capital</th>
                </tr>
            </thead>
            <tbody>
                @foreach (SimulationPeriodSummaryPeriod period in Summary.Periods)
                {
                    <tr>
                        <td data-label="Period">@period.DisplayName</td>
                        <td data-label="Cash flow">@Money(period.CashFlow)</td>
                        <td data-label="Income">@Money(period.Income)</td>
                        <td data-label="Expenses">@Money(period.Expenses)</td>
                        <td data-label="Profit" class="@TrendClass(period.Profit)">@Money(period.Profit)</td>
                        <td data-label="Own capital">@Money(period.OwnCapital)</td>
                        <td data-label="External capital">@Money(period.ExternalCapital)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>

@code {
    private const double ChartWidth = 720d;
    private const double ChartHeight = 280d;
    private const double ChartLeft = 70d;
    private const double ChartRight = 700d;
    private const double ChartTop = 20d;
    private const double ChartBottom = 238d;

    private static readonly IReadOnlyList<string> TrendPalette =
    [
        "#2563eb",
        "#059669",
        "#dc2626",
        "#7c3aed",
        "#0f766e",
        "#b45309"
    ];

    private static readonly IReadOnlyList<string> DistributionPalette =
    [
        "#0f766e",
        "#2563eb",
        "#b45309",
        "#7c3aed",
        "#be123c",
        "#64748b",
        "#0891b2"
    ];

    private SimulationPeriodSummaryGranularity selectedGranularity = SimulationPeriodSummaryGranularity.Quarter;

    [Parameter]
    public SimulationRunConsoleState? Run { get; set; }

    private SimulationRunConsoleState CurrentRun => Run ?? EconomySimulatorSampleData.CreateRunConsole().SelectedRun;

    private SimulationPeriodSummarySnapshot Summary => SimulationPeriodSummaryCalculator.Build(CurrentRun, selectedGranularity);

    private string GranularityLabel => selectedGranularity == SimulationPeriodSummaryGranularity.Year ? "Yearly" : "Quarterly";

    private string ProfitTone => Summary.TotalProfit < 0m ? "Loss" : "Positive";

    private IReadOnlyList<TrendLine> TrendLines
        =>
        [
            new("Cash flow", Summary.Periods.Select(period => period.CashFlow).ToArray(), TrendPalette[0]),
            new("Income", Summary.Periods.Select(period => period.Income).ToArray(), TrendPalette[1]),
            new("Expenses", Summary.Periods.Select(period => period.Expenses).ToArray(), TrendPalette[2]),
            new("Profit", Summary.Periods.Select(period => period.Profit).ToArray(), TrendPalette[3]),
            new("Own capital", Summary.Periods.Select(period => period.OwnCapital).ToArray(), TrendPalette[4]),
            new("External capital", Summary.Periods.Select(period => period.ExternalCapital).ToArray(), TrendPalette[5])
        ];

    private decimal TrendMin
    {
        get
        {
            decimal min = TrendLines.SelectMany(line => line.Values).DefaultIfEmpty(0m).Min();
            decimal max = TrendLines.SelectMany(line => line.Values).DefaultIfEmpty(0m).Max();
            decimal padding = Math.Max(Math.Abs(max - min) * 0.08m, 1m);
            return min - padding;
        }
    }

    private decimal TrendMax
    {
        get
        {
            decimal min = TrendLines.SelectMany(line => line.Values).DefaultIfEmpty(0m).Min();
            decimal max = TrendLines.SelectMany(line => line.Values).DefaultIfEmpty(0m).Max();
            decimal padding = Math.Max(Math.Abs(max - min) * 0.08m, 1m);
            return max + padding;
        }
    }

    private IReadOnlyList<TrendGridLine> TrendGridLines
        => Enumerable.Range(0, 5)
            .Select(index =>
            {
                decimal value = TrendMax - ((TrendMax - TrendMin) * index / 4m);
                return new TrendGridLine(value, TrendY(value));
            })
            .ToArray();

    private IReadOnlyList<TrendAxisLabel> TrendAxisLabels
        => Summary.Periods
            .Select((period, index) => new TrendAxisLabel(period.DisplayName, TrendX(index, Summary.Periods.Count)))
            .ToArray();

    private RenderFragment DistributionChart(
        string title,
        decimal total,
        IReadOnlyList<SimulationPeriodSummaryDistributionSlice> slices,
        string testId)
        => @<section class="cda-sim-panel cda-sim-donut-panel" data-testid="@testId">
            <PanelHeading Title="@title" LinkText="@($"{Money(total)} total")" />
            @if (slices.Count == 0)
            {
                <EmptyState Eyebrow="Distribution" Title="No values" Description="This run has no values in the selected period." />
            }
            else
            {
                <div class="cda-sim-donut-layout">
                    <svg class="cda-sim-donut-svg" viewBox="0 0 180 180" role="img" aria-label="@title">
                        <circle cx="90" cy="90" r="62" class="cda-sim-donut-track" pathLength="100" />
                        @foreach (DonutSegment segment in DonutSegments(slices))
                        {
                            <circle cx="90"
                                    cy="90"
                                    r="62"
                                    class="cda-sim-donut-segment"
                                    pathLength="100"
                                    stroke="@segment.Color"
                                    stroke-dasharray="@DonutDashArray(segment.Percent)"
                                    stroke-dashoffset="@FormatNumber(-segment.Offset)"
                                    transform="rotate(-90 90 90)" />
                        }
                        @SvgText(90, 85, Money(total), "cda-sim-donut-total", "middle")
                        @SvgText(90, 104, Summary.CurrencyCode, "cda-sim-donut-caption", "middle")
                    </svg>
                    <div class="cda-sim-donut-legend">
                        @foreach (DonutSegment segment in DonutSegments(slices))
                        {
                            <div class="cda-sim-donut-legend-row">
                                <i style="@($"background:{segment.Color}")"></i>
                                <span>@segment.Slice.DisplayName</span>
                                <strong>@($"{segment.Percent:0.#}%")</strong>
                                <small>@Money(segment.Slice.Amount)</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>;

    private void SelectGranularity(SimulationPeriodSummaryGranularity granularity)
    {
        selectedGranularity = granularity;
    }

    private ButtonStyle GranularityButtonStyle(SimulationPeriodSummaryGranularity granularity)
        => selectedGranularity == granularity ? ButtonStyle.Info : ButtonStyle.Secondary;

    private Variant GranularityVariant(SimulationPeriodSummaryGranularity granularity)
        => selectedGranularity == granularity ? Variant.Filled : Variant.Outlined;

    private string TrendPoints(IReadOnlyList<decimal> values)
        => string.Join(
            " ",
            values.Select((value, index) => $"{FormatNumber(TrendX(index, values.Count))},{FormatNumber(TrendY(value))}"));

    private IReadOnlyList<TrendPoint> TrendPointMarkers(IReadOnlyList<decimal> values)
        => values.Select((value, index) => new TrendPoint(TrendX(index, values.Count), TrendY(value))).ToArray();

    private static double TrendX(int index, int count)
    {
        if (count <= 1)
        {
            return ChartLeft;
        }

        double availableWidth = ChartRight - ChartLeft;
        return ChartLeft + (availableWidth * index / (count - 1));
    }

    private double TrendY(decimal value)
    {
        decimal range = TrendMax - TrendMin;
        if (range <= 0m)
        {
            return ChartBottom;
        }

        decimal normalized = (value - TrendMin) / range;
        return ChartBottom - ((double)normalized * (ChartBottom - ChartTop));
    }

    private IReadOnlyList<DonutSegment> DonutSegments(IReadOnlyList<SimulationPeriodSummaryDistributionSlice> slices)
    {
        var segments = new List<DonutSegment>(slices.Count);
        decimal offset = 0m;

        for (var index = 0; index < slices.Count; index++)
        {
            SimulationPeriodSummaryDistributionSlice slice = slices[index];
            decimal percent = Math.Clamp(slice.PercentOfTotal, 0m, 100m);
            segments.Add(new DonutSegment(slice, DistributionPalette[index % DistributionPalette.Count], offset, percent));
            offset += percent;
        }

        return segments;
    }

    private static string DonutDashArray(decimal percent)
        => $"{FormatNumber(Math.Max(percent - 1.2m, 0.2m))} 100";

    private string Money(decimal value)
    {
        string amount = Math.Abs(value).ToString("#,0", CultureInfo.InvariantCulture);
        return value < 0m ? $"{Summary.CurrencyCode} ({amount})" : $"{Summary.CurrencyCode} {amount}";
    }

    private static string TrendClass(decimal value)
        => value < 0m ? "cda-sim-trend cda-sim-trend--down" : "cda-sim-trend";

    private string CompactMoney(decimal value)
    {
        decimal absolute = Math.Abs(value);
        string suffix;
        decimal scaled;

        if (absolute >= 1_000_000m)
        {
            scaled = absolute / 1_000_000m;
            suffix = "m";
        }
        else if (absolute >= 1_000m)
        {
            scaled = absolute / 1_000m;
            suffix = "k";
        }
        else
        {
            scaled = absolute;
            suffix = string.Empty;
        }

        string amount = scaled.ToString(scaled >= 10m || suffix.Length == 0 ? "0" : "0.#", CultureInfo.InvariantCulture);
        return value < 0m ? $"({amount}{suffix})" : $"{amount}{suffix}";
    }

    private static string FormatNumber(double value)
        => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string FormatNumber(decimal value)
        => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static MarkupString SvgText(
        double x,
        double y,
        string value,
        string cssClass,
        string? textAnchor = null)
    {
        string anchor = string.IsNullOrWhiteSpace(textAnchor)
            ? string.Empty
            : $" text-anchor=\"{WebUtility.HtmlEncode(textAnchor)}\"";
        string markup = string.Create(
            CultureInfo.InvariantCulture,
            $"<text x=\"{FormatNumber(x)}\" y=\"{FormatNumber(y)}\" class=\"{WebUtility.HtmlEncode(cssClass)}\"{anchor}>{WebUtility.HtmlEncode(value)}</text>");
        return new MarkupString(markup);
    }

    private static string FormatDate(DateOnly value)
        => value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private sealed record TrendLine(string Name, IReadOnlyList<decimal> Values, string Color);

    private sealed record TrendPoint(double X, double Y);

    private sealed record TrendGridLine(decimal Value, double Y);

    private sealed record TrendAxisLabel(string Text, double X);

    private sealed record DonutSegment(
        SimulationPeriodSummaryDistributionSlice Slice,
        string Color,
        decimal Offset,
        decimal Percent);
}
