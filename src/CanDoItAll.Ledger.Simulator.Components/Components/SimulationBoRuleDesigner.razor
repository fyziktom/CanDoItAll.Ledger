@namespace CanDoItAll.Ledger.Simulator.Components.Components

<ListDetailShell Dense="true"
                 ListPaneWidth="18rem"
                 ListPaneClass="min-h-[28rem]"
                 DetailPaneClass="min-h-[28rem]"
                 data-testid="simulation-bo-rules-tab">
    <ListHeader>
        <ListPanelHeader Title="Objects and rules"
                         Count="@Project.BusinessObjectDefinitions.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         HelpText="Definitions are grouped in folders. Search by display name, object type, kind, or identifier."
                         Dense="true">
            <Actions>
                <Button Text="Templates"
                        Icon="view_module"
                        ButtonStyle="ButtonStyle.Secondary"
                        Variant="Variant.Outlined"
                        Size="ButtonSize.Small"
                        Click="@OpenTemplateCatalogueDialog"
                        data-testid="simulation-template-catalogue-open" />
            </Actions>
        </ListPanelHeader>
    </ListHeader>
    <ListContent>
        <Stack GapScale="LayoutGap.Small" Class="w-full min-w-0">
            <TextBox Value="@definitionSearch"
                     ValueChanged="@(value => definitionSearch = value ?? string.Empty)"
                     Immediate="true"
                     Placeholder="Search objects and rules..."
                     aria-label="Search objects and rules" />
            <div class="max-h-[38rem] min-h-0 w-full min-w-0 overflow-y-auto pr-1">
            <TreeView Items="FolderNodes"
                      Style="TreeViewStyle.Workbench"
                      AriaLabel="BO and rule folders"
                      OnSelect="SelectNode"
                      OnToggle="ToggleNode" />
            </div>
        </Stack>
    </ListContent>
    <DetailHeader>
        @if (SelectedDefinition is not null)
        {
            <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium" Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.H4" Value="@SelectedDefinition.DisplayName" />
                    <SmallText Text="@SelectedDefinition.DefinitionId" />
                </Stack>
                <Cluster Gap="LayoutGap.Small">
                    <StatusBadge Text="@SelectedDefinition.Kind.ToString()" Tone="muted" />
                    <StatusBadge Text="@SelectedDefinition.MaterializationStatus.ToString()" Tone="@MaterializationTone(SelectedDefinition.MaterializationStatus)" />
                </Cluster>
            </Split>
        }
        else if (SelectedFolder is not null)
        {
            <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Medium" Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.H4" Value="@SelectedFolder.DisplayName" />
                    <SmallText Text="@SelectedFolder.FolderId" />
                </Stack>
                <StatusBadge Text="@SelectedFolder.Kind.ToString()" Tone="info" />
            </Split>
        }
    </DetailHeader>
    <DetailContent>
        @if (SelectedDefinition is not null)
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="simulation-selected-bo-rule-detail">
                <CompactStatStrip>
                    <CompactStat Label="Object type" Value="@SelectedDefinition.ObjectType" Position="TooltipPosition.Right" />
                    <CompactStat Label="Schema" Value="@SelectedDefinition.SchemaVersion" />
                    <CompactStat Label="Folder" Value="@SelectedFolderName" HelperText="@SelectedDefinition.FolderId" Position="TooltipPosition.Right" />
                    <CompactStat Label="Owner" Value="@SelectedOwnerName" HelperText="@SelectedDefinition.OwnerBusinessUnitId?.Value" Position="TooltipPosition.Right" />
                    <CompactStat Label="Evidence" Value="@SelectedDefinition.EvidenceObjectIds.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)" TooltipText="@string.Join(", ", SelectedDefinition.EvidenceObjectIds.DefaultIfEmpty("None"))" Position="TooltipPosition.Right" />
                    <CompactStat Label="Trigger" Value="@SelectedTriggerType" Position="TooltipPosition.Right" />
                    <CompactStat Label="Actions" Value="@SelectedActionCount" />
                </CompactStatStrip>

                <SimulationDefinitionSettingsPanel Project="Project" Definition="SelectedDefinition" />
                <ValidationList Messages="SelectedDefinition.ValidationMessages" />
            </Stack>
        }
        else if (SelectedFolder is not null)
        {
            <Stack GapScale="LayoutGap.Medium" data-testid="simulation-selected-bo-folder-detail">
                <DataGrid TItem="SimulationBusinessObjectDefinitionState" Data="DefinitionsInFolder">
                    <DataGridColumn TItem="SimulationBusinessObjectDefinitionState" Property="DisplayName" Title="Definition" />
                    <DataGridColumn TItem="SimulationBusinessObjectDefinitionState" Property="ObjectType" Title="Object type" />
                    <DataGridColumn TItem="SimulationBusinessObjectDefinitionState" Title="Status">
                        <Template Context="definition">
                            <StatusBadge Text="@definition.MaterializationStatus.ToString()" Tone="@MaterializationTone(definition.MaterializationStatus)" />
                        </Template>
                    </DataGridColumn>
                </DataGrid>
            </Stack>
        }
        else
        {
            <Alert AlertStyle="AlertStyle.Info">
                <strong>Select a folder or definition</strong>
                <span>Choose an item from the object tree or open Templates.</span>
            </Alert>
        }
    </DetailContent>
</ListDetailShell>

<Dialog IsOpen="@isTemplateCatalogueDialogOpen"
        Title="Simulation templates"
        Eyebrow="BO and rule catalogue"
        Subtitle="Search BO, rule, schedule, and model templates with dependency hints. Templates load only while this dialog is open."
        Size="ModalSize.Full"
        TestId="simulation-template-catalogue-dialog"
        OnClose="@CloseTemplateCatalogueDialog">
    <ChildContent>
        @if (isTemplateCatalogueDialogOpen)
        {
            <SimulationTemplateCataloguePanel Project="Project" />
        }
    </ChildContent>
    <Footer>
        <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
            <Button Text="Close" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@CloseTemplateCatalogueDialog" />
        </Cluster>
    </Footer>
</Dialog>

@code {
    private readonly HashSet<string> expandedNodeIds = new(StringComparer.Ordinal);
    private string? selectedNodeId;
    private bool isTemplateCatalogueDialogOpen;
    private string definitionSearch = string.Empty;
    private string renderedProjectId = string.Empty;

    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    private string SelectedId => selectedNodeId
        ?? Project.BusinessObjectDefinitions.FirstOrDefault(x => x.Kind == SimulationBusinessObjectDefinitionKind.RuleDefinition)?.DefinitionId
        ?? Project.Folders.FirstOrDefault()?.FolderId
        ?? string.Empty;

    private SimulationBusinessObjectDefinitionState? SelectedDefinition => Project.BusinessObjectDefinitions.FirstOrDefault(x => x.DefinitionId == SelectedId);

    private SimulationProjectFolderState? SelectedFolder => Project.Folders.FirstOrDefault(x => x.FolderId == SelectedId);

    private string SelectedFolderName => Project.Folders.FirstOrDefault(folder => string.Equals(folder.FolderId, SelectedDefinition?.FolderId, StringComparison.Ordinal))?.DisplayName
        ?? SelectedDefinition?.FolderId
        ?? "Unfiled";

    private string SelectedOwnerName => SelectedDefinition?.OwnerBusinessUnitId is { } ownerId
        ? Project.BusinessUnits.FirstOrDefault(unit => unit.BusinessUnitId == ownerId)?.DisplayName ?? ownerId.Value
        : "Project";

    private string SelectedTriggerType
    {
        get
        {
            string? objectType = SelectedDefinition?.RuleDefinition is { Trigger: { } trigger }
                ? trigger.ObjectType
                : SelectedDefinition?.ObjectType;
            return string.IsNullOrWhiteSpace(objectType) ? "n/a" : objectType;
        }
    }

    private string SelectedActionCount => SelectedDefinition?.RuleDefinition is { } ruleDefinition
        ? ruleDefinition.Actions.Count.ToString(System.Globalization.CultureInfo.InvariantCulture)
        : "n/a";

    private IReadOnlyList<string> RuleValidationErrors
    {
        get
        {
            if (SelectedDefinition?.RuleDefinition is null)
            {
                return [];
            }

            return RuleTokenAuthority.TryValidate(SelectedDefinition.RuleDefinition, out IReadOnlyList<string> errors)
                ? []
                : errors;
        }
    }

    private IReadOnlyList<SimulationBusinessObjectDefinitionState> DefinitionsInFolder => SelectedFolder is null
        ? []
        : Project.BusinessObjectDefinitions.Where(x => x.FolderId == SelectedFolder.FolderId).ToArray();

    private IReadOnlyList<TreeViewNode> FolderNodes => BuildFolderNodes(Project.Folders.Where(x => x.ParentFolderId is null).OrderBy(x => x.SortOrder));

    protected override void OnParametersSet()
    {
        if (!string.Equals(renderedProjectId, Project.Summary.ProjectId, StringComparison.Ordinal))
        {
            renderedProjectId = Project.Summary.ProjectId;
            expandedNodeIds.Clear();
            selectedNodeId = Project.BusinessObjectDefinitions.FirstOrDefault(x => x.Kind == SimulationBusinessObjectDefinitionKind.RuleDefinition)?.DefinitionId
                ?? Project.Folders.FirstOrDefault()?.FolderId;
            definitionSearch = string.Empty;
        }

        bool selectionExists = Project.BusinessObjectDefinitions.Any(definition => string.Equals(definition.DefinitionId, selectedNodeId, StringComparison.Ordinal))
            || Project.Folders.Any(folder => string.Equals(folder.FolderId, selectedNodeId, StringComparison.Ordinal));
        if (!selectionExists)
        {
            selectedNodeId = Project.BusinessObjectDefinitions.FirstOrDefault(definition => definition.Kind == SimulationBusinessObjectDefinitionKind.RuleDefinition)?.DefinitionId
                ?? Project.Folders.FirstOrDefault()?.FolderId
                ?? Project.BusinessObjectDefinitions.FirstOrDefault()?.DefinitionId;
        }

        EnsureSelectedAncestryExpanded();
    }

    private IReadOnlyList<TreeViewNode> BuildFolderNodes(IEnumerable<SimulationProjectFolderState> folders)
        => folders
            .Select(folder =>
            {
                IReadOnlyList<TreeViewNode> children = Project.Folders
                    .Where(x => string.Equals(x.ParentFolderId, folder.FolderId, StringComparison.Ordinal))
                    .OrderBy(x => x.SortOrder)
                    .SelectMany(child => BuildFolderNodes([child]))
                    .Concat(Project.BusinessObjectDefinitions
                        .Where(x => string.Equals(x.FolderId, folder.FolderId, StringComparison.Ordinal))
                        .Where(DefinitionMatchesSearch)
                        .OrderBy(x => x.DisplayName, StringComparer.Ordinal)
                        .Select(definition => new TreeViewNode
                        {
                            Id = definition.DefinitionId,
                            Text = definition.DisplayName,
                            Icon = definition.Kind == SimulationBusinessObjectDefinitionKind.RuleDefinition ? "rule" : "draft",
                            BadgeText = definition.Kind.ToString(),
                            Tooltip = $"{definition.DisplayName} · {definition.Kind} · {definition.ObjectType} · schema {definition.SchemaVersion} · owner BU {definition.OwnerBusinessUnitId?.Value ?? "not assigned"}",
                            IsSelected = definition.DefinitionId == SelectedId,
                            DataTestId = $"simulation-bo-node-{definition.DefinitionId}"
                        }))
                    .ToArray();
                return new TreeViewNode
                {
                    Id = folder.FolderId,
                    Text = folder.DisplayName,
                    Icon = "folder",
                    BadgeText = folder.Kind.ToString(),
                    Tooltip = $"{folder.DisplayName} · {folder.Kind} · {children.Count} item(s)",
                    Children = children,
                    IsExpanded = !string.IsNullOrWhiteSpace(definitionSearch) || expandedNodeIds.Contains(folder.FolderId),
                    IsSelected = folder.FolderId == SelectedId,
                    DataTestId = $"simulation-bo-folder-{folder.FolderId}"
                };
            })
            .ToArray();

    private Task SelectNode(string nodeId)
    {
        selectedNodeId = nodeId;
        EnsureSelectedAncestryExpanded();
        return Task.CompletedTask;
    }

    private Task ToggleNode(string nodeId)
    {
        if (!expandedNodeIds.Add(nodeId))
        {
            expandedNodeIds.Remove(nodeId);
        }

        return Task.CompletedTask;
    }

    private bool DefinitionMatchesSearch(SimulationBusinessObjectDefinitionState definition)
        => string.IsNullOrWhiteSpace(definitionSearch)
            || definition.DisplayName.Contains(definitionSearch, StringComparison.OrdinalIgnoreCase)
            || definition.DefinitionId.Contains(definitionSearch, StringComparison.OrdinalIgnoreCase)
            || definition.ObjectType.Contains(definitionSearch, StringComparison.OrdinalIgnoreCase)
            || definition.Kind.ToString().Contains(definitionSearch, StringComparison.OrdinalIgnoreCase);

    private void EnsureSelectedAncestryExpanded()
    {
        string? folderId = SelectedDefinition?.FolderId ?? SelectedFolder?.FolderId;
        while (!string.IsNullOrWhiteSpace(folderId))
        {
            expandedNodeIds.Add(folderId);
            folderId = Project.Folders.FirstOrDefault(folder => string.Equals(folder.FolderId, folderId, StringComparison.Ordinal))?.ParentFolderId;
        }
    }

    private void OpenTemplateCatalogueDialog() => isTemplateCatalogueDialogOpen = true;

    private Task CloseTemplateCatalogueDialog()
    {
        isTemplateCatalogueDialogOpen = false;
        return Task.CompletedTask;
    }

    private static string MaterializationTone(SimulationDefinitionMaterializationStatus status)
        => status switch
        {
            SimulationDefinitionMaterializationStatus.Materialized => "success",
            SimulationDefinitionMaterializationStatus.Validated => "info",
            SimulationDefinitionMaterializationStatus.Blocked => "danger",
            _ => "warning"
        };
}
