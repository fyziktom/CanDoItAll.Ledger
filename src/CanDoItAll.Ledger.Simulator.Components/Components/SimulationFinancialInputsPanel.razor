@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<Grid ColumnTemplateLg="minmax(18rem, 0.85fr) minmax(0, 1.5fr)"
      Gap="LayoutGap.Large"
      AlignItems="AlignItems.Start"
      data-testid="simulation-financial-inputs-tab">
    <WorkspacePanel Tone="WorkspacePanelTone.Ghost" Class="min-h-0 overflow-hidden">
        <Stack FillHeight="true" GapScale="LayoutGap.Medium">
            <Split Breakpoint="LayoutBreakpoint.None"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Gap="LayoutGap.Small">
                <Stack GapScale="LayoutGap.Tiny">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="Financial profiles" />
                    <TextBlock TextStyle="TextStyle.H4" Value="@Project.FinancialInputProfiles.Count.ToString(CultureInfo.InvariantCulture)" />
                </Stack>
                <Button Text="Add input" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" />
            </Split>

            @foreach (SimulationFinancialInputProfileState profile in Project.FinancialInputProfiles)
            {
                <SectionCard Title="@profile.DisplayName" Description="@($"{profile.Inputs.Count} typed assumption(s)")">
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (SimulationFinancialInputState input in profile.Inputs.OrderBy(x => x.Kind).ThenBy(x => x.DisplayName, StringComparer.Ordinal))
                        {
                            bool selected = string.Equals(input.InputId, SelectedInputId, StringComparison.Ordinal);
                            <SelectionListItem IsSelected="@selected"
                                               Dense="true"
                                               Title="@input.DisplayName"
                                               Meta="@input.Kind.ToString()"
                                               Summary="@FormatInputValue(input)"
                                               DataTestId="@($"simulation-financial-input-{input.InputId}")"
                                               OnSelect="@(() => SelectInput(input.InputId))" />
                        }
                    </Stack>
                </SectionCard>
            }
        </Stack>
    </WorkspacePanel>

    <WorkspacePanel Class="min-h-0 overflow-auto">
        @if (SelectedInput is not null)
        {
            <Stack GapScale="LayoutGap.Large" data-testid="simulation-selected-financial-input-detail">
                <Split Breakpoint="LayoutBreakpoint.Md"
                       AlignItems="AlignItems.Start"
                       JustifyContent="JustifyContent.SpaceBetween"
                       Gap="LayoutGap.Medium"
                       Wrap="FlexWrap.Wrap">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="@SelectedInput.Kind.ToString()" />
                        <TextBlock TextStyle="TextStyle.H3" Value="@SelectedInput.DisplayName" />
                        <SmallText Text="@SelectedInput.InputId" />
                    </Stack>
                    <Cluster Gap="LayoutGap.Small">
                        <StatusBadge Text="@SelectedInput.Unit.ToString()" Tone="info" />
                        <Button Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                        <Button Text="Validate" Icon="rule" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                    </Cluster>
                </Split>

                <Grid ColumnsLg="4" Gap="LayoutGap.Medium">
                    <SectionCard Title="Current value" Description="@SelectedInput.UnitCode">
                        <TextBlock TextStyle="TextStyle.H4" Value="@FormatInputValue(SelectedInput)" />
                    </SectionCard>
                    <SectionCard Title="Business unit" Description="Scoped assumption owner.">
                        <TextBlock TextStyle="TextStyle.H4" Value="@BusinessUnitName(SelectedInput.BusinessUnitId)" />
                    </SectionCard>
                    <SectionCard Title="Valid from" Description="Inclusive date.">
                        <TextBlock TextStyle="TextStyle.H4" Value="@(SelectedInput.ValidFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "project start")" />
                    </SectionCard>
                    <SectionCard Title="Valid to" Description="Inclusive date.">
                        <TextBlock TextStyle="TextStyle.H4" Value="@(SelectedInput.ValidTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "project end")" />
                    </SectionCard>
                </Grid>

                <FormSection Title="Assumption definition" Description="Typed simulator assumption stored in the project manifest and consumed by deterministic run setup hashes.">
                    <FormRow Split="true">
                        <FormField Text="Input id">
                            <TextBox Value="@SelectedInput.InputId" ReadOnly="true" />
                        </FormField>
                        <FormField Text="Kind">
                            <TextBox Value="@SelectedInput.Kind.ToString()" ReadOnly="true" />
                        </FormField>
                        <FormField Text="Unit">
                            <TextBox Value="@SelectedInput.Unit.ToString()" ReadOnly="true" />
                        </FormField>
                        <FormField Text="Source">
                            <TextBox Value="@(SelectedInput.Source ?? "not set")" ReadOnly="true" />
                        </FormField>
                    </FormRow>
                </FormSection>

                <FormSection Title="Profile inputs" Description="Tax rates, inflation, acquisition, collection timing, supplier terms, wages, and custom drivers roundtrip together.">
                    <DataGrid TItem="SimulationFinancialInputState" Data="SelectedProfileInputs">
                        <DataGridColumn TItem="SimulationFinancialInputState" Property="DisplayName" Title="Input" />
                        <DataGridColumn TItem="SimulationFinancialInputState" Title="Kind">
                            <Template Context="input">
                                <StatusBadge Text="@input.Kind.ToString()" Tone="info" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="SimulationFinancialInputState" Title="Value">
                            <Template Context="input">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@FormatInputValue(input)" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="SimulationFinancialInputState" Title="BU">
                            <Template Context="input">
                                <SmallText Text="@BusinessUnitName(input.BusinessUnitId)" />
                            </Template>
                        </DataGridColumn>
                    </DataGrid>
                </FormSection>

                <ValidationList Messages="InputValidationMessages" />
            </Stack>
        }
    </WorkspacePanel>
</Grid>

@code {
    private string? selectedInputId;

    [Parameter, EditorRequired]
    public SimulationProjectState Project { get; set; } = default!;

    private IReadOnlyList<SimulationFinancialInputState> Inputs => Project.FinancialInputProfiles
        .SelectMany(profile => profile.Inputs)
        .OrderBy(input => input.Kind)
        .ThenBy(input => input.DisplayName, StringComparer.Ordinal)
        .ToArray();

    private string SelectedInputId => selectedInputId ?? Inputs.FirstOrDefault()?.InputId ?? string.Empty;

    private SimulationFinancialInputState? SelectedInput => Inputs.FirstOrDefault(input => string.Equals(input.InputId, SelectedInputId, StringComparison.Ordinal));

    private IReadOnlyList<SimulationFinancialInputState> SelectedProfileInputs => Project.FinancialInputProfiles
        .FirstOrDefault(profile => profile.Inputs.Any(input => string.Equals(input.InputId, SelectedInputId, StringComparison.Ordinal)))
        ?.Inputs ?? [];

    private IReadOnlyList<SimulationProjectValidationMessage> InputValidationMessages => Project.ValidationMessages
        .Where(message => SelectedInput is not null && string.Equals(message.RelatedId, SelectedInput.InputId, StringComparison.Ordinal))
        .ToArray();

    protected override void OnParametersSet()
    {
        selectedInputId ??= Inputs.FirstOrDefault()?.InputId;
    }

    private void SelectInput(string inputId)
    {
        selectedInputId = inputId;
    }

    private string BusinessUnitName(BusinessUnitId? businessUnitId)
    {
        if (businessUnitId is null)
        {
            return "Project";
        }

        return Project.BusinessUnits.FirstOrDefault(x => x.BusinessUnitId == businessUnitId.Value)?.DisplayName ?? businessUnitId.Value.Value;
    }

    private static string FormatInputValue(SimulationFinancialInputState input)
    {
        if (input.Unit == SimulationFinancialInputUnit.Text)
        {
            return input.TextValue ?? "not set";
        }

        if (input.NumericValue is null)
        {
            return "missing";
        }

        return input.Unit switch
        {
            SimulationFinancialInputUnit.Percent => input.NumericValue.Value.ToString("P2", CultureInfo.InvariantCulture),
            SimulationFinancialInputUnit.Amount => input.NumericValue.Value.ToString("#,0.##", CultureInfo.InvariantCulture),
            SimulationFinancialInputUnit.Days => $"{input.NumericValue.Value:#,0.##} days",
            SimulationFinancialInputUnit.Count => input.NumericValue.Value.ToString("#,0.##", CultureInfo.InvariantCulture),
            _ => input.NumericValue.Value.ToString(CultureInfo.InvariantCulture)
        };
    }

}
