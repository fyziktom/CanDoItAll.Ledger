@namespace CanDoItAll.Economy.Simulator.Components.Components

<div class="cda-sim-panel-heading">
    <TextBlock TextStyle="TextStyle.H4" Value="@Title" />
    @if (!string.IsNullOrWhiteSpace(LinkText))
    {
        <span>@LinkText</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? LinkText { get; set; }
}
