@namespace CanDoItAll.Ledger.Simulator.Components.Components

<SectionHead>
    <TextBlock TextStyle="TextStyle.H4" Value="@Title" />
    @if (!string.IsNullOrWhiteSpace(LinkText))
    {
        <SmallText Text="@LinkText" />
    }
</SectionHead>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? LinkText { get; set; }
}
