@namespace CanDoItAll.Economy.Simulator.Components.Components
@using System.Globalization

<PageScaffold Mode="PageScaffoldMode.FocusWorkbench"
              MaxWidthClass="max-w-none"
              Style="height:auto;min-height:100%;overflow:visible;">
    <Header>
        <Split Breakpoint="LayoutBreakpoint.Md"
               AlignItems="AlignItems.Center"
               JustifyContent="JustifyContent.SpaceBetween"
               Gap="LayoutGap.Medium"
               Wrap="FlexWrap.Wrap">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.H4" Value="@Selected.Run.RunId" />
                <SmallText Text="@($"{Selected.Project.Summary.DisplayName} · {Selected.Run.ScenarioName} · {FormatDate(Selected.Run.CurrentDate)}")" />
            </Stack>
            <Cluster Gap="LayoutGap.Small">
                <StatusBadge Text="@DisplayStatus(Selected.Run.Status)" Tone="@LifecycleTone(Selected.Run.Status)" />
                <StatusBadge Text="@($"{Selected.Run.CurrentStep}/{Selected.Run.TotalSteps}")" Tone="info" />
                <Button Text="@PauseResumeText" Icon="@PauseResumeIcon" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@(!CanPauseOrResume)" Click="@PauseOrResumeAsync" />
                <Button Text="Stop" Icon="stop" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@(!CanStop)" Click="@(() => CommandRequested.InvokeAsync(SimulationRunCommandKind.Stop))" />
            </Cluster>
        </Split>
    </Header>

    <ChildContent>
        <ListDetailShell Dense="true"
                         ListPaneWidth="19rem"
                         ListPaneClass="min-h-[34rem]"
                         DetailPaneClass="min-h-[34rem]"
                         data-testid="simulation-run-console-page">
            <ListHeader>
                <ListPanelHeader Title="Runs"
                                 Count="@FilteredRuns.Count.ToString(CultureInfo.InvariantCulture)"
                                 HelpText="Runs refresh automatically. Search by id, scenario, or lifecycle status."
                                 Dense="true" />
            </ListHeader>
            <ListContent>
                <Stack GapScale="LayoutGap.Small">
                    <TextBox Value="@runSearch"
                             ValueChanged="@(value => runSearch = value ?? string.Empty)"
                             Immediate="true"
                             Placeholder="Search runs..."
                             aria-label="Search runs" />

                    <Stack GapScale="LayoutGap.Small"
                           Class="min-h-0 max-h-[48rem] overflow-auto"
                           data-testid="simulation-run-list">
                        @foreach (SimulationRunConsoleState run in FilteredRuns)
                        {
                            bool selected = string.Equals(run.Run.RunId, Selected.Run.RunId, StringComparison.Ordinal);
                            <SelectionListItem IsSelected="@selected"
                                               Dense="true"
                                               Title="@run.Run.RunId"
                                               Meta="@run.Run.ScenarioName"
                                               Summary="@($"Started: {run.Run.StartedAtUtc.ToString("MMM d, yyyy HH:mm", CultureInfo.InvariantCulture)}")"
                                               DataTestId="@($"simulation-run-row-{run.Run.RunId}")"
                                               OnSelect="@(() => SelectRunAsync(run.Run.RunId))">
                                <Status>
                                    <Stack GapScale="LayoutGap.Tiny" AlignItems="AlignItems.End">
                                        <StatusBadge Text="@DisplayStatus(run.Run.Status)" Tone="@LifecycleTone(run.Run.Status)" />
                                        <SmallText Text="@(run.Run.ErrorCount == 0 ? $"{run.Run.WarningCount} warning(s)" : $"{run.Run.ErrorCount} error(s)")" />
                                        <SmallText Text="@FormatDuration(run.Run.WallClockElapsed)" />
                                    </Stack>
                                </Status>
                            </SelectionListItem>
                        }
                    </Stack>

                </Stack>
            </ListContent>

            <DetailContent>
                <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                    <CompactStatStrip data-testid="simulation-run-header">
                        <CompactStat Label="Project" Value="@Selected.Run.ProjectName" Position="TooltipPosition.Right" />
                        <CompactStat Label="Scenario" Value="@Selected.Run.ScenarioName" Position="TooltipPosition.Right" />
                        <CompactStat Label="Status" Value="@DisplayStatus(Selected.Run.Status)" Tone="@LifecycleTone(Selected.Run.Status)" />
                        <CompactStat Label="Step/date" Value="@($"{Selected.Run.CurrentStep}/{Selected.Run.TotalSteps} · {FormatDate(Selected.Run.CurrentDate)}")" />
                        <CompactStat Label="Elapsed" Value="@FormatDuration(Selected.Run.WallClockElapsed)" />
                        <CompactStat Label="Output hash" Value="@Short(Selected.Run.OutputHash)" TooltipText="@Selected.Run.OutputHash" Position="TooltipPosition.Right" />
                        <CompactStat Label="Updated" Value="@Selected.Run.LastUpdatedAtUtc.ToString("HH:mm:ss", CultureInfo.InvariantCulture)" TooltipText="@Selected.Run.LastUpdatedAtUtc.ToString("u", CultureInfo.InvariantCulture)" Position="TooltipPosition.Right" />
                    </CompactStatStrip>

                    @if (Console.CommandMessages.Count > 0)
                    {
                        <ValidationList Messages="Console.CommandMessages" />
                    }

                    <TimelineStepper CurrentStep="@Selected.Run.SelectedStep"
                                     TotalSteps="@Selected.Run.TotalSteps"
                                     AvailableStep="@Selected.Run.AvailableStep"
                                     Mode="@SelectedTimelineMode"
                                     ShowModeToggle="false"
                                     StepLabel="@($"{Selected.Setup.StepPeriod} timeline")"
                                     CurrentLabel="@FormatDate(Selected.Run.CurrentDate)"
                                     StatusText="@TimelineStatusText"
                                     StatusTone="@TimelineStatusTone"
                                     AvailableText="Data available"
                                     FutureText="Not simulated yet"
                                     CanStepBack="@CanStepBack"
                                     CanStepForward="@CanStepForward"
                                     ShowPlayPause="true"
                                     IsPlaying="@(Selected.Run.Status == SimulationRunLifecycleStatus.Running)"
                                     CanPlayPause="@CanPauseOrResume"
                                     PreviousClicked="@StepPreviousAsync"
                                     NextClicked="@StepNextAsync"
                                     PlayPauseClicked="@PauseOrResumeAsync"
                                     StepSelected="@SelectStepAsync"
                                     Ticks="@TimelineTicks"
                                     data-testid="simulation-run-timeline-stepper" />

                    @if (CanApplyInterventions)
                    {
                        <details class="rounded-lg border border-slate-200 bg-white p-3" data-testid="simulation-run-intervention-panel">
                            <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm font-semibold text-slate-900">
                                <span>Manual intervention</span>
                                <Pill Tone="PillTone.Label" Text="@($"{RuntimeInterventionCount} applied")" />
                            </summary>
                            <div class="mt-3">
                            <Stack GapScale="LayoutGap.Medium">
                                <Grid ColumnsMd="2" Gap="LayoutGap.Medium" role="group" aria-label="Intervention type">
                                    <Button Look="ButtonLook.SheetCardGhost"
                                            Class="h-full w-full items-start justify-start text-left"
                                            Style="@ChoiceCardStyle(pendingInterventionKind == SimulationRunInterventionKind.DemandChange)"
                                            aria-pressed="@(pendingInterventionKind == SimulationRunInterventionKind.DemandChange ? "true" : "false")"
                                            data-testid="simulation-intervention-demand"
                                            Click="@(() => SelectInterventionKind(SimulationRunInterventionKind.DemandChange))">
                                        <Stack GapScale="LayoutGap.Tiny" AlignItems="AlignItems.Stretch" Class="w-full">
                                            <Cluster JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Small">
                                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Demand" />
                                                <Pill Tone="PillTone.Label" Text="Intervention" />
                                            </Cluster>
                                            <TextBlock TextStyle="TextStyle.Body2" Value="Forecast quantity or multiplier" />
                                        </Stack>
                                    </Button>
                                    <Button Look="ButtonLook.SheetCardGhost"
                                            Class="h-full w-full items-start justify-start text-left"
                                            Style="@ChoiceCardStyle(pendingInterventionKind == SimulationRunInterventionKind.CapacityExpansion)"
                                            aria-pressed="@(pendingInterventionKind == SimulationRunInterventionKind.CapacityExpansion ? "true" : "false")"
                                            data-testid="simulation-intervention-capacity"
                                            Click="@(() => SelectInterventionKind(SimulationRunInterventionKind.CapacityExpansion))">
                                        <Stack GapScale="LayoutGap.Tiny" AlignItems="AlignItems.Stretch" Class="w-full">
                                            <Cluster JustifyContent="JustifyContent.SpaceBetween" Gap="LayoutGap.Small">
                                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="Production line" />
                                                <Pill Tone="PillTone.Label" Text="Intervention" />
                                            </Cluster>
                                            <TextBlock TextStyle="TextStyle.Body2" Value="CapEx request and depreciation" />
                                        </Stack>
                                    </Button>
                                </Grid>

                                <Grid ColumnTemplate="repeat(auto-fit, minmax(12rem, 1fr))" Gap="LayoutGap.Medium">
                                    <FormField Text="@InterventionTargetLabel">
                                        <DropDown TValue="string"
                                                  Data="InterventionTargetOptions"
                                                  Value="@interventionTargetId"
                                                  ValueChanged="@(value => interventionTargetId = value ?? string.Empty)"
                                                  Placeholder="Choose a target"
                                                  aria-label="@InterventionTargetLabel" />
                                    </FormField>
                                    <FormField Text="Effective date">
                                        <input type="date"
                                               class="min-h-10 w-full min-w-0 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900"
                                               min="@FormatDate(Selected.Run.CurrentDate)"
                                               max="@FormatDate(Selected.Setup.HorizonEndDate)"
                                               value="@interventionEffectiveDate"
                                               @onchange="OnInterventionDateChanged"
                                               aria-label="Intervention effective date" />
                                    </FormField>
                                    @if (pendingInterventionKind == SimulationRunInterventionKind.DemandChange)
                                    {
                                        <FormField Text="Multiplier">
                                            <TextBox Value="@interventionMultiplier"
                                                     ValueChanged="@(value => interventionMultiplier = value ?? string.Empty)"
                                                     Immediate="true" />
                                        </FormField>
                                        <FormField Text="Quantity delta">
                                            <TextBox Value="@interventionQuantityDelta"
                                                     ValueChanged="@(value => interventionQuantityDelta = value ?? string.Empty)"
                                                     Immediate="true" />
                                        </FormField>
                                    }
                                    else
                                    {
                                        <FormField Text="CapEx amount">
                                            <TextBox Value="@interventionAmount"
                                                     ValueChanged="@(value => interventionAmount = value ?? string.Empty)"
                                                     Immediate="true" />
                                        </FormField>
                                        <FormField Text="Depreciation months">
                                            <TextBox Value="@interventionDepreciationMonths"
                                                     ValueChanged="@(value => interventionDepreciationMonths = value ?? string.Empty)"
                                                     Immediate="true" />
                                        </FormField>
                                    }
                                    <FormField Text="Reason">
                                        <TextBox Value="@interventionReason"
                                                 ValueChanged="@(value => interventionReason = value ?? string.Empty)"
                                                 Immediate="true" />
                                    </FormField>
                                </Grid>

                                @if (InterventionValidationMessage is { } interventionValidationMessage)
                                {
                                    <Alert AlertStyle="AlertStyle.Warning">
                                        <strong>Check intervention</strong>
                                        <span>@interventionValidationMessage</span>
                                    </Alert>
                                }

                                <Cluster JustifyContent="JustifyContent.End" Gap="LayoutGap.Small">
                                    <Button Text="Reset" Icon="restart_alt" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@ResetInterventionForm" />
                                    <Button Text="Apply" Icon="playlist_add_check" Disabled="@(!CanSubmitIntervention)" Click="@ApplyInterventionAsync" data-testid="simulation-apply-intervention" />
                                </Cluster>
                            </Stack>
                            </div>
                        </details>
                    }

                    <Tabs AriaLabel="Simulation run observation workspace"
                          Variant="TabsVariant.WorkspaceTertiary"
                          RenderMode="TabRenderMode.Client"
                          SelectedIndex="@selectedObservationTabIndex"
                          SelectedIndexChanged="@OnObservationTabChanged"
                          OverflowMode="TabsOverflowMode.Scroll"
                          PanelOverflowMode="TabsPanelOverflowMode.Visible"
                          data-testid="simulation-run-observation-tabs">
                        <TabsItem Text="State" Icon="monitoring">
                            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" data-testid="simulation-run-state-tab">
                                <div data-testid="simulation-run-kpi-strip">
                                    <SummaryTiles ColumnsSm="2" ColumnsMd="3" ColumnsXl="6" GapScale="LayoutGap.Small">
                                        @foreach (SimulationRunKpiSnapshot kpi in Selected.Kpis)
                                        {
                                            <SummaryTile Label="@kpi.DisplayName"
                                                         Value="@kpi.Value"
                                                         HelperText="@($"{kpi.Unit} | {kpi.DeltaText} | {kpi.SourceLabel}")"
                                                         Tone="@KpiTone(kpi.Tone)"
                                                         Compact="true"
                                                         ShowHelperTextAsTooltip="true" />
                                        }
                                    </SummaryTiles>
                                </div>

                                <Grid ColumnTemplateLg="minmax(0, 1.15fr) minmax(0, 0.85fr)"
                                      Gap="LayoutGap.Medium">
                                    <PanelCard data-testid="simulation-run-events-panel">
                                        <Stack GapScale="LayoutGap.Medium">
                                            <PanelHeading Title="Recent events" />
                                            <DataGrid TItem="SimulationRunEventState" Data="Selected.Events.Take(5)" Caption="Recent simulation events">
                                                <DataGridColumn TItem="SimulationRunEventState" Title="Time (sim)">
                                                    <Template Context="item"><TextBlock Value="@FormatDate(item.SimulationDate)" /></Template>
                                                </DataGridColumn>
                                                <DataGridColumn TItem="SimulationRunEventState" Title="Level">
                                                    <Template Context="item"><StatusBadge Text="@item.Level.ToString()" Tone="@SeverityTone(item.Level)" /></Template>
                                                </DataGridColumn>
                                                <DataGridColumn TItem="SimulationRunEventState" Property="Source" Title="Source" />
                                                <DataGridColumn TItem="SimulationRunEventState" Property="Message" Title="Message" />
                                            </DataGrid>
                                        </Stack>
                                    </PanelCard>

                                    <PanelCard data-testid="simulation-run-top-issues-panel">
                                        <Stack GapScale="LayoutGap.Medium">
                                            <PanelHeading Title="@($"Top issues ({Selected.TopIssues.Count})")" />
                                            <DataGrid TItem="SimulationRunTopIssueState" Data="Selected.TopIssues.Take(4)" Caption="Top simulation issues">
                                                <DataGridColumn TItem="SimulationRunTopIssueState" Title="Severity">
                                                    <Template Context="issue"><StatusBadge Text="@issue.Severity.ToString()" Tone="@SeverityTone(issue.Severity)" /></Template>
                                                </DataGridColumn>
                                                <DataGridColumn TItem="SimulationRunTopIssueState" Property="Source" Title="Source" />
                                                <DataGridColumn TItem="SimulationRunTopIssueState" Title="Issue">
                                                    <Template Context="issue">
                                                        <Stack GapScale="LayoutGap.Tiny">
                                                            <TextBlock Value="@issue.Issue" />
                                                            <SmallText Text="@($"First: {FormatDate(issue.FirstSeen)}")" />
                                                        </Stack>
                                                    </Template>
                                                </DataGridColumn>
                                            </DataGrid>
                                        </Stack>
                                    </PanelCard>

                                    <PanelCard data-testid="simulation-run-resources-panel">
                                        <Stack GapScale="LayoutGap.Medium">
                                            <PanelHeading Title="Resource usage" />
                                            @foreach (SimulationRunResourceMetricState metric in Selected.ResourceUsage.Metrics)
                                            {
                                                <Grid ColumnTemplateSm="5.5rem minmax(4rem, 1fr) minmax(5rem, 7rem)"
                                                      Gap="LayoutGap.Small"
                                                      AlignItems="AlignItems.Center">
                                                    <TextBlock Value="@metric.DisplayName" />
                                                    <ProgressBar Value="@((double)metric.Percent)" Max="100" aria-label="@($"{metric.DisplayName} utilization")" />
                                                    <SmallText Text="@metric.Detail" />
                                                </Grid>
                                            }
                                        </Stack>
                                    </PanelCard>
                                </Grid>

                                <PanelCard data-testid="simulation-run-pipeline-panel">
                                    <Stack GapScale="LayoutGap.Medium">
                                        <PanelHeading Title="Simulation pipeline" />
                                        <Grid ColumnTemplate="repeat(auto-fit, minmax(8.5rem, 1fr))" Gap="LayoutGap.Small">
                                            @foreach (SimulationRunPipelineStepState step in Selected.Pipeline.OrderBy(x => x.SortOrder))
                                            {
                                                <PanelCard Soft="true">
                                                    <Stack GapScale="LayoutGap.Tiny">
                                                        <StatusBadge Text="@($"{step.SortOrder}. {step.DisplayName}")" Tone="@PipelineTone(step.Status)" />
                                                        <SmallText Text="@(step.Duration is null ? step.Detail : FormatDuration(step.Duration.Value))" />
                                                    </Stack>
                                                </PanelCard>
                                            }
                                        </Grid>
                                    </Stack>
                                </PanelCard>

                            </Stack>
                        </TabsItem>
                        <TabsItem Text="Summary" Icon="calendar_view_month">
                            <SimulationPeriodSummaryPanel Run="Selected" />
                        </TabsItem>
                        <TabsItem Text="Graphs" Icon="monitoring">
                            <div data-testid="simulation-run-graphs-tab">
                                <EconomyScenarioGraphPanel Graphs="Selected.Observation.Graphs"
                                                           BusinessUnits="GraphBusinessUnits"
                                                           AddressBindings="GraphAddressBindings"
                                                           CurrencyCode="@Selected.Project.Model.BaseCurrencyCode" />
                            </div>
                        </TabsItem>
                        <TabsItem Text="BUs" Icon="account_tree">
                            <SimulationRunBusinessUnitObservationPanel Project="Selected.Project"
                                                                       Observation="Selected.Observation" />
                        </TabsItem>
                        <TabsItem Text="Evidence" Icon="rule" BadgeText="@Selected.Observation.RuleEvidence.Count.ToString(CultureInfo.InvariantCulture)">
                            <Grid ColumnsLg="1" Gap="LayoutGap.Medium" data-testid="simulation-run-bo-evidence-tab">
                                <FormSection Title="Rule execution evidence" Description="Evidence generated by existing account-rule automation contracts.">
                                    <DataGrid TItem="RuleExecutionEvidenceState" Data="Selected.Observation.RuleEvidence">
                                        <DataGridColumn TItem="RuleExecutionEvidenceState" Property="RuleId" Title="Rule" />
                                        <DataGridColumn TItem="RuleExecutionEvidenceState" Title="Status">
                                            <Template Context="evidence">
                                                <StatusBadge Text="@evidence.Status" Tone="@StatusTone(evidence.Status)" />
                                            </Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="RuleExecutionEvidenceState" Property="ActionKind" Title="Action" />
                                        <DataGridColumn TItem="RuleExecutionEvidenceState" Property="Message" Title="Message" />
                                    </DataGrid>
                                </FormSection>

                                <FormSection Title="Output source map" Description="Visible KPI and option outputs mapped to BOs, BUs, and rule evidence.">
                                    <DataGrid TItem="SimulationOutputSourceRef" Data="Selected.OutputSources" AllowPaging="true" PageSize="8">
                                        <DataGridColumn TItem="SimulationOutputSourceRef" Property="DisplayName" Title="Output" />
                                        <DataGridColumn TItem="SimulationOutputSourceRef" Property="SourceKind" Title="Source" />
                                        <DataGridColumn TItem="SimulationOutputSourceRef" Property="BusinessUnitName" Title="BU" />
                                        <DataGridColumn TItem="SimulationOutputSourceRef" Property="RuleId" Title="Rule" />
                                    </DataGrid>
                                </FormSection>
                            </Grid>
                        </TabsItem>
                        <TabsItem Text="Issues" Icon="report_problem" BadgeText="@Selected.Observation.Issues.Count.ToString(CultureInfo.InvariantCulture)">
                            <Stack GapScale="LayoutGap.Medium" data-testid="simulation-run-issues-tab">
                                <Grid ColumnTemplate="minmax(12rem, 1fr) minmax(10rem, 0.45fr) auto" Gap="LayoutGap.Small" AlignItems="AlignItems.End">
                                    <TextBox Value="@issueSearch"
                                             ValueChanged="@(value => issueSearch = value ?? string.Empty)"
                                             Immediate="true"
                                             Placeholder="Search issues..."
                                             aria-label="Search run issues" />
                                    <DropDown TValue="string"
                                              Data="IssueSeverityOptions"
                                              Placeholder="All severities"
                                              AllowClear="true"
                                              Value="@selectedIssueSeverity"
                                              ValueChanged="@(value => selectedIssueSeverity = value)"
                                              aria-label="Filter issues by severity" />
                                    <CompactStat Label="Matches" Value="@FilteredIssues.Count.ToString(CultureInfo.InvariantCulture)" />
                                </Grid>
                                <DataGrid TItem="SimulationIssue" Data="FilteredIssues" AllowPaging="true" PageSize="8">
                                    <DataGridColumn TItem="SimulationIssue" Title="Date">
                                        <Template Context="issue">
                                            <TextBlock TextStyle="TextStyle.Body2" Value="@FormatDate(issue.Date)" />
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SimulationIssue" Property="Code" Title="Code" />
                                    <DataGridColumn TItem="SimulationIssue" Title="Severity">
                                        <Template Context="issue">
                                            <StatusBadge Text="@issue.Severity" Tone="@StatusTone(issue.Severity)" />
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SimulationIssue" Title="Business unit">
                                        <Template Context="issue">
                                            <SmallText Text="@BusinessUnitName(issue.BusinessUnitId)" />
                                        </Template>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="SimulationIssue" Property="Message" Title="Message" />
                                </DataGrid>
                            </Stack>
                        </TabsItem>
                        <TabsItem Text="Artifacts" Icon="inventory_2" BadgeText="@Selected.Observation.Artifacts.Count.ToString(CultureInfo.InvariantCulture)">
                            <Grid ColumnsLg="2" Gap="LayoutGap.Medium" data-testid="simulation-run-artifacts-tab">
                                <FormSection Title="Artifacts" Description="Generated run outputs and local or persisted paths.">
                                    <DataGrid TItem="SimulationRunArtifactState" Data="Selected.Observation.Artifacts">
                                        <DataGridColumn TItem="SimulationRunArtifactState" Property="DisplayName" Title="Artifact" />
                                        <DataGridColumn TItem="SimulationRunArtifactState" Property="ArtifactType" Title="Type" />
                                        <DataGridColumn TItem="SimulationRunArtifactState" Title="Path">
                                            <Template Context="artifact">
                                                <TooltipTarget Text="@(artifact.Path ?? "Not persisted")" Position="TooltipPosition.Right" TabIndex="0">
                                                    <SmallText Text="@(artifact.Path is null ? "In memory" : Short(artifact.Path))" />
                                                </TooltipTarget>
                                            </Template>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="SimulationRunArtifactState" Title="Hash">
                                            <Template Context="artifact">
                                                <TooltipTarget Text="@artifact.Hash" Position="TooltipPosition.Right" TabIndex="0">
                                                    <MonoText Text="@Short(artifact.Hash)" />
                                                </TooltipTarget>
                                            </Template>
                                        </DataGridColumn>
                                    </DataGrid>
                                </FormSection>

                                <FormSection Title="Current assumptions" Description="Run setup, financial inputs, and sample policy assumptions used by this run.">
                                    <DataGrid TItem="SimulationRunAssumptionItem" Data="Selected.Assumptions">
                                        <DataGridColumn TItem="SimulationRunAssumptionItem" Property="DisplayName" Title="Assumption" />
                                        <DataGridColumn TItem="SimulationRunAssumptionItem" Property="Value" Title="Value" />
                                        <DataGridColumn TItem="SimulationRunAssumptionItem" Property="Source" Title="Source" />
                                    </DataGrid>
                                </FormSection>
                            </Grid>
                        </TabsItem>
                    </Tabs>
                </Stack>
            </DetailContent>
        </ListDetailShell>
    </ChildContent>
</PageScaffold>

@code {
    private const int ObservationTabCount = 7;

    private string runSearch = string.Empty;
    private int selectedObservationTabIndex;
    private bool observationTabIndexInitialized;
    private string interventionFormRunId = string.Empty;
    private SimulationRunInterventionKind pendingInterventionKind = SimulationRunInterventionKind.DemandChange;
    private string interventionTargetId = string.Empty;
    private string interventionEffectiveDate = string.Empty;
    private string interventionMultiplier = "1.25";
    private string interventionQuantityDelta = "0";
    private string interventionAmount = "250000";
    private string interventionDepreciationMonths = "60";
    private string interventionReason = "Management scenario change";
    private string issueSearch = string.Empty;
    private string? selectedIssueSeverity;

    [Parameter]
    public SimulationRunConsoleViewModel? ConsoleViewModel { get; set; }

    [Parameter]
    public int InitialObservationTabIndex { get; set; }

    [Parameter]
    public EventCallback<string> RunSelected { get; set; }

    [Parameter]
    public EventCallback<SimulationRunCommandKind> CommandRequested { get; set; }

    [Parameter]
    public EventCallback<SimulationRunStepRequest> StepRequested { get; set; }

    [Parameter]
    public EventCallback<SimulationRunInterventionRequest> InterventionRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (!observationTabIndexInitialized)
        {
            selectedObservationTabIndex = NormalizeObservationTabIndex(InitialObservationTabIndex);
            observationTabIndexInitialized = true;
        }

        if (!string.Equals(interventionFormRunId, Selected.Run.RunId, StringComparison.Ordinal))
        {
            ResetInterventionFormValues();
            interventionFormRunId = Selected.Run.RunId;
            issueSearch = string.Empty;
            selectedIssueSeverity = null;
        }
        else if (!DateOnly.TryParseExact(interventionEffectiveDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly effectiveDate)
            || effectiveDate < Selected.Run.CurrentDate
            || effectiveDate > Selected.Setup.HorizonEndDate)
        {
            interventionEffectiveDate = DefaultInterventionDate().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
    }

    private SimulationRunConsoleViewModel Console => ConsoleViewModel ?? EconomySimulatorSampleData.CreateRunConsole();

    private SimulationRunConsoleState Selected => Console.SelectedRun;

    private decimal ProgressPercent => Selected.Run.TotalSteps <= 0
        ? 0m
        : Math.Clamp(Selected.Run.CurrentStep * 100m / Selected.Run.TotalSteps, 0m, 100m);

    private string PauseResumeText => Selected.Run.Status == SimulationRunLifecycleStatus.Paused ? "Resume" : "Pause";

    private string PauseResumeIcon => Selected.Run.Status == SimulationRunLifecycleStatus.Paused ? "play_arrow" : "pause";

    private bool CanPauseOrResume => Selected.Run.Status is SimulationRunLifecycleStatus.Running or SimulationRunLifecycleStatus.Paused;

    private bool CanStop => Selected.Run.Status is SimulationRunLifecycleStatus.Running or SimulationRunLifecycleStatus.Paused;

    private bool CanStepBack => Selected.Run.SelectedStep > 1;

    private bool CanStepForward => Selected.Run.SelectedStep < Selected.Run.TotalSteps
        && Selected.Run.Status is not SimulationRunLifecycleStatus.Stopped and not SimulationRunLifecycleStatus.Failed;

    private bool CanApplyInterventions => Selected.Run.RunMode == SimulationRunMode.Manual
        && Selected.Run.Status is SimulationRunLifecycleStatus.Paused or SimulationRunLifecycleStatus.Running;

    private int RuntimeInterventionCount => Selected.Project.BusinessObjectDefinitions.Count(definition => definition.ObjectType == EconomySimulatorObjectTypes.RuntimeIntervention);

    private string InterventionTargetLabel => pendingInterventionKind == SimulationRunInterventionKind.DemandChange
        ? "Demand schedule"
        : "Business unit";

    private IReadOnlyList<string> InterventionTargetOptions
    {
        get
        {
            IEnumerable<string> targets = pendingInterventionKind == SimulationRunInterventionKind.DemandChange
                ? Selected.Project.BusinessObjectDefinitions
                    .Where(definition => definition.ObjectType.Contains("schedule", StringComparison.OrdinalIgnoreCase)
                        || definition.Metadata.Values.Any(value => value.Contains("schedule", StringComparison.OrdinalIgnoreCase)))
                    .Select(definition => definition.DefinitionId)
                : Selected.Project.BusinessUnits
                    .Where(unit => unit.Status == BusinessUnitStatus.Active)
                    .Select(unit => unit.BusinessUnitId.Value);

            string defaultTarget = pendingInterventionKind == SimulationRunInterventionKind.DemandChange
                ? DefaultDemandTarget()
                : DefaultCapacityTarget();
            return targets
                .Prepend(defaultTarget)
                .Where(target => !string.IsNullOrWhiteSpace(target))
                .Distinct(StringComparer.Ordinal)
                .Order(StringComparer.Ordinal)
                .ToArray();
        }
    }

    private string? InterventionValidationMessage
    {
        get
        {
            if (string.IsNullOrWhiteSpace(interventionTargetId))
            {
                return "Choose a target.";
            }

            if (!DateOnly.TryParseExact(interventionEffectiveDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly effectiveDate)
                || effectiveDate < Selected.Run.CurrentDate
                || effectiveDate > Selected.Setup.HorizonEndDate)
            {
                return $"Choose a date from {FormatDate(Selected.Run.CurrentDate)} through {FormatDate(Selected.Setup.HorizonEndDate)}.";
            }

            if (string.IsNullOrWhiteSpace(interventionReason))
            {
                return "Explain the reason for the change.";
            }

            if (pendingInterventionKind == SimulationRunInterventionKind.DemandChange)
            {
                if (TryParseDecimal(interventionMultiplier) is not { } multiplier || multiplier <= 0m)
                {
                    return "Multiplier must be a positive number.";
                }

                if (TryParseDecimal(interventionQuantityDelta) is null)
                {
                    return "Quantity delta must be a number.";
                }

                return null;
            }

            if (TryParseDecimal(interventionAmount) is not { } amount || amount <= 0m)
            {
                return "CapEx amount must be a positive number.";
            }

            if (!int.TryParse(interventionDepreciationMonths, NumberStyles.Integer, CultureInfo.InvariantCulture, out int months) || months <= 0)
            {
                return "Depreciation months must be a positive whole number.";
            }

            return null;
        }
    }

