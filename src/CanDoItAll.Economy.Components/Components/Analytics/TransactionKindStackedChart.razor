@namespace CanDoItAll.Economy.Components

<CdaChart Title="Transaction kinds"
          Description="Kind mix across account history."
          Series="Series"
          Options="Options"
          data-testid="cda-transaction-kind-stacked-chart" />

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    private IReadOnlyList<CdaChartSeries> Series
        => Transactions
            .GroupBy(item => item.Kind)
            .Select(group => new CdaChartSeries
            {
                Name = group.Key.ToString(),
                Type = CdaChartType.Bar,
                Points =
                [
                    new CdaChartPoint("Current", group.Count())
                ]
            })
            .ToArray();

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Stacked = true,
        ShowToolbar = false,
        Palette = ["#0f766e", "#2563eb", "#b45309", "#9333ea"]
    };
}
