@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel" data-testid="cda-account-history-chart-panel">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Account analytics</span>
            <h2>Account history</h2>
        </div>
    </header>
    <div class="cda-sdk-dashboard-grid">
        <AccountBalanceTrendChart Workspace="Workspace" />
        <ChartInsightSummary Title="Account facts" Insights="Insights" />
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    private IReadOnlyList<(string Label, string Value)> Insights
        =>
        [
            ("Main balance", Workspace.Balance.MainBalance.ToString()),
            ("UTXOs", Workspace.Balance.UtxoCount.ToString()),
            ("Transactions", Workspace.Transactions.Count.ToString()),
            ("Objects", Workspace.BusinessObjects.Count.ToString())
        ];
}
