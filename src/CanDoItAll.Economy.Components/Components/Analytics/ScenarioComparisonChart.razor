@namespace CanDoItAll.Economy.Components

<CdaChart Title="Scenario comparison"
          Description="Generic current-vs-baseline hooks for future scenario hosts."
          Series="Series"
          Options="Options"
          Class="cda-sdk-chart"
          data-testid="cda-scenario-comparison-chart" />

@code {
    [Parameter]
    public string CurrentScenario { get; set; } = "Current";

    [Parameter]
    public decimal CurrentValue { get; set; } = 126500m;

    private IReadOnlyList<CdaChartSeries> Series
        =>
        [
            new CdaChartSeries
            {
                Name = "Scenario",
                Type = CdaChartType.Bar,
                Points =
                [
                    new CdaChartPoint("Baseline", CurrentValue * 0.82m),
                    new CdaChartPoint(CurrentScenario, CurrentValue),
                    new CdaChartPoint("Stress", CurrentValue * 0.68m)
                ]
            }
        ];

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "main",
        ShowToolbar = false,
        Palette = ["#2563eb", "#0f766e", "#b45309"]
    };
}
