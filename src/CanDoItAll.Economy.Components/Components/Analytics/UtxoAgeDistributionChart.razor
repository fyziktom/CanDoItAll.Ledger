@namespace CanDoItAll.Economy.Components

<CdaChart Title="UTXO age distribution"
          Description="Spendable output age buckets."
          Series="Series"
          Options="Options"
          data-testid="cda-utxo-age-distribution-chart" />

@code {
    [Parameter]
    public IReadOnlyList<LedgerSpendableOutput> Outputs { get; set; } = [];

    [Parameter]
    public DateTimeOffset ViewedAtUtc { get; set; } = DateTimeOffset.UtcNow;

    private IReadOnlyList<CdaChartSeries> Series
        =>
        [
            new CdaChartSeries
            {
                Name = "UTXOs",
                Type = CdaChartType.Bar,
                Points =
                [
                    new CdaChartPoint("< 1h", Outputs.Count(item => (ViewedAtUtc - item.CreatedAt).TotalHours < 1)),
                    new CdaChartPoint("1-12h", Outputs.Count(item => (ViewedAtUtc - item.CreatedAt).TotalHours is >= 1 and < 12)),
                    new CdaChartPoint("12-24h", Outputs.Count(item => (ViewedAtUtc - item.CreatedAt).TotalHours is >= 12 and < 24)),
                    new CdaChartPoint("> 1d", Outputs.Count(item => (ViewedAtUtc - item.CreatedAt).TotalHours >= 24))
                ]
            }
        ];

    private static readonly CdaChartOptions Options = new()
    {
        Type = CdaChartType.Bar,
        XAxisType = CdaChartAxisType.Category,
        Unit = "outputs",
        ShowToolbar = false
    };
}
