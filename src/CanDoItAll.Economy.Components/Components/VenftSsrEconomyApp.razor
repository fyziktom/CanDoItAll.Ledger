@namespace CanDoItAll.Economy.Components

<div class="cda-vef-app">
    <aside class="cda-vef-sidebar">
        <div class="cda-vef-brand">
            <span class="cda-vef-brand-mark">VE</span>
            <strong>VENFT</strong>
            <span class="material-icons" aria-hidden="true">menu</span>
        </div>

        <nav class="cda-vef-nav" aria-label="VENFT economy app">
            @foreach (VenftNavItem item in NavItems)
            {
                <button type="button"
                        class="@NavClass(item.Key)"
                        @onclick="@(() => SelectView(item.Key))">
                    <span class="material-icons" aria-hidden="true">@item.Icon</span>
                    <span>@item.Label</span>
                </button>
            }
        </nav>

        <button type="button" class="cda-vef-account-switch" @onclick="SelectHome">
            <span class="material-icons" aria-hidden="true">account_balance_wallet</span>
            <span>Account</span>
            <span class="material-icons" aria-hidden="true">expand_more</span>
        </button>
    </aside>

    <main class="cda-vef-main">
        <header class="cda-vef-page-header">
            <div>
                <h1>@PageTitle</h1>
                <p class="cda-vef-page-subtitle">@Workspace.ConnectionLabel</p>
            </div>
            <div class="cda-vef-breadcrumb" aria-label="Breadcrumb">
                <span class="material-icons" aria-hidden="true">home</span>
                <span>VENFT</span>
                <span>/</span>
                <strong>@(Workspace.AccountAlias ?? PageTitle)</strong>
            </div>
        </header>

        @if (selectedView == "gallery")
        {
            <BusinessObjectLedgerGallery Workspace="Workspace"
                                         SendRequested="BusinessObjectSendRequested"
                                         SetPriceRequested="BusinessObjectSetPriceRequested"
                                         TransactionDetailsRequested="BusinessObjectTransactionDetailsRequested"
                                         TicketVerificationRequested="BusinessObjectTicketVerificationRequested"
                                         TicketUseRequested="BusinessObjectTicketUseRequested" />
        }
        else if (IsCreationView)
        {
            <BusinessObjectCreationWizard Model="CreationWizardForSelectedView"
                                          Workspace="Workspace"
                                          StageBusinessObjectRequested="StageBusinessObjectAsync"
                                          StageBusinessObjectBatchRequested="StageBusinessObjectBatchAsync"
                                          EventBusinessObjectLookupRequested="BusinessObjectEventLookupRequested" />
        }
        else if (selectedView == "rule")
        {
            <AccountRuleDesigner Workspace="Workspace"
                                 SubmitRequested="RuleTokenCreateRequested" />
        }
        else if (selectedView == "intro")
        {
            <SectionCard Title="Introduction" Description="VENFT-style SSR surface backed by the real in-memory economy session.">
                <Grid ColumnsLg="3" Gap="LayoutGap.Medium">
                    <div class="cda-economy-fact"><span>Ledger</span><strong>@Workspace.Context.LedgerId</strong></div>
                    <div class="cda-economy-fact"><span>Scenario</span><strong>@(Workspace.Context.ScenarioId?.Value ?? "live")</strong></div>
                    <div class="cda-economy-fact"><span>Viewed at UTC</span><strong>@Workspace.ViewedAtUtc.ToString("u")</strong></div>
                </Grid>
            </SectionCard>
        }
        else
        {
            <EconomyAccountWorkspace Workspace="Workspace"
                                     RefreshRequested="RefreshRequested"
                                     CreateSubAccountRequested="CreateSubAccountRequested"
                                     ValidateRequested="ValidateRequested"
                                     CreateTokenRequested="CreateTokenRequested"
                                     AddTransactionRequested="OpenSendTransactionRequested"
                                     TransactionDetailsRequested="TransactionDetailsRequested"
                                     BusinessObjectTransactionDetailsRequested="BusinessObjectTransactionDetailsRequested"
                                     BusinessObjectSendRequested="BusinessObjectSendRequested"
                                     BusinessObjectSetPriceRequested="BusinessObjectSetPriceRequested"
                                     TransactionSubmitRequested="TransactionSubmitRequested"
                                     BusinessObjectTicketVerificationRequested="BusinessObjectTicketVerificationRequested"
                                     BusinessObjectTicketUseRequested="BusinessObjectTicketUseRequested"
                                     MessageSignRequested="MessageSignRequested"
                                     MessageVerifyRequested="MessageVerifyRequested"
                                     MessageEncryptRequested="MessageEncryptRequested"
                                     MessageDecryptRequested="MessageDecryptRequested" />
        }
    </main>
</div>

@code {
    private static readonly IReadOnlyList<VenftNavItem> NavItems = new[]
        {
            new VenftNavItem("home", "Home", "home"),
            new VenftNavItem("gallery", "Gallery", "photo_library")
        }
        .Concat(BusinessObjectFamilyCatalog.UserMintableFamilies.Select(family => new VenftNavItem(family.ObjectType, $"New {family.DisplayName}", family.Icon)))
        .Concat(
        [
            new VenftNavItem("rule", "New Rule", "account_tree"),
            new VenftNavItem("intro", "Introduction", "help")
        ])
        .ToArray();

    private string selectedView = "home";
    private string? appliedInitialView;

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public string? InitialView { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }

    [Parameter]
    public EventCallback ValidateRequested { get; set; }

    [Parameter]
    public EventCallback OpenSendTransactionRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> TransactionSubmitRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectBatchTransactionRequest> TransactionBatchSubmitRequested { get; set; }

    [Parameter]
    public EventCallback<EconomyRuleTokenCreationRequest> RuleTokenCreateRequested { get; set; }

    [Parameter]
    public EventCallback<LedgerTransactionSummary> TransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> BusinessObjectTransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback CreateTokenRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSetPriceRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? BusinessObjectTicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<EconomyTransactionExecutionResult>>? BusinessObjectTicketUseRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectEventLookupRequest, Task<BusinessObjectEventLookupResult>>? BusinessObjectEventLookupRequested { get; set; }

    [Parameter]
    public Func<MessageSecuritySignRequest, Task<MessageSecurityActionResult>>? MessageSignRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityVerifyRequest, Task<MessageSecurityActionResult>>? MessageVerifyRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityEncryptRequest, Task<MessageSecurityActionResult>>? MessageEncryptRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityDecryptRequest, Task<MessageSecurityActionResult>>? MessageDecryptRequested { get; set; }

    protected override void OnParametersSet()
    {
        string? normalizedInitialView = NormalizeView(InitialView);
        if (normalizedInitialView is not null && !string.Equals(appliedInitialView, normalizedInitialView, StringComparison.Ordinal))
        {
            selectedView = normalizedInitialView;
            appliedInitialView = normalizedInitialView;
        }
    }

    private string PageTitle
        => selectedView == "gallery"
            ? "Gallery"
            : IsCreationView
                ? $"Add New {BusinessObjectFamilyCatalog.FindOrDefault(selectedView).DisplayName}"
                : selectedView switch
                {
                    "rule" => "Add New Rule",
                    "intro" => "Introduction",
                    _ => "VENFT"
                };

    private BusinessObjectCreationWizardModel CreationWizardForSelectedView
    {
        get
        {
            BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(selectedView);
            return new(
                definition.ObjectType,
                Step: 1,
                BusinessObjectPayloadBuilder.DefaultName(definition),
                "#VEFramework #Neblio #NET #Blazor #OpenSource",
                definition.Description,
                Workspace.TransactionDraft.StateJson,
                [],
                null);
        }
    }

    private bool IsCreationView
        => BusinessObjectFamilyCatalog.TryFindByObjectType(selectedView, out BusinessObjectFamilyDefinition definition)
            && definition.IsUserMintable;

    private static string? NormalizeView(string? view)
    {
        if (string.IsNullOrWhiteSpace(view))
        {
            return null;
        }

        string normalized = view.Trim();
        return normalized is "home" or "gallery" or "rule" or "intro"
            || (BusinessObjectFamilyCatalog.TryFindByObjectType(normalized, out BusinessObjectFamilyDefinition definition)
                && definition.IsUserMintable)
            ? normalized
            : null;
    }

    private string NavClass(string view)
        => selectedView == view ? "cda-vef-nav-item is-active" : "cda-vef-nav-item";

    private void SelectView(string view)
    {
        selectedView = view;
    }

    private async Task StageBusinessObjectAsync(BusinessObjectTransactionDraft draft)
    {
        await TransactionSubmitRequested.InvokeAsync(draft);
        selectedView = "gallery";
    }

    private async Task StageBusinessObjectBatchAsync(BusinessObjectBatchTransactionRequest request)
    {
        await TransactionBatchSubmitRequested.InvokeAsync(request);
        selectedView = "gallery";
    }

    private void SelectHome()
    {
        selectedView = "home";
    }

    private sealed record VenftNavItem(string Key, string Label, string Icon);
}
