@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject SideMenuService SideMenus

<div class="cda-venft-theme">
    <Layout FitViewport="true"
            LockOverflow="true"
            Class="cda-venft-shell">
    <SideMenu MenuId="@MenuId"
              Title="VENFT BO"
              Subtitle="Business object demo"
              Icon="deployed_code"
              AriaLabel="Business object demo"
              Items="@PrimaryMenuItems"
              BottomItems="@BottomMenuItems"
              ItemSelected="HandleMenuSelection"
              FillHeight="true" />

    <Body FillHeight="true" Scrollable="true" Class="min-w-0 p-4 md:p-5">
        <PageScaffold MaxWidthClass="max-w-full">
            <Header>
                <PageHeader Eyebrow="VENFT BO"
                            Title="@PageTitle"
                            Description="@PageSubtitle">
                    <Actions>
                        <nav class="cda-venft-breadcrumb" aria-label="Breadcrumb">
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.NoWrap">
                                <Icon Name="home" />
                                <span>VENFT BO</span>
                                <span>/</span>
                                <strong>@PageTitle</strong>
                            </Cluster>
                        </nav>
                    </Actions>
                </PageHeader>
            </Header>
            <ChildContent>
                @if (selectedView == "account" || selectedView == "home")
                {
                    <AccountBackupPanel Model="AccountBackup" CreateSubAccountRequested="OpenSubAccountDialogAsync" />
                }

                @if (selectedView == "gallery" || selectedView == "home")
                {
                    <BusinessObjectGallery Items="GalleryItems" />
                }

                @if (IsCreationView)
                {
                    <BusinessObjectCreationWizard Model="WizardForSelectedView" />
                }
            </ChildContent>
        </PageScaffold>
    </Body>
    </Layout>
</div>

@code {
    private const string MenuId = "economy-bo-demo";

    [Parameter, EditorRequired]
    public AccountBackupWorkflowModel AccountBackup { get; set; } = default!;

    [Parameter, EditorRequired]
    public BusinessObjectCreationWizardModel PostWizard { get; set; } = default!;

    [Parameter, EditorRequired]
    public BusinessObjectCreationWizardModel ImageWizard { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<BusinessObjectGalleryItem> GalleryItems { get; set; } = default!;

    private string selectedView = "gallery";

    private static readonly IReadOnlyList<VenftNavItem> NavItems = new[]
        {
            new VenftNavItem("home", "Home", "home"),
            new VenftNavItem("gallery", "Gallery", "photo_library")
        }
        .Concat(BusinessObjectFamilyCatalog.UserMintableFamilies.Select(family => new VenftNavItem(family.ObjectType, $"New {family.DisplayName}", family.Icon)))
        .Concat([new VenftNavItem("account", "Account", "account_circle")])
        .ToArray();

    private static readonly IReadOnlyList<ISideMenuItem> PrimaryMenuItems = NavItems
        .Where(item => !string.Equals(item.Key, "account", StringComparison.Ordinal))
        .Select(ToMenuItem)
        .ToArray();

    private static readonly IReadOnlyList<ISideMenuItem> BottomMenuItems =
    [
        ToMenuItem(NavItems.Single(item => string.Equals(item.Key, "account", StringComparison.Ordinal))),
        new SideMenuItemDefinition
        {
            Id = "backup-ready",
            Text = "Backup ready",
            Icon = "lock",
            Description = "The account backup workflow is ready.",
            Disabled = true
        }
    ];

    private BusinessObjectCreationWizardModel WizardForSelectedView
        => selectedView switch
        {
            "image" => ImageWizard,
            "post" => PostWizard,
            _ => CreateDefaultWizard(selectedView)
        };

    private string PageTitle
        => IsCreationView
            ? $"Add New {BusinessObjectFamilyCatalog.FindOrDefault(selectedView).DisplayName}"
            : selectedView switch
            {
                "account" => "Account",
                "home" => "Home",
                _ => "Gallery"
            };

    private string PageSubtitle
        => IsCreationView
            ? "Upload data, add information, and stage a BO transaction."
            : selectedView switch
        {
            "account" => "Create, import, backup, and manage subaccounts.",
            "home" => "Account controls and latest BusinessObjects.",
            _ => "Browse Image and Post BusinessObjects by address and tags."
        };

    private bool IsCreationView
        => BusinessObjectFamilyCatalog.TryFindByObjectType(selectedView, out BusinessObjectFamilyDefinition definition)
            && definition.IsUserMintable;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SideMenus.SelectAsync(MenuId, selectedView);
        }
    }

    private static BusinessObjectCreationWizardModel CreateDefaultWizard(string objectType)
    {
        BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(objectType);
        return new(
            definition.ObjectType,
            1,
            BusinessObjectPayloadBuilder.DefaultName(definition),
            "#VEFramework #NET #Blazor #OpenSource",
            definition.Description,
            string.Empty,
            [],
            null);
    }

    private void SelectView(string view)
    {
        selectedView = view;
    }

    private void HandleMenuSelection(SideMenuSelection selection)
        => SelectView(selection.ItemId);

    private static SideMenuItemDefinition ToMenuItem(VenftNavItem item)
        => new()
        {
            Id = item.Key,
            Text = item.Label,
            Icon = item.Icon,
            Description = item.Label
        };

    private Task OpenSubAccountDialogAsync()
        => DialogService.OpenAsync<SubAccountCreateDialogContent>(
            "Add New SubAccount",
            new Dictionary<string, object?>
            {
                [nameof(SubAccountCreateDialogContent.ParentAddress)] = AccountBackup.Address.Value
            },
            new DialogOptions
            {
                Subtitle = "Create a child account under the current session.",
                Size = ModalSize.Medium,
                TestId = "cda-subaccount-dialog"
            });

    private sealed record VenftNavItem(string Key, string Label, string Icon);
}
