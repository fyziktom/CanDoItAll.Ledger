@namespace CanDoItAll.Economy.Components

<div class="cda-economy-theme">
    <Layout FitViewport="true"
            LockOverflow="true"
            Class="cda-economy-shell"
            data-testid="cda-economy-shell">
    <SideMenu @ref="navigationMenu"
              MenuId="@MenuId"
              @bind-Expanded="navigationExpanded"
              PersistenceKey="@MenuPersistenceKey"
              Title="Economy"
              Subtitle="@Workspace.AccountName"
              Icon="account_balance_wallet"
              AriaLabel="Economy account app"
              Items="@NavigationItems"
              BottomItems="@AccountItems"
              FillHeight="true"
              ItemSelected="HandleNavigationSelectionAsync"
              data-testid="cda-economy-navigation" />

    <Body FillHeight="true" Scrollable="true" Class="min-w-0 p-3.5 sm:p-4 md:p-5">
        <PageScaffold Mode="PageScaffoldMode.FocusWorkbench"
                      MaxWidthClass="max-w-full"
                      data-testid="cda-economy-main">
            <Header>
                <PageHeader Eyebrow="@HeaderEyebrow"
                            Title="@PageTitle"
                            Compact="true">
                    <Stats>
                        @if (!string.IsNullOrWhiteSpace(Workspace.ConnectionLabel)
                            || !string.IsNullOrWhiteSpace(HostModeLabel)
                            || !string.IsNullOrWhiteSpace(SigningModeLabel))
                        {
                            <Cluster Gap="LayoutGap.Small" data-testid="adapter-host-mode">
                                @if (!string.IsNullOrWhiteSpace(Workspace.ConnectionLabel))
                                {
                                    <StatusBadge Text="@Workspace.ConnectionLabel" Tone="neutral" />
                                }
                                @if (!string.IsNullOrWhiteSpace(HostModeLabel))
                                {
                                    <StatusBadge Text="@HostModeLabel" Tone="info" />
                                }
                                @if (!string.IsNullOrWhiteSpace(SigningModeLabel))
                                {
                                    <StatusBadge Text="@SigningModeLabel" Tone="neutral" />
                                }
                            </Cluster>
                        }
                    </Stats>
                </PageHeader>
            </Header>

            <ChildContent>
                @if (selectedView == "gallery")
                {
                <BusinessObjectLedgerGallery Workspace="Workspace"
                                             SendRequested="BusinessObjectSendRequested"
                                             SetPriceRequested="BusinessObjectSetPriceRequested"
                                             EditRequested="StageBusinessObjectAsync"
                                             TransactionDetailsRequested="BusinessObjectTransactionDetailsRequested"
                                             TicketVerificationRequested="BusinessObjectTicketVerificationRequested"
                                             TicketUseRequested="BusinessObjectTicketUseRequested" />
                }
                else if (selectedView == "messaging")
                {
                <SecureMessagingWorkspace Workspace="Workspace"
                                          SendRequested="SecureMessageSendRequested"
                                          OpenRequested="SecureMessageOpenRequested"
                                          AttachmentOpenRequested="SecureMessageAttachmentOpenRequested" />
                }
                else if (IsCreationView)
                {
                <BusinessObjectCreationWizard Model="CreationWizardForSelectedView"
                                              Workspace="Workspace"
                                              StageBusinessObjectRequested="StageBusinessObjectAsync"
                                              StageBusinessObjectBatchRequested="StageBusinessObjectBatchAsync"
                                              EventBusinessObjectLookupRequested="BusinessObjectEventLookupRequested" />
                }
                else if (selectedView == "rule")
                {
                <AccountRuleDesigner Workspace="Workspace"
                                     SubmitRequested="RuleTokenCreateRequested" />
                }
                else if (selectedView == "intro")
                {
                <SectionCard Title="Introduction" Description="Economy account workspace backed by the real in-memory economy session.">
                    <Grid ColumnsLg="3" Gap="LayoutGap.Medium">
                        <SummaryTile Label="Ledger" Value="@Workspace.Context.LedgerId.Value" Compact="true" />
                        <SummaryTile Label="Scenario" Value="@(Workspace.Context.ScenarioId?.Value ?? "live")" Compact="true" />
                        <SummaryTile Label="Viewed at UTC" Value="@Workspace.ViewedAtUtc.ToString("u")" Compact="true" />
                    </Grid>
                </SectionCard>
                }
                else
                {
                <EconomyAccountWorkspace Workspace="Workspace"
                                         RefreshRequested="RefreshRequested"
                                         CreateSubAccountRequested="CreateSubAccountRequested"
                                         ValidateRequested="ValidateRequested"
                                         CreateTokenRequested="CreateTokenRequested"
                                         AddTransactionRequested="OpenSendTransactionRequested"
                                         TransactionDetailsRequested="TransactionDetailsRequested"
                                         BusinessObjectTransactionDetailsRequested="BusinessObjectTransactionDetailsRequested"
                                         BusinessObjectSendRequested="BusinessObjectSendRequested"
                                         BusinessObjectSetPriceRequested="BusinessObjectSetPriceRequested"
                                         TransactionSubmitRequested="TransactionSubmitRequested"
                                         BusinessObjectTicketVerificationRequested="BusinessObjectTicketVerificationRequested"
                                         BusinessObjectTicketUseRequested="BusinessObjectTicketUseRequested"
                                         MessageSignRequested="MessageSignRequested"
                                         MessageVerifyRequested="MessageVerifyRequested"
                                         MessageEncryptRequested="MessageEncryptRequested"
                                         MessageDecryptRequested="MessageDecryptRequested" />
                }
            </ChildContent>
        </PageScaffold>
    </Body>
    </Layout>
</div>

@code {
    private const string MenuId = "economy-account-primary";
    private const string MenuPersistenceKey = "cda.side-menu.economy-account-primary.expanded.v2";

    private static readonly IReadOnlyList<ISideMenuItem> NavigationItems = new[]
        {
            CreateNavigationItem("home", "Home", "home", "Account overview and balances.", SideMenuOverflowBehavior.PreferVisible),
            CreateNavigationItem("gallery", "Gallery", "photo_library", "Browse owned business objects.", SideMenuOverflowBehavior.PreferVisible),
            CreateNavigationItem("messaging", "Messaging", "mail", "Open secure account messaging.", SideMenuOverflowBehavior.PreferVisible)
        }
        .Concat(BusinessObjectFamilyCatalog.UserMintableFamilies.Select(family =>
            CreateNavigationItem(family.ObjectType, $"New {family.DisplayName}", family.Icon, family.Description)))
        .Concat(
        [
            CreateNavigationItem("rule", "New Rule", "account_tree", "Create a new account rule."),
            CreateNavigationItem("intro", "Introduction", "help", "Review the active ledger context.", SideMenuOverflowBehavior.AlwaysInMore)
        ])
        .ToArray();

    private static readonly IReadOnlyList<ISideMenuItem> AccountItems =
    [
        new SideMenuItemDefinition
        {
            Id = "account-home",
            Text = "Account",
            Icon = "account_balance_wallet",
            Description = "Return to the account overview.",
            Payload = "home"
        }
    ];

    private string selectedView = "home";
    private string? appliedInitialView;
    private string? pendingMenuSelection = "home";
    private bool navigationExpanded = false;
    private SideMenu? navigationMenu;

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public string? InitialView { get; set; }

    [Parameter]
    public string? HostModeLabel { get; set; }

    [Parameter]
    public string? SigningModeLabel { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }

    [Parameter]
    public EventCallback ValidateRequested { get; set; }

    [Parameter]
    public EventCallback OpenSendTransactionRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> TransactionSubmitRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectBatchTransactionRequest> TransactionBatchSubmitRequested { get; set; }

    [Parameter]
    public EventCallback<EconomyRuleTokenCreationRequest> RuleTokenCreateRequested { get; set; }

    [Parameter]
    public EventCallback<LedgerTransactionSummary> TransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> BusinessObjectTransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback CreateTokenRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSetPriceRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? BusinessObjectTicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<EconomyTransactionExecutionResult>>? BusinessObjectTicketUseRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectEventLookupRequest, Task<BusinessObjectEventLookupResult>>? BusinessObjectEventLookupRequested { get; set; }

    [Parameter]
    public Func<MessageSecuritySignRequest, Task<MessageSecurityActionResult>>? MessageSignRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityVerifyRequest, Task<MessageSecurityActionResult>>? MessageVerifyRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityEncryptRequest, Task<MessageSecurityActionResult>>? MessageEncryptRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityDecryptRequest, Task<MessageSecurityActionResult>>? MessageDecryptRequested { get; set; }

    [Parameter]
    public Func<SecureMessageComposeRequest, Task<EconomyTransactionExecutionResult>>? SecureMessageSendRequested { get; set; }

    [Parameter]
    public Func<SecureMessageOpenRequest, Task<SecureMessageOpenResult>>? SecureMessageOpenRequested { get; set; }

    [Parameter]
    public Func<SecureMessageAttachmentOpenRequest, Task<SecureMessageAttachmentOpenResult>>? SecureMessageAttachmentOpenRequested { get; set; }

    protected override void OnParametersSet()
    {
        string? normalizedInitialView = NormalizeView(InitialView);
        if (normalizedInitialView is not null && !string.Equals(appliedInitialView, normalizedInitialView, StringComparison.Ordinal))
        {
            selectedView = normalizedInitialView;
            appliedInitialView = normalizedInitialView;
            pendingMenuSelection = normalizedInitialView;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (navigationMenu is null || pendingMenuSelection is null)
        {
            return;
        }

        string itemId = pendingMenuSelection;
        pendingMenuSelection = null;
        await navigationMenu.SelectAsync(itemId);
    }

    private string HeaderEyebrow
        => $"Economy / {Workspace.AccountAlias ?? Workspace.AccountName}";

    private string PageTitle
        => selectedView == "gallery"
            ? "Gallery"
            : IsCreationView
                ? $"Add New {BusinessObjectFamilyCatalog.FindOrDefault(selectedView).DisplayName}"
                : selectedView switch
                {
                    "rule" => "Add New Rule",
                    "intro" => "Introduction",
                    "messaging" => "Messaging",
                    _ => "Economy"
                };

    private BusinessObjectCreationWizardModel CreationWizardForSelectedView
    {
        get
        {
            BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(selectedView);
            return new(
                definition.ObjectType,
                Step: 1,
                BusinessObjectPayloadBuilder.DefaultName(definition),
                "#CanDoItAll #NET #Blazor #OpenSource",
                definition.Description,
                Workspace.TransactionDraft.StateJson,
                [],
                null);
        }
    }

    private bool IsCreationView
        => BusinessObjectFamilyCatalog.TryFindByObjectType(selectedView, out BusinessObjectFamilyDefinition definition)
            && definition.IsUserMintable;

    private static string? NormalizeView(string? view)
    {
        if (string.IsNullOrWhiteSpace(view))
        {
            return null;
        }

        string normalized = view.Trim();
        return normalized is "home" or "gallery" or "messaging" or "rule" or "intro"
            || (BusinessObjectFamilyCatalog.TryFindByObjectType(normalized, out BusinessObjectFamilyDefinition definition)
                && definition.IsUserMintable)
            ? normalized
            : null;
    }

    private Task HandleNavigationSelectionAsync(SideMenuSelection selection)
    {
        string? view = selection.Item.Payload as string ?? NormalizeView(selection.ItemId);
        if (view is not null)
        {
            selectedView = view;
        }

        return Task.CompletedTask;
    }

    private async Task StageBusinessObjectAsync(BusinessObjectTransactionDraft draft)
    {
        await TransactionSubmitRequested.InvokeAsync(draft);
        await SelectViewAsync("gallery");
    }

    private async Task StageBusinessObjectBatchAsync(BusinessObjectBatchTransactionRequest request)
    {
        await TransactionBatchSubmitRequested.InvokeAsync(request);
        await SelectViewAsync("gallery");
    }

    private async Task SelectViewAsync(string view)
    {
        selectedView = view;
        if (navigationMenu is null)
        {
            pendingMenuSelection = view;
            return;
        }

        await navigationMenu.SelectAsync(view);
    }

    private static SideMenuItemDefinition CreateNavigationItem(
        string id,
        string text,
        string icon,
        string description,
        SideMenuOverflowBehavior overflowBehavior = SideMenuOverflowBehavior.Auto)
        => new()
        {
            Id = id,
            Text = text,
            Icon = icon,
            Description = description,
            OverflowBehavior = overflowBehavior,
            Payload = id
        };
}
