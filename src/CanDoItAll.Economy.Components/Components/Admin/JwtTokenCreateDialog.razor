@namespace CanDoItAll.Economy.Components

<DialogScaffold Eyebrow="Admin auth"
                Title="Create JWT token"
                Description="The token secret is only shown by the host after creation; this component keeps fields and review separate."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                Footer="@RenderFooter"
                data-testid="cda-jwt-token-create-dialog">
    <div class="cda-sdk-form-grid">
        <FormField Text="Name">
            <TextBox @bind-Value="name" />
        </FormField>
        <FormField Text="Scope">
            <DropDown TItem="string" Value="@scope" ValueChanged="@((string value) => scope = value)" Items="Scopes" />
        </FormField>
        <FormField Text="Expiration">
            <TextBox @bind-Value="expiration" />
        </FormField>
    </div>
</DialogScaffold>

@code {
    private string name = "ops-dashboard";
    private string scope = "read";
    private string expiration = "2026-05-20";
    private static readonly IReadOnlyList<string> Scopes = ["read", "operator", "admin"];

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<SecurityProfilePanel>(0);
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<ActionReviewPanel>(0);
        builder.AddAttribute(1, nameof(ActionReviewPanel.Title), "Token review");
        builder.AddAttribute(2, nameof(ActionReviewPanel.Items), new[]
        {
            new ActionReviewFact("Name", name),
            new ActionReviewFact("Scope", scope),
            new ActionReviewFact("Expires", expiration)
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Cancel");
        builder.AddAttribute(2, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(3);
        builder.AddAttribute(4, nameof(Button.Text), "Create token");
        builder.AddAttribute(5, nameof(Button.Icon), "key");
        builder.CloseComponent();
    };
}
