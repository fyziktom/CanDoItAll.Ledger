@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-node-issue-list">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Issues</span>
            <h2>Node issue review</h2>
        </div>
        <StatusBadge Text="2 open" Tone="warning" />
    </header>
    <div class="cda-sdk-list">
        <article class="cda-sdk-list__row">
            <span class="material-icons" aria-hidden="true">warning</span>
            <div><strong>Legacy route disabled</strong><span>Clients must use api/v1 or configured ApiBasePath.</span></div>
        </article>
        <article class="cda-sdk-list__row">
            <span class="material-icons" aria-hidden="true">info</span>
            <div><strong>Projection rebuild queued</strong><span>Operator approval required before rebuild.</span></div>
        </article>
    </div>
</section>
