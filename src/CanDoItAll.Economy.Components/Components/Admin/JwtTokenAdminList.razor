@namespace CanDoItAll.Economy.Components

<div data-testid="cda-jwt-token-admin-list">
    <SectionCard Title="Issued tokens" Description="JWT tokens">
        <HeaderActions>
            <Button Text="Create token" Icon="add" Variant="Variant.Outlined" />
        </HeaderActions>
        <ChildContent>
            <Stack GapScale="LayoutGap.Small">
                <SurfaceCard Soft="true">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Small"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Cluster Gap="LayoutGap.Small" AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap">
                            <Icon Name="vpn_key" />
                            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="ops-dashboard" />
                                <SmallText Text="read scope - expires 2026-05-20" />
                            </Stack>
                        </Cluster>
                        <StatusBadge Text="active" Tone="success" />
                    </Split>
                </SurfaceCard>
                <SurfaceCard Soft="true">
                    <Split Breakpoint="LayoutBreakpoint.None"
                           Gap="LayoutGap.Small"
                           AlignItems="AlignItems.Start"
                           JustifyContent="JustifyContent.SpaceBetween"
                           Wrap="FlexWrap.Wrap">
                        <Cluster Gap="LayoutGap.Small" AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap">
                            <Icon Name="vpn_key" />
                            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="maintenance" />
                                <SmallText Text="admin scope - expires 2026-05-12" />
                            </Stack>
                        </Cluster>
                        <StatusBadge Text="expires soon" Tone="warning" />
                    </Split>
                </SurfaceCard>
            </Stack>
        </ChildContent>
    </SectionCard>
</div>
