@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-jwt-token-admin-list">
    <header class="cda-sdk-panel__header">
        <div>
            <span>JWT tokens</span>
            <h2>Issued tokens</h2>
        </div>
        <Button Text="Create token" Icon="add" Variant="Variant.Outlined" />
    </header>
    <div class="cda-sdk-list">
        <article class="cda-sdk-list__row">
            <span class="material-icons" aria-hidden="true">vpn_key</span>
            <div>
                <strong>ops-dashboard</strong>
                <small>read scope - expires 2026-05-20</small>
            </div>
            <StatusBadge Text="active" Tone="success" />
        </article>
        <article class="cda-sdk-list__row">
            <span class="material-icons" aria-hidden="true">vpn_key</span>
            <div>
                <strong>maintenance</strong>
                <small>admin scope - expires 2026-05-12</small>
            </div>
            <StatusBadge Text="expires soon" Tone="warning" />
        </article>
    </div>
</section>
