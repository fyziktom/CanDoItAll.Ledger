@namespace CanDoItAll.Economy.Components

@if (Address is null)
{
    <EmptyState Eyebrow="Address" Title="Address unavailable" Description="Select an address from the node console to inspect its ledger footprint." />
}
else
{
    <Stack GapScale="LayoutGap.Medium" Class="cda-node-address-dialog" data-testid="cda-node-address-details">
        <section class="cda-node-address-hero">
            <div>
                <span class="cda-economy-eyebrow">@Address.Role</span>
                <h3>@Address.Label</h3>
                <CopyableMonoValue Value="@Address.Address" />
            </div>
            <StatusBadge Text="@Address.Status" Tone="@(Address.Status == "Active" ? "success" : "warning")" />
        </section>

        <Grid ColumnsLg="4" Gap="LayoutGap.Small">
            <div class="cda-economy-fact"><span>Balance</span><strong>@Address.Balance</strong></div>
            <div class="cda-economy-fact"><span>Objects</span><strong>@Address.BusinessObjects</strong></div>
            <div class="cda-economy-fact"><span>Transactions</span><strong>@Address.Transactions</strong></div>
            <div class="cda-economy-fact"><span>Last seen</span><strong>@Address.LastSeenUtc.ToString("MM.dd HH:mm")</strong></div>
        </Grid>

        <section class="cda-vef-panel">
            <div class="cda-vef-panel-header">Address transactions</div>
            <div class="cda-vef-panel-body cda-node-address-tx-list">
                @if (Transactions.Count == 0)
                {
                    <p class="cda-vef-empty-line">No matching transactions are available for this address.</p>
                }
                else
                {
                    @foreach (NodeAdminTransactionSummary transaction in Transactions)
                    {
                        <article class="cda-node-tx-row">
                            <div>
                                <strong>@transaction.TxId</strong>
                                <span>@transaction.Route</span>
                                <small>@transaction.Kind / @transaction.Status / @transaction.TimestampUtc.ToString("MM.dd.yyyy HH:mm")</small>
                            </div>
                            <Button Text="Open"
                                    Icon="open_in_full"
                                    Size="ButtonSize.Small"
                                    Variant="Variant.Outlined"
                                    Click="@(() => TransactionSelected.InvokeAsync(transaction))" />
                        </article>
                    }
                }
            </div>
        </section>
    </Stack>
}

@code {
    [Parameter]
    public NodeAdminAddressSummary? Address { get; set; }

    [Parameter]
    public IReadOnlyList<NodeAdminTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public EventCallback<NodeAdminTransactionSummary> TransactionSelected { get; set; }
}
