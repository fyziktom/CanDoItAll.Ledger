@namespace CanDoItAll.Economy.Components

@if (Address is null)
{
    <EmptyState Eyebrow="Address" Title="Address unavailable" Description="Select an address from the node console to inspect its ledger footprint." />
}
else
{
    <Stack GapScale="LayoutGap.Medium" data-testid="cda-node-address-details">
        <SurfaceCard Soft="true">
            <Split Breakpoint="LayoutBreakpoint.None"
                   Gap="LayoutGap.Medium"
                   AlignItems="AlignItems.Center"
                   JustifyContent="JustifyContent.SpaceBetween"
                   Wrap="FlexWrap.Wrap">
                <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                    <TextBlock TextStyle="TextStyle.Eyebrow" Value="@Address.Role" />
                    <TextBlock TextStyle="TextStyle.H3" Value="@Address.Label" />
                    <CopyableMonoValue Value="@Address.Address" />
                </Stack>
                <StatusBadge Text="@Address.Status" Tone="@(Address.Status == "Active" ? "success" : "warning")" />
            </Split>
        </SurfaceCard>

        <SummaryTiles ColumnsSm="2" ColumnsXl="4" GapScale="LayoutGap.Small">
            <SummaryTile Label="Balance" Value="@Address.Balance" />
            <SummaryTile Label="Objects" Value="@Address.BusinessObjects.ToString()" />
            <SummaryTile Label="Transactions" Value="@Address.Transactions.ToString()" />
            <SummaryTile Label="Last seen" Value="@Address.LastSeenUtc.ToString("MM.dd HH:mm")" />
        </SummaryTiles>

        <SectionCard Title="Address transactions" Description="Ledger activity associated with this address.">
                @if (Transactions.Count == 0)
                {
                    <EmptyState Title="No matching transactions"
                                Description="No matching transactions are available for this address." />
                }
                else
                {
                    <Stack GapScale="LayoutGap.Small">
                        @foreach (NodeAdminTransactionSummary transaction in Transactions)
                        {
                            <SelectionListItem Title="@transaction.TxId"
                                               Meta="@($"{transaction.Kind} / {transaction.Status} / {transaction.TimestampUtc:MM.dd.yyyy HH:mm}")"
                                               Summary="@transaction.Route"
                                               Dense="true"
                                               OnSelect="@(() => TransactionSelected.InvokeAsync(transaction))">
                                <Actions>
                                    <Button Text="Open"
                                            Icon="open_in_full"
                                            Size="ButtonSize.Small"
                                            Variant="Variant.Outlined"
                                            Click="@(() => TransactionSelected.InvokeAsync(transaction))" />
                                </Actions>
                            </SelectionListItem>
                        }
                    </Stack>
                }
        </SectionCard>
    </Stack>
}

@code {
    [Parameter]
    public NodeAdminAddressSummary? Address { get; set; }

    [Parameter]
    public IReadOnlyList<NodeAdminTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public EventCallback<NodeAdminTransactionSummary> TransactionSelected { get; set; }
}
