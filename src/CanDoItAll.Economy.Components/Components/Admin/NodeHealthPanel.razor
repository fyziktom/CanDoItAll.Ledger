@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-node-health-panel">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Node health</span>
            <h2>@NodeName</h2>
        </div>
        <StatusBadge Text="@Status" Tone="@Tone" />
    </header>
    <div class="cda-sdk-fact-grid">
        <div><span>Base URI</span><strong>@BaseUri</strong></div>
        <div><span>Ledger</span><strong>@LedgerId</strong></div>
        <div><span>Mode</span><strong>@EnvironmentName</strong></div>
        <div><span>Checked</span><strong>@CheckedAtUtc.ToString("u")</strong></div>
    </div>
</section>

@code {
    [Parameter]
    public string NodeName { get; set; } = "Economy node";

    [Parameter]
    public string Status { get; set; } = "Healthy";

    [Parameter]
    public string Tone { get; set; } = "success";

    [Parameter]
    public string BaseUri { get; set; } = "http://localhost:5000/api/v1";

    [Parameter]
    public string LedgerId { get; set; } = "company-economy";

    [Parameter]
    public string EnvironmentName { get; set; } = "Development";

    [Parameter]
    public DateTimeOffset CheckedAtUtc { get; set; } = new(2026, 05, 06, 14, 45, 00, TimeSpan.Zero);
}
