@namespace CanDoItAll.Economy.Components

<div data-testid="cda-admin-key-posture-panel">
    <SectionCard Title="Key posture" Description="Admin key">
        <HeaderActions>
            <StatusBadge Text="Protected" Tone="success" />
        </HeaderActions>
        <ChildContent>
            <SurfaceCard Soft="true">
                <Cluster Gap="LayoutGap.Small" AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap">
                    <Icon Name="admin_panel_settings" />
                    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                        <TextBlock TextStyle="TextStyle.Subtitle2" Value="operator-admin" />
                        <SmallText Text="Signing key is configured outside the browser." />
                        <SmallText Text="Public key hash only: 2ce445a77b90..." />
                    </Stack>
                </Cluster>
            </SurfaceCard>
        </ChildContent>
    </SectionCard>
</div>
