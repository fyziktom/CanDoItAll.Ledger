@namespace CanDoItAll.Economy.Components
@using CanDoItAll.Economy.Components.Samples
@inject DialogService DialogService

<Stack Section="true" GapScale="LayoutGap.Medium" data-testid="cda-node-admin-dashboard">
    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Medium"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Wrap="FlexWrap.Wrap">
        <Stack GapScale="LayoutGap.Tiny">
            <TextBlock TextStyle="TextStyle.Eyebrow" Value="Node admin" />
            <TextBlock TextStyle="TextStyle.H2" Value="Operator console" />
        </Stack>
        <Cluster Gap="LayoutGap.Small">
            <StatusBadge Text="@HealthStatusLabel" Tone="@HealthTone" />
            <StatusBadge Text="@ReadinessLabel" Tone="info" />
        </Cluster>
    </Split>

    <Tabs TabPosition="TabPosition.Left"
          SelectedIndex="@selectedNodeTab"
          SelectedIndexChanged="@(index => selectedNodeTab = index)"
          Variant="TabsVariant.Workstation"
           BorderMode="TabsBorderMode.Soft"
           OverflowMode="TabsOverflowMode.Scroll"
           PanelOverflowMode="TabsPanelOverflowMode.Visible"
           AriaLabel="Node console sections">
        <TabsItem Text="Overview" Icon="dashboard">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="2" Gap="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                    <NodeHealthPanel />
                    <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                        <SummaryTile Label="Addresses" Value="@AddressRowsSource.Count.ToString()" />
                        <SummaryTile Label="Transactions" Value="@TransactionRowsSource.Count.ToString()" />
                        <SummaryTile Label="Indexed BOs" Value="@AddressRowsSource.Sum(item => item.BusinessObjects).ToString()" />
                        <SummaryTile Label="Newest tx" Value="@NewestTransactionLabel" />
                    </SummaryTiles>
                </Grid>

                <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                    <ReadinessVerificationPanel />
                    <ProjectionVerificationPanel />
                    <ChainVerificationPanel />
                    <NodeIssueList />
                </Grid>
            </Stack>
        </TabsItem>

        <TabsItem Text="Addresses" Icon="account_tree" BadgeText="@AddressRowsSource.Count.ToString()">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="2" ColumnTemplateLg="minmax(16rem, 1fr) minmax(16rem, 0.8fr)" Gap="LayoutGap.Medium" AlignItems="AlignItems.End">
                    <FormField Text="Search addresses">
                        <TextBox @bind-Value="addressSearch"
                                 Immediate="true"
                                 Placeholder="Name, address, role, status..."
                                 aria-label="Search node addresses" />
                    </FormField>
                    <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                        <SummaryTile Label="Matches" Value="@FilteredAddresses.Count.ToString()" Compact="true" />
                        <SummaryTile Label="Transactions" Value="@FilteredAddresses.Sum(item => item.Transactions).ToString()" Compact="true" />
                    </SummaryTiles>
                </Grid>

                <Grid ColumnTemplate="repeat(auto-fit, minmax(17rem, 1fr))" Gap="LayoutGap.Medium">
                    @foreach (NodeAdminAddressSummary address in FilteredAddresses)
                    {
                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Medium">
                            <Stack GapScale="LayoutGap.Tiny">
                                <TextBlock TextStyle="TextStyle.Eyebrow" Value="@address.Role" />
                                <TextBlock TextStyle="TextStyle.H3" Value="@address.Label" />
                                <CopyableMonoValue Value="@address.Address" StartChars="10" EndChars="6" AriaLabel="Copy node address" />
                            </Stack>
                            <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap">
                                <Pill Tone="PillTone.Label" Text="@address.Balance" />
                                <Pill Tone="PillTone.Label" Text="@($"{address.Transactions} tx")" />
                                <Pill Tone="PillTone.Label" Text="@($"{address.BusinessObjects} BOs")" />
                            </Cluster>
                            <Stack GapScale="LayoutGap.XSmall">
                                @foreach (NodeAdminTransactionSummary transaction in TransactionsFor(address).Take(2))
                                {
                                    <Button Look="ButtonLook.SheetCardGhost"
                                            Class="w-full justify-start text-left"
                                            Click="@(() => OpenTransactionDetailsAsync(transaction))">
                                        <Split Breakpoint="LayoutBreakpoint.None"
                                               Gap="LayoutGap.Small"
                                               AlignItems="AlignItems.Center"
                                               JustifyContent="JustifyContent.SpaceBetween"
                                               Wrap="FlexWrap.NoWrap">
                                            <TextBlock TextStyle="TextStyle.Mono" Value="@transaction.TxId" />
                                            <SmallText Text="@transaction.Data" />
                                        </Split>
                                    </Button>
                                }
                            </Stack>
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Details"
                                        Icon="info"
                                        Size="ButtonSize.Small"
                                        Variant="Variant.Outlined"
                                        Click="@(() => OpenAddressDetailsAsync(address))" />
                                <Button Text="Transactions"
                                        Icon="receipt_long"
                                        Size="ButtonSize.Small"
                                        ButtonStyle="ButtonStyle.Secondary"
                                         Variant="Variant.Outlined"
                                         Click="@(() => FocusTransactions(address.Address))" />
                            </Cluster>
                            </Stack>
                        </SurfaceCard>
                    }
                </Grid>
            </Stack>
        </TabsItem>

        <TabsItem Text="Transactions" Icon="receipt_long" BadgeText="@TransactionRowsSource.Count.ToString()">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="3" ColumnTemplateLg="minmax(16rem, 1.3fr) minmax(10rem, 0.7fr) minmax(10rem, 0.7fr)" Gap="LayoutGap.Medium" AlignItems="AlignItems.End">
                    <FormField Text="Search transactions">
                        <TextBox @bind-Value="transactionSearch"
                                 Immediate="true"
                                 Placeholder="Tx id, address, route, data..."
                                 aria-label="Search node transactions" />
                    </FormField>
                    <FormField Text="Kind">
                        <DropDown TValue="string"
                                  Data="KindOptions"
                                  TextProperty="Text"
                                  ValueProperty="Value"
                                  Value="@selectedKind"
                                  ValueChanged="@(value => selectedKind = value ?? AllFilter)"
                                  Placeholder="All kinds"
                                  aria-label="Filter node transactions by kind" />
                    </FormField>
                    <FormField Text="Status">
                        <DropDown TValue="string"
                                  Data="StatusOptions"
                                  TextProperty="Text"
                                  ValueProperty="Value"
                                  Value="@selectedStatus"
                                  ValueChanged="@(value => selectedStatus = value ?? AllFilter)"
                                  Placeholder="All statuses"
                                  aria-label="Filter node transactions by status" />
                    </FormField>
                </Grid>

                <Stack GapScale="LayoutGap.Small" Class="max-h-[min(48rem,calc(100vh-14rem))] overflow-y-auto overscroll-contain pr-1">
                    @foreach (NodeAdminTransactionSummary transaction in FilteredTransactions)
                    {
                        <SelectionListItem Title="@transaction.TxId"
                                           Eyebrow="@transaction.Kind.ToString()"
                                           Meta="@transaction.PrimaryAddress"
                                           Summary="@transaction.Route"
                                           Dense="true"
                                           OnSelect="@(() => OpenTransactionDetailsAsync(transaction))">
                            <Status>
                                <Icon Name="@TransactionIcon(transaction)" />
                            </Status>
                            <Actions>
                                <Stack GapScale="LayoutGap.XSmall" AlignItems="AlignItems.End">
                                    <Cluster Gap="LayoutGap.XSmall" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.End">
                                        <StatusBadge Text="@transaction.Status.ToString()" Tone="@TransactionUiPresentation.StatusTone(transaction.Status)" />
                                        <Pill Tone="PillTone.Label" Text="@($"{transaction.Inputs} input(s)")" />
                                        <Pill Tone="PillTone.Label" Text="@($"{transaction.Outputs} output(s)")" />
                                        <Pill Tone="PillTone.Label" Text="@transaction.Data" />
                                    </Cluster>
                                    <Button Text="Details"
                                            Icon="open_in_full"
                                            Size="ButtonSize.Small"
                                            Variant="Variant.Outlined"
                                            Click="@(() => OpenTransactionDetailsAsync(transaction))" />
                                </Stack>
                            </Actions>
                        </SelectionListItem>
                    }
                </Stack>
            </Stack>
        </TabsItem>

        <TabsItem Text="Rules" Icon="account_tree" BadgeText="@RuleObjects.Count.ToString()">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="2" ColumnTemplateLg="minmax(24rem, 0.95fr) minmax(0, 1.05fr)" Gap="LayoutGap.Medium">
                    <AccountRuleDesigner Workspace="RuleWorkspace"
                                         SubmitRequested="RuleTokenCreateRequested" />

                    <div data-testid="cda-admin-rule-objects">
                        <SectionCard Title="Logic carried by this account" Description="Rule business objects available to the operator account.">
                            <HeaderActions>
                            <StatusBadge Text="@($"{RuleObjects.Count} rule(s)")" Tone="info" />
                            </HeaderActions>
                            <ChildContent>

                        @if (RuleObjects.Count == 0)
                        {
                            <EmptyState Eyebrow="Rules" Title="No rule BOs" Description="Create a rule token to make account-driver logic visible here." />
                        }
                        else
                        {
                            <Stack GapScale="LayoutGap.Small">
                                @foreach (IBusinessObjectView ruleObject in RuleObjects)
                                {
                                    <BusinessObjectRendererHost Object="ruleObject" />
                                }
                            </Stack>
                        }
                            </ChildContent>
                        </SectionCard>
                    </div>
                </Grid>
            </Stack>
        </TabsItem>

        <TabsItem Text="Operations" Icon="admin_panel_settings">
            <Stack GapScale="LayoutGap.Medium">
                <Grid ColumnsLg="2" Gap="LayoutGap.Medium" AlignItems="AlignItems.Start">
                    <SecurityProfilePanel />
                    <AdminKeyPosturePanel />
                    <BootstrapInfoPanel />
                    <JwtTokenAdminList />
                    <JwtTokenCreateDialog />
                    <LedgerOperatorActions />
                    <SnapshotAdminPanel />
                    <TimeControlPanel />
                </Grid>
            </Stack>
        </TabsItem>
    </Tabs>
</Stack>

@code {
    private const string AllFilter = "__all";
    private string addressSearch = string.Empty;
    private string transactionSearch = string.Empty;
    private string selectedKind = AllFilter;
    private string selectedStatus = AllFilter;
    private int selectedNodeTab;

    [Parameter]
    public IReadOnlyList<NodeAdminAddressSummary>? Addresses { get; set; }

    [Parameter]
    public IReadOnlyList<NodeAdminTransactionSummary>? Transactions { get; set; }

    [Parameter]
    public string HealthStatusLabel { get; set; } = "Healthy";

    [Parameter]
    public string HealthTone { get; set; } = "success";

    [Parameter]
    public string ReadinessLabel { get; set; } = "Read first";

    [Parameter]
    public Func<NodeAdminTransactionSummary, Task<EconomyTransactionDetailsModel?>>? TransactionDetailsProvider { get; set; }

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public EventCallback<EconomyRuleTokenCreationRequest> RuleTokenCreateRequested { get; set; }

    private static readonly DateTimeOffset SampleClock = new(2026, 05, 06, 14, 45, 00, TimeSpan.Zero);

    private static readonly IReadOnlyList<NodeAdminAddressSummary> AddressRows =
    [
        new("Operations primary", "cdia1NZW6356kk5ecYvmz1AhdsRwCquyeBz8ZbK", "Account", "126500 main", 7, 18, "Active", SampleClock.AddMinutes(-3)),
        new("Operations approval", "cdia1NWkfTJcfobv5pAqdGNNb7RPiLTNWuB2qpb", "Subaccount", "25000 main", 2, 7, "Active", SampleClock.AddMinutes(-16)),
        new("Warehouse north", "cdia1NN6M9TZRjAyLoX13ztB2LLKCfyUW3DU2Zk", "Subaccount", "41000 main", 5, 11, "Active", SampleClock.AddHours(-1)),
        new("Supplier Acme", "cdia1N6ZF4yZ7m11hLxmxZbgA4fz6dQL1pVcM8w", "External", "0 main", 0, 4, "Watched", SampleClock.AddHours(-4)),
        new("Treasury mirror", "cdia1NWTZy5b7qKTj4x8vQ1DkYS8qz9sRz6g2a", "Mirror", "60500 main", 1, 6, "Watched", SampleClock.AddDays(-1))
    ];

    private static readonly IReadOnlyList<NodeAdminTransactionSummary> TransactionRows =
    [
        new("tx-po-1042-v3", "Operations primary \u2192 Operations primary", TransactionKind.BusinessObject, TransactionStatus.Confirmed, 1, 1, AddressRows[0].Address, "BusinessObject", SampleClock.AddHours(-6)),
        new("tx-image-warehouse-capacity-v2", "Operations primary \u2192 Warehouse north", TransactionKind.Transfer, TransactionStatus.Confirmed, 2, 2, AddressRows[2].Address, "Image BO", SampleClock.AddHours(-9)),
        new("tx-post-energy-balance-v4", "Operations primary \u2192 Operations primary", TransactionKind.BusinessObject, TransactionStatus.Confirmed, 1, 2, AddressRows[0].Address, "Post BO", SampleClock.AddHours(-12)),
        new("tx-steel-77-transfer", "Operations primary \u2192 Warehouse north", TransactionKind.Transfer, TransactionStatus.Confirmed, 1, 2, AddressRows[2].Address, "Inventory", SampleClock.AddHours(-18)),
        new("tx-settings-ops", "genesis/mint \u2192 Operations primary", TransactionKind.Mint, TransactionStatus.Confirmed, 0, 1, AddressRows[0].Address, "Settings", SampleClock.AddDays(-1)),
        new("tx-token-usd-credit", "genesis/mint \u2192 Operations primary", TransactionKind.Mint, TransactionStatus.Confirmed, 0, 2, AddressRows[0].Address, "Token", SampleClock.AddDays(-2))
    ];

    private IReadOnlyList<NodeAdminAddressSummary> AddressRowsSource
        => Addresses is { Count: > 0 } ? Addresses : AddressRows;

    private IReadOnlyList<NodeAdminTransactionSummary> TransactionRowsSource
        => Transactions is { Count: > 0 } ? Transactions : TransactionRows;

    private BusinessObjectWorkspaceModel RuleWorkspace
        => Workspace ?? EconomyComponentSampleData.CreateWorkspace();

    private IReadOnlyList<IBusinessObjectView> RuleObjects
        => RuleWorkspace.BusinessObjects
            .Where(RuleBusinessObjectDisplay.CanDisplay)
            .OrderBy(item => item.ObjectId.Value, StringComparer.Ordinal)
            .ToArray();

    private IReadOnlyList<NodeAdminAddressSummary> FilteredAddresses
        => string.IsNullOrWhiteSpace(addressSearch)
            ? AddressRowsSource
            : AddressRowsSource.Where(address => AddressProbe(address).Contains(addressSearch, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<NodeAdminTransactionSummary> FilteredTransactions
        => TransactionRowsSource
            .Where(MatchesTransactionFilters)
            .OrderByDescending(row => row.TimestampUtc)
            .ToArray();

    private IReadOnlyList<FilterOption> KindOptions => FilterOptions(TransactionRowsSource.Select(row => row.Kind.ToString()));

    private IReadOnlyList<FilterOption> StatusOptions => FilterOptions(TransactionRowsSource.Select(row => row.Status.ToString()));

    private string NewestTransactionLabel
        => TransactionRowsSource.Count == 0 ? "none" : TransactionRowsSource.Max(row => row.TimestampUtc).ToString("MM.dd HH:mm");

    private Task OpenAddressDetailsAsync(NodeAdminAddressSummary address)
        => DialogService.OpenAsync<NodeAddressDetailsDialogContent>(
            "Address details",
            new Dictionary<string, object?>
            {
                [nameof(NodeAddressDetailsDialogContent.Address)] = address,
                [nameof(NodeAddressDetailsDialogContent.Transactions)] = TransactionsFor(address),
                [nameof(NodeAddressDetailsDialogContent.TransactionSelected)] =
                    EventCallback.Factory.Create<NodeAdminTransactionSummary>(this, OpenTransactionDetailsAsync)
            },
            new DialogOptions
            {
                Subtitle = address.Address,
                Size = ModalSize.Medium,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-node-address-dialog"
            });

    private async Task OpenTransactionDetailsAsync(NodeAdminTransactionSummary transaction)
    {
        EconomyTransactionDetailsModel details = await ResolveTransactionDetailsAsync(transaction).ConfigureAwait(false) ??
            EconomyComponentSampleData.CreateTransactionDetails() with
        {
            TxId = new TxId(transaction.TxId),
            Kind = transaction.Kind,
            Status = transaction.Status,
            Timestamp = transaction.TimestampUtc
        };

        await DialogService.OpenAsync<TransactionDetailsDialogContent>(
            "Transaction detail",
            new Dictionary<string, object?>
            {
                [nameof(TransactionDetailsDialogContent.Details)] = details
            },
            new DialogOptions
            {
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog cda-ledger-dialog--compact",
                TestId = "cda-node-transaction-details-dialog"
            }).ConfigureAwait(false);
    }

    private void FocusTransactions(string address)
    {
        NodeAdminAddressSummary? row = AddressRowsSource.FirstOrDefault(item => item.Address.Equals(address, StringComparison.OrdinalIgnoreCase));
        transactionSearch = row?.Label ?? address;
        selectedNodeTab = 2;
    }

    private IReadOnlyList<NodeAdminTransactionSummary> TransactionsFor(NodeAdminAddressSummary address)
        => TransactionRowsSource
            .Where(row => TransactionBelongsToAddress(row, address))
            .OrderByDescending(row => row.TimestampUtc)
            .ToArray();

    private bool MatchesTransactionFilters(NodeAdminTransactionSummary transaction)
    {
        if (selectedKind != AllFilter && !transaction.Kind.ToString().Equals(selectedKind, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (selectedStatus != AllFilter && !transaction.Status.ToString().Equals(selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(transactionSearch)
            || TransactionProbe(transaction).Contains(transactionSearch, StringComparison.OrdinalIgnoreCase);
    }

    private static string AddressProbe(NodeAdminAddressSummary address)
        => string.Join(' ', address.Label, address.Address, address.Role, address.Balance, address.Status);

    private static string TransactionProbe(NodeAdminTransactionSummary transaction)
        => string.Join(' ', transaction.TxId, transaction.Route, transaction.Kind, transaction.Status, transaction.PrimaryAddress, transaction.Data);

    private static bool TransactionBelongsToAddress(NodeAdminTransactionSummary transaction, NodeAdminAddressSummary address)
        => transaction.PrimaryAddress.Equals(address.Address, StringComparison.OrdinalIgnoreCase)
            || transaction.PrimaryAddress.Equals(address.Label, StringComparison.OrdinalIgnoreCase)
            || transaction.Route.Contains(address.Label, StringComparison.OrdinalIgnoreCase)
            || transaction.Route.Contains(address.Address, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<FilterOption> FilterOptions(IEnumerable<string> values)
        => new[] { new FilterOption(AllFilter, "All") }
            .Concat(values
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
                .Select(value => new FilterOption(value, value)))
            .ToArray();

    private static string TransactionIcon(NodeAdminTransactionSummary transaction)
        => transaction.Kind switch
        {
            TransactionKind.Mint => "south",
            TransactionKind.BusinessObject => "widgets",
            _ => "swap_horiz"
        };

    private async Task<EconomyTransactionDetailsModel?> ResolveTransactionDetailsAsync(NodeAdminTransactionSummary transaction)
        => TransactionDetailsProvider is null
            ? null
            : await TransactionDetailsProvider(transaction).ConfigureAwait(false);

    private sealed record FilterOption(string Value, string Text);
}
