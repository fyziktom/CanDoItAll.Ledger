@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IAddressDirectoryService AddressDirectory

<FormStack Class="cda-address-directory-add-form"
           data-testid="cda-address-directory-add-dialog-content">
    <FormField Text="Display name" ContainerClass="cda-economy-field">
        <TextBox Value="@displayName"
                 ValueChanged="HandleDisplayNameChanged"
                 Immediate="true"
                 Placeholder="e.g., My exchange account"
                 autocomplete="off"
                 data-testid="cda-address-directory-add-name" />
        <p class="mt-1 text-xs text-slate-500">A friendly name to help you recognize this address.</p>
    </FormField>

    <FormField Text="Ledger address" ContainerClass="cda-economy-field">
        <TextBox Value="@address"
                 ValueChanged="HandleAddressChanged"
                 Immediate="true"
                 Placeholder="cdia1..."
                 autocomplete="off"
                 autocapitalize="none"
                 spellcheck="false"
                 data-testid="cda-address-directory-add-address" />
        <p class="mt-1 text-xs text-slate-500">Paste the complete Cronos zkEVM ledger address.</p>
    </FormField>

    @if (!string.IsNullOrWhiteSpace(validationMessage))
    {
        <p class="text-sm font-medium text-rose-700"
           role="alert"
           data-testid="cda-address-directory-add-validation">
            @validationMessage
        </p>
    }

    <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
        Contacts are stored locally in this browser profile and are not synced automatically.
    </Alert>

    <Cluster JustifyContent="JustifyContent.SpaceBetween"
             Gap="LayoutGap.Small"
             Class="cda-address-directory-add-form__actions border-t border-slate-200 pt-4">
        <Button Text="Cancel"
                Icon="close"
                Size="ButtonSize.Small"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Light"
                Disabled="@isSaving"
                Click="CancelAsync" />
        <Button Text="Save address"
                Icon="save"
                Size="ButtonSize.Small"
                ButtonStyle="ButtonStyle.Secondary"
                IsBusy="@isSaving"
                Click="SaveAsync"
                data-testid="cda-address-directory-add-save" />
    </Cluster>
</FormStack>

@code {
    private string displayName = string.Empty;
    private string address = string.Empty;
    private string? validationMessage;
    private bool isSaving;

    [Parameter, EditorRequired]
    public string AccountScope { get; set; } = "default";

    [CascadingParameter]
    public DialogReference? CurrentDialog { get; set; }

    private void HandleDisplayNameChanged(string? value)
        => displayName = value ?? string.Empty;

    private void HandleAddressChanged(string? value)
    {
        address = value ?? string.Empty;
        validationMessage = null;
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return;
        }

        string normalizedAddress = address.Trim();
        if (normalizedAddress.Length == 0)
        {
            validationMessage = "Enter an address before saving.";
            Notifications.Warning(
                "Address required",
                "Paste an address before saving.",
                position: NotificationPosition.BottomCenter);
            return;
        }

        string normalizedName = string.IsNullOrWhiteSpace(displayName)
            ? AccountWorkspaceLocalServiceHelpers.ShortAddress(normalizedAddress)
            : displayName.Trim();
        var entry = new AddressDirectoryEntry(
            normalizedAddress,
            normalizedName,
            AddressDirectoryEntryKind.External);

        isSaving = true;
        try
        {
            await AddressDirectory.SaveEntryAsync(AccountScope, entry);
            Notifications.Success(
                "Address saved",
                entry.DisplayName,
                position: NotificationPosition.BottomCenter);
            await CloseCurrentDialogAsync(entry);
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task CancelAsync()
        => CloseCurrentDialogAsync();

    private Task CloseCurrentDialogAsync(object? result = null)
        => CurrentDialog is null
            ? DialogService.CloseAsync(result)
            : CurrentDialog.CloseAsync(result);
}
