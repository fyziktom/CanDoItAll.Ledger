@namespace CanDoItAll.Economy.Components
@using CanDoItAll.Economy.Components.Services
@inject DialogService DialogService
@inject NotificationService Notifications

@if (loadError is not null)
{
    <Alert AlertStyle="AlertStyle.Danger">
        <strong>@Adapter.HostMode workspace failed</strong>
        <span>@loadError</span>
    </Alert>
}
else if (workspace is null)
{
    <EmptyState Eyebrow="@Adapter.HostMode"
                Title="Loading account workspace"
                Description="Account workspace data is being loaded." />
}
else
{
    <section class="cda-economy-adapter-workspace" data-testid="adapter-workspace-host">
        <div class="cda-economy-adapter-host-mode" data-testid="adapter-host-mode">
            <span>@Adapter.HostMode</span>
            <strong>@(Adapter.UsesServerSideAccountSigning ? "Server signing" : "Browser signing")</strong>
        </div>

        @if (UseFullAppShell)
        {
            <VenftSsrEconomyApp Workspace="workspace"
                                LastResult="lastResult"
                                RefreshNotification="@refreshNotification"
                                RefreshRequested="RefreshAsync"
                                CreateSubAccountRequested="OpenSubAccountDialogAsync"
                                ValidateRequested="RefreshAsync"
                                OpenSendTransactionRequested="OpenSendTransactionDialogAsync"
                                TransactionSubmitRequested="SubmitTransactionAsync"
                                RuleTokenCreateRequested="SubmitRuleTokenCreationAsync"
                                TransactionDetailsRequested="OpenTransactionDetailsAsync"
                                BusinessObjectTransactionDetailsRequested="OpenTransactionDetailsByIdAsync"
                                CreateTokenRequested="OpenTokenCreationDialogAsync"
                                BusinessObjectSendRequested="OpenBusinessObjectSendDialogAsync"
                                BusinessObjectSetPriceRequested="OpenBusinessObjectSetPriceDialogAsync"
                                MessageSignRequested="SignMessageAsync"
                                MessageVerifyRequested="VerifyMessageAsync"
                                MessageEncryptRequested="EncryptMessageAsync"
                                MessageDecryptRequested="DecryptMessageAsync" />
        }
        else
        {
            <EconomyAccountWorkspace Workspace="workspace"
                                     RefreshRequested="RefreshAsync"
                                     AddTransactionRequested="SubmitCurrentDraftAsync"
                                     TransactionSubmitRequested="SubmitTransactionAsync"
                                     TransactionDetailsRequested="LoadTransactionDetailsAsync"
                                     MessageSignRequested="SignMessageAsync"
                                     MessageVerifyRequested="VerifyMessageAsync"
                                     MessageEncryptRequested="EncryptMessageAsync"
                                     MessageDecryptRequested="DecryptMessageAsync" />

            <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-economy-adapter-grid">
                <section data-testid="adapter-utxo-explorer">
                    <UtxoExplorer Outputs="workspace.SpendableOutputsOrEmpty" />
                </section>

                <section data-testid="adapter-transaction-history">
                    <TransactionHistoryBrowser Transactions="workspace.Transactions" />
                </section>

                <section data-testid="adapter-transaction-composer">
                    <TransactionComposerShell Draft="workspace.TransactionDraft"
                                              TokenOptions="workspace.TokenOptions"
                                              SubmitRequested="SubmitTransactionAsync" />
                </section>
            </Grid>

            @if (lastResult is not null)
            {
                <TransactionReceipt Result="lastResult" />
            }
        }
    </section>
}

@code {
    private BusinessObjectWorkspaceModel? workspace;
    private EconomyTransactionExecutionResult? lastResult;
    private string? refreshNotification;
    private string? loadError;

    [Parameter, EditorRequired]
    public IEconomyAccountWorkspaceAdapter Adapter { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectWorkspaceModel> WorkspaceLoaded { get; set; }

    [Parameter]
    public EventCallback<EconomyTransactionExecutionResult> TransactionSubmitted { get; set; }

    [Parameter]
    public bool UseFullAppShell { get; set; }

    protected override async Task OnInitializedAsync()
        => await RefreshAsync().ConfigureAwait(false);

    private async Task RefreshAsync()
    {
        try
        {
            loadError = null;
            workspace = await Adapter.GetWorkspaceAsync().ConfigureAwait(false);
            refreshNotification = $"Workspace refreshed for {workspace.AccountName}.";
            await WorkspaceLoaded.InvokeAsync(workspace).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
            workspace = null;
        }
    }

    private Task SubmitCurrentDraftAsync()
        => workspace is null
            ? Task.CompletedTask
            : SubmitTransactionAsync(workspace.TransactionDraft);

    private async Task SubmitTransactionAsync(BusinessObjectTransactionDraft draft)
        => await ExecuteAndRefreshAsync(
            () => Adapter.SubmitTransactionAsync(draft),
            "Transaction submitted").ConfigureAwait(false);

    private Task OpenSendTransactionDialogAsync()
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<TransactionComposerDialogContent>(
            "Send Transaction",
            new Dictionary<string, object?>
            {
                [nameof(TransactionComposerDialogContent.Draft)] = workspace.TransactionDraft,
                [nameof(TransactionComposerDialogContent.TokenOptions)] = workspace.TokenOptions,
                [nameof(TransactionComposerDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectTransactionDraft>(this, SubmitTransactionAsync),
                [nameof(TransactionComposerDialogContent.AssembleRequested)] =
                    EventCallback.Factory.Create(this, RefreshAsync),
                [nameof(TransactionComposerDialogContent.BroadcastRequested)] =
                    EventCallback.Factory.Create(this, RefreshAsync)
            },
            new DialogOptions
            {
                Subtitle = $"{workspace.AccountName} - {workspace.Address.Value}",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--send",
                TestId = "cda-send-transaction-dialog"
            });
    }

    private async Task OpenSubAccountDialogAsync()
    {
        if (workspace is null)
        {
            return;
        }

        object? result = await DialogService.OpenAsync<SubAccountCreateDialogContent>(
            "Add New SubAccount",
            new Dictionary<string, object?>
            {
                [nameof(SubAccountCreateDialogContent.ParentAddress)] = workspace.Address.Value
            },
            new DialogOptions
            {
                Subtitle = "Create a child account under the current browser vault.",
                Size = ModalSize.Medium,
                Class = "cda-vef-dialog cda-vef-dialog--form",
                ShowCloseButton = false,
                TestId = "cda-subaccount-dialog"
            }).ConfigureAwait(false);

        if (result is SubAccountCreateDialogResult)
        {
            Notifications.Info(
                "SubAccount prepared",
                "The browser AccountApp does not persist child accounts yet.",
                position: NotificationPosition.BottomCenter);
        }
    }

    private Task OpenTransactionDetailsAsync(LedgerTransactionSummary transaction)
        => OpenTransactionDetailsByIdAsync(transaction.TxId);

    private async Task OpenTransactionDetailsByIdAsync(TxId txId)
    {
        EconomyTransactionDetailsModel? details = await Adapter.GetTransactionDetailsAsync(txId).ConfigureAwait(false);
        if (details is null)
        {
            Notifications.Warning("Transaction not found", txId.Value, position: NotificationPosition.BottomCenter);
            return;
        }

        await DialogService.OpenAsync<TransactionDetailsDialogContent>(
            "Transaction Details",
            new Dictionary<string, object?>
            {
                [nameof(TransactionDetailsDialogContent.Details)] = details
            },
            new DialogOptions
            {
                Subtitle = $"{details.Kind} - {details.Status}",
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-vef-dialog cda-vef-dialog--details cda-vef-dialog--tx-detail",
                TestId = "cda-transaction-details-dialog"
            }).ConfigureAwait(false);
    }

    private Task OpenBusinessObjectSendDialogAsync(IBusinessObjectView item)
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<BusinessObjectSendDialogContent>(
            "Send BusinessObject",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectSendDialogContent.Object)] = item,
                [nameof(BusinessObjectSendDialogContent.Bookmarks)] = workspace.AddressBookmarks,
                [nameof(BusinessObjectSendDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectSendRequest>(this, SubmitBusinessObjectSendAsync)
            },
            new DialogOptions
            {
                Subtitle = item.ObjectId.Value,
                Size = ModalSize.Medium,
                Class = "cda-vef-dialog cda-vef-dialog--form",
                TestId = "cda-bo-send-dialog"
            });
    }

    private Task OpenBusinessObjectSetPriceDialogAsync(IBusinessObjectView item)
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<BusinessObjectSetPriceDialogContent>(
            "Set BusinessObject Price",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectSetPriceDialogContent.Object)] = item,
                [nameof(BusinessObjectSetPriceDialogContent.TokenOptions)] = workspace.TokenOptions,
                [nameof(BusinessObjectSetPriceDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectPriceRequest>(this, SubmitBusinessObjectPriceAsync)
            },
            new DialogOptions
            {
                Subtitle = item.ObjectId.Value,
                Size = ModalSize.Medium,
                Class = "cda-vef-dialog cda-vef-dialog--form",
                TestId = "cda-bo-set-price-dialog"
            });
    }

    private Task OpenTokenCreationDialogAsync()
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<TokenCreationDialogContent>(
            "Create Token",
            new Dictionary<string, object?>
            {
                [nameof(TokenCreationDialogContent.Authorities)] = workspace.TokenCreationAuthorities,
                [nameof(TokenCreationDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<EconomyTokenCreationRequest>(this, SubmitTokenCreationAsync)
            },
            new DialogOptions
            {
                Subtitle = "Authority-aware token mint",
                Size = ModalSize.Medium,
                Class = "cda-vef-dialog cda-vef-dialog--form",
                TestId = "cda-token-create-dialog"
            });
    }

    private Task SubmitBusinessObjectSendAsync(BusinessObjectSendRequest request)
        => ExecuteAndRefreshAsync(
            () => Adapter.SendBusinessObjectAsync(request),
            "BusinessObject sent");

    private Task SubmitBusinessObjectPriceAsync(BusinessObjectPriceRequest request)
        => ExecuteAndRefreshAsync(
            () => Adapter.SetBusinessObjectPriceAsync(request),
            "Price updated");

    private Task SubmitTokenCreationAsync(EconomyTokenCreationRequest request)
        => ExecuteAndRefreshAsync(
            () => Adapter.CreateTokenAsync(request),
            "Token created");

    private Task SubmitRuleTokenCreationAsync(EconomyRuleTokenCreationRequest request)
        => ExecuteAndRefreshAsync(
            () => Adapter.CreateRuleTokenAsync(request),
            "Rule BO created");

    private Task<MessageSecurityActionResult> SignMessageAsync(MessageSecuritySignRequest request)
        => Adapter.SignMessageAsync(request);

    private Task<MessageSecurityActionResult> VerifyMessageAsync(MessageSecurityVerifyRequest request)
        => Adapter.VerifyMessageAsync(request);

    private Task<MessageSecurityActionResult> EncryptMessageAsync(MessageSecurityEncryptRequest request)
        => Adapter.EncryptMessageAsync(request);

    private Task<MessageSecurityActionResult> DecryptMessageAsync(MessageSecurityDecryptRequest request)
        => Adapter.DecryptMessageAsync(request);

    private async Task ExecuteAndRefreshAsync(
        Func<Task<EconomyTransactionExecutionResult>> action,
        string successSummary)
    {
        try
        {
            lastResult = await action().ConfigureAwait(false);
            await TransactionSubmitted.InvokeAsync(lastResult).ConfigureAwait(false);
            await RefreshAsync().ConfigureAwait(false);

            if (lastResult.Accepted)
            {
                Notifications.Success(successSummary, lastResult.Message, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Error("Ledger rejected transaction", lastResult.Message, position: NotificationPosition.BottomCenter);
            }
        }
        catch (Exception exception)
        {
            lastResult = new EconomyTransactionExecutionResult(
                BusinessObjectTransactionMode.Create,
                Accepted: false,
                TxId: null,
                LedgerSequence: null,
                exception.Message);
            await TransactionSubmitted.InvokeAsync(lastResult).ConfigureAwait(false);
            Notifications.Error("Economy action failed", exception.Message, position: NotificationPosition.BottomCenter);
        }
    }

    private Task LoadTransactionDetailsAsync(LedgerTransactionSummary transaction)
        => Adapter.GetTransactionDetailsAsync(transaction.TxId);
}
