@namespace CanDoItAll.Economy.Components

<InspectorDialogLayout Eyebrow="Account settings"
                       Title="@Workspace.AccountName"
                       Description="Ledger account context, aliases, connection state, and embedding configuration."
                       InspectorRail="@RenderSummary"
                       HeaderActions="@RenderActions"
                       TestId="cda-account-settings-dialog">
    <SectionCard Title="Account Settings" Description="Current ledger session and UI account context.">
        <AccountSettingsDialogContent Workspace="Workspace" />
    </SectionCard>
</InspectorDialogLayout>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    private RenderFragment RenderSummary => builder =>
    {
        builder.OpenComponent<StatusCheckList>(0);
        builder.AddAttribute(1, nameof(StatusCheckList.Title), "Session checks");
        builder.AddAttribute(2, nameof(StatusCheckList.Items), new[]
        {
            new StatusCheckItem { Label = "Address loaded", Status = "Ready", Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Ledger context", Status = Workspace.Context.LedgerId.Value, Tone = "info", Complete = true },
            new StatusCheckItem { Label = "Connection", Status = Workspace.ConnectionLabel ?? "in-memory", Tone = "neutral", Complete = true }
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderActions => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Copy address");
        builder.AddAttribute(2, nameof(Button.Icon), "content_copy");
        builder.AddAttribute(3, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
    };
}
