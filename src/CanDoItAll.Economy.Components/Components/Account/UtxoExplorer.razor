@namespace CanDoItAll.Economy.Components

<div data-testid="cda-utxo-explorer">
    <SectionCard Title="UTXO explorer" Description="Spendable outputs in the current account projection">
        <HeaderActions>
            <StatusBadge Text="@($"{Outputs.Count} outputs")" Tone="info" />
        </HeaderActions>

        <ChildContent>
            @if (Outputs.Count == 0)
            {
                <EmptyState Eyebrow="UTXO" Title="No spendable outputs" Description="This account has no source outputs in the current projection." />
            }
            else
            {
                <DataGrid TItem="LedgerSpendableOutput"
                          Data="@Outputs"
                          Caption="Spendable account outputs">
                    <Columns>
                        <DataGridColumn TItem="LedgerSpendableOutput" Title="Output">
                            <Template Context="output">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <TextBlock TextStyle="TextStyle.Mono">@output.OutPoint</TextBlock>
                                    <CopyableMonoValue Value="@output.OutPointKey.Value.Value" />
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="LedgerSpendableOutput" Title="Address">
                            <Template Context="output">
                                <TextBlock TextStyle="TextStyle.Mono" Value="@Short(output.Address.Value)" />
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="LedgerSpendableOutput" Title="Balance">
                            <Template Context="output">
                                <Stack GapScale="LayoutGap.Tiny">
                                    <TextBlock TextStyle="TextStyle.Body2">@output.MainAmount main</TextBlock>
                                    @if (output.Token is not null)
                                    {
                                        <TextBlock TextStyle="TextStyle.Caption" Value="@FormatToken(output.Token)" />
                                    }
                                </Stack>
                            </Template>
                        </DataGridColumn>
                        <DataGridColumn TItem="LedgerSpendableOutput" Title="Business object">
                            <Template Context="output">
                                @if (output.BusinessObject is not null)
                                {
                                    <Stack GapScale="LayoutGap.Tiny">
                                        <TextBlock TextStyle="TextStyle.Mono">@BusinessObjectId.FromOutPoint(output.OutPoint).Value</TextBlock>
                                        <TextBlock TextStyle="TextStyle.Caption">Version @output.BusinessObject.Version</TextBlock>
                                    </Stack>
                                }
                                else
                                {
                                    <TextBlock TextStyle="TextStyle.Muted" Value="None" />
                                }
                            </Template>
                        </DataGridColumn>
                    </Columns>
                </DataGrid>
            }
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LedgerSpendableOutput> Outputs { get; set; } = [];

    private static string FormatToken(TokenTransfer? token)
        => token is null ? string.Empty : $"{token.Amount} {token.TokenId.Value}";

    private static string Short(string value)
        => value.Length > 18 ? $"{value[..10]}...{value[^6..]}" : value;
}
