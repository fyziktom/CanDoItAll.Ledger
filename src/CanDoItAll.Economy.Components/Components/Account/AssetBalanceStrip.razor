@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel" data-testid="cda-asset-balance-strip">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Assets</span>
            <h2>Balance strip</h2>
        </div>
        <StatusBadge Text="@($"{TokenOptions.Count} assets")" Tone="info" />
    </header>

    <div class="cda-sdk-asset-strip">
        @foreach (EconomyTokenOption option in TokenOptions)
        {
            <article class="cda-sdk-asset-card">
                <span>@(option.IsMain ? "Native" : "Token")</span>
                <strong>@option.AssetLabel</strong>
                <em>@option.AvailableAmount</em>
                @if (option.CanCreateMore)
                {
                    <StatusBadge Text="Mintable" Tone="success" />
                }
            </article>
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<EconomyTokenOption> TokenOptions { get; set; } = [];
}
