@namespace CanDoItAll.Economy.Components

<div data-testid="cda-token-source-explorer">
    <SectionCard Title="Token type explorer" Description="Token sources projected for this account">
        <HeaderActions>
            <StatusBadge Text="@($"{TokenTypes.Count} types")" Tone="info" />
        </HeaderActions>

        <ChildContent>
            @if (TokenTypes.Count == 0)
            {
                <EmptyState Eyebrow="Tokens" Title="No token types" Description="Token type projections are not available for this account context." />
            }
            else
            {
                <Grid ColumnsMd="2" ColumnsXl="3" Gap="LayoutGap.Small">
                    @foreach (LedgerTokenType token in TokenTypes)
                    {
                        <SurfaceCard Soft="true">
                            <Stack GapScale="LayoutGap.Medium">
                                <Split Breakpoint="LayoutBreakpoint.None" Gap="LayoutGap.Small" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap">
                                    <TextBlock TextStyle="TextStyle.Mono" Value="@token.TokenId.Value" />
                                    <StatusBadge Text="@($"{token.TotalUtxoCount} UTXO")" Tone="neutral" />
                                </Split>
                                <SummaryTiles ColumnsSm="3" ColumnsXl="3" GapScale="LayoutGap.Small">
                                    <SummaryTile Label="Total" Value="@token.TotalAmount.ToString()" Compact="true" />
                                    <SummaryTile Label="Source" Value="@token.SourceAmount.ToString()" Compact="true" />
                                    <SummaryTile Label="Unique" Value="@token.UniqueAmount.ToString()" Compact="true" />
                                </SummaryTiles>
                            </Stack>
                        </SurfaceCard>
                    }
                </Grid>
            }
        </ChildContent>
    </SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTokenType> TokenTypes { get; set; } = [];
}
