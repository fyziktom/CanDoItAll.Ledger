@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService

<section class="cda-vef-home cda-vef-account-overview" data-testid="ssr-vef-home">
    <section class="cda-vef-panel cda-vef-account-command">
        <div class="cda-vef-account-identity">
            <div class="cda-vef-profile-avatar">
                @if (!string.IsNullOrWhiteSpace(ProfileImageLink))
                {
                    <img src="@ProfileImageLink" alt="@Workspace.AccountName" />
                }
                else
                {
                    <span>@ProfileInitials</span>
                }
            </div>
            <div>
                <span class="cda-vef-account-state">@(Workspace.Context.ScenarioId?.Value ?? "live")</span>
                <h2>@Workspace.AccountName</h2>
                <p>
                    <CopyableMonoValue Value="@Workspace.Address.Value" StartChars="10" EndChars="5" AriaLabel="Copy account address" />
                    <QrCodeButton Payload="@AccountAddressQrPayload"
                                  Label="Show account address QR"
                                  TooltipText="Show account address as QR code"
                                  TestId="cda-account-address-qr-button" />
                    <PageHeaderActionButton Icon="badge"
                                            Label="Profile"
                                            TooltipText="Open account profile"
                                            Variant="Variant.Outlined"
                                            Click="ValidateRequested"
                                            TestId="cda-account-profile-button" />
                </p>
            </div>
        </div>

        <div class="cda-vef-account-metrics">
            <div class="cda-economy-fact"><span>Main</span><strong>@FormatAmount(Workspace.Balance.MainBalance)</strong></div>
            <div class="cda-economy-fact"><span>Token types</span><strong>@Workspace.TokenTypesOrEmpty.Count</strong></div>
            <div class="cda-economy-fact"><span>BOs</span><strong>@Workspace.BusinessObjects.Count</strong></div>
            <div class="cda-economy-fact"><span>UTXOs</span><strong>@Workspace.Balance.UtxoCount</strong></div>
            <div class="cda-economy-fact"><span>Txs</span><strong>@Workspace.Transactions.Count</strong></div>
            <div class="cda-economy-fact"><span>Ledger</span><strong><CopyableMonoValue Value="@Workspace.Context.LedgerId.Value" StartChars="8" EndChars="4" AriaLabel="Copy ledger id" /></strong></div>
            <div class="cda-economy-fact"><span>Scenario</span><strong><CopyableMonoValue Value="@(Workspace.Context.ScenarioId?.Value ?? "live")" Truncate="false" AriaLabel="Copy scenario id" /></strong></div>
            <div class="cda-economy-fact"><span>Node</span><strong>@(Workspace.NodeBaseUri?.ToString() ?? "local")</strong></div>
        </div>

        <div class="cda-vef-account-actions">
            <Button Icon="send" Text="Send" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small" Click="AddTransactionRequested" title="Send transaction" aria-label="Send transaction" data-testid="cda-action-send" />
            <Button Icon="add_circle" Text="Token" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="CreateTokenRequested" title="Create token" aria-label="Create token" data-testid="cda-action-token" />
            <Button Icon="contacts" Text="Addresses" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenAddressDirectoryAsync" title="Manage address directory" aria-label="Manage address directory" data-testid="cda-action-address-directory" />
            <Button Icon="security" Text="Security" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenMessageSecurityDialogAsync" title="Open message security" aria-label="Open message security" data-testid="cda-action-security" />
            <Button Icon="tune" Text="Settings" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenSettingsDialogAsync" title="Open account settings" aria-label="Open account settings" data-testid="cda-action-settings" />
            <Button Icon="archive" Text="Backup" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenSettingsBackupDialogAsync" title="Import or export browser-local settings" aria-label="Import or export browser-local settings" data-testid="cda-action-settings-backup" />
            <Button Icon="refresh" Text="Refresh" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="RefreshRequested" title="Refresh workspace" aria-label="Refresh workspace" data-testid="cda-action-refresh" />
            <Button Icon="add" Text="Subaccount" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="CreateSubAccountRequested" title="Create subaccount" aria-label="Create subaccount" data-testid="cda-action-subaccount" />
        </div>
    </section>

    <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-vef-account-work-grid">
        <section class="cda-vef-panel cda-vef-account-panel--dense">
            <div class="cda-vef-panel-header">
                <span>Balances</span>
                <QrCodeButton Payload="@AccountAddressQrPayload"
                              Label="Show account address QR"
                              TooltipText="Show account address as QR code"
                              TestId="cda-balance-address-qr-button" />
            </div>
            <div class="cda-vef-panel-body">
                <div class="cda-economy-ledger-table-wrap cda-vef-compact-table-wrap">
                    <table class="cda-economy-ledger-table cda-vef-compact-table">
                        <thead>
                            <tr>
                                <th>Asset</th>
                                <th>Amount</th>
                                <th>Shape</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Main</td>
                                <td>@FormatAmount(Workspace.Balance.MainBalance)</td>
                                <td>native</td>
                            </tr>
                            @foreach (LedgerTokenType tokenType in DisplayTokenTypes)
                            {
                                <tr>
                                    <td>@tokenType.TokenId.Value</td>
                                    <td>@tokenType.TotalAmount</td>
                                    <td>@tokenType.SourceAmount source / @tokenType.UniqueAmount unique</td>
                                </tr>
                            }
                            @foreach (KeyValuePair<TokenId, Amount> token in BalanceOnlyTokens)
                            {
                                <tr>
                                    <td>@token.Key.Value</td>
                                    <td>@FormatAmount(token.Value)</td>
                                    <td>balance</td>
                                </tr>
                            }
                            @if (TokenSourceOutputs.Count > 0)
                            {
                                <tr class="cda-vef-balance-section-row">
                                    <td colspan="3">Source UTXOs</td>
                                </tr>
                                @foreach (LedgerSpendableOutput output in TokenSourceOutputs)
                                {
                                    <tr class="cda-vef-balance-source-row">
                                        <td>
                                            <div class="cda-vef-balance-source-cell">
                                                <strong>@output.Token!.TokenId.Value</strong>
                                                <CopyableMonoValue Value="@output.OutPoint.ToString()" StartChars="8" EndChars="6" AriaLabel="Copy token source outpoint" />
                                            </div>
                                        </td>
                                        <td>@output.Token.Amount</td>
                                        <td><span class="cda-vef-source-pill cda-vef-source-pill--source">Source</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="cda-vef-panel cda-vef-account-panel--dense cda-vef-recent-transactions" data-testid="cda-recent-transactions">
            <div class="cda-vef-panel-header">
                <span>Recent Transactions</span>
                <PageHeaderActionButton Icon="open_in_full"
                                        Label="Show all transactions"
                                        TooltipText="Show all transactions"
                                        Variant="Variant.Outlined"
                                        Click="OpenAllTransactionsAsync"
                                        TestId="cda-show-all-transactions" />
            </div>
            <div class="cda-vef-panel-body cda-vef-transaction-rail">
                @if (Workspace.Transactions.Count == 0)
                {
                    <p class="cda-vef-empty-line">No account-visible transactions loaded yet.</p>
                }
                else
                {
                    @foreach (LedgerTransactionSummary transaction in RecentTransactions)
                    {
                        <article class="cda-vef-transaction-item">
                            <span class="material-icons" aria-hidden="true">@HistoryIcon(transaction)</span>
                            <div>
                                <strong><CopyableMonoValue Value="@transaction.TxId.Value" StartChars="8" EndChars="6" AriaLabel="Copy transaction id" /></strong>
                                <CopyableMonoValue Value="@FormatRoute(transaction)" StartChars="18" EndChars="10" AriaLabel="Copy transaction route" />
                                <small>@transaction.Kind / @transaction.Status / @transaction.Timestamp.ToString("HH:mm")</small>
                            </div>
                            <PageHeaderActionButton Icon="info"
                                                    Label="Transaction details"
                                                    TooltipText="Open transaction details"
                                                    Variant="Variant.Outlined"
                                                    Click="@(() => TransactionDetailsRequested.InvokeAsync(transaction))"
                                                    TestId="cda-transaction-details-button" />
                        </article>
                    }
                }
            </div>
        </section>
    </Grid>

    <BusinessObjectCommerceDashboard Workspace="Workspace"
                                     EditRequested="TransactionSubmitRequested" />

    <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-vef-account-analytics-grid" data-testid="cda-vef-account-analytics">
        <AccountBalanceTrendChart Workspace="Workspace" />
        <TokenAllocationDonut TokenOptions="Workspace.TokenOptions" />
        <TransactionKindStackedChart Transactions="Workspace.Transactions" />
    </Grid>
</section>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }

    [Parameter]
    public EventCallback ValidateRequested { get; set; }

    [Parameter]
    public EventCallback AddTransactionRequested { get; set; }

    [Parameter]
    public EventCallback CreateTokenRequested { get; set; }

    [Parameter]
    public EventCallback<LedgerTransactionSummary> TransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> BusinessObjectTransactionDetailsRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> BusinessObjectSetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> TransactionSubmitRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? BusinessObjectTicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<EconomyTransactionExecutionResult>>? BusinessObjectTicketUseRequested { get; set; }

    [Parameter]
    public Func<MessageSecuritySignRequest, Task<MessageSecurityActionResult>>? MessageSignRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityVerifyRequest, Task<MessageSecurityActionResult>>? MessageVerifyRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityEncryptRequest, Task<MessageSecurityActionResult>>? MessageEncryptRequested { get; set; }

    [Parameter]
    public Func<MessageSecurityDecryptRequest, Task<MessageSecurityActionResult>>? MessageDecryptRequested { get; set; }

    private IEnumerable<KeyValuePair<TokenId, Amount>> OrderedTokenBalances
        => Workspace.Balance.TokenBalances.OrderBy(token => token.Key.Value, StringComparer.Ordinal);

    private IReadOnlyList<LedgerTokenType> DisplayTokenTypes
        => Workspace.TokenTypesOrEmpty
            .OrderBy(token => token.TokenId.Value, StringComparer.Ordinal)
            .Take(6)
            .ToArray();

    private IReadOnlyList<KeyValuePair<TokenId, Amount>> BalanceOnlyTokens
        => OrderedTokenBalances
            .Where(token => Workspace.TokenTypesOrEmpty.All(type => type.TokenId != token.Key))
            .Take(4)
            .ToArray();

    private IReadOnlyList<LedgerSpendableOutput> TokenSourceOutputs
        => Workspace.SpendableOutputsOrEmpty
            .Where(IsTokenSourceOutput)
            .OrderBy(output => output.Token!.TokenId.Value, StringComparer.Ordinal)
            .ThenByDescending(output => output.Token!.Amount.Value)
            .Take(5)
            .ToArray();

    private IReadOnlyList<LedgerTransactionSummary> RecentTransactions
        => LedgerTransactionOrdering
            .NewestFirst(Workspace.Transactions)
            .Take(5)
            .ToArray();

    private QrCodePayload AccountAddressQrPayload
        => new(
            Workspace.Address.Value,
            QrPayloadKind.Address,
            "Account address",
            $"Address for {Workspace.AccountName}");

    private string? ProfileImageLink
    {
        get
        {
            IBusinessObjectView? profile = Workspace.BusinessObjects.FirstOrDefault(item =>
                item.ObjectType.Equals("profile", StringComparison.OrdinalIgnoreCase));
            if (profile is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.ImageLink))
            {
                return media.ImageLink;
            }

            return BusinessObjectPayloadBuilder.TryParseMediaPayload(profile?.StateJson, out BusinessObjectMediaPayload? payload)
                ? payload?.ImageLink
                : null;
        }
    }

    private string ProfileInitials
    {
        get
        {
            string[] parts = Workspace.AccountName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            string initials = string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
            return string.IsNullOrWhiteSpace(initials) ? "BO" : initials;
        }
    }

    private Task OpenSettingsDialogAsync()
        => DialogService.OpenAsync<AccountSettingsDialogContent>(
            "Account Settings",
            new Dictionary<string, object?>
            {
                [nameof(AccountSettingsDialogContent.Workspace)] = Workspace
            },
            new DialogOptions
            {
                Subtitle = Workspace.Address.Value,
                Size = ModalSize.Medium,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--form cda-vef-dialog--settings",
                TestId = "cda-account-settings-dialog"
            });

    private Task OpenSettingsBackupDialogAsync()
        => DialogService.OpenAsync<SettingsBackupDialogContent>(
            "Browser Settings Backup",
            new Dictionary<string, object?>
            {
                [nameof(SettingsBackupDialogContent.AccountScope)] = Workspace.Address.Value
            },
            new DialogOptions
            {
                Subtitle = $"{Workspace.AccountName} - local browser settings",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--settings-backup",
                TestId = "cda-settings-backup-dialog"
            });

    private Task OpenAddressDirectoryAsync()
        => DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Address Directory",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Workspace)] = Workspace,
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Manage
            },
            new DialogOptions
            {
                Subtitle = "Own and external address management",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--address-directory",
                TestId = "cda-address-directory-dialog"
            });

    private Task OpenMessageSecurityDialogAsync()
        => DialogService.OpenAsync<MessageSecurityPanel>(
            "Message Security",
            new Dictionary<string, object?>
            {
                [nameof(MessageSecurityPanel.Workspace)] = Workspace,
                [nameof(MessageSecurityPanel.SignRequested)] = MessageSignRequested,
                [nameof(MessageSecurityPanel.VerifyRequested)] = MessageVerifyRequested,
                [nameof(MessageSecurityPanel.EncryptRequested)] = MessageEncryptRequested,
                [nameof(MessageSecurityPanel.DecryptRequested)] = MessageDecryptRequested,
                [nameof(MessageSecurityPanel.SendRequested)] = BusinessObjectSendRequested,
                [nameof(MessageSecurityPanel.SetPriceRequested)] = BusinessObjectSetPriceRequested,
                [nameof(MessageSecurityPanel.EditRequested)] = TransactionSubmitRequested,
                [nameof(MessageSecurityPanel.TransactionDetailsRequested)] = BusinessObjectTransactionDetailsRequested,
                [nameof(MessageSecurityPanel.TicketVerificationRequested)] = BusinessObjectTicketVerificationRequested,
                [nameof(MessageSecurityPanel.TicketUseRequested)] = BusinessObjectTicketUseRequested
            },
            new DialogOptions
            {
                Subtitle = $"Signing and encryption tools for {Workspace.AccountName}",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--security",
                TestId = "cda-message-security-dialog"
            });

    private Task OpenAllTransactionsAsync()
        => DialogService.OpenAsync<TransactionHistoryDialogContent>(
            "All Transactions",
            new Dictionary<string, object?>
            {
                [nameof(TransactionHistoryDialogContent.Transactions)] = Workspace.Transactions,
                [nameof(TransactionHistoryDialogContent.AccountAddress)] = Workspace.Address,
                [nameof(TransactionHistoryDialogContent.TransactionDetailsRequested)] = TransactionDetailsRequested
            },
            new DialogOptions
            {
                Subtitle = $"{Workspace.AccountName} - {Workspace.Transactions.Count} account-visible transactions",
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-vef-dialog cda-vef-dialog--transactions",
                TestId = "cda-transaction-history-dialog"
            });

    private static string FormatAmount(Amount amount) => amount.ToString();

    private static string FormatRoute(LedgerTransactionSummary transaction)
    {
        string inputs = transaction.InputAddresses.Count == 0
            ? "mint"
            : string.Join(", ", transaction.InputAddresses.Select(address => address.Value));
        string outputs = transaction.OutputAddresses.Count == 0
            ? "none"
            : string.Join(", ", transaction.OutputAddresses.Select(address => address.Value));

        return $"{inputs} \u2192 {outputs}";
    }

    private static string HistoryIcon(LedgerTransactionSummary transaction)
        => transaction.Kind == TransactionKind.Mint ? "south" : "north";

    private static bool IsTokenSourceOutput(LedgerSpendableOutput output)
        => output.BusinessObject is null
            && output.Token is not null
            && output.Token.Amount.Value > 1m;
}
