@namespace CanDoItAll.Economy.Components

<SectionCard Title="Account" Description="@Description">
    <Grid ColumnsMd="2" ColumnsXl="4" Gap="LayoutGap.Medium">
        <div class="cda-economy-metric">
            <span>Main balance</span>
            <strong>@FormatAmount(Workspace.Balance.MainBalance)</strong>
        </div>
        <div class="cda-economy-metric">
            <span>Business objects</span>
            <strong>@Workspace.BusinessObjects.Count</strong>
        </div>
        <div class="cda-economy-metric">
            <span>Spendable outputs</span>
            <strong>@Workspace.Balance.UtxoCount</strong>
        </div>
        <div class="cda-economy-metric">
            <span>Subaccounts</span>
            <strong>@Workspace.SubAccounts.Count</strong>
        </div>
    </Grid>

    <Cluster Class="cda-economy-token-strip" Gap="LayoutGap.Small">
        @foreach (KeyValuePair<TokenId, Amount> token in OrderedTokenBalances)
        {
            <span class="cda-economy-token">
                <span>@token.Key</span>
                <strong>@FormatAmount(token.Value)</strong>
            </span>
        }
    </Cluster>
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    private string Description => $"{Workspace.Address} on {Workspace.Context.LedgerId}";

    private IEnumerable<KeyValuePair<TokenId, Amount>> OrderedTokenBalances
        => Workspace.Balance.TokenBalances.OrderBy(token => token.Key.Value, StringComparer.Ordinal);

    private static string FormatAmount(Amount amount) => amount.ToString();
}
