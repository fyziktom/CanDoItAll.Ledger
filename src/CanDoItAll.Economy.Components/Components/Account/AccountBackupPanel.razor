@namespace CanDoItAll.Economy.Components

<Stack Section="true" GapScale="LayoutGap.Large" data-testid="account-backup-panel">
    <Grid ColumnsLg="2" Gap="LayoutGap.Large">
        <SectionCard Title="Create or import account" Description="Three-step account setup mirrors the original backup-first flow.">
            <Stack GapScale="LayoutGap.Medium">
                <Steps Value="1"
                       CanSelect="false"
                       NavigationPosition="StepsNavigationPosition.None"
                       aria-label="Account setup steps">
                    <StepsItem Text="Create" Icon="person_add" />
                    <StepsItem Text="Password" Icon="lock" />
                    <StepsItem Text="Finish" Icon="check_circle" />
                </Steps>

                <FormField Text="Account name">
                    <TextBox Value="@Model.AccountName" aria-label="Account name" />
                </FormField>
                <FormField Text="Private key password">
                    <Password Value="**********" aria-label="Private key password" />
                </FormField>
                <FormField Text="Confirm password">
                    <Password Value="**********" aria-label="Confirm password" />
                </FormField>

                <Alert AlertStyle="AlertStyle.Success">
                    <strong>Password and confirmation match.</strong>
                    <span>@Model.StatusMessage</span>
                </Alert>

                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Import backup" Icon="upload_file" Variant="Variant.Outlined" Click="ImportBackupRequested" />
                    <Button Text="Finish setup" Icon="check_circle" ButtonStyle="ButtonStyle.Secondary" Click="CreateAccountRequested" />
                </Cluster>
                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Import private key" Icon="key" Variant="Variant.Outlined" Click="ImportPastedPrivateKeyRequested" />
                    <Button Text="Unlock account" Icon="lock_open" Variant="Variant.Outlined" Click="UnlockAccountRequested" />
                </Cluster>
            </Stack>
        </SectionCard>

        <SectionCard Title="Backup" Description="Store this backup securely; nobody else can restore the key for you.">
            <Stack GapScale="LayoutGap.Medium">
                <SurfaceCard Soft="true">
                    <Cluster Gap="LayoutGap.Medium" AlignItems="AlignItems.Center" Wrap="FlexWrap.NoWrap">
                        <Icon Name="enhanced_encryption" />
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Model.BackupFileName" />
                            <CopyableMonoValue Value="@Model.Address.Value" StartChars="12" EndChars="8" AriaLabel="Copy account address" />
                        </Stack>
                    </Cluster>
                </SurfaceCard>
                <Button Text="Backup account" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click="BackupAccountRequested" />
                <Button Text="Add SubAccount" Icon="add" Variant="Variant.Outlined" Click="CreateSubAccountRequested" />
            </Stack>
        </SectionCard>
    </Grid>
</Stack>

@code {
    [Parameter, EditorRequired]
    public AccountBackupWorkflowModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback CreateAccountRequested { get; set; }

    [Parameter]
    public EventCallback UnlockAccountRequested { get; set; }

    [Parameter]
    public EventCallback BackupAccountRequested { get; set; }

    [Parameter]
    public EventCallback ImportBackupRequested { get; set; }

    [Parameter]
    public EventCallback ImportPastedPrivateKeyRequested { get; set; }

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }
}
