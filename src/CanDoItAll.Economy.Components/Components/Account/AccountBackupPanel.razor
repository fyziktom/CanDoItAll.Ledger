@namespace CanDoItAll.Economy.Components

<section class="cda-venft-account-panel" data-testid="account-backup-panel">
    <Grid ColumnsLg="2" Gap="LayoutGap.Large">
        <SectionCard Title="Create or import account" Description="Three-step account setup mirrors the original backup-first flow.">
            <Stack GapScale="LayoutGap.Medium">
                <Steps Value="1"
                       CanSelect="false"
                       NavigationPosition="StepsNavigationPosition.None"
                       aria-label="Account setup steps">
                    <StepsItem Text="Create" Icon="person_add" />
                    <StepsItem Text="Password" Icon="lock" />
                    <StepsItem Text="Finish" Icon="check_circle" />
                </Steps>

                <label class="cda-economy-field">
                    <span>Account name</span>
                    <TextBox Value="@Model.AccountName" aria-label="Account name" />
                </label>
                <label class="cda-economy-field">
                    <span>Private key password</span>
                    <TextBox Value="**********" aria-label="Private key password" />
                </label>
                <label class="cda-economy-field">
                    <span>Confirm password</span>
                    <TextBox Value="**********" aria-label="Confirm password" />
                </label>

                <div class="cda-venft-success">
                    <strong>Password and confirmation match.</strong>
                    <span>@Model.StatusMessage</span>
                </div>

                <Cluster Gap="LayoutGap.Small">
                    <Button Text="Import backup" Icon="upload_file" Variant="Variant.Outlined" />
                    <Button Text="Finish setup" Icon="check_circle" ButtonStyle="ButtonStyle.Secondary" />
                </Cluster>
            </Stack>
        </SectionCard>

        <SectionCard Title="Backup" Description="Store this backup securely; nobody else can restore the key for you.">
            <Stack GapScale="LayoutGap.Medium">
                <div class="cda-venft-backup-card">
                    <span class="material-icons">enhanced_encryption</span>
                    <strong>@Model.BackupFileName</strong>
                    <p>@Model.Address</p>
                </div>
                <Button Text="Backup account" Icon="download" ButtonStyle="ButtonStyle.Secondary" />
                <Button Text="Add SubAccount" Icon="add" Variant="Variant.Outlined" Click="CreateSubAccountRequested" />
            </Stack>
        </SectionCard>
    </Grid>
</section>

@code {
    [Parameter, EditorRequired]
    public AccountBackupWorkflowModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback CreateSubAccountRequested { get; set; }
}
