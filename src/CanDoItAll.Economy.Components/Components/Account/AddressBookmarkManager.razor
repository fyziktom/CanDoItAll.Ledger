@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-address-bookmark-manager">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Address book</span>
            <h2>Directory</h2>
        </div>
        <PageHeaderActionButton Icon="contacts"
                                Label="Manage"
                                TooltipText="Manage address directory"
                                Variant="Variant.Outlined"
                                Click="OpenAsync" />
    </header>

    <div class="cda-sdk-list cda-address-directory-mini">
        <span>@Bookmarks.Count bookmark(s)</span>
        <Button Text="Open directory" Icon="open_in_new" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="OpenAsync" />
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<EconomyAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    private Task OpenAsync()
        => DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Address Directory",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Workspace)] = Workspace,
                [nameof(AddressDirectoryDialogContent.Bookmarks)] = Bookmarks,
                [nameof(AddressDirectoryDialogContent.AccountScope)] = Workspace?.Address.Value ?? "bookmarks",
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Manage
            },
            new DialogOptions
            {
                Subtitle = "Manage own and external addresses.",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--address-directory",
                TestId = "cda-address-directory-dialog"
            });
}
