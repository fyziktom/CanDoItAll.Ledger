@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IAccountAppSettingsBackupService BackupService

<DialogScaffold Dense="true"
                Eyebrow="Browser settings"
                Title="Import and export local settings"
                Description="Back up AccountApp UI preferences, tag usage, and address directory metadata without touching the encrypted account vault.">
    <ChildContent>
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-settings-backup" data-testid="cda-settings-backup-dialog">
            <section class="cda-ledger-panel">
                <div class="cda-ledger-panel-header">Export</div>
                <div class="cda-ledger-panel-body cda-settings-backup__section">
                    <p class="cda-ledger-empty-line">Exported settings include tag counters, tag color metadata, address favorites, user tags, and safe profile summaries.</p>
                    <Button Text="Create export"
                            Icon="download"
                            ButtonStyle="ButtonStyle.Secondary"
                            Size="ButtonSize.Small"
                            Click="ExportAsync"
                            data-testid="cda-settings-backup-export" />
                    <TextArea Value="@exportJson"
                              ValueChanged="@(value => exportJson = value ?? string.Empty)"
                              Rows="14"
                              Placeholder="Export JSON appears here."
                              aria-label="Settings export JSON" />
                </div>
            </section>

            <section class="cda-ledger-panel">
                <div class="cda-ledger-panel-header">Import</div>
                <div class="cda-ledger-panel-body cda-settings-backup__section">
                    <TextArea Value="@importJson"
                              ValueChanged="@(value => importJson = value ?? string.Empty)"
                              Rows="8"
                              Placeholder="Paste settings backup JSON."
                              aria-label="Settings import JSON" />

                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                        <Button Text="Preview"
                                Icon="visibility"
                                Variant="Variant.Outlined"
                                ButtonStyle="ButtonStyle.Secondary"
                                Size="ButtonSize.Small"
                                Click="PreviewAsync"
                                data-testid="cda-settings-backup-preview" />
                        <Button Text="Import selected"
                                Icon="restore"
                                ButtonStyle="ButtonStyle.Secondary"
                                Size="ButtonSize.Small"
                                Disabled="@(!CanImport)"
                                Click="ImportAsync"
                                data-testid="cda-settings-backup-import" />
                    </Cluster>

                    <FormField Text="Conflict strategy" ContainerClass="cda-economy-field">
                        <select class="cda-economy-input"
                                value="@strategy"
                                @onchange="OnStrategyChanged"
                                aria-label="Import conflict strategy">
                            <option value="@SettingsImportConflictStrategy.Merge">Merge</option>
                            <option value="@SettingsImportConflictStrategy.ReplaceSection">Replace section</option>
                            <option value="@SettingsImportConflictStrategy.SkipExisting">Skip existing</option>
                        </select>
                    </FormField>

                    <div class="cda-settings-backup__checks">
                        @foreach (SettingsBackupSection section in AllSections)
                        {
                            <label class="cda-economy-check-row">
                                <input type="checkbox"
                                       checked="@selectedSections.Contains(section)"
                                       @onchange="@((ChangeEventArgs args) => ToggleSection(section, args))" />
                                <span>@SectionLabel(section)</span>
                            </label>
                        }
                    </div>

                    @if (preview is not null)
                    {
                        <Alert AlertStyle="@(preview.IsValid ? AlertStyle.Success : AlertStyle.Danger)" Variant="Variant.Outlined">
                            <strong>@(preview.IsValid ? "Import preview ready" : "Import preview failed")</strong>
                            <span>@preview.Summary @(preview.Error ?? string.Empty)</span>
                        </Alert>
                    }
                </div>
            </section>
        </Grid>
    </ChildContent>
    <Footer>
        <Button Text="Close"
                Icon="close"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Click="CloseAsync" />
    </Footer>
</DialogScaffold>

@code {
    private static readonly SettingsBackupSection[] AllSections =
    [
        SettingsBackupSection.TagUsage,
        SettingsBackupSection.AddressDirectory,
        SettingsBackupSection.UiPreferences
    ];

    private string exportJson = string.Empty;
    private string importJson = string.Empty;
    private SettingsBackupPreview? preview;
    private SettingsImportConflictStrategy strategy = SettingsImportConflictStrategy.Merge;
    private HashSet<SettingsBackupSection> selectedSections = AllSections.ToHashSet();

    [Parameter, EditorRequired]
    public string AccountScope { get; set; } = "default";

    private bool CanImport => preview?.IsValid == true && selectedSections.Count > 0;

    private async Task ExportAsync()
    {
        exportJson = await BackupService.ExportAsync(AccountScope);
        importJson = exportJson;
        preview = await BackupService.PreviewImportAsync(importJson);
        Notifications.Success("Settings exported", "Browser-local settings backup is ready.", position: NotificationPosition.BottomCenter);
    }

    private async Task PreviewAsync()
    {
        preview = await BackupService.PreviewImportAsync(importJson);
        selectedSections = preview.Sections.Count == 0
            ? []
            : preview.Sections.ToHashSet();
    }

    private async Task ImportAsync()
    {
        SettingsBackupImportResult result = await BackupService.ImportAsync(AccountScope, importJson, selectedSections, strategy);
        if (result.Success)
        {
            Notifications.Success("Settings imported", result.Summary, position: NotificationPosition.BottomCenter);
            preview = await BackupService.PreviewImportAsync(importJson);
        }
        else
        {
            Notifications.Error("Settings import failed", result.Summary, position: NotificationPosition.BottomCenter);
        }
    }

    private void ToggleSection(SettingsBackupSection section, ChangeEventArgs args)
    {
        bool selected = args.Value is bool value && value;
        if (selected)
        {
            selectedSections.Add(section);
        }
        else
        {
            selectedSections.Remove(section);
        }
    }

    private void OnStrategyChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse(Convert.ToString(args.Value), out SettingsImportConflictStrategy parsed))
        {
            strategy = parsed;
        }
    }

    private static string SectionLabel(SettingsBackupSection section)
        => section switch
        {
            SettingsBackupSection.TagUsage => "Tag usage and colors",
            SettingsBackupSection.AddressDirectory => "Address directory",
            SettingsBackupSection.UiPreferences => "UI preferences",
            _ => section.ToString()
        };

    private Task CloseAsync()
        => DialogService.CloseAsync();
}
