@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IAddressDirectoryService AddressDirectory
@inject ITagOccurrenceService Tags

<DialogScaffold Dense="true"
                Eyebrow="Address directory"
                Title="@Title"
                Description="@Description">
    <ChildContent>
        <Stack GapScale="LayoutGap.Medium"
               AlignItems="AlignItems.Stretch"
               Class="cda-address-directory"
               data-testid="cda-address-directory-dialog">
            <section class="cda-address-directory__control-band">
                <div class="cda-address-directory__toolbar">
                    <SecondaryTabs Items="FilterItems"
                                   SelectedKey="@selectedFilter"
                                   SelectedKeyChanged="SelectFilterAsync"
                                   Dense="true" />
                    <FormField Text="Search" ContainerClass="cda-economy-field">
                        <TextBox Value="@search"
                                 ValueChanged="@(value => search = value ?? string.Empty)"
                                 Immediate="true"
                                 Placeholder="Name, address, or tag"
                                 aria-label="Search address directory" />
                    </FormField>
                    <div class="cda-address-directory__summary">
                        <span>Showing</span>
                        <strong>@FilteredEntries.Count / @entries.Count</strong>
                    </div>
                </div>

                @if (Mode == AddressDirectoryDialogMode.Manage)
                {
                    <section class="cda-address-directory__add" data-testid="cda-address-directory-add">
                        <FormField Text="Name" ContainerClass="cda-economy-field">
                            <TextBox Value="@newName"
                                     ValueChanged="@(value => newName = value ?? string.Empty)"
                                     Immediate="true"
                                     Placeholder="Display name" />
                        </FormField>
                        <FormField Text="Address" ContainerClass="cda-economy-field cda-economy-field--wide">
                            <TextBox Value="@newAddress"
                                     ValueChanged="@(value => newAddress = value ?? string.Empty)"
                                     Immediate="true"
                                     Placeholder="cdia1..." />
                        </FormField>
                        <PageHeaderActionButton Icon="add"
                                                Label="Add address"
                                                TooltipText="Add address to the directory"
                                                ButtonStyle="ButtonStyle.Secondary"
                                                Click="AddExternalAsync"
                                                TestId="cda-address-directory-add-button" />
                    </section>
                }
            </section>

            <div class="cda-address-directory__grid" data-testid="cda-address-directory-grid">
                @foreach (AddressDirectoryEntry entry in FilteredEntries)
                {
                    <article class="cda-address-directory-card" data-testid="cda-address-directory-card">
                        <div class="cda-address-directory-card__header">
                            <div class="cda-address-directory-card__avatar">
                                @if (!string.IsNullOrWhiteSpace(entry.ProfileImageLink))
                                {
                                    <img src="@entry.ProfileImageLink" alt="@entry.DisplayName" />
                                }
                                else
                                {
                                    <span>@Initials(entry)</span>
                                }
                            </div>
                            <div>
                                <strong>@entry.DisplayName</strong>
                                <CopyableMonoValue Value="@entry.Address" StartChars="10" EndChars="6" AriaLabel="Copy directory address" />
                            </div>
                            <PageHeaderActionButton Icon="@(entry.Favorite ? "star" : "star_border")"
                                                    Label="Favorite"
                                                    TooltipText="Toggle favorite"
                                                    Variant="Variant.Outlined"
                                                    Click="@(() => ToggleFavoriteAsync(entry))"
                                                    TestId="cda-address-directory-favorite" />
                        </div>

                        <div class="cda-address-directory-card__meta">
                            <StatusBadge Text="@entry.Kind.ToString()" Tone="@(entry.Kind == AddressDirectoryEntryKind.Own ? "info" : "neutral")" />
                            @if (!string.IsNullOrWhiteSpace(entry.ProfileDisplayName) || !string.IsNullOrWhiteSpace(entry.ProfileObjectId))
                            {
                                <StatusBadge Text="Profile cached" Tone="success" />
                            }
                        </div>

                        <FormField Text="Tags" ContainerClass="cda-economy-field cda-address-directory-card__tags">
                            <TagEditor Value="@entry.TagsOrEmpty"
                                       ValueChanged="@((IReadOnlyList<string> value) => SaveTagsAsync(entry, value))"
                                       Suggestions="@tagSuggestions"
                                       Placeholder="Add address tag"
                                       InputTestId="cda-address-directory-tag-input" />
                        </FormField>

                        <div class="cda-address-directory-card__actions">
                            @if (Mode == AddressDirectoryDialogMode.Select)
                            {
                                <PageHeaderActionButton Icon="check"
                                                        Label="Select"
                                                        TooltipText="Select this address"
                                                        ButtonStyle="ButtonStyle.Secondary"
                                                        Click="@(() => SelectAsync(entry))" />
                            }
                            else
                            {
                                <PageHeaderActionButton Icon="save"
                                                        Label="Save"
                                                        TooltipText="Save address metadata"
                                                        Variant="Variant.Outlined"
                                                        ButtonStyle="ButtonStyle.Secondary"
                                                        Click="@(() => SaveEntryAsync(entry))" />
                                <PageHeaderActionButton Icon="delete"
                                                        Label="Remove"
                                                        TooltipText="Remove address metadata"
                                                        Variant="Variant.Outlined"
                                                        ButtonStyle="ButtonStyle.Warning"
                                                        Disabled="@(entry.Kind == AddressDirectoryEntryKind.Own)"
                                                        Click="@(() => RemoveAsync(entry))" />
                            }
                        </div>
                    </article>
                }
            </div>
        </Stack>
    </ChildContent>
    <Footer>
        <PageHeaderActionButton Icon="close"
                                Label="Close"
                                TooltipText="Close address directory"
                                Variant="Variant.Outlined"
                                ButtonStyle="ButtonStyle.Light"
                                Click="CloseAsync" />
    </Footer>
</DialogScaffold>

@code {
    private static readonly IReadOnlyList<SecondaryTabItem> FilterItems =
    [
        new("all", "All"),
        new("own", "Own"),
        new("external", "External"),
        new("favorite", "Favorites")
    ];

    private IReadOnlyList<AddressDirectoryEntry> entries = [];
    private IReadOnlyList<string> tagSuggestions = [];
    private string selectedFilter = "all";
    private string search = string.Empty;
    private string newName = string.Empty;
    private string newAddress = string.Empty;

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public IReadOnlyList<EconomyAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "default";

    [Parameter]
    public AddressDirectoryDialogMode Mode { get; set; }

    private string Title => Mode == AddressDirectoryDialogMode.Select ? "Select address" : "Manage addresses";

    private string Description => Mode == AddressDirectoryDialogMode.Select
        ? "Choose an own or external address from the shared directory."
        : "Manage favorite flags and local user tags for own and external addresses.";

    private AddressDirectorySeed Seed
        => Workspace is not null
            ? AddressDirectorySeed.FromWorkspace(Workspace)
            : AddressDirectorySeed.FromBookmarks(AccountScope, Bookmarks);

    private IReadOnlyList<AddressDirectoryEntry> FilteredEntries
        => entries
            .Where(MatchesFilter)
            .Where(MatchesSearch)
            .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        entries = await AddressDirectory.GetEntriesAsync(Seed);
        tagSuggestions = await Tags.GetSuggestionsAsync(Seed.AccountScope, TagSuggestionSource.Unique);
    }

    private Task SelectFilterAsync(string filter)
    {
        selectedFilter = filter;
        return Task.CompletedTask;
    }

    private async Task AddExternalAsync()
    {
        if (string.IsNullOrWhiteSpace(newAddress))
        {
            Notifications.Warning("Address required", "Paste an address before adding a directory card.", position: NotificationPosition.BottomCenter);
            return;
        }

        var entry = new AddressDirectoryEntry(
            newAddress.Trim(),
            string.IsNullOrWhiteSpace(newName) ? AccountWorkspaceLocalServiceHelpers.ShortAddress(newAddress) : newName.Trim(),
            AddressDirectoryEntryKind.External);
        await AddressDirectory.SaveEntryAsync(Seed.AccountScope, entry);
        newAddress = string.Empty;
        newName = string.Empty;
        entries = await AddressDirectory.GetEntriesAsync(Seed);
        Notifications.Success("Address saved", entry.DisplayName, position: NotificationPosition.BottomCenter);
    }

    private async Task ToggleFavoriteAsync(AddressDirectoryEntry entry)
    {
        await SaveEntryAsync(entry with { Favorite = !entry.Favorite }, notify: false);
        Notifications.Info(entry.Favorite ? "Favorite removed" : "Favorite saved", entry.DisplayName, position: NotificationPosition.BottomCenter);
    }

    private Task SaveEntryAsync(AddressDirectoryEntry entry)
        => SaveEntryAsync(entry, notify: true);

    private async Task SaveEntryAsync(AddressDirectoryEntry entry, bool notify)
    {
        await AddressDirectory.SaveEntryAsync(Seed.AccountScope, entry);
        entries = await AddressDirectory.GetEntriesAsync(Seed);
        if (notify)
        {
            Notifications.Success("Address metadata saved", entry.DisplayName, position: NotificationPosition.BottomCenter);
        }
    }

    private async Task SaveTagsAsync(AddressDirectoryEntry entry, IReadOnlyList<string> value)
    {
        await SaveEntryAsync(entry with { UserTags = value }, notify: false);
    }

    private async Task RemoveAsync(AddressDirectoryEntry entry)
    {
        await AddressDirectory.RemoveEntryAsync(Seed.AccountScope, entry.Address);
        entries = await AddressDirectory.GetEntriesAsync(Seed);
        Notifications.Info("Address metadata removed", entry.DisplayName, position: NotificationPosition.BottomCenter);
    }

    private Task SelectAsync(AddressDirectoryEntry entry)
        => DialogService.CloseAsync(entry);

    private Task CloseAsync()
        => DialogService.CloseAsync();

    private bool MatchesFilter(AddressDirectoryEntry entry)
        => selectedFilter switch
        {
            "own" => entry.Kind == AddressDirectoryEntryKind.Own,
            "external" => entry.Kind == AddressDirectoryEntryKind.External,
            "favorite" => entry.Favorite,
            _ => true
        };

    private bool MatchesSearch(AddressDirectoryEntry entry)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        string term = search.Trim();
        return entry.DisplayName.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.Address.Contains(term, StringComparison.OrdinalIgnoreCase)
            || entry.TagsOrEmpty.Any(tag => tag.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string Initials(AddressDirectoryEntry entry)
    {
        string[] parts = entry.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        string initials = string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
        return string.IsNullOrWhiteSpace(initials) ? "AD" : initials;
    }
}
