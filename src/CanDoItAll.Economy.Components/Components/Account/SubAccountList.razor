@namespace CanDoItAll.Economy.Components

<SectionCard Title="Subaccounts" Description="Delegated accounts available from this login context">
    <HeaderActions>
        <Button Text="New" Icon="add" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="CreateRequested" />
    </HeaderActions>

    <ChildContent>
        <Stack GapScale="LayoutGap.Small" Class="cda-economy-list">
            @foreach (BusinessObjectSubAccountSummary subAccount in Items)
            {
                <div class="cda-economy-list-item">
                    <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Start" Gap="LayoutGap.Small">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                            <strong>@subAccount.Name</strong>
                            <span>@subAccount.Address</span>
                        </Stack>
                        <Cluster Gap="LayoutGap.Small">
                            <span class="cda-economy-pill">@FormatAmount(subAccount.MainBalance)</span>
                            <span class="cda-economy-pill">@subAccount.BusinessObjectCount BO</span>
                            <span class="cda-economy-pill">@subAccount.UtxoCount UTXO</span>
                        </Cluster>
                    </Split>
                </div>
            }
        </Stack>
    </ChildContent>
</SectionCard>

@code {
    [Parameter]
    public IReadOnlyList<BusinessObjectSubAccountSummary> Items { get; set; } = [];

    [Parameter]
    public EventCallback CreateRequested { get; set; }

    private static string FormatAmount(Amount amount) => amount.ToString();
}
