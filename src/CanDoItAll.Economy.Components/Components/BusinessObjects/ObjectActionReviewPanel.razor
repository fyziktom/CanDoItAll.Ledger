@namespace CanDoItAll.Economy.Components

<ActionReviewPanel Title="Object action review"
                   Description="Ownership, lineage, destination, state, and transaction impact before the host submits."
                   Items="Facts"
                   data-testid="cda-object-action-review-panel" />

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public BusinessObjectTransactionDraft? Draft { get; set; }

    private IReadOnlyList<ActionReviewFact> Facts
        =>
        [
            new("Object", Object?.ObjectId.Value ?? Draft?.ObjectId.Value ?? "none"),
            new("Version", Object?.Version.ToString() ?? "new"),
            new("Owner", Object?.OwnerAddress.Value ?? Draft?.OwnerAddress.Value ?? "unknown"),
            new("Destination", Draft?.ReceiverAddress.Value ?? "not selected"),
            new("Mode", Draft?.SelectedMode.ToString() ?? Object?.Operation.ToString() ?? "inspect"),
            new("OutPoint", Object?.CurrentOutPoint.ToString() ?? "pending")
        ];
}
