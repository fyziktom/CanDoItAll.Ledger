@namespace CanDoItAll.Economy.Components

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny">
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Object.ObjectId.Value" />
        <TextBlock TextStyle="TextStyle.Caption">@Object.ObjectType v@(Object.Version)</TextBlock>
        <Cluster Gap="LayoutGap.Small">
            <StatusBadge Tone="neutral" Text="@Object.Operation.ToString()" />
            <StatusBadge Tone="info" Text="generic" />
        </Cluster>
    </Stack>
}
else
{
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <SummaryTile Label="Renderer" Value="@Descriptor.DisplayName" Compact="true" />
            <SummaryTile Label="Object type" Value="@Object.ObjectType" Compact="true" />
            <SummaryTile Label="Object id" Value="@Object.ObjectId.Value" Compact="true" />
            <SummaryTile Label="Owner" Value="@Object.OwnerAddress.Value" Compact="true" />
            <SummaryTile Label="Operation" Value="@Object.Operation.ToString()" Compact="true" />
            <SummaryTile Label="Outpoint" Value="@Object.CurrentOutPoint.ToString()" Compact="true" />
        </Grid>

        <MetricCard Label="Data hash" Value="@Object.DataHash.Value" />
        <MetricCard Label="State JSON">
            <ValueContent>
                <TextBlock TextStyle="TextStyle.Mono" Value="@DisplayState" />
            </ValueContent>
        </MetricCard>
    </Stack>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private string DisplayState
        => string.IsNullOrWhiteSpace(Object.StateJson)
            ? "{}"
            : Object.StateJson!;
}
