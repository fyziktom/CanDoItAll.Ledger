@namespace CanDoItAll.Economy.Components

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny" Class="cda-economy-renderer-summary">
        <strong>@Object.ObjectId</strong>
        <span>@Object.ObjectType v@(Object.Version)</span>
        <Cluster Gap="LayoutGap.Small">
            <span class="cda-economy-pill">@Object.Operation</span>
            <span class="cda-economy-pill">generic</span>
        </Cluster>
    </Stack>
}
else
{
    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
        <div class="cda-economy-fact">
            <span>Renderer</span>
            <strong>@Descriptor.DisplayName</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Object type</span>
            <strong>@Object.ObjectType</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Object id</span>
            <strong>@Object.ObjectId</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Owner</span>
            <strong>@Object.OwnerAddress</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Operation</span>
            <strong>@Object.Operation</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Outpoint</span>
            <strong>@Object.CurrentOutPoint</strong>
        </div>
        <div class="cda-economy-fact cda-economy-fact--wide">
            <span>Data hash</span>
            <strong>@Object.DataHash</strong>
        </div>
        <div class="cda-economy-fact cda-economy-fact--wide">
            <span>State JSON</span>
            <pre>@DisplayState</pre>
        </div>
    </Grid>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private string DisplayState
        => string.IsNullOrWhiteSpace(Object.StateJson)
            ? "{}"
            : Object.StateJson!;
}
