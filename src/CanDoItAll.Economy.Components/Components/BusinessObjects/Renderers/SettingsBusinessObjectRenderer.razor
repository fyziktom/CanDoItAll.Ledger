@namespace CanDoItAll.Economy.Components

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny" Class="cda-economy-renderer-summary">
        <strong>@Object.ObjectId</strong>
        <span>@Settings.Count account settings</span>
        <span class="cda-economy-pill">settings renderer</span>
    </Stack>
}
else
{
    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
        <div class="cda-economy-fact">
            <span>Renderer</span>
            <strong>@Descriptor.DisplayName</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Settings count</span>
            <strong>@Settings.Count</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Object id</span>
            <strong>@Object.ObjectId</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Owner</span>
            <strong>@Object.OwnerAddress</strong>
        </div>
    </Grid>

    <Stack GapScale="LayoutGap.Small" Class="cda-economy-settings">
        @foreach (KeyValuePair<string, string> item in Settings)
        {
            <div class="cda-economy-setting-row">
                <span>@item.Key</span>
                <strong>@item.Value</strong>
            </div>
        }
    </Stack>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private IReadOnlyDictionary<string, string> Settings
        => Object is AccountSettingsBusinessObjectView settings
            ? settings.Settings
            : new Dictionary<string, string>(StringComparer.Ordinal);
}
