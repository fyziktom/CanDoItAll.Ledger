@namespace CanDoItAll.Economy.Components

@if (Typed is null)
{
    <MediaBusinessObjectRenderer Object="Object"
                                 Mode="Mode"
                                 ViewedAtUtc="ViewedAtUtc"
                                 Descriptor="Descriptor" />
}
else if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny" Class="cda-economy-renderer-summary">
        <strong>@Typed.Name</strong>
        <span>@Typed.Definition.DisplayName / @Typed.ObjectType</span>
        <Cluster Gap="LayoutGap.Small">
            <StatusBadge Tone="info" Text="@Typed.Definition.Family" />
            <StatusBadge Tone="neutral" Text="@Typed.Operation.ToString()" />
        </Cluster>
    </Stack>
}
else
{
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsLg="2" Gap="LayoutGap.Small">
            <SummaryTile Label="Renderer" Value="@Descriptor.DisplayName" />
            <SummaryTile Label="Family" Value="@Typed.Definition.Family" Tone="info" />
            <SummaryTile Label="Object type" Value="@Typed.ObjectType" />
            <SummaryTile Label="Operation" Value="@Typed.Operation.ToString()" />
            <SummaryTile Label="Name" Value="@Typed.Name" />
            <SummaryTile Label="DataItems" Value="@Typed.DataItems.Count.ToString()" Tone="neutral" />
            @foreach (BusinessObjectDisplayFact fact in Typed.Facts)
            {
                <SummaryTile Label="@fact.Label" Value="@fact.Value" />
            }
        </Grid>

        @if (!string.IsNullOrWhiteSpace(Typed.Description))
        {
            <SummaryTile Label="Description" Value="@Typed.Description" />
        }

        @if (!string.IsNullOrWhiteSpace(Typed.Text)
            && !Typed.Text.Equals(Typed.Description, StringComparison.Ordinal))
        {
            <SummaryTile Label="Text" Value="@Typed.Text" />
        }
    </Stack>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private ITypedBusinessObjectView? Typed
        => Object as ITypedBusinessObjectView;
}

