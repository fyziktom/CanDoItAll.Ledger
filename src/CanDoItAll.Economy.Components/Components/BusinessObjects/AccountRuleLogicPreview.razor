@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel" data-testid="cda-account-rule-preview">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Rule logic</span>
            <h2>@(Rule?.RuleId ?? "No rule")</h2>
        </div>
        @if (Rule is not null)
        {
            <Cluster Gap="LayoutGap.Small">
                <StatusBadge Text="@(Rule.Enabled ? "enabled" : "disabled")" Tone="@(Rule.Enabled ? "success" : "muted")" />
                <StatusBadge Text="@Rule.RuleNamespace" Tone="info" />
            </Cluster>
        }
    </header>

    @if (Rule is null)
    {
        <EmptyState Eyebrow="Rule" Title="No rule preview" Description="Complete the required fields to preview the rule logic." />
    }
    else
    {
        <Stack GapScale="@(Compact ? LayoutGap.Small : LayoutGap.Medium)">
            @if (ValidationErrors.Count > 0)
            {
                <Alert AlertStyle="AlertStyle.Warning">
                    <strong>Rule needs attention</strong>
                    <span>@string.Join(" ", ValidationErrors)</span>
                </Alert>
            }

            <Grid ColumnsLg="3" Gap="LayoutGap.Small">
                <div class="cda-economy-fact"><span>Trigger</span><strong>@TriggerLabel</strong></div>
                <div class="cda-economy-fact"><span>Conditions</span><strong>@Rule.Conditions.Count</strong></div>
                <div class="cda-economy-fact"><span>Actions</span><strong>@Rule.Actions.Count</strong></div>
                <div class="cda-economy-fact"><span>Processed flag</span><strong>@Processing.ProcessedProperty</strong></div>
                <div class="cda-economy-fact"><span>Keep trigger BO</span><strong>@(Processing.KeepProcessedBusinessObject ? "yes" : "close after processing")</strong></div>
                <div class="cda-economy-fact"><span>Max actions</span><strong>@Processing.MaxActionsPerRefresh</strong></div>
            </Grid>

            <Grid ColumnsLg="3" Gap="LayoutGap.Small">
                <section>
                    <div class="cda-sdk-section__heading">
                        <span>Variables</span>
                        <h2>@Rule.Variables.Count variable(s)</h2>
                    </div>
                    <div class="cda-sdk-list">
                        @if (Rule.Variables.Count == 0)
                        {
                            <p class="cda-vef-empty-line">No custom variables.</p>
                        }
                        else
                        {
                            @foreach (KeyValuePair<string, string> variable in Rule.Variables)
                            {
                                <article class="cda-sdk-list__row">
                                    <span class="material-icons" aria-hidden="true">tag</span>
                                    <div>
                                        <strong>@variable.Key</strong>
                                        <span>@variable.Value</span>
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </section>

                <section>
                    <div class="cda-sdk-section__heading">
                        <span>Conditions</span>
                        <h2>NCalc expressions</h2>
                    </div>
                    <div class="cda-sdk-list">
                        @foreach (string condition in Rule.Conditions)
                        {
                            <article class="cda-sdk-list__row">
                                <span class="material-icons" aria-hidden="true">rule</span>
                                <div>
                                    <strong>@condition</strong>
                                    <span>must evaluate true</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>

                <section>
                    <div class="cda-sdk-section__heading">
                        <span>Actions</span>
                        <h2>Submitted by refresh</h2>
                    </div>
                    <div class="cda-sdk-list">
                        @foreach (AccountRuleAction action in Rule.Actions)
                        {
                            <article class="cda-sdk-list__row">
                                <span class="material-icons" aria-hidden="true">@ActionIcon(action.Kind)</span>
                                <div>
                                    <strong>@action.Kind</strong>
                                    <span>@ActionDetails(action)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            </Grid>
        </Stack>
    }
</section>

@code {
    [Parameter]
    public AccountRuleDefinition? Rule { get; set; }

    [Parameter]
    public IReadOnlyList<string> ValidationErrors { get; set; } = [];

    [Parameter]
    public bool Compact { get; set; }

    private AccountRuleProcessingOptions Processing
        => Rule?.Processing ?? AccountRuleProcessingOptions.Default;

    private string TriggerLabel
    {
        get
        {
            AccountRuleTrigger trigger = Rule?.Trigger ?? AccountRuleTrigger.Default;
            return string.IsNullOrWhiteSpace(trigger.ObjectType)
                ? trigger.Kind.ToString()
                : $"{trigger.Kind} / {trigger.ObjectType}";
        }
    }

    private static string ActionIcon(AccountRuleActionKind kind)
        => kind switch
        {
            AccountRuleActionKind.Payment => "payments",
            AccountRuleActionKind.TokenTransfer => "toll",
            AccountRuleActionKind.TransferBusinessObject => "move_up",
            AccountRuleActionKind.UpdateBusinessObject => "edit_note",
            AccountRuleActionKind.MarkProcessed => "task_alt",
            _ => "bolt"
        };

    private static string ActionDetails(AccountRuleAction action)
        => action.Kind switch
        {
            AccountRuleActionKind.Payment => $"{action.AmountExpression} main to {Short(action.ReceiverAddress)}",
            AccountRuleActionKind.TokenTransfer => $"{action.AmountExpression} {action.TokenId} to {Short(action.ReceiverAddress)}",
            AccountRuleActionKind.TransferBusinessObject => $"transfer trigger BO to {Short(action.ReceiverAddress)}",
            AccountRuleActionKind.UpdateBusinessObject => "update trigger BO state",
            AccountRuleActionKind.MarkProcessed => "mark or close trigger BO",
            _ => "rule action"
        };

    private static string Short(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? "not set"
            : value.Length <= 18
                ? value
                : $"{value[..10]}...{value[^5..]}";
}
