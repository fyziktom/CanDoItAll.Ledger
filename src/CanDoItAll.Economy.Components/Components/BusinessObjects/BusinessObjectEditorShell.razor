@namespace CanDoItAll.Economy.Components

<SectionCard Title="Business object editor" Description="Time-aware draft surface for create and update flows">
    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
        <Stack GapScale="LayoutGap.Small">
            <FormField Text="Object id">
                <TextBox Value="@Editor.ObjectId.Value" aria-label="Object id" />
            </FormField>
            <FormField Text="Object type">
                <TextBox Value="@Editor.ObjectType" aria-label="Object type" />
            </FormField>
            <FormField Text="Schema version">
                <TextBox Value="@Editor.SchemaVersion" aria-label="Schema version" />
            </FormField>
            <FormField Text="Effective time">
                <TextBox Value="@FormatTime(Editor.EffectiveTimeUtc)" aria-label="Effective time" />
            </FormField>
        </Stack>
        <Stack GapScale="LayoutGap.Small">
            <FormField Text="Owner address">
                <TextBox Value="@Editor.OwnerAddress.Value" aria-label="Owner address" />
            </FormField>
            <FormField Text="State JSON">
                <TextArea Value="@Editor.StateJson" Rows="10" aria-label="State JSON" />
            </FormField>
            <Cluster Gap="LayoutGap.Small">
                <Button Text="Validate" Icon="fact_check" Variant="Variant.Outlined" Click="ValidateRequested" />
                <Button Text="Stage update" Icon="playlist_add_check" ButtonStyle="ButtonStyle.Secondary" Click="StageRequested" />
            </Cluster>
        </Stack>
    </Grid>
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectEditorModel Editor { get; set; } = default!;

    [Parameter]
    public EventCallback ValidateRequested { get; set; }

    [Parameter]
    public EventCallback StageRequested { get; set; }

    private static string FormatTime(DateTimeOffset time) => time.ToString("u");
}
