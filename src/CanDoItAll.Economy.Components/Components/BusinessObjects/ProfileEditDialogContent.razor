@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService

<SectionCard Title="@DialogTitle" Description="@ProfileDescription">
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <FormField Text="Display name" ContainerClass="cda-economy-field cda-economy-field--wide">
                <TextBox Value="@displayName" ValueChanged="@(value => displayName = value ?? string.Empty)" Immediate="true" aria-label="Profile display name" />
            </FormField>
            <FormField Text="First name" ContainerClass="cda-economy-field">
                <TextBox Value="@firstName" ValueChanged="@(value => firstName = value ?? string.Empty)" Immediate="true" aria-label="Profile first name" />
            </FormField>
            <FormField Text="Surname" ContainerClass="cda-economy-field">
                <TextBox Value="@surname" ValueChanged="@(value => surname = value ?? string.Empty)" Immediate="true" aria-label="Profile surname" />
            </FormField>
            <FormField Text="Nickname" ContainerClass="cda-economy-field">
                <TextBox Value="@nickname" ValueChanged="@(value => nickname = value ?? string.Empty)" Immediate="true" aria-label="Profile nickname" />
            </FormField>
            <FormField Text="Image link" ContainerClass="cda-economy-field">
                <TextBox Value="@imageLink" ValueChanged="@(value => imageLink = value ?? string.Empty)" Immediate="true" aria-label="Profile image link" />
            </FormField>
            <FormField Text="Contact" ContainerClass="cda-economy-field">
                <TextBox Value="@contact" ValueChanged="@(value => contact = value ?? string.Empty)" Immediate="true" aria-label="Profile contact" />
            </FormField>
            <FormField Text="Website" ContainerClass="cda-economy-field">
                <TextBox Value="@website" ValueChanged="@(value => website = value ?? string.Empty)" Immediate="true" aria-label="Profile website" />
            </FormField>
            <FormField Text="Role" ContainerClass="cda-economy-field">
                <TextBox Value="@role" ValueChanged="@(value => role = value ?? string.Empty)" Immediate="true" aria-label="Profile role" />
            </FormField>
            <FormField Text="Age" ContainerClass="cda-economy-field">
                <TextBox Value="@age" ValueChanged="@(value => age = value ?? string.Empty)" Immediate="true" aria-label="Profile age" />
            </FormField>
            <FormField Text="Relationship status" ContainerClass="cda-economy-field">
                <TextBox Value="@relationshipStatus" ValueChanged="@(value => relationshipStatus = value ?? string.Empty)" Immediate="true" aria-label="Profile relationship status" />
            </FormField>
            <FormField Text="Currency" ContainerClass="cda-economy-field">
                <TextBox Value="@currency" ValueChanged="@(value => currency = value ?? string.Empty)" Immediate="true" aria-label="Profile currency" />
            </FormField>
            <FormField Text="Approval mode" ContainerClass="cda-economy-field">
                <TextBox Value="@approvalMode" ValueChanged="@(value => approvalMode = value ?? string.Empty)" Immediate="true" aria-label="Profile approval mode" />
            </FormField>
            <FormField Text="Simulation clock" ContainerClass="cda-economy-field">
                <TextBox Value="@simulationClock" ValueChanged="@(value => simulationClock = value ?? string.Empty)" Immediate="true" aria-label="Profile simulation clock" />
            </FormField>
            <FormField Text="Bio" ContainerClass="cda-economy-field cda-economy-field--wide">
                <TextArea Value="@bio" ValueChanged="@(value => bio = value ?? string.Empty)" Immediate="true" Rows="5" aria-label="Profile bio" />
            </FormField>
        </Grid>

        <Cluster Gap="LayoutGap.Small">
            <Button Text="@SaveButtonText" Icon="save" Click="SubmitAsync" />
            <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="CancelAsync" />
        </Cluster>
    </Stack>
</SectionCard>

@code {
    private string displayName = "Operations account";
    private string firstName = string.Empty;
    private string surname = string.Empty;
    private string nickname = string.Empty;
    private string bio = string.Empty;
    private string imageLink = string.Empty;
    private string age = string.Empty;
    private string relationshipStatus = string.Empty;
    private string contact = string.Empty;
    private string website = string.Empty;
    private string role = string.Empty;
    private string currency = "USD";
    private string approvalMode = "two-step";
    private string simulationClock = "manual";

    [Parameter]
    public IBusinessObjectView? ProfileObject { get; set; }

    [Parameter]
    public string AccountName { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<ProfileEditRequest> SubmitRequested { get; set; }

    private bool IsNewProfile => ProfileObject is null;

    private string DialogTitle => IsNewProfile ? "Create Profile" : "Edit Profile";

    private string ProfileDescription => ProfileObject?.ObjectId.Value ?? "New profile BusinessObject";

    private string SaveButtonText => IsNewProfile ? "Create Profile" : "Save Profile";

    protected override void OnParametersSet()
    {
        displayName = string.IsNullOrWhiteSpace(displayName) ? AccountName : displayName;

        if (ProfileObject is IMediaBusinessObjectView media)
        {
            displayName = string.IsNullOrWhiteSpace(media.Name) ? displayName : media.Name;
            bio = string.IsNullOrWhiteSpace(media.Text) ? media.Description : media.Text;
        }

        if (BusinessObjectPayloadBuilder.TryParseMediaPayload(ProfileObject?.StateJson, out BusinessObjectMediaPayload? payload)
            && payload is not null)
        {
            displayName = string.IsNullOrWhiteSpace(payload.Name) ? displayName : payload.Name;
            bio = string.IsNullOrWhiteSpace(payload.Text) ? payload.Description : payload.Text;
            imageLink = payload.ImageLink ?? imageLink;
            website = payload.Link ?? website;
            ApplyFields(payload.Fields);
        }

        if (ProfileObject is AccountSettingsBusinessObjectView settings)
        {
            displayName = settings.Settings.TryGetValue("displayName", out string? name) ? name : AccountName;
            currency = settings.Settings.TryGetValue("currency", out string? value) ? value : currency;
            approvalMode = settings.Settings.TryGetValue("approvalMode", out value) ? value : approvalMode;
            simulationClock = settings.Settings.TryGetValue("simulationClock", out value) ? value : simulationClock;
        }
    }

    private async Task SubmitAsync()
    {
        var request = new ProfileEditRequest(
            ProfileObject?.ObjectId ?? BusinessObjectCreateIdFactory.CreateNewObjectId("profile", displayName),
            currency,
            approvalMode,
            displayName,
            simulationClock,
            ProfileObject?.StateJson ?? "{}",
            CreateNew: ProfileObject is null,
            FirstName: firstName,
            Surname: surname,
            Nickname: nickname,
            Bio: bio,
            ImageLink: imageLink,
            Age: age,
            RelationshipStatus: relationshipStatus,
            Contact: contact,
            Website: website,
            Role: role);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private void ApplyFields(IReadOnlyDictionary<string, string>? fields)
    {
        if (fields is null)
        {
            return;
        }

        firstName = Get(fields, "firstName", firstName);
        surname = Get(fields, "surname", surname);
        nickname = Get(fields, "nickname", nickname);
        bio = Get(fields, "bio", bio);
        imageLink = Get(fields, "imageLink", imageLink);
        age = Get(fields, "age", age);
        relationshipStatus = Get(fields, "relationshipStatus", relationshipStatus);
        contact = Get(fields, "contact", contact);
        website = Get(fields, "website", website);
        role = Get(fields, "role", role);
        currency = Get(fields, "currency", currency);
        approvalMode = Get(fields, "approvalMode", approvalMode);
        simulationClock = Get(fields, "simulationClock", simulationClock);
    }

    private static string Get(IReadOnlyDictionary<string, string> fields, string key, string fallback)
        => fields.TryGetValue(key, out string? value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : fallback;

    private Task CancelAsync() => DialogService.CloseAsync();
}
