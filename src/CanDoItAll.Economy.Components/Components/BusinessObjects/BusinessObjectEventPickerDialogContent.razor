@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications

<Stack GapScale="LayoutGap.Medium" Class="cda-event-picker" data-testid="cda-event-picker-content">
    <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-event-picker__layout">
        <section class="cda-vef-panel">
            <div class="cda-vef-panel-header">
                <span>Available Events</span>
                <span class="cda-vef-source-pill cda-vef-source-pill--source">@FilteredEvents.Count event(s)</span>
            </div>
            <div class="cda-vef-panel-body">
                <FormField Text="Search events">
                    <TextBox Value="@searchText"
                             ValueChanged="@(value => searchText = value ?? string.Empty)"
                             Immediate="true"
                             Placeholder="Name, location, owner, BO id"
                             aria-label="Search available events" />
                </FormField>

                @if (FilteredEvents.Count == 0)
                {
                    <p class="cda-vef-empty-line">No event BOs match the current search.</p>
                }
                else
                {
                    <div class="cda-event-picker__list">
                        @foreach (IBusinessObjectView item in FilteredEvents)
                        {
                            <button type="button"
                                    class="@EventButtonClass(item)"
                                    @onclick="@(() => SelectEvent(item))"
                                    data-testid="cda-event-picker-event">
                                <span class="material-icons" aria-hidden="true">event</span>
                                <span>
                                    <strong>@DisplayName(item)</strong>
                                    <small>@DisplaySubtitle(item)</small>
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        </section>

        <Stack GapScale="LayoutGap.Medium" Class="min-w-0">
            <section class="cda-vef-panel">
                <div class="cda-vef-panel-header">Load By Hash</div>
                <div class="cda-vef-panel-body">
                    <FormField Text="Event BO id or transaction hash">
                        <TextBox Value="@lookupText"
                                 ValueChanged="@(value => lookupText = value ?? string.Empty)"
                                 Immediate="true"
                                 Placeholder="transaction-hash:output-index or transaction hash"
                                 aria-label="Event BusinessObject id or transaction hash"
                                 data-testid="cda-event-lookup-input" />
                    </FormField>
                    <Cluster Gap="LayoutGap.Small">
                        <Button Text="Load Event"
                                Icon="travel_explore"
                                ButtonStyle="ButtonStyle.Secondary"
                                Disabled="@(!CanLookup)"
                                Click="LookupAsync"
                                data-testid="cda-event-lookup-button" />
                    </Cluster>
                    @if (!string.IsNullOrWhiteSpace(lookupSummary))
                    {
                        <p class="cda-vef-empty-line">@lookupSummary</p>
                    }
                </div>
            </section>

            <section class="cda-vef-panel" data-testid="cda-event-picker-selected">
                <div class="cda-vef-panel-header">Selected Event</div>
                <div class="cda-vef-panel-body">
                    @if (selectedEvent is null)
                    {
                        <p class="cda-vef-empty-line">Select or load an event BO to preload ticket data.</p>
                    }
                    else
                    {
                        <Stack GapScale="LayoutGap.Small">
                            <div class="cda-event-picker__selected-title">
                                <span class="material-icons" aria-hidden="true">event_available</span>
                                <div>
                                    <strong>@DisplayName(selectedEvent)</strong>
                                    <small>@selectedEvent.ObjectId.Value</small>
                                </div>
                            </div>
                            <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                <div class="cda-economy-fact"><span>Owner</span><strong>@ShortAddress(selectedEvent.OwnerAddress.Value)</strong></div>
                                <div class="cda-economy-fact"><span>Created</span><strong>@selectedEvent.CreatedAt.ToString("MM.dd HH:mm")</strong></div>
                                @foreach (BusinessObjectDisplayFact fact in DisplayFacts(selectedEvent).Take(6))
                                {
                                    <div class="cda-economy-fact"><span>@fact.Label</span><strong>@fact.Value</strong></div>
                                }
                            </Grid>
                        </Stack>
                    }
                </div>
            </section>
        </Stack>
    </Grid>

    <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
        <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" Click="CancelAsync" />
        <Button Text="Use Event"
                Icon="check"
                ButtonStyle="ButtonStyle.Secondary"
                Disabled="@(selectedEvent is null)"
                Click="UseSelectedAsync"
                data-testid="cda-event-picker-use" />
    </Cluster>
</Stack>

@code {
    private string searchText = string.Empty;
    private string lookupText = string.Empty;
    private string? lookupSummary;
    private bool lookupInProgress;
    private IBusinessObjectView? selectedEvent;

    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Events { get; set; } = [];

    [Parameter]
    public Func<BusinessObjectEventLookupRequest, Task<BusinessObjectEventLookupResult>>? LookupRequested { get; set; }

    private IReadOnlyList<IBusinessObjectView> FilteredEvents
        => Events
            .Where(IsEvent)
            .Where(MatchesSearch)
            .OrderByDescending(item => item.CreatedAt)
            .ThenByDescending(item => item.ObjectId.Value, StringComparer.Ordinal)
            .ToArray();

    private bool CanLookup
        => LookupRequested is not null
            && !lookupInProgress
            && !string.IsNullOrWhiteSpace(lookupText);

    protected override void OnParametersSet()
    {
        selectedEvent ??= FilteredEvents.FirstOrDefault();
    }

    private async Task LookupAsync()
    {
        if (LookupRequested is null || string.IsNullOrWhiteSpace(lookupText))
        {
            return;
        }

        lookupInProgress = true;
        lookupSummary = null;
        try
        {
            BusinessObjectEventLookupResult result = await LookupRequested(new BusinessObjectEventLookupRequest(lookupText));
            lookupSummary = result.Summary;
            if (result.Found && result.EventObject is not null)
            {
                selectedEvent = result.EventObject;
                Notifications.Success("Event loaded", result.Summary, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Warning("Event not found", result.Summary, position: NotificationPosition.BottomCenter);
            }
        }
        catch (Exception exception)
        {
            lookupSummary = exception.Message;
            Notifications.Error("Event lookup failed", exception.Message, position: NotificationPosition.BottomCenter);
        }
        finally
        {
            lookupInProgress = false;
        }
    }

    private void SelectEvent(IBusinessObjectView item)
    {
        selectedEvent = item;
        lookupSummary = null;
    }

    private Task UseSelectedAsync()
        => DialogService.CloseAsync(selectedEvent);

    private Task CancelAsync()
        => DialogService.CloseAsync((object?)null);

    private string EventButtonClass(IBusinessObjectView item)
        => selectedEvent?.ObjectId == item.ObjectId
            ? "cda-event-picker__event is-selected"
            : "cda-event-picker__event";

    private bool MatchesSearch(IBusinessObjectView item)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        string needle = searchText.Trim();
        return Contains(item.ObjectId.Value, needle)
            || Contains(item.OwnerAddress.Value, needle)
            || Contains(DisplayName(item), needle)
            || Contains(DisplaySubtitle(item), needle)
            || DisplayFacts(item).Any(fact => Contains(fact.Value, needle));
    }

    private static bool IsEvent(IBusinessObjectView item)
        => item.ObjectType.Equals("event", StringComparison.OrdinalIgnoreCase);

    private static string DisplayName(IBusinessObjectView item)
        => item is ITypedBusinessObjectView typed && !string.IsNullOrWhiteSpace(typed.Name)
            ? typed.Name
            : item.ObjectId.Value;

    private static string DisplaySubtitle(IBusinessObjectView item)
    {
        if (item is ITypedBusinessObjectView typed)
        {
            string? startsAt = FieldValue(typed.Fields, "startsAt", "eventDate");
            string? location = FieldValue(typed.Fields, "location");
            if (!string.IsNullOrWhiteSpace(startsAt) && !string.IsNullOrWhiteSpace(location))
            {
                return $"{startsAt} - {location}";
            }

            if (!string.IsNullOrWhiteSpace(startsAt))
            {
                return startsAt;
            }

            if (!string.IsNullOrWhiteSpace(location))
            {
                return location;
            }
        }

        return ShortAddress(item.OwnerAddress.Value);
    }

    private static IReadOnlyList<BusinessObjectDisplayFact> DisplayFacts(IBusinessObjectView item)
        => item is ITypedBusinessObjectView typed ? typed.Facts : [];

    private static string? FieldValue(IReadOnlyDictionary<string, string> fields, params string[] keys)
    {
        foreach (string key in keys)
        {
            if (fields.TryGetValue(key, out string? value) && !string.IsNullOrWhiteSpace(value))
            {
                return value;
            }
        }

        return null;
    }

    private static bool Contains(string value, string needle)
        => value.Contains(needle, StringComparison.OrdinalIgnoreCase);

    private static string ShortAddress(string value)
        => value.Length > 18 ? $"{value[..10]}...{value[^6..]}" : value;
}
