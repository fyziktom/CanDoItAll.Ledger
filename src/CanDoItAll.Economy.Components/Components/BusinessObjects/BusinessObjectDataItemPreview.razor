@namespace CanDoItAll.Economy.Components
@inherits BusinessObjectDataItemAddressComponentBase

<div class="@PreviewClass">
    @if (Item.Type == BusinessObjectDataItemType.Image && PreviewUri is not null)
    {
        <img src="@PreviewUri" alt="@Item.Name" />
    }
    else if (IsVideo && PreviewUri is not null)
    {
        <video src="@PreviewUri" controls preload="metadata"></video>
    }
    else if (IsAudio && PreviewUri is not null)
    {
        <div class="cda-bo-file-preview cda-bo-file-preview--audio">
            <Icon Name="graphic_eq" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Item.Name" />
            <audio src="@PreviewUri" controls preload="metadata"></audio>
        </div>
    }
    else
    {
        <div class="cda-bo-file-preview">
            <Icon Name="@Icon" />
            <TextBlock TextStyle="TextStyle.Subtitle2" Value="@Label" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectDataItem Item { get; set; } = default!;

    [Parameter]
    public bool Large { get; set; }

    [Parameter]
    public bool Flush { get; set; }

    private string PreviewClass
        => CssClassBuilder.Join(
            "cda-bo-data-preview w-full",
            Large ? "cda-bo-data-preview--large" : null,
            Flush ? "cda-bo-data-preview--flush" : null);

    private string? PreviewUri
        => ResolveDataItemUriString(Item);

    private bool IsVideo
        => Item.Type == BusinessObjectDataItemType.AVMedia
            && (Item.ContentType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) == true);

    private bool IsAudio
        => Item.Type == BusinessObjectDataItemType.AVMedia
            && (Item.ContentType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) == true);

    private string Icon
        => Item.Type switch
        {
            BusinessObjectDataItemType.Pdf => "picture_as_pdf",
            BusinessObjectDataItemType.Json => "data_object",
            BusinessObjectDataItemType.Html => "html",
            BusinessObjectDataItemType.Mermaid => "account_tree",
            BusinessObjectDataItemType.AVMedia => "movie",
            BusinessObjectDataItemType.Text => "article",
            _ => "insert_drive_file"
        };

    private string Label
        => Item.Type switch
        {
            BusinessObjectDataItemType.Pdf => "PDF",
            BusinessObjectDataItemType.Json => "JSON",
            BusinessObjectDataItemType.Html => "HTML",
            BusinessObjectDataItemType.Mermaid => "MMD",
            BusinessObjectDataItemType.AVMedia => "Media",
            BusinessObjectDataItemType.Text => "Text",
            _ => "File"
        };
}
