@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-bo-data-item-strip">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Attached data</span>
            <h2>Data items</h2>
        </div>
        <StatusBadge Text="@($"{Items.Count} item(s)")" Tone="info" />
    </header>

    @if (Items.Count == 0)
    {
        <p class="cda-sdk-muted">No attached data items were found for this object.</p>
    }
    else
    {
        <div class="cda-sdk-asset-strip">
            @foreach (BusinessObjectDataItem item in Items)
            {
                <article class="cda-sdk-asset-card">
                    <span>@item.Type</span>
                    <strong>@item.Name</strong>
                    <em>@(item.Size?.ToString("N0") ?? "unknown") bytes</em>
                    <HashDisplay Value="@item.Hash" />
                    <Button Text="Download"
                            Icon="download"
                            Size="ButtonSize.Small"
                            Variant="Variant.Outlined"
                            Href="@item.Uri?.ToString()"
                            Target="_blank"
                            Rel="noopener noreferrer"
                            Disabled="@(item.Uri is null)" />
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    private IReadOnlyList<BusinessObjectDataItem> Items
        => Object is IMediaBusinessObjectView media ? media.DataItems : [];
}
