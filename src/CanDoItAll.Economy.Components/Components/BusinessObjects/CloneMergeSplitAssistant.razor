@namespace CanDoItAll.Economy.Components

<DialogScaffold Eyebrow="Business object actions"
                Title="Clone, merge, or split"
                Description="Advanced actions stay review-first and expose lineage before submission."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                ValidationContent="@RenderValidation"
                Footer="@RenderFooter"
                data-testid="cda-clone-merge-split-assistant">
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <FormField Text="Action">
                <DropDown TItem="string" Value="@mode" ValueChanged="@((string value) => mode = value)" Items="Modes" />
            </FormField>
            <FormField Text="Result business-object ID">
                <TextBlock TextStyle="TextStyle.Muted" Value="Assigned after confirmation from the transaction output." />
            </FormField>
            <FormField Text="Payment amount">
                <TextBox @bind-Value="amount" />
            </FormField>
        </Grid>
        <FormField Text="Notes">
            <TextArea @bind-Value="notes" Rows="4" />
        </FormField>
    </Stack>
</DialogScaffold>

@code {
    private string mode = "Clone";
    private string amount = "1000";
    private string notes = "Create a reviewable branch before merging or splitting payment outputs.";
    private static readonly IReadOnlyList<string> Modes = ["Clone", "Merge", "Split payment"];

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<BusinessObjectStateViewer>(0);
        builder.AddAttribute(1, nameof(BusinessObjectStateViewer.Object), Object);
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<ActionReviewPanel>(0);
        builder.AddAttribute(1, nameof(ActionReviewPanel.Title), "Lineage impact");
        builder.AddAttribute(2, nameof(ActionReviewPanel.Items), new[]
        {
            new ActionReviewFact("Action", mode),
            new ActionReviewFact("Source", Object?.ObjectId.Value ?? "none"),
            new ActionReviewFact("Result ID", "Assigned after confirmation"),
            new ActionReviewFact("Amount", amount)
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderValidation => builder =>
    {
        builder.OpenComponent<Alert>(0);
        builder.AddAttribute(1, nameof(Alert.AlertStyle), AlertStyle.Info);
        builder.AddAttribute(2, nameof(Alert.ChildContent), (RenderFragment)(content =>
        {
            content.AddContent(0, "Host applications decide which advanced action modes are supported by the active SDK/node.");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Save draft");
        builder.AddAttribute(2, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(3);
        builder.AddAttribute(4, nameof(Button.Text), "Review action");
        builder.AddAttribute(5, nameof(Button.Icon), "fact_check");
        builder.CloseComponent();
    };
}
