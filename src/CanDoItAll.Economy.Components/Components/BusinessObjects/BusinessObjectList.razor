@namespace CanDoItAll.Economy.Components

<SectionCard Title="Business objects" Description="Current BO holdings projected from the ledger">
    <Stack GapScale="LayoutGap.Small" Class="cda-economy-list">
        @foreach (IBusinessObjectView item in Items)
        {
            bool isSelected = SelectedObjectId.HasValue && item.ObjectId.Equals(SelectedObjectId.Value);

            <button type="button"
                    class="@ResolveItemClass(isSelected)"
                    @onclick="() => SelectAsync(item)">
                <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Start" Gap="LayoutGap.Small">
                    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                        <strong>@item.ObjectId</strong>
                        <span>@item.ObjectType v@(item.Version) owned by @item.OwnerAddress</span>
                    </Stack>
                    <Cluster Gap="LayoutGap.Small">
                        <span class="cda-economy-pill">@item.Operation</span>
                        <span class="cda-economy-pill">schema @item.SchemaVersion</span>
                    </Cluster>
                </Split>
            </button>
        }
    </Stack>
</SectionCard>

@code {
    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Items { get; set; } = [];

    [Parameter]
    public BusinessObjectId? SelectedObjectId { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> SelectedObjectChanged { get; set; }

    private Task SelectAsync(IBusinessObjectView item)
        => SelectedObjectChanged.InvokeAsync(item);

    private static string ResolveItemClass(bool isSelected)
        => isSelected
            ? "cda-economy-list-item cda-economy-list-item--active"
            : "cda-economy-list-item";
}
