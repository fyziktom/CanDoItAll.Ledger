@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService

<section class="cda-vef-panel cda-vef-commerce-dashboard" data-testid="cda-commerce-dashboard">
    <div class="cda-vef-panel-header">
        <span>Commerce Records</span>
        <StatusBadge Text="@($"{CommerceItemCount} item(s)")" Tone="info" />
    </div>
    <div class="cda-vef-panel-body">
        @if (CommerceItemCount == 0)
        {
            <p class="cda-vef-empty-line">No payment, purchase, or receipt records are visible in this account.</p>
        }
        else
        {
            <section class="cda-vef-commerce-group" data-testid="cda-commerce-payments">
                <div class="cda-vef-panel-subheader">
                    <span>Payments</span>
                    <StatusBadge Text="@($"{PaymentItems.Count} item(s)")" Tone="info" />
                </div>
                <div class="cda-vef-commerce-list">
                    @if (PaymentItems.Count == 0)
                    {
                        <p class="cda-vef-empty-line">No payment records are visible in this account.</p>
                    }
                    else
                    {
                        @foreach (ICommerceBusinessObjectView item in PaymentItems)
                        {
                            IBusinessObjectView? relatedObject = ResolveRelatedBusinessObject(item);
                            <article class="cda-vef-commerce-row"
                                     data-testid="cda-commerce-record"
                                     data-commerce-kind="payment">
                                <span class="material-icons cda-vef-commerce-row__icon" aria-hidden="true">@IconFor(item)</span>
                                <span class="cda-vef-commerce-row__content">
                                    <strong>@DisplayName(item)</strong>
                                    <small>@SummaryFor(item)</small>
                                </span>
                                <em>@item.ObjectType</em>
                                <span class="cda-vef-commerce-row__actions">
                                    <Button Text="Record"
                                            Icon="info"
                                            Size="ButtonSize.Small"
                                            Variant="Variant.Outlined"
                                            Click="@(() => OpenDetailsAsync(item))"
                                            data-testid="cda-commerce-record-details" />
                                    <Button Text="@RelatedButtonText(item)"
                                            Icon="inventory_2"
                                            Size="ButtonSize.Small"
                                            ButtonStyle="ButtonStyle.Secondary"
                                            Disabled="@(relatedObject is null)"
                                            Click="@(() => OpenRelatedDetailsAsync(relatedObject))"
                                            title="@RelatedButtonTitle(relatedObject)"
                                            data-testid="cda-commerce-related-details" />
                                </span>
                            </article>
                        }
                    }
                </div>
            </section>

            <section class="cda-vef-commerce-group" data-testid="cda-commerce-receipts">
                <div class="cda-vef-panel-subheader">
                    <span>Receipts</span>
                    <StatusBadge Text="@($"{ReceiptItems.Count} item(s)")" Tone="info" />
                </div>
                <div class="cda-vef-commerce-list">
                    @if (ReceiptItems.Count == 0)
                    {
                        <p class="cda-vef-empty-line">No receipt or purchase records are visible in this account.</p>
                    }
                    else
                    {
                        @foreach (ICommerceBusinessObjectView item in ReceiptItems)
                        {
                            IBusinessObjectView? relatedObject = ResolveRelatedBusinessObject(item);
                            <article class="cda-vef-commerce-row"
                                     data-testid="cda-commerce-record"
                                     data-commerce-kind="receipt">
                                <span class="material-icons cda-vef-commerce-row__icon" aria-hidden="true">@IconFor(item)</span>
                                <span class="cda-vef-commerce-row__content">
                                    <strong>@DisplayName(item)</strong>
                                    <small>@SummaryFor(item)</small>
                                </span>
                                <em>@item.ObjectType</em>
                                <span class="cda-vef-commerce-row__actions">
                                    <Button Text="Record"
                                            Icon="info"
                                            Size="ButtonSize.Small"
                                            Variant="Variant.Outlined"
                                            Click="@(() => OpenDetailsAsync(item))"
                                            data-testid="cda-commerce-record-details" />
                                    <Button Text="@RelatedButtonText(item)"
                                            Icon="inventory_2"
                                            Size="ButtonSize.Small"
                                            ButtonStyle="ButtonStyle.Secondary"
                                            Disabled="@(relatedObject is null)"
                                            Click="@(() => OpenRelatedDetailsAsync(relatedObject))"
                                            title="@RelatedButtonTitle(relatedObject)"
                                            data-testid="cda-commerce-related-details" />
                                </span>
                            </article>
                        }
                    }
                </div>
            </section>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> EditRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> TransactionDetailsRequested { get; set; }

    private int CommerceItemCount => PaymentItems.Count + ReceiptItems.Count;

    private IReadOnlyList<ICommerceBusinessObjectView> PaymentItems
        => Workspace.BusinessObjects
            .OfType<ICommerceBusinessObjectView>()
            .Where(item => item.Commerce.Payment is not null)
            .OrderByDescending(item => item.CreatedAt)
            .ToArray();

    private IReadOnlyList<ICommerceBusinessObjectView> ReceiptItems
        => Workspace.BusinessObjects
            .OfType<ICommerceBusinessObjectView>()
            .Where(item => item.Commerce.Purchase is not null || item.Commerce.Receipt is not null)
            .OrderByDescending(item => item.CreatedAt)
            .ToArray();

    private Task OpenDetailsAsync(ICommerceBusinessObjectView item)
        => OpenDetailsDialogAsync(item, $"{DisplayName(item)} - Details");

    private Task OpenRelatedDetailsAsync(IBusinessObjectView? item)
        => item is null
            ? Task.CompletedTask
            : OpenDetailsDialogAsync(item, $"{DisplayName(item)} - BO Details");

    private Task OpenDetailsDialogAsync(IBusinessObjectView item, string title)
        => DialogService.OpenAsync<BusinessObjectLedgerDetailsDialogContent>(
            title,
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectLedgerDetailsDialogContent.Object)] = item,
                [nameof(BusinessObjectLedgerDetailsDialogContent.ViewedAtUtc)] = Workspace.ViewedAtUtc,
                [nameof(BusinessObjectLedgerDetailsDialogContent.Workspace)] = Workspace,
                [nameof(BusinessObjectLedgerDetailsDialogContent.EditRequested)] = EditRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.TransactionDetailsRequested)] = TransactionDetailsRequested
            },
            new DialogOptions
            {
                Subtitle = item.ObjectId.Value,
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-vef-dialog cda-vef-dialog--details cda-vef-dialog--bo-detail",
                TestId = "cda-commerce-details-dialog"
            });

    private IBusinessObjectView? ResolveRelatedBusinessObject(ICommerceBusinessObjectView item)
    {
        foreach (string objectId in CandidateRelatedObjectIds(item).Distinct(StringComparer.Ordinal))
        {
            IBusinessObjectView? relatedObject = Workspace.BusinessObjects.FirstOrDefault(candidate =>
                candidate.ObjectId != item.ObjectId
                && string.Equals(candidate.ObjectId.Value, objectId, StringComparison.Ordinal));
            if (relatedObject is not null)
            {
                return relatedObject;
            }
        }

        return null;
    }

    private static IEnumerable<string> CandidateRelatedObjectIds(ICommerceBusinessObjectView item)
    {
        if (item.Commerce.Purchase is { } purchase)
        {
            if (!string.IsNullOrWhiteSpace(purchase.DeliveredObjectId))
            {
                yield return purchase.DeliveredObjectId;
            }

            yield return purchase.TargetObjectId;
        }

        if (item.Commerce.Receipt is { } receipt)
        {
            yield return receipt.DeliveredObjectId;
            yield return receipt.TargetObjectId;
        }

        if (item.Commerce.Payment is { } payment)
        {
            if (!string.IsNullOrWhiteSpace(payment.DeliveredObjectId))
            {
                yield return payment.DeliveredObjectId;
            }

            yield return payment.TargetObjectId;
        }
    }

    private static string DisplayName(IBusinessObjectView item)
    {
        if (item is ICommerceBusinessObjectView commerce && !string.IsNullOrWhiteSpace(commerce.Name))
        {
            return commerce.Name;
        }

        if (item is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Name))
        {
            return media.Name;
        }

        return BusinessObjectPayloadBuilder.TryParseMediaPayload(item.StateJson, out BusinessObjectMediaPayload? payload)
            && !string.IsNullOrWhiteSpace(payload?.Name)
                ? payload.Name
                : item.ObjectId.Value;
    }

    private static string RelatedButtonText(ICommerceBusinessObjectView item)
        => item.Commerce.Purchase is not null
            ? "Bought BO"
            : item.Commerce.Payment is not null || item.Commerce.Receipt is not null
                ? "Sold BO"
                : "BO details";

    private static string RelatedButtonTitle(IBusinessObjectView? item)
        => item is null
            ? "Related BO is not visible in this account workspace"
            : $"Open details for {DisplayName(item)}";

    private static string IconFor(ICommerceBusinessObjectView item)
        => item.ObjectType switch
        {
            "payment" => "payments",
            "purchase" => "shopping_cart",
            "receipt" => "receipt_long",
            _ => "sell"
        };

    private static string SummaryFor(ICommerceBusinessObjectView item)
    {
        if (item.Commerce.Payment is { } payment)
        {
            return $"{payment.Status} / {payment.PriceAmount:0.#############################} {(payment.TokenId ?? BusinessObjectCommercePayloadBuilder.MainCurrencyCode)} / {payment.TargetObjectId}";
        }

        if (item.Commerce.Purchase is { } purchase)
        {
            return $"{purchase.Status} / {purchase.PriceAmount:0.#############################} {(purchase.TokenId ?? BusinessObjectCommercePayloadBuilder.MainCurrencyCode)} / {purchase.TargetObjectId}";
        }

        if (item.Commerce.Receipt is { } receipt)
        {
            return $"{receipt.Status} / {receipt.PriceAmount:0.#############################} {(receipt.TokenId ?? BusinessObjectCommercePayloadBuilder.MainCurrencyCode)} / {receipt.DeliveredObjectId}";
        }

        return item.ObjectId.Value;
    }
}
