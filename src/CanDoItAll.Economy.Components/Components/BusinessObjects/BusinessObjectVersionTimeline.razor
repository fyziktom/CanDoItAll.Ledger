@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-bo-version-timeline">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Timeline</span>
            <h2>Version timeline</h2>
        </div>
    </header>
    <Timeline Items="Items" AriaLabel="Business object version timeline" />
</section>

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    private IReadOnlyList<TimelineItem> Items
        => Object is null
            ? []
            :
            [
                new TimelineItem
                {
                    Label = $"{Object.Operation} v{Object.Version}",
                    Description = Object.ObjectId.Value,
                    Timestamp = Object.CreatedAt,
                    Icon = "inventory_2",
                    Tone = "success"
                },
                .. LedgerTransactionOrdering.NewestFirst(BusinessObjectTransactionHistory
                    .SelectVersions(Object.ObjectId, Transactions)
                    .Select(version => version.Transaction)
                    .DistinctBy(transaction => transaction.TxId))
                    .Select(item => new TimelineItem
                    {
                        Label = item.TxId.Value,
                        Description = $"{item.Kind} - {item.Status}",
                        Timestamp = item.Timestamp,
                        Icon = "receipt_long",
                        Tone = item.Status == TransactionStatus.Confirmed ? "success" : "warning"
                    })
            ];
}
