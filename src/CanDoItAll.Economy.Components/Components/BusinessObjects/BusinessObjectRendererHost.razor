@namespace CanDoItAll.Economy.Components
@using Microsoft.Extensions.DependencyInjection

@if (Object is null)
{
    <EmptyState Eyebrow="Business object" Title="No object selected" Description="No business object is available for this renderer." />
}
else
{
    BusinessObjectRendererDescriptor descriptor = ResolveDescriptor();

    <Stack GapScale="LayoutGap.Small" Class="min-w-0" data-renderer="@descriptor.Key">
        <DynamicComponent Type="descriptor.ComponentType" Parameters="BuildParameters(descriptor)" />
    </Stack>
}

@code {
    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    private IBusinessObjectRendererRegistry RendererRegistry
        => Services.GetService<IBusinessObjectRendererRegistry>()
            ?? DefaultBusinessObjectRendererRegistry.Instance;

    private BusinessObjectRendererDescriptor ResolveDescriptor()
        => RendererRegistry.Resolve(Object!);

    private Dictionary<string, object?> BuildParameters(BusinessObjectRendererDescriptor descriptor)
        => new(StringComparer.Ordinal)
        {
            [nameof(Object)] = Object,
            [nameof(Mode)] = Mode,
            [nameof(ViewedAtUtc)] = ViewedAtUtc,
            ["Descriptor"] = descriptor
        };
}
