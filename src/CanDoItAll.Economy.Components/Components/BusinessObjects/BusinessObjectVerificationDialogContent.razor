@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IBusinessObjectVerificationService Verification

<DialogScaffold Dense="true"
                Eyebrow="BusinessObject verification"
                Title="Verify ownership payload"
                Description="@Object?.ObjectId.Value">
    <ChildContent>
        @if (Object is null)
        {
            <EmptyState Eyebrow="Verification" Title="No BusinessObject selected" Description="A target BO is required before verification can run." />
        }
        else
        {
            <Grid ColumnsLg="2" Gap="LayoutGap.Medium" data-testid="cda-bo-verification-dialog">
                <PanelCard Class="min-w-0">
                    <Stack GapScale="LayoutGap.Medium">
                        <TextBlock TextStyle="TextStyle.Subtitle1" Value="Payload" />
                        <TextArea Value="@payload"
                                  ValueChanged="@(value => payload = value ?? string.Empty)"
                                  Rows="12"
                                  Placeholder="Paste or scan a BO ownership payload."
                                  aria-label="BusinessObject verification payload" />
                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                            <Button Text="Use selected BO"
                                    Icon="sync"
                                    Variant="Variant.Outlined"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Size="ButtonSize.Small"
                                    Click="ResetPayload" />
                            <QrScanButton Label="Scan ownership payload"
                                          TooltipText="Scan or paste a BO ownership QR payload"
                                          EnableCamera="true"
                                          Scanned="ApplyScanAsync"
                                          TestId="cda-bo-verification-scan" />
                            <Button Text="Verify"
                                    Icon="verified"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Size="ButtonSize.Small"
                                    Click="VerifyAsync"
                                    data-testid="cda-bo-verification-run" />
                        </Cluster>
                    </Stack>
                </PanelCard>

                <PanelCard Class="min-w-0">
                    <Stack GapScale="LayoutGap.Medium">
                        <TextBlock TextStyle="TextStyle.Subtitle1" Value="Result" />
                        @if (result is null)
                        {
                            <TextBlock TextStyle="TextStyle.Muted"
                                       Value="Run verification to check payload format, object id, owner, outpoint, and data hash." />
                        }
                        else
                        {
                            <Alert AlertStyle="@(result.Success ? AlertStyle.Success : AlertStyle.Danger)" Variant="Variant.Outlined">
                                <strong>@(result.Success ? "Verification passed" : "Verification failed")</strong>
                                <span>@result.Summary</span>
                            </Alert>
                            <Stack GapScale="LayoutGap.Small">
                                @foreach (VerificationStepResult step in result.Steps)
                                {
                                    <SurfaceCard Soft="true">
                                        <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.NoWrap" Class="w-full">
                                            <StatusBadge Text="@step.Status.ToString()" Tone="@StepTone(step)" />
                                            <Stack GapScale="LayoutGap.Tiny" Class="min-w-0 flex-1">
                                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@step.Label" />
                                                <TextBlock TextStyle="TextStyle.Muted" Value="@step.Summary" />
                                            </Stack>
                                        </Cluster>
                                    </SurfaceCard>
                                }
                            </Stack>
                        }
                    </Stack>
                </PanelCard>
            </Grid>
        }
    </ChildContent>
    <Footer>
        <Button Text="Close"
                Icon="close"
                Variant="Variant.Outlined"
                ButtonStyle="ButtonStyle.Light"
                Size="ButtonSize.Small"
                Click="CloseAsync" />
    </Footer>
</DialogScaffold>

@code {
    private string payload = string.Empty;
    private VerificationFlowResult? result;
    private string? initializedObjectId;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    protected override void OnParametersSet()
    {
        if (Object is null || string.Equals(initializedObjectId, Object.ObjectId.Value, StringComparison.Ordinal))
        {
            return;
        }

        initializedObjectId = Object.ObjectId.Value;
        payload = Verification.CreateOwnershipPayload(Object);
        result = null;
    }

    private Task ResetPayload()
    {
        if (Object is not null)
        {
            payload = Verification.CreateOwnershipPayload(Object);
            result = null;
        }

        return Task.CompletedTask;
    }

    private Task ApplyScanAsync(QrScanResult scan)
    {
        if (!scan.IsValid)
        {
            Notifications.Warning("QR scan ignored", scan.Error ?? "The scanned payload is not valid.", position: NotificationPosition.BottomCenter);
            return Task.CompletedTask;
        }

        payload = scan.Text;
        result = null;
        return Task.CompletedTask;
    }

    private Task VerifyAsync()
    {
        if (Object is null)
        {
            return Task.CompletedTask;
        }

        result = Verification.VerifyOwnershipPayload(payload, Object);
        if (result.Success)
        {
            Notifications.Success("Ownership verified", result.Summary, position: NotificationPosition.BottomCenter);
        }
        else
        {
            Notifications.Warning("Ownership mismatch", result.Summary, position: NotificationPosition.BottomCenter);
        }

        return Task.CompletedTask;
    }

    private static string StepTone(VerificationStepResult step)
        => step.Status switch
        {
            VerificationStepStatus.Passed => "success",
            VerificationStepStatus.Warning => "warning",
            VerificationStepStatus.Failed => "danger",
            _ => "neutral"
        };

    private Task CloseAsync()
        => DialogService.CloseAsync();
}
