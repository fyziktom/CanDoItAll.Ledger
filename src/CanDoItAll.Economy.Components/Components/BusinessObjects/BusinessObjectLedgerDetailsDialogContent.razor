    private async Task CreateTicketVerificationAsync()
    {
        if (Object is null || TicketVerificationRequested is null)
        {
            return;
        }

        ticketVerificationBusy = true;
        try
        {
            ticketVerification = await TicketVerificationRequested(new BusinessObjectTicketVerificationRequest(
                Object.ObjectId,
                Object.ObjectType,
                Object.CurrentOutPoint,
                Object.OwnerAddress,
                Object.StateJson ?? "{}"));
            if (ticketVerification.Success)
            {
                Notifications.Success("Ticket ownership signed", ticketVerification.Summary, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Warning("Ticket verification blocked", ticketVerification.Summary, position: NotificationPosition.BottomCenter);
            }
        }
        finally
        {
            ticketVerificationBusy = false;
        }
    }

    private async Task UseTicketAsync()
    {
        if (Object is null || TicketUseRequested is null || TicketUsed || ticketUseBusy)
        {
            return;
        }

        IBusinessObjectView ticket = Object;
        ticketUseBusy = true;
        try
        {
            EconomyTransactionExecutionResult result = await TicketUseRequested(new BusinessObjectTicketUseRequest(
                ticket.ObjectId,
                ticket.StateJson ?? "{}",
                $"bo-ticket://use/{ticket.ObjectId.Value}",
                ticketVerification?.MessageHash));
            if (result.Accepted)
            {
                acceptedTicketUseObjectId = ticket.ObjectId.Value;
                acceptedTicketUsedAtUtc = DateTimeOffset.UtcNow;
                Notifications.Success("Ticket used", result.Message, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Error("Ticket use rejected", result.Message, position: NotificationPosition.BottomCenter);
            }
        }
        finally
        {
            ticketUseBusy = false;
        }
    }

