@namespace CanDoItAll.Economy.Components
@using System.Globalization
@inherits BusinessObjectDataItemAddressComponentBase
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject ITagOccurrenceService TagOccurrences
@inject IBusinessObjectVerificationService VerificationService
@if (Object is null)
{
    <EmptyState Eyebrow="Business object" Title="Details are unavailable" Description="No BusinessObject is selected in the current gallery session." />
}
else
{
    <div class="cda-bo-detail-shell" data-testid="cda-bo-details-layout">
      <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" FillHeight="true">
        <Tabs Variant="TabsVariant.ModalCompact"
              BorderMode="TabsBorderMode.Soft"
              OverflowMode="TabsOverflowMode.Scroll"
              PanelOverflowMode="TabsPanelOverflowMode.Visible"
              Class="cda-bo-detail-tabs"
              AriaLabel="Business object detail sections">
            <TabsItem Text="Overview" Icon="dashboard" BadgeText="@($"{DataItems.Count} item(s)")">
                @if (HasDataItems)
                {
                    <section class="cda-bo-overview-workspace">
                        <div class="cda-bo-selected-preview">
                            @if (SelectedItem is not null)
                            {
                                <BusinessObjectDataItemInteractivePreview Item="SelectedItem" />
                            }
                            else
                            {
                                <div class="cda-bo-preview-empty">
                                    <span class="material-icons" aria-hidden="true">@ObjectIcon</span>
                                    <strong>@DisplayName</strong>
                                    <small>No data items are attached.</small>
                                </div>
                            }
                        </div>

                        <aside class="cda-bo-overview-aside">
                            <Stack GapScale="LayoutGap.Small">
                                <Eyebrow Text="@Object.ObjectType" />
                                <TextBlock TextStyle="TextStyle.H3" Value="@DisplayName" />
                                <TextBlock TextStyle="TextStyle.Body2" Value="@Description" />
                                @if (HasLongDescription)
                                {
                                    <SurfaceCard Soft="true"
                                                 Class="cda-bo-long-description"
                                                 data-testid="cda-bo-long-description"
                                                 aria-label="Business object long description">
                                        <Stack GapScale="LayoutGap.XSmall">
                                            <Eyebrow Text="Long description" />
                                            <TextBlock TextStyle="TextStyle.Body2" Value="@LongDescription" />
                                        </Stack>
                                    </SurfaceCard>
                                }
                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="cda-bo-tags">
                                    @foreach (string tag in Tags.Take(6))
                                    {
                                        <TagBadge Tag="@tag" AccountScope="@TagAccountScope" TestId="cda-bo-detail-tag-badge" />
                                    }
                                </Cluster>
                            </Stack>

                            <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                <SummaryTile Label="Version" Value="@Object.Version.ToString(CultureInfo.InvariantCulture)" Compact="true" />
                                <SummaryTile Label="Operation" Value="@Object.Operation.ToString()" Compact="true" />
                                <SummaryTile Label="Data items" Value="@DataItems.Count.ToString(CultureInfo.InvariantCulture)" Compact="true" />
                                <SummaryTile Label="Created" Value="@Object.CreatedAt.ToString("MM.dd HH:mm")" Compact="true" />
                            </SummaryTiles>
                            @if (SaleTerms is { Status: BusinessObjectSaleStatus.Listed } sale)
                            {
                                <SurfaceCard Soft="true" data-testid="cda-bo-sale-panel">
                                  <Stack GapScale="LayoutGap.Small">
                                    <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                        <SummaryTile Label="For sale" Value="@($"{sale.Mode} / {FormatPrice(sale.PriceAmount, sale.TokenId)}")" Compact="true" Tone="success" />
                                    @if (sale.MaxClones is not null)
                                    {
                                        <SummaryTile Label="Copies" Value="@($"{sale.SoldCount} / {sale.MaxClones}")" Compact="true" />
                                    }
                                    </SummaryTiles>
                                    <MetricCard Label="Buy link">
                                        <ValueContent>
                                            <CopyableMonoValue Value="@BuyLink" StartChars="32" EndChars="12" AriaLabel="Copy buy link" />
                                        </ValueContent>
                                    </MetricCard>
                                  </Stack>
                                </SurfaceCard>
                            }
                            @if (TypedFacts.Count > 0)
                            {
                                <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                    @foreach (BusinessObjectDisplayFact fact in TypedFacts)
                                    {
                                        <SummaryTile Label="@fact.Label" Value="@fact.Value" Compact="true" />
                                    }
                                </SummaryTiles>
                            }

                            <section class="cda-bo-gallery-rail" aria-label="Business object data items">
                                <div class="cda-bo-gallery-rail__header">
                                    <strong>Data items</strong>
                                    <StatusBadge Text="@($"{DataItems.Count} item(s)")" Tone="info" />
                                </div>

                                <div class="cda-bo-gallery-list">
                                    @foreach (BusinessObjectDataItem item in DataItems)
                                    {
                                        string? itemUri = ResolveDataItemUriString(item);
                                        <article class="@GalleryItemClass(item)">
                                            <button type="button"
                                                    class="cda-bo-gallery-item__select"
                                                    aria-label="@($"Show {item.Name}")"
                                                    @onclick="@(() => SelectItem(item))">
                                                <BusinessObjectDataItemPreview Item="item" />
                                                <span>
                                                    <strong>@item.Name</strong>
                                                    <small>@item.Type / @FormatSize(item.Size)</small>
                                                    <em>@(item.Description ?? item.FileName ?? item.Hash)</em>
                                                </span>
                                            </button>
                                             <Cluster Gap="LayoutGap.XSmall"
                                                      Wrap="FlexWrap.NoWrap"
                                                      aria-label="@($"Copy actions for {item.Name}")">
                                                <CopyButton Value="@item.Hash"
                                                            Icon="tag"
                                                            DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                            Size="CopyButtonSize.ExtraSmall"
                                                            AriaLabel="@($"Copy CID for {item.Name}")"
                                                            Disabled="@(string.IsNullOrWhiteSpace(item.Hash))"
                                                            title="Copy CID"
                                                            data-testid="cda-bo-data-item-copy-cid" />
                                                <CopyButton Value="@itemUri"
                                                            Icon="link"
                                                            DisplayMode="CopyButtonDisplayMode.IconOnly"
                                                            Size="CopyButtonSize.ExtraSmall"
                                                            AriaLabel="@($"Copy IPFS link for {item.Name}")"
                                                            Disabled="@(itemUri is null)"
                                                            title="Copy IPFS link"
                                                            data-testid="cda-bo-data-item-copy-link" />
                                            </Cluster>
                                        </article>
                                    }
                                </div>
                            </section>
                        </aside>
                    </section>
                }
                else
                {
                    <Grid ColumnsLg="2" Gap="LayoutGap.Medium" data-testid="cda-bo-overview-no-data">
                        <div data-testid="cda-bo-overview-summary">
                          <SectionCard Title="@Object.ObjectType">
                            <HeaderActions>
                                <span class="material-icons" aria-hidden="true">@ObjectIcon</span>
                            </HeaderActions>
                            <ChildContent>
                                <Stack GapScale="LayoutGap.Small">
                                    <Eyebrow Text="@Object.ObjectType" />
                                    <TextBlock TextStyle="TextStyle.H3" Value="@DisplayName" />
                                    <TextBlock TextStyle="TextStyle.Body2" Value="@Description" />
                                    @if (HasLongDescription)
                                    {
                                        <SurfaceCard Soft="true"
                                                     Class="cda-bo-long-description"
                                                     data-testid="cda-bo-long-description"
                                                     aria-label="Business object long description">
                                            <Stack GapScale="LayoutGap.XSmall">
                                                <Eyebrow Text="Long description" />
                                                <TextBlock TextStyle="TextStyle.Body2" Value="@LongDescription" />
                                            </Stack>
                                        </SurfaceCard>
                                    }
                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="cda-bo-tags">
                                        @foreach (string tag in Tags.Take(8))
                                        {
                                            <TagBadge Tag="@tag" AccountScope="@TagAccountScope" TestId="cda-bo-detail-tag-badge" />
                                        }
                                    </Cluster>
                                    @if (SaleTerms is { Status: BusinessObjectSaleStatus.Listed } sale)
                                    {
                                        <SurfaceCard Soft="true" data-testid="cda-bo-sale-panel">
                                          <Stack GapScale="LayoutGap.Small">
                                            <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                                <SummaryTile Label="For sale" Value="@($"{sale.Mode} / {FormatPrice(sale.PriceAmount, sale.TokenId)}")" Compact="true" Tone="success" />
                                            @if (sale.MaxClones is not null)
                                            {
                                                <SummaryTile Label="Copies" Value="@($"{sale.SoldCount} / {sale.MaxClones}")" Compact="true" />
                                            }
                                            </SummaryTiles>
                                            <MetricCard Label="Buy link">
                                                <ValueContent>
                                                    <CopyableMonoValue Value="@BuyLink" StartChars="32" EndChars="12" AriaLabel="Copy buy link" />
                                                </ValueContent>
                                            </MetricCard>
                                          </Stack>
                                        </SurfaceCard>
                                    }
                                </Stack>
                            </ChildContent>
                          </SectionCard>
                        </div>

                        <Stack GapScale="LayoutGap.Medium">
                            <div data-testid="cda-bo-overview-facts">
                              <SectionCard Title="Key information">
                                    <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                        <SummaryTile Label="Version" Value="@Object.Version.ToString(CultureInfo.InvariantCulture)" Compact="true" />
                                        <SummaryTile Label="Operation" Value="@Object.Operation.ToString()" Compact="true" />
                                        <SummaryTile Label="Data items" Value="@DataItems.Count.ToString(CultureInfo.InvariantCulture)" Compact="true" />
                                        <SummaryTile Label="Created" Value="@Object.CreatedAt.ToString("MM.dd HH:mm")" Compact="true" />
                                        @foreach (BusinessObjectDisplayFact fact in TypedFacts)
                                        {
                                            <SummaryTile Label="@fact.Label" Value="@fact.Value" Compact="true" />
                                        }
                                    </SummaryTiles>
                              </SectionCard>
                            </div>

                            @if (RelatedBusinessObjects.Count > 0)
                            {
                                <div data-testid="cda-bo-related-panel">
                                  <SectionCard Title="Related business object">
                                        <Grid ColumnsLg="1" Gap="LayoutGap.Small">
                                            @foreach (IBusinessObjectView related in RelatedBusinessObjects)
                                            {
                                                <BusinessObjectGalleryCard Item="related"
                                                                           Workspace="Workspace"
                                                                           OpenRequested="OpenRelatedDetailsAsync"
                                                                           TestId="cda-bo-related-card" />
                                            }
                                        </Grid>
                                  </SectionCard>
                                </div>
                            }
                        </Stack>
                    </Grid>
                }
            </TabsItem>

            @if (ShowActions)
            {
                <TabsItem Text="Actions" Icon="bolt">
                    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                        <SectionCard Title="Object actions">
                                <Grid ColumnsSm="2" Gap="LayoutGap.Small">
                                    <QrCodeButton Payload="@ObjectOwnershipQrPayload"
                                                  Label="Show ownership QR"
                                                  TooltipText="Show BO ownership payload as QR"
                                                  Variant="Variant.Outlined"
                                                  TestId="cda-bo-ownership-qr-button" />
                                    <Button Text="Edit"
                                            Icon="edit"
                                            ButtonStyle="ButtonStyle.Secondary"
                                            Disabled="@(!CanEdit)"
                                            Click="OpenEditDialogAsync"
                                            data-testid="cda-bo-edit-button" />
                                    <Button Text="Upload DataItem" Icon="upload_file" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" />
                                    <Button Text="Send" Icon="send" ButtonStyle="ButtonStyle.Secondary" Click="SendAsync" />
                                    <Button Text="Set Sale" Icon="sell" ButtonStyle="ButtonStyle.Secondary" Click="SetPriceAsync" />
                                    <Button Text="Recycle"
                                            Icon="delete"
                                            Variant="Variant.Outlined"
                                            ButtonStyle="ButtonStyle.Warning"
                                            IsBusy="@recycleBusy"
                                            Disabled="@(!CanRecycle)"
                                            Click="RecycleAsync"
                                            data-testid="cda-bo-recycle-button" />
                                </Grid>
                        </SectionCard>

                        <SectionCard Title="Data item actions">
                                @if (DataItems.Count == 0)
                                {
                                    <EmptyState Eyebrow="Data items"
                                                Title="No data item actions"
                                                Description="Attach a data item to enable asset-specific commands." />
                                }
                                else
                                {
                                    <div class="cda-bo-data-action-list">
                                      <Stack GapScale="LayoutGap.Small">
                                        @foreach (BusinessObjectDataItem item in DataItems)
                                        {
                                            string? itemUri = ResolveDataItemUriString(item);
                                            <SelectionListItem Title="@item.Name"
                                                               Meta="@($"{item.Type} / {FormatSize(item.Size)}")"
                                                               Dense="true"
                                                               IsSelected="@(SelectedItem is not null && IsSameItem(item, SelectedItem))"
                                                               OnSelect="@(() => SelectItem(item))">
                                                <Actions>
                                                    <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                        <CopyButton Text="CID"
                                                                    Value="@item.Hash"
                                                                    Size="CopyButtonSize.Small"
                                                                    ButtonStyle="ButtonStyle.Secondary" />
                                                        <Button Text="Open"
                                                                Icon="open_in_new"
                                                                Size="ButtonSize.Small"
                                                                Variant="Variant.Outlined"
                                                                Href="@itemUri"
                                                                Target="_blank"
                                                                Rel="noopener noreferrer"
                                                                Disabled="@(itemUri is null)" />
                                                        <Button Text="Download"
                                                                Icon="download"
                                                                Size="ButtonSize.Small"
                                                                Variant="Variant.Outlined"
                                                                Href="@itemUri"
                                                                Target="_blank"
                                                                Rel="noopener noreferrer"
                                                                Disabled="@(itemUri is null)" />
                                                    </Cluster>
                                                </Actions>
                                            </SelectionListItem>
                                        }
                                      </Stack>
                                    </div>
                                }
                        </SectionCard>
                    </Grid>
                </TabsItem>
            }

            @if (IsTicket)
            {
                <TabsItem Text="Ticket" Icon="confirmation_number">
                    <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                        <SectionCard Title="Ticket status">
                            <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
                                <SummaryTile Label="Event" Value="@TicketField("eventId")" Compact="true" />
                                <SummaryTile Label="Seat" Value="@TicketField("seat")" Compact="true" />
                                <SummaryTile Label="Class" Value="@TicketField("ticketClass")" Compact="true" />
                                <SummaryTile Label="Duration" Value="@TicketField("ticketDuration")" Compact="true" />
                                <SummaryTile Label="Used" Value="@(TicketUsed ? "true" : "false")" Compact="true" Tone="@(TicketUsed ? "warning" : "success")" />
                                <SummaryTile Label="Used at" Value="@TicketField("usedAt")" Compact="true" />
                            </SummaryTiles>
                            <Cluster Gap="LayoutGap.Small" JustifyContent="JustifyContent.End">
                                <Button Text="Sign Ownership"
                                        Icon="verified"
                                        ButtonStyle="ButtonStyle.Secondary"
                                        IsBusy="@ticketVerificationBusy"
                                        Disabled="@(TicketVerificationRequested is null)"
                                        Click="CreateTicketVerificationAsync" />
                                <Button Text="Use Ticket"
                                        Icon="task_alt"
                                        Variant="Variant.Outlined"
                                        ButtonStyle="ButtonStyle.Warning"
                                        IsBusy="@ticketUseBusy"
                                        Disabled="@(TicketUseRequested is null || TicketUsed)"
                                        Click="UseTicketAsync" />
                            </Cluster>
                        </SectionCard>

                        <div data-testid="cda-ticket-verification-panel">
                          <SectionCard Title="Verification code">
                                @if (ticketVerification is null)
                                {
                                    <EmptyState Eyebrow="Verification"
                                                Title="No ownership code"
                                                Description="No ticket ownership code is generated for this dialog session." />
                                }
                                else
                                {
                                    <Stack GapScale="LayoutGap.Small">
                                        <SummaryTile Label="Status" Value="@ticketVerification.Summary" Compact="true" Tone="@(ticketVerification.Success ? "success" : "warning")" />
                                        <MetricCard Label="Hash">
                                            <ValueContent>
                                                <HashDisplay Value="@(ticketVerification.MessageHash?.Value ?? string.Empty)" />
                                            </ValueContent>
                                        </MetricCard>
                                        <pre class="cda-bo-state-json" data-testid="cda-ticket-verification-message">@ticketVerification.Message</pre>
                                        @if (!string.IsNullOrWhiteSpace(ticketVerification.SignatureJson))
                                        {
                                            <pre class="cda-bo-state-json" data-testid="cda-ticket-verification-signature">@ticketVerification.SignatureJson</pre>
                                        }
                                        <Grid ColumnsMd="2"
                                              Gap="LayoutGap.Small"
                                              AlignItems="AlignItems.Center"
                                              data-testid="cda-ticket-ownership-qr"
                                              aria-label="Ticket verification QR">
                                            <QrCodeView Payload="@TicketOwnershipPayloadText"
                                                        Caption="Ticket ownership payload"
                                                        TestId="cda-ticket-ownership-qr-view" />
                                            <QrCodeButton Payload="@TicketOwnershipQrPayload"
                                                          Label="Open ticket QR"
                                                          TooltipText="Open ticket ownership QR dialog"
                                                          TestId="cda-ticket-ownership-qr-button" />
                                        </Grid>
                                    </Stack>
                                }
                          </SectionCard>
                        </div>
                    </Grid>
                </TabsItem>
            }

            <TabsItem Text="Ledger details" Icon="data_object">
                <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                    <SectionCard Title="Ledger storage">
                        <Grid ColumnsSm="2" Gap="LayoutGap.Small">
                            <MetricCard Label="Object id">
                                <ValueContent><CopyableMonoValue Value="@Object.ObjectId.Value" Truncate="false" AriaLabel="Copy object id" /></ValueContent>
                            </MetricCard>
                            <MetricCard Label="Owner">
                                <ValueContent><CopyableMonoValue Value="@Object.OwnerAddress.Value" StartChars="12" EndChars="8" AriaLabel="Copy owner address" /></ValueContent>
                            </MetricCard>
                            <MetricCard Label="Outpoint">
                                <ValueContent><CopyableMonoValue Value="@Object.CurrentOutPoint.ToString()" StartChars="10" EndChars="6" AriaLabel="Copy object outpoint" /></ValueContent>
                            </MetricCard>
                            <MetricCard Label="Version" Value="@Object.Version.ToString(CultureInfo.InvariantCulture)" />
                            <MetricCard Label="Operation" Value="@Object.Operation.ToString()" />
                            <MetricCard Label="Data hash">
                                <ValueContent><HashDisplay Value="@Object.DataHash.Value" /></ValueContent>
                            </MetricCard>
                            <MetricCard Label="Created" Value="@Object.CreatedAt.ToString("u")" />
                            <MetricCard Label="Viewed" Value="@(ViewedAtUtc?.ToString("u") ?? Object.ViewedAt.ToString("u"))" />
                        </Grid>
                        <Cluster JustifyContent="JustifyContent.End">
                            <Button Text="Open transaction"
                                    Icon="receipt_long"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Disabled="@(!TransactionDetailsRequested.HasDelegate)"
                                    Click="OpenTransactionAsync" />
                        </Cluster>
                    </SectionCard>

                    <SectionCard Title="Raw state">
                            @if (string.IsNullOrWhiteSpace(Object.StateJson))
                            {
                                <EmptyState Eyebrow="Ledger state"
                                            Title="No state JSON"
                                            Description="No state JSON was stored with this object." />
                            }
                            else
                            {
                                <pre class="cda-bo-state-json">@Object.StateJson</pre>
                            }
                    </SectionCard>
                </Grid>
            </TabsItem>
        </Tabs>
      </Stack>
    </div>
}

@code {
    private BusinessObjectDataItem? selectedItem;
    private BusinessObjectTicketVerificationResult? ticketVerification;
    private bool ticketVerificationBusy;
    private bool ticketUseBusy;
    private bool recycleBusy;
    private string? recordedTagKey;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = true;

    [Parameter]
    public EventCallback<IBusinessObjectView> SendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> SetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> EditRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> TransactionDetailsRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? TicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<EconomyTransactionExecutionResult>>? TicketUseRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (selectedItem is null || !DataItems.Any(item => IsSameItem(item, selectedItem)))
        {
            selectedItem = PrimaryItem;
        }
    }

    private BusinessObjectMediaPayload? Payload
        => Object is null ? null : PayloadFor(Object);

    private ITypedBusinessObjectView? TypedObject
        => Object as ITypedBusinessObjectView;

    private IReadOnlyList<BusinessObjectDisplayFact> TypedFacts
        => TypedObject?.Facts
            ?? (Object is not null && BusinessObjectFamilyCatalog.TryFindByObjectType(Object.ObjectType, out BusinessObjectFamilyDefinition definition)
                ? BusinessObjectPayloadBuilder.CreateFacts(definition, Payload?.Fields)
                : []);

    private IReadOnlyList<BusinessObjectDataItem> DataItems
        => Object is IMediaBusinessObjectView media
            ? media.DataItems
            : Payload?.DataItems ?? [];

    private bool HasDataItems => DataItems.Count > 0;

    private IReadOnlyList<IBusinessObjectView> RelatedBusinessObjects
        => ResolveRelatedBusinessObjects().ToArray();

    private IReadOnlyList<string> Tags
        => Object is IMediaBusinessObjectView media
            ? media.Tags
            : Payload?.TagList ?? [];

    private string TagAccountScope => Object?.OwnerAddress.Value ?? "bo-details";

    private QrCodePayload ObjectOwnershipQrPayload
        => Object is null
            ? new(string.Empty)
            : new(
                VerificationService.CreateOwnershipPayload(Object),
                QrPayloadKind.BusinessObjectOwnershipHash,
                "BO ownership hash",
                Object.ObjectId.Value);

    private string TicketOwnershipPayloadText
        => ticketVerification is null
            ? string.Empty
            : string.Join(
                Environment.NewLine,
                ticketVerification.Message,
                ticketVerification.SignatureJson ?? string.Empty);

    private QrCodePayload TicketOwnershipQrPayload
        => new(
            TicketOwnershipPayloadText,
            QrPayloadKind.TicketOwnershipHash,
            "Ticket ownership hash",
            ticketVerification?.MessageHash?.Value);

    private BusinessObjectDataItem? PrimaryItem
        => DataItems
            .OrderByDescending(item => item.IsMain)
            .ThenBy(item => item.Type == BusinessObjectDataItemType.Image ? 0 : 1)
            .FirstOrDefault();

    private BusinessObjectDataItem? SelectedItem => selectedItem ?? PrimaryItem;

    private string DisplayName
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Name)
            ? media.Name
            : !string.IsNullOrWhiteSpace(Payload?.Name)
                ? Payload!.Name
                : Object?.ObjectId.Value ?? "BusinessObject";

    private string Description
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Description)
            ? media.Description
            : !string.IsNullOrWhiteSpace(Payload?.Description)
                ? Payload!.Description
                : Object?.StateJson ?? "Ledger-owned object.";

    private string LongDescription
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Text)
            ? media.Text
            : !string.IsNullOrWhiteSpace(Payload?.Text)
                ? Payload!.Text
                : string.Empty;

    private bool HasLongDescription
        => !string.IsNullOrWhiteSpace(LongDescription)
            && !LongDescription.Equals(Description, StringComparison.Ordinal);

    private BusinessObjectSaleTerms? SaleTerms
        => Object is not null && BusinessObjectCommercePayloadBuilder.TryGetSaleTerms(Object.StateJson, out BusinessObjectSaleTerms? terms)
            ? terms
            : null;

    private bool IsTicket
        => Object is not null && BusinessObjectTicketVerification.IsTicketObject(Object.ObjectType);

    private bool CanEdit
        => Object is not null && Workspace is not null && EditRequested.HasDelegate;

    private bool CanRecycle
        => Object is not null && EditRequested.HasDelegate;

    private bool TicketUsed
        => Object is not null && BusinessObjectTicketVerification.StateHasUsedFlag(Object.StateJson);

    private string BuyPath
        => Object is null
            ? "/buy-bo"
            : BuyPathFor(Object.CurrentOutPoint);

    protected override async Task OnParametersSetAsync()
    {
        if (Object is null)
        {
            return;
        }

        string key = $"{Object.OwnerAddress.Value}|{Object.ObjectId.Value}|{Object.Version}";
        if (string.Equals(recordedTagKey, key, StringComparison.Ordinal))
        {
            return;
        }

        recordedTagKey = key;
        await TagOccurrences.RecordBusinessObjectViewAsync(Object.OwnerAddress.Value, Object.ObjectId.Value, Tags);
    }

    private string BuyLink => Navigation.ToAbsoluteUri(BuyPath).ToString();

    private string ObjectIcon
        => Object is not null && BusinessObjectFamilyCatalog.TryFindByObjectType(Object.ObjectType, out BusinessObjectFamilyDefinition definition)
            ? definition.Icon
            : Object?.ObjectType switch
        {
            "image" or "bo-image" => "image",
            "post" or "bo-post" => "article",
            "purchase-order" => "receipt_long",
            "inventory-lot" => "inventory_2",
            "settings" or "account-settings" => "settings",
            _ => "widgets"
        };

    private Task SendAsync()
        => Object is null ? Task.CompletedTask : SendRequested.InvokeAsync(Object);

    private Task SetPriceAsync()
        => Object is null ? Task.CompletedTask : SetPriceRequested.InvokeAsync(Object);

    private Task OpenEditDialogAsync()
    {
        if (Object is null || Workspace is null)
        {
            Notifications.Warning("Edit unavailable", "BusinessObject editing needs a loaded workspace.", position: NotificationPosition.BottomCenter);
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<BusinessObjectCreationWizard>(
            $"{DisplayName} - Edit",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectCreationWizard.Model)] = BusinessObjectCreationWizardModel.ForEdit(Object),
                [nameof(BusinessObjectCreationWizard.Workspace)] = Workspace,
                [nameof(BusinessObjectCreationWizard.StageBusinessObjectRequested)] =
                    EventCallback.Factory.Create<BusinessObjectTransactionDraft>(this, StageEditAsync)
            },
            new DialogOptions
            {
                Subtitle = $"{Object.ObjectType} - {Object.ObjectId.Value}",
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog cda-ledger-dialog--details cda-ledger-dialog--bo-edit",
                TestId = "cda-bo-edit-dialog"
            });
    }

    private async Task StageEditAsync(BusinessObjectTransactionDraft draft)
    {
        await EditRequested.InvokeAsync(draft);
        await DialogService.CloseAsync(draft);
    }

    private async Task RecycleAsync()
    {
        if (Object is null)
        {
            return;
        }

        if (!EditRequested.HasDelegate)
        {
            Notifications.Warning("Recycle unavailable", "BusinessObject recycling needs an account transaction submit handler.", position: NotificationPosition.BottomCenter);
            return;
        }

        recycleBusy = true;
        try
        {
            BusinessObjectTransactionDraft draft = new(
                Object.ObjectId,
                Object.ObjectType,
                Object.SchemaVersion,
                Object.OwnerAddress,
                Object.OwnerAddress,
                Object.OwnerAddress,
                Amount.Zero,
                Amount.Zero,
                Object.StateJson ?? "{}",
                $"bo-recycle://{Object.ObjectId.Value}",
                BusinessObjectTransactionMode.CloseObject,
                SourceObjectId: Object.ObjectId);

            await EditRequested.InvokeAsync(draft);
            Notifications.Info("Recycle submitted", "BusinessObject close transaction was requested.", position: NotificationPosition.BottomCenter);
            await DialogService.CloseAsync(draft);
        }
        catch (Exception exception)
        {
            Notifications.Error("Recycle failed", exception.Message, position: NotificationPosition.BottomCenter);
        }
        finally
        {
            recycleBusy = false;
        }
    }

