    private string GalleryItemClass(BusinessObjectDataItem item)
        => SelectedItem is not null && IsSameItem(item, SelectedItem)
            ? "cda-bo-gallery-item is-selected"
            : "cda-bo-gallery-item";

    private static bool IsSameItem(BusinessObjectDataItem left, BusinessObjectDataItem right)
        => left.Name.Equals(right.Name, StringComparison.OrdinalIgnoreCase)
            && left.Hash.Equals(right.Hash, StringComparison.Ordinal);

    private static BusinessObjectMediaPayload? PayloadFor(IBusinessObjectView item)
        => BusinessObjectPayloadBuilder.TryParseMediaPayload(item.StateJson, out BusinessObjectMediaPayload? payload)
            ? payload
            : null;

    private string TicketField(string key)
        => Payload?.Fields is not null
            && Payload.Fields.TryGetValue(key, out string? value)
            && !string.IsNullOrWhiteSpace(value)
                ? value
                : "none";

    private IEnumerable<IBusinessObjectView> ResolveRelatedBusinessObjects()
    {
        if (Object is null || Workspace is null)
        {
            yield break;
        }

        int yieldedCount = 0;
        var visitedIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (string relatedObjectId in CandidateRelatedObjectIds(Object))
        {
            if (!visitedIds.Add(relatedObjectId)
                || string.Equals(relatedObjectId, Object.ObjectId.Value, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            IBusinessObjectView? related = Workspace.BusinessObjects.FirstOrDefault(candidate =>
                string.Equals(candidate.ObjectId.Value, relatedObjectId, StringComparison.OrdinalIgnoreCase));
            if (related is not null)
            {
                yield return related;
                yieldedCount++;
                if (yieldedCount >= 4)
                {
                    yield break;
                }
            }
        }
    }

    private static IEnumerable<string> CandidateRelatedObjectIds(IBusinessObjectView item)
    {
        if (item is ICommerceBusinessObjectView commerce)
        {
            foreach (string commerceId in CandidateCommerceRelatedObjectIds(commerce))
            {
                yield return commerceId;
            }
        }

        foreach (string fieldKey in KnownRelatedObjectFieldKeys)
        {
            if (TryGetPayloadField(item, fieldKey, out string? value))
            {
                yield return value;
            }
        }
    }

    private static IEnumerable<string> CandidateCommerceRelatedObjectIds(ICommerceBusinessObjectView commerce)
    {
        if (commerce.Commerce.Purchase is { } purchase)
        {
            foreach (string objectId in NonBlankObjectIds(
                purchase.DeliveredObjectId,
                purchase.TargetObjectId,
                purchase.PaymentObjectId,
                purchase.ReceiptObjectId))
            {
                yield return objectId;
            }
        }

        if (commerce.Commerce.Receipt is { } receipt)
        {
            foreach (string objectId in NonBlankObjectIds(
                receipt.DeliveredObjectId,
                receipt.TargetObjectId,
                receipt.PaymentObjectId))
            {
                yield return objectId;
            }
        }

        if (commerce.Commerce.Payment is { } payment)
        {
            foreach (string objectId in NonBlankObjectIds(
                payment.DeliveredObjectId,
                payment.TargetObjectId,
                payment.PurchaseObjectId,
                payment.ReceiptObjectId))
            {
                yield return objectId;
            }
        }
    }

    private static IEnumerable<string> NonBlankObjectIds(params string?[] objectIds)
    {
        foreach (string? objectId in objectIds)
        {
            if (!string.IsNullOrWhiteSpace(objectId))
            {
                yield return objectId.Trim();
            }
        }
    }

    private static IReadOnlyList<string> KnownRelatedObjectFieldKeys { get; } =
    [
        "eventId",
        "targetObjectId",
        "deliveredObjectId",
        "paymentObjectId",
        "purchaseObjectId",
        "receiptObjectId"
    ];

    private static bool TryGetPayloadField(IBusinessObjectView item, string key, out string value)
    {
        value = string.Empty;
        IReadOnlyDictionary<string, string>? fields = item is ITypedBusinessObjectView typed
            ? typed.Fields
            : PayloadFor(item)?.Fields;
        if (fields is null)
        {
            return false;
        }

        foreach ((string candidateKey, string candidateValue) in fields)
        {
            if (string.Equals(candidateKey, key, StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(candidateValue))
            {
                value = candidateValue.Trim();
                return true;
            }
        }

        return false;
    }

    private static string Short(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? "none"
            : value.Length > 18 ? $"{value[..12]}...{value[^6..]}" : value;

    private static string FormatSize(long? size)
        => size is null ? "unknown" : $"{size.Value:N0} bytes";

    private static string FormatPrice(decimal amount, string? tokenId)
        => $"{amount.ToString("0.#############################", CultureInfo.InvariantCulture)} {(string.IsNullOrWhiteSpace(tokenId) ? BusinessObjectCommercePayloadBuilder.MainCurrencyCode : tokenId)}";

    private static string BuyPathFor(OutPoint outPoint)
        => $"/buy-bo/tx/{Uri.EscapeDataString(outPoint.TxId.Value)}/{outPoint.OutputIndex}";
