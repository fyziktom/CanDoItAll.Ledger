@namespace CanDoItAll.Economy.Components
@using System.Globalization
@inject NavigationManager Navigation
@if (Object is null)
{
    <EmptyState Eyebrow="Business object" Title="Details are unavailable" Description="No BusinessObject is selected in the current gallery session." />
}
else
{
    <Stack GapScale="LayoutGap.Medium" Class="cda-vef-bo-detail-shell" data-testid="cda-bo-details-layout">
        <Tabs Variant="TabsVariant.ModalCompact"
              BorderMode="TabsBorderMode.Soft"
              OverflowMode="TabsOverflowMode.Scroll"
              PanelOverflowMode="TabsPanelOverflowMode.Visible"
              Class="cda-vef-dialog-tabs cda-vef-bo-detail-tabs"
              AriaLabel="Business object detail sections">
            <TabsItem Text="Overview" Icon="dashboard" BadgeText="@($"{DataItems.Count} item(s)")">
                <section class="cda-vef-bo-overview-workspace">
                    <div class="cda-vef-bo-selected-preview">
                        @if (SelectedItem is not null)
                        {
                            <BusinessObjectDataItemInteractivePreview Item="SelectedItem" />
                        }
                        else
                        {
                            <div class="cda-vef-bo-preview-empty">
                                <span class="material-icons" aria-hidden="true">@ObjectIcon</span>
                                <strong>@DisplayName</strong>
                                <small>No data items are attached.</small>
                            </div>
                        }
                    </div>

                    <aside class="cda-vef-bo-overview-aside">
                        <div class="cda-vef-bo-summary">
                            <span class="cda-economy-eyebrow">@Object.ObjectType</span>
                            <h3>@DisplayName</h3>
                            <p>@Description</p>
                            @if (HasLongDescription)
                            {
                                <section class="cda-vef-bo-long-description" data-testid="cda-bo-long-description" aria-label="Business object long description">
                                    <span>Long description</span>
                                    <p>@LongDescription</p>
                                </section>
                            }
                            <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap" Class="cda-vef-tags">
                                @foreach (string tag in Tags.Take(6))
                                {
                                    <span>#@tag</span>
                                }
                            </Cluster>
                        </div>

                        <Grid ColumnsMd="2" Gap="LayoutGap.Small" Class="cda-vef-bo-overview-facts">
                            <div class="cda-economy-fact"><span>Version</span><strong>@Object.Version</strong></div>
                            <div class="cda-economy-fact"><span>Operation</span><strong>@Object.Operation</strong></div>
                            <div class="cda-economy-fact"><span>Data items</span><strong>@DataItems.Count</strong></div>
                            <div class="cda-economy-fact"><span>Created</span><strong>@Object.CreatedAt.ToString("MM.dd HH:mm")</strong></div>
                        </Grid>
                        @if (SaleTerms is { Status: BusinessObjectSaleStatus.Listed } sale)
                        {
                            <section class="cda-vef-sale-panel" data-testid="cda-bo-sale-panel">
                                <div>
                                    <span>For sale</span>
                                    <strong>@sale.Mode / @FormatPrice(sale.PriceAmount, sale.TokenId)</strong>
                                </div>
                                @if (sale.MaxClones is not null)
                                {
                                    <div>
                                        <span>Copies</span>
                                        <strong>@sale.SoldCount / @sale.MaxClones</strong>
                                    </div>
                                }
                                <div class="cda-vef-sale-panel__link">
                                    <span>Buy link</span>
                                    <CopyableMonoValue Value="@BuyLink" StartChars="32" EndChars="12" AriaLabel="Copy buy link" />
                                </div>
                            </section>
                        }
                        @if (TypedFacts.Count > 0)
                        {
                            <Grid ColumnsMd="2" Gap="LayoutGap.Small" Class="cda-vef-bo-overview-facts">
                                @foreach (BusinessObjectDisplayFact fact in TypedFacts)
                                {
                                    <div class="cda-economy-fact"><span>@fact.Label</span><strong>@fact.Value</strong></div>
                                }
                            </Grid>
                        }

                        <section class="cda-vef-bo-gallery-rail" aria-label="Business object data items">
                            <div class="cda-vef-bo-gallery-rail__header">
                                <strong>Data items</strong>
                                <StatusBadge Text="@($"{DataItems.Count} item(s)")" Tone="info" />
                            </div>

                            @if (DataItems.Count == 0)
                            {
                                <p class="cda-vef-empty-line">No visual or attached data items are available for this BusinessObject.</p>
                            }
                            else
                            {
                                <div class="cda-vef-bo-gallery-list">
                                    @foreach (BusinessObjectDataItem item in DataItems)
                                    {
                                        <button type="button"
                                                class="@GalleryItemClass(item)"
                                                @onclick="@(() => SelectItem(item))">
                                            <BusinessObjectDataItemPreview Item="item" />
                                            <span>
                                                <strong>@item.Name</strong>
                                                <small>@item.Type / @FormatSize(item.Size)</small>
                                                <em>@(item.Description ?? item.FileName ?? item.Hash)</em>
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        </section>
                    </aside>
                </section>
            </TabsItem>

            @if (ShowActions)
            {
                <TabsItem Text="Actions" Icon="bolt">
                    <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-vef-bo-action-grid">
                        <section class="cda-vef-panel">
                            <div class="cda-vef-panel-header">Object actions</div>
                            <div class="cda-vef-panel-body">
                                <div class="cda-vef-bo-action-list">
                                    <Button Text="Show QR Code" Icon="qr_code" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" />
                                    <Button Text="Upload DataItem" Icon="upload_file" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" />
                                    <Button Text="Send" Icon="send" ButtonStyle="ButtonStyle.Secondary" Click="SendAsync" />
                                    <Button Text="Set Sale" Icon="sell" ButtonStyle="ButtonStyle.Secondary" Click="SetPriceAsync" />
                                    <Button Text="Recycle" Icon="delete" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Warning" />
                                </div>
                            </div>
                        </section>

                        <section class="cda-vef-panel">
                            <div class="cda-vef-panel-header">Data item actions</div>
                            <div class="cda-vef-panel-body">
                                @if (DataItems.Count == 0)
                                {
                                    <p class="cda-vef-empty-line">Attach a data item to enable asset-specific commands.</p>
                                }
                                else
                                {
                                    <div class="cda-vef-bo-action-table">
                                        @foreach (BusinessObjectDataItem item in DataItems)
                                        {
                                            <article>
                                                <div>
                                                    <strong>@item.Name</strong>
                                                    <span>@item.Type / @FormatSize(item.Size)</span>
                                                </div>
                                                <Cluster Gap="LayoutGap.Small" Wrap="FlexWrap.Wrap">
                                                    <CopyButton Text="CID"
                                                                Value="@item.Hash"
                                                                Size="CopyButtonSize.Small"
                                                                ButtonStyle="ButtonStyle.Secondary" />
                                                    <Button Text="Open"
                                                            Icon="open_in_new"
                                                            Size="ButtonSize.Small"
                                                            Variant="Variant.Outlined"
                                                            Href="@item.Uri?.ToString()"
                                                            Target="_blank"
                                                            Rel="noopener noreferrer"
                                                            Disabled="@(item.Uri is null)" />
                                                </Cluster>
                                            </article>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    </Grid>
                </TabsItem>
            }

            <TabsItem Text="Ledger details" Icon="data_object">
                <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-vef-bo-raw-grid">
                    <section class="cda-vef-panel">
                        <div class="cda-vef-panel-header">Ledger storage</div>
                        <div class="cda-vef-panel-body cda-vef-bo-fact-grid">
                            <div class="cda-economy-fact cda-economy-fact--wide"><span>Object id</span><strong><CopyableMonoValue Value="@Object.ObjectId.Value" Truncate="false" AriaLabel="Copy object id" /></strong></div>
                            <div class="cda-economy-fact"><span>Owner</span><strong><CopyableMonoValue Value="@Object.OwnerAddress.Value" StartChars="12" EndChars="8" AriaLabel="Copy owner address" /></strong></div>
                            <div class="cda-economy-fact"><span>Outpoint</span><strong><CopyableMonoValue Value="@Object.CurrentOutPoint.ToString()" StartChars="10" EndChars="6" AriaLabel="Copy object outpoint" /></strong></div>
                            <div class="cda-economy-fact"><span>Version</span><strong>@Object.Version</strong></div>
                            <div class="cda-economy-fact"><span>Operation</span><strong>@Object.Operation</strong></div>
                            <div class="cda-economy-fact cda-economy-fact--wide"><span>Data hash</span><strong><HashDisplay Value="@Object.DataHash.Value" /></strong></div>
                            <div class="cda-economy-fact"><span>Created</span><strong>@Object.CreatedAt.ToString("u")</strong></div>
                            <div class="cda-economy-fact"><span>Viewed</span><strong>@(ViewedAtUtc?.ToString("u") ?? Object.ViewedAt.ToString("u"))</strong></div>
                        </div>
                        <div class="cda-vef-panel-footer">
                            <Button Text="Open transaction"
                                    Icon="receipt_long"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Disabled="@(!TransactionDetailsRequested.HasDelegate)"
                                    Click="OpenTransactionAsync" />
                        </div>
                    </section>

                    <section class="cda-vef-panel">
                        <div class="cda-vef-panel-header">Raw state</div>
                        <div class="cda-vef-panel-body">
                            @if (string.IsNullOrWhiteSpace(Object.StateJson))
                            {
                                <p class="cda-vef-empty-line">No state JSON was stored with this object.</p>
                            }
                            else
                            {
                                <pre class="cda-vef-bo-state-json">@Object.StateJson</pre>
                            }
                        </div>
                    </section>
                </Grid>
            </TabsItem>
        </Tabs>
    </Stack>
}

@code {
    private BusinessObjectDataItem? selectedItem;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter]
    public bool ShowActions { get; set; } = true;

    [Parameter]
    public EventCallback<IBusinessObjectView> SendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> SetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> TransactionDetailsRequested { get; set; }

    protected override void OnParametersSet()
    {
        if (selectedItem is null || !DataItems.Any(item => IsSameItem(item, selectedItem)))
        {
            selectedItem = PrimaryItem;
        }
    }

    private BusinessObjectMediaPayload? Payload
        => Object is null ? null : PayloadFor(Object);

    private ITypedBusinessObjectView? TypedObject
        => Object as ITypedBusinessObjectView;

    private IReadOnlyList<BusinessObjectDisplayFact> TypedFacts
        => TypedObject?.Facts
            ?? (Object is not null && BusinessObjectFamilyCatalog.TryFindByObjectType(Object.ObjectType, out BusinessObjectFamilyDefinition definition)
                ? BusinessObjectPayloadBuilder.CreateFacts(definition, Payload?.Fields)
                : []);

    private IReadOnlyList<BusinessObjectDataItem> DataItems
        => Object is IMediaBusinessObjectView media
            ? media.DataItems
            : Payload?.DataItems ?? [];

    private IReadOnlyList<string> Tags
        => Object is IMediaBusinessObjectView media
            ? media.Tags
            : Payload?.TagList ?? [];

    private BusinessObjectDataItem? PrimaryItem
        => DataItems
            .OrderByDescending(item => item.IsMain)
            .ThenBy(item => item.Type == BusinessObjectDataItemType.Image ? 0 : 1)
            .FirstOrDefault();

    private BusinessObjectDataItem? SelectedItem => selectedItem ?? PrimaryItem;

    private string DisplayName
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Name)
            ? media.Name
            : !string.IsNullOrWhiteSpace(Payload?.Name)
                ? Payload!.Name
                : Object?.ObjectId.Value ?? "BusinessObject";

    private string Description
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Description)
            ? media.Description
            : !string.IsNullOrWhiteSpace(Payload?.Description)
                ? Payload!.Description
                : Object?.StateJson ?? "Ledger-owned object.";

    private string LongDescription
        => Object is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Text)
            ? media.Text
            : !string.IsNullOrWhiteSpace(Payload?.Text)
                ? Payload!.Text
                : string.Empty;

    private bool HasLongDescription
        => !string.IsNullOrWhiteSpace(LongDescription)
            && !LongDescription.Equals(Description, StringComparison.Ordinal);

    private BusinessObjectSaleTerms? SaleTerms
        => Object is not null && BusinessObjectCommercePayloadBuilder.TryGetSaleTerms(Object.StateJson, out BusinessObjectSaleTerms? terms)
            ? terms
            : null;

    private string BuyPath
        => Object is null
            ? "/buy-bo"
            : BuyPathFor(Object.CurrentOutPoint);

    private string BuyLink => Navigation.ToAbsoluteUri(BuyPath).ToString();

    private string ObjectIcon
        => Object is not null && BusinessObjectFamilyCatalog.TryFindByObjectType(Object.ObjectType, out BusinessObjectFamilyDefinition definition)
            ? definition.Icon
            : Object?.ObjectType switch
        {
            "image" or "bo-image" => "image",
            "post" or "bo-post" => "article",
            "purchase-order" => "receipt_long",
            "inventory-lot" => "inventory_2",
            "settings" or "account-settings" => "settings",
            _ => "widgets"
        };

    private Task SendAsync()
        => Object is null ? Task.CompletedTask : SendRequested.InvokeAsync(Object);

    private Task SetPriceAsync()
        => Object is null ? Task.CompletedTask : SetPriceRequested.InvokeAsync(Object);

    private Task OpenTransactionAsync()
        => Object is null ? Task.CompletedTask : TransactionDetailsRequested.InvokeAsync(Object.CurrentOutPoint.TxId);

    private void SelectItem(BusinessObjectDataItem item)
    {
        selectedItem = item;
    }

    private string GalleryItemClass(BusinessObjectDataItem item)
        => SelectedItem is not null && IsSameItem(item, SelectedItem)
            ? "cda-vef-bo-gallery-item is-selected"
            : "cda-vef-bo-gallery-item";

    private static bool IsSameItem(BusinessObjectDataItem left, BusinessObjectDataItem right)
        => left.Name.Equals(right.Name, StringComparison.OrdinalIgnoreCase)
            && left.Hash.Equals(right.Hash, StringComparison.Ordinal);

    private static BusinessObjectMediaPayload? PayloadFor(IBusinessObjectView item)
        => BusinessObjectPayloadBuilder.TryParseMediaPayload(item.StateJson, out BusinessObjectMediaPayload? payload)
            ? payload
            : null;

    private static string FormatSize(long? size)
        => size is null ? "unknown" : $"{size.Value:N0} bytes";

    private static string FormatPrice(decimal amount, string? tokenId)
        => $"{amount.ToString("0.#############################", CultureInfo.InvariantCulture)} {(string.IsNullOrWhiteSpace(tokenId) ? BusinessObjectCommercePayloadBuilder.MainCurrencyCode : tokenId)}";

    private static string BuyPathFor(OutPoint outPoint)
        => $"/buy-bo/tx/{Uri.EscapeDataString(outPoint.TxId.Value)}/{outPoint.OutputIndex}";
}
