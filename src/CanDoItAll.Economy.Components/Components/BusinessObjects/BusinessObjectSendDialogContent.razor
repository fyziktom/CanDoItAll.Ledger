@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications

<SectionCard Title="Send BusinessObject" Description="@Object?.ObjectId.Value">
    <Stack GapScale="LayoutGap.Medium">
        <SecondaryTabs Items="ModeTabs"
                       SelectedKey="@selectedMode"
                       SelectedKeyChanged="@(key => selectedMode = key)"
                       Dense="true" />

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <FormField Text="Receiver address" ContainerClass="cda-economy-field cda-economy-field--wide">
                <div class="cda-address-input-row">
                    <TextBox Value="@receiverAddress"
                             ValueChanged="@(value => receiverAddress = value ?? string.Empty)"
                             Immediate="true"
                             Placeholder="cdia1..."
                             aria-label="Receiver address" />
                    <PageHeaderActionButton Icon="contacts"
                                            Label="Choose receiver"
                                            TooltipText="Choose receiver from address directory"
                                            Variant="Variant.Outlined"
                                            Click="OpenAddressDirectoryAsync"
                                            TestId="cda-bo-send-address-directory" />
                    <QrScanButton Label="Scan receiver"
                                  TooltipText="Scan receiver address QR"
                                  Scanned="ApplyScanAsync"
                                  TestId="cda-bo-send-scan-receiver" />
                </div>
            </FormField>

            <FormField Text="Bookmarked address" ContainerClass="cda-economy-field">
                <DropDown TValue="string"
                          Data="BookmarkOptions"
                          TextProperty="Text"
                          ValueProperty="Value"
                          Value="@selectedBookmark"
                          ValueChanged="SelectBookmark"
                          Placeholder="Choose bookmark"
                          aria-label="Bookmarked receiver address" />
            </FormField>

            <SummaryTile Label="Mode"
                         Value="@(IsClone ? "Send clone" : "Send original")"
                         Compact="true" />
        </Grid>

        <Cluster Gap="LayoutGap.Small">
            <Button Text="Send" Icon="send" Click="SubmitAsync" />
            <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="CancelAsync" />
        </Cluster>
    </Stack>
</SectionCard>

@code {
    private static readonly IReadOnlyList<SecondaryTabItem> ModeTabs =
    [
        new(nameof(BusinessObjectSendMode.Original), "Original", Description: "Transfer this BO to another address."),
        new(nameof(BusinessObjectSendMode.Clone), "Clone", Description: "Create a clone of this BO for another address.")
    ];

    private string selectedMode = nameof(BusinessObjectSendMode.Original);
    private string receiverAddress = string.Empty;
    private string? selectedBookmark;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public IReadOnlyList<EconomyAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public EventCallback<BusinessObjectSendRequest> SubmitRequested { get; set; }

    private bool IsClone => selectedMode == nameof(BusinessObjectSendMode.Clone);

    private IReadOnlyList<BookmarkOption> BookmarkOptions
        => Bookmarks.Select(bookmark => new BookmarkOption(bookmark.Address.Value, $"{bookmark.Name} - {ShortAddress(bookmark.Address)}")).ToArray();

    protected override void OnParametersSet()
    {
        receiverAddress = string.IsNullOrWhiteSpace(receiverAddress)
            ? Bookmarks.FirstOrDefault()?.Address.Value ?? string.Empty
            : receiverAddress;
    }

    private void SelectBookmark(string? address)
    {
        selectedBookmark = address;
        if (!string.IsNullOrWhiteSpace(address))
        {
            receiverAddress = address;
        }
    }

    private async Task OpenAddressDirectoryAsync()
    {
        object? result = await DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Select Receiver",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Bookmarks)] = Bookmarks,
                [nameof(AddressDirectoryDialogContent.AccountScope)] = "bo-send",
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Select
            },
            new DialogOptions
            {
                Subtitle = Object?.ObjectId.Value,
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-ledger-dialog cda-ledger-dialog--address-directory",
                TestId = "cda-address-directory-dialog"
            });

        if (result is AddressDirectoryEntry entry)
        {
            receiverAddress = entry.Address;
            selectedBookmark = entry.Address;
        }
    }

    private Task ApplyScanAsync(QrScanResult scan)
    {
        if (scan.IsValid)
        {
            receiverAddress = scan.Text;
        }
        else
        {
            Notifications.Warning("QR scan ignored", scan.Error ?? "Scanned receiver payload is invalid.", position: NotificationPosition.BottomCenter);
        }

        return Task.CompletedTask;
    }

    private async Task SubmitAsync()
    {
        if (Object is null)
        {
            Notifications.Error("Cannot send BO", "No BusinessObject is selected.", position: NotificationPosition.BottomCenter);
            return;
        }

        if (string.IsNullOrWhiteSpace(receiverAddress))
        {
            Notifications.Warning("Receiver required", "Select a bookmarked address or paste a receiver address.", position: NotificationPosition.BottomCenter);
            return;
        }

        var request = new BusinessObjectSendRequest(
            Object.ObjectId,
            IsClone ? BusinessObjectSendMode.Clone : BusinessObjectSendMode.Original,
            new Address(receiverAddress.Trim()),
            Object.StateJson ?? "{}",
            Object.ObjectType,
            Object.SchemaVersion);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private Task CancelAsync() => DialogService.CloseAsync();

    private static string ShortAddress(Address address)
        => address.Value.Length > 14 ? $"{address.Value[..8]}...{address.Value[^4..]}" : address.Value;

    private sealed record BookmarkOption(string Value, string Text);
}
