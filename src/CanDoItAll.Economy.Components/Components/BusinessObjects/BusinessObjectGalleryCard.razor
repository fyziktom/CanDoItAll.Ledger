@namespace CanDoItAll.Economy.Components

<SurfaceCard Class="@CardClass"
             Style="padding:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto"
             role="article"
             data-testid="@TestId">
    @if (PreviewImage is not null)
    {
        <button type="button"
                class="grid w-full min-w-0 cursor-pointer overflow-hidden border-0 border-b border-slate-200 bg-slate-100"
                style="padding:0"
                aria-label="@InfoLabel"
                @onclick="OpenAsync">
            <BusinessObjectDataItemPreview Item="PreviewImage" Flush="true" />
        </button>
    }
    else
    {
        <div class="p-3">
            <Button Icon="@BusinessObjectCardDisplay.PreviewIcon(Item)"
                    Variant="Variant.Outlined"
                    Size="ButtonSize.Small"
                    Click="OpenAsync"
                    aria-label="@InfoLabel" />
        </div>
    }
    <Stack GapScale="LayoutGap.Small"
           AlignItems="AlignItems.Stretch"
           Class="p-3 min-w-0">
        <h3 class="cda-text-block cda-text-block--subtitle2 min-w-0 break-words">@DisplayName</h3>
        <p class="cda-text-block cda-text-block--body2 cda-bo-gallery-description break-words">@Description</p>
        <Cluster Gap="LayoutGap.Tiny">
            <Pill Text="@Item.Operation.ToString()" Tone="PillTone.Info" />
            <Pill Text="BO" Tone="PillTone.Neutral" />
            <Pill Text="@Item.ObjectType" Tone="PillTone.Neutral" />
            @if (SaleTerms is { Status: BusinessObjectSaleStatus.Listed } sale)
            {
                <Pill Text="@($"{sale.Mode} / {BusinessObjectCardDisplay.FormatPrice(sale.PriceAmount, sale.TokenId)}")"
                      Tone="PillTone.Ok"
                      data-testid="cda-bo-sale-badge" />
            }
        </Cluster>
        <Grid ColumnTemplate="minmax(0,1fr) auto" Gap="LayoutGap.Small">
            <TextBlock TextStyle="TextStyle.Caption"
                       Value="@BusinessObjectCardDisplay.ShortObjectId(Item.ObjectId)"
                       Class="min-w-0 overflow-hidden"
                       Style="white-space:nowrap;text-overflow:ellipsis" />
            <TextBlock TextStyle="TextStyle.Caption"
                       Value="@SortTimestamp.ToString("MM.dd.yyyy HH:mm")"
                       Class="min-w-0 overflow-hidden"
                       Style="white-space:nowrap;text-overflow:ellipsis" />
        </Grid>
        @if (Facts.Count > 0)
        {
            <Grid ColumnTemplate="repeat(2,minmax(0,1fr))" Gap="LayoutGap.Small">
                @foreach (BusinessObjectDisplayFact fact in Facts.Take(MaxFacts))
                {
                    <TextBlock TextStyle="TextStyle.Caption"
                               Class="min-w-0 overflow-hidden"
                               Style="white-space:nowrap;text-overflow:ellipsis">
                        @fact.Label: @fact.Value
                    </TextBlock>
                }
            </Grid>
        }
        <Cluster Gap="LayoutGap.Tiny">
            @foreach (string tag in Tags)
            {
                <Pill Text="@($"#{tag}")" Tone="PillTone.Neutral" />
            }
        </Cluster>
    </Stack>
    @if (ShowInfoButton)
    {
        <Button Icon="info"
                Variant="Variant.Filled"
                Class="w-full"
                Click="OpenAsync"
                aria-label="@InfoLabel" />
    }
</SurfaceCard>

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Item { get; set; } = default!;

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> OpenRequested { get; set; }

    [Parameter]
    public bool ShowInfoButton { get; set; } = true;

    [Parameter]
    public int MaxFacts { get; set; } = 2;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string TestId { get; set; } = "cda-bo-gallery-card";

    private string CardClass
        => string.IsNullOrWhiteSpace(Class)
            ? "overflow-hidden"
            : $"overflow-hidden {Class}";

    private BusinessObjectDataItem? PreviewImage
        => BusinessObjectCardDisplay.ImageFor(Item);

    private string DisplayName
        => BusinessObjectCardDisplay.DisplayName(Item);

    private string Description
        => BusinessObjectCardDisplay.Description(Item);

    private IReadOnlyList<BusinessObjectDisplayFact> Facts
        => BusinessObjectCardDisplay.FactsFor(Item);

    private IReadOnlyList<string> Tags
        => BusinessObjectCardDisplay.TagsFor(Item);

    private BusinessObjectSaleTerms? SaleTerms
        => BusinessObjectCardDisplay.SaleTermsFor(Item);

    private DateTimeOffset SortTimestamp
        => BusinessObjectCardDisplay.SortTimestampFor(Item, Workspace);

    private string InfoLabel
        => $"Open BO details for {DisplayName}";

    private Task OpenAsync()
        => OpenRequested.HasDelegate
            ? OpenRequested.InvokeAsync(Item)
            : Task.CompletedTask;
}
