@namespace CanDoItAll.Economy.Components
@inherits BusinessObjectDataItemAddressComponentBase

<Dialog IsOpen="@IsOpen"
        Title="@DialogTitle"
        Size="ModalSize.Wide"
        OnClose="OnClose"
        TestId="bo-details-dialog"
        Class="cda-venft-details-dialog">
    @if (Item is not null)
    {
        <Grid ColumnsLg="2" Gap="LayoutGap.Large" Class="cda-venft-details-grid">
            <Stack GapScale="LayoutGap.Medium">
                <SectionCard Title="Basic Info" Description="@Item.Object.ObjectId.Value">
                    <Stack GapScale="LayoutGap.Medium">
                        <div class="cda-venft-thumb-strip">
                            @foreach (BusinessObjectDataItem dataItem in Item.Object.DataItems)
                            {
                                <button type="button"
                                        class="@(Equals(dataItem, SelectedDataItem) ? "is-active" : null)"
                                        @onclick="@(() => SelectDataItem(dataItem))">
                                    <BusinessObjectDataItemPreview Item="dataItem" />
                                </button>
                            }
                        </div>
                        @if (SelectedDataItem is not null)
                        {
                            <BusinessObjectDataItemPreview Item="SelectedDataItem" Large="true" />
                        }
                        <p class="cda-venft-modal-description">@Item.Object.Description</p>
                        <div class="cda-venft-card-tags">
                            @foreach (string tag in Item.Object.Tags)
                            {
                                <span>#@tag</span>
                            }
                        </div>
                    </Stack>
                </SectionCard>

                <SectionCard Title="Description">
                    <p class="cda-venft-long-text">@Item.Object.Text</p>
                </SectionCard>
            </Stack>

            <Stack GapScale="LayoutGap.Medium">
                <SectionCard Title="BO Details" Description="@Item.Object.ObjectType">
                    <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                        <div class="cda-economy-fact"><span>Version</span><strong>v@(Item.Object.Version)</strong></div>
                        <div class="cda-economy-fact"><span>Operation</span><strong>@Item.Object.Operation</strong></div>
                        <div class="cda-economy-fact cda-economy-fact--wide"><span>Owner</span><strong><CopyableMonoValue Value="@Item.Object.OwnerAddress.Value" StartChars="12" EndChars="8" AriaLabel="Copy owner address" /></strong></div>
                    </Grid>
                </SectionCard>

                <SectionCard Title="Actions">
                    <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                        <Button Text="Show QR Code" Icon="qr_code" ButtonStyle="ButtonStyle.Secondary" />
                        <Button Text="Send" Icon="send" ButtonStyle="ButtonStyle.Secondary" />
                        <Button Text="Recycle" Icon="delete" Variant="Variant.Outlined" />
                        <Button Text="Set Price" Icon="payments" ButtonStyle="ButtonStyle.Secondary" />
                    </Grid>
                </SectionCard>

                <SectionCard Title="IPFS Storage Info">
                    <Stack GapScale="LayoutGap.Small">
                        <div class="cda-economy-fact"><span>Selected item</span><strong>@(SelectedDataItem?.Name ?? "none")</strong></div>
                        <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                            <CopyButton Text="Copy Link" Icon="link" Variant="Variant.Outlined" Value="@SelectedDataItemUri" Disabled="@(SelectedDataItemUri is null)" />
                            <CopyButton Text="Copy Hash" Icon="tag" Variant="Variant.Outlined" Value="@(SelectedDataItem?.Hash)" Disabled="@(string.IsNullOrWhiteSpace(SelectedDataItem?.Hash))" />
                        </Grid>
                        <Button Text="Open DataItem Link"
                                Icon="open_in_new"
                                Variant="Variant.Outlined"
                                Href="@SelectedDataItemUri"
                                Target="_blank"
                                Rel="noopener noreferrer"
                                Disabled="@(SelectedDataItemUri is null)" />
                    </Stack>
                </SectionCard>
            </Stack>
        </Grid>
    }
</Dialog>

@code {
    [Parameter]
    public BusinessObjectGalleryItem? Item { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private BusinessObjectDataItem? selectedDataItem;

    private BusinessObjectDataItem? SelectedDataItem
        => selectedDataItem is not null && Item?.Object.DataItems.Contains(selectedDataItem) == true
            ? selectedDataItem
            : Item?.Object.DataItems.FirstOrDefault(item => item.IsMain) ?? Item?.Object.DataItems.FirstOrDefault();

    private string? SelectedDataItemUri
        => SelectedDataItem is null ? null : ResolveDataItemUriString(SelectedDataItem);

    private string DialogTitle
        => Item is null ? "BusinessObject Details" : $"{Item.Object.Name} - Details";

    protected override void OnParametersSet()
    {
        if (Item is not null && selectedDataItem is null)
        {
            selectedDataItem = SelectedDataItem;
        }
    }

    private void SelectDataItem(BusinessObjectDataItem item)
    {
        selectedDataItem = item;
    }
}
