@namespace CanDoItAll.Economy.Components

<InspectorDialogLayout Eyebrow="Business object inspector"
                       Title="@(Object?.ObjectId.Value ?? "No object selected")"
                       Description="Renderer output, raw state, data items, history, and diff remain available for unknown object types."
                       InspectorRail="@RenderSummary"
                       HeaderActions="@RenderActions"
                       TestId="cda-business-object-inspector-dialog">
    @if (Object is null)
    {
        <EmptyState Eyebrow="Business object" Title="No object selected" Description="Select an object from the explorer to inspect renderer and raw state." />
    }
    else
    {
        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
            <SectionCard Title="Renderer" Description="Custom renderers remain registry-owned; generic state stays below.">
                <BusinessObjectRendererHost Object="Object" Mode="BusinessObjectRenderMode.Detail" ViewedAtUtc="Object.ViewedAt" />
            </SectionCard>
            <BusinessObjectStateViewer Object="Object" />
            <BusinessObjectDataItemStrip Object="Object" />
            <BusinessObjectHistoryTable Object="Object" Transactions="Transactions" />
            <BusinessObjectVersionTimeline Object="Object" Transactions="Transactions" />
            <BusinessObjectDiffViewer PreviousStateJson="@PreviousStateJson" CurrentStateJson="@(Object.StateJson ?? "{}")" />
            <ObjectActionReviewPanel Object="Object" Draft="Draft" />
        </Stack>
    }
</InspectorDialogLayout>

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public BusinessObjectTransactionDraft? Draft { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public string PreviousStateJson { get; set; } = "{\"status\":\"previous\"}";

    private RenderFragment RenderSummary => builder =>
    {
        builder.OpenComponent<StatusCheckList>(0);
        builder.AddAttribute(1, nameof(StatusCheckList.Title), "Inspector checks");
        builder.AddAttribute(2, nameof(StatusCheckList.Items), Object is null ? Array.Empty<StatusCheckItem>() : new[]
        {
            new StatusCheckItem { Label = "Renderer available", Status = "Extensible", Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Raw state visible", Status = string.IsNullOrWhiteSpace(Object.StateJson) ? "Empty" : "Ready", Tone = "info", Complete = true },
            new StatusCheckItem { Label = "Lineage visible", Status = Object.CurrentOutPoint.ToString(), Tone = "neutral", Complete = true }
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderActions => builder =>
    {
        builder.OpenComponent<BusinessObjectActionRail>(0);
        builder.AddAttribute(1, nameof(BusinessObjectActionRail.Disabled), Object is null);
        builder.CloseComponent();
    };
}
