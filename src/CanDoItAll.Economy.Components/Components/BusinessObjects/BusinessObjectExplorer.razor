@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel" data-testid="cda-business-object-explorer">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Business objects</span>
            <h2>Explorer</h2>
        </div>
        <StatusBadge Text="@($"{Objects.Count} objects")" Tone="info" />
    </header>

    <div class="cda-sdk-explorer">
        <div class="cda-sdk-list">
            @foreach (IBusinessObjectView item in Objects)
            {
                <article class="cda-sdk-list__row @(item.ObjectId == SelectedObjectId ? "cda-sdk-list__row--selected" : null)">
                    <span class="material-icons" aria-hidden="true">inventory_2</span>
                    <div>
                        <strong>@item.ObjectId.Value</strong>
                        <span>@item.ObjectType v@item.Version - @item.Operation</span>
                        <small>@item.CurrentOutPoint</small>
                    </div>
                </article>
            }
        </div>
        <div class="cda-sdk-explorer__detail">
            <BusinessObjectStateViewer Object="SelectedObject" />
            <BusinessObjectDataItemStrip Object="SelectedObject" />
        </div>
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Objects { get; set; } = [];

    [Parameter]
    public BusinessObjectId? SelectedObjectId { get; set; }

    private IBusinessObjectView? SelectedObject
        => Objects.FirstOrDefault(item => item.ObjectId == SelectedObjectId) ?? Objects.FirstOrDefault();
}
