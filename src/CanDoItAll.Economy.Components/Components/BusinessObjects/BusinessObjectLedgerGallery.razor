@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService

<section class="cda-vef-gallery" data-testid="ssr-bo-gallery">
    <div class="cda-vef-gallery-header">
        <Stack GapScale="LayoutGap.Tiny">
            <h2>My Business Objects</h2>
            <p>@Workspace.Address.Value</p>
        </Stack>
        <Cluster Gap="LayoutGap.Small" Class="cda-vef-gallery-title-actions">
            <Button Text="@ActiveTabLabel" Icon="account_circle" Variant="Variant.Outlined" />
            <Button Icon="star" Variant="Variant.Text" aria-label="Bookmark address" />
        </Cluster>
    </div>

    <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-vef-gallery-toolbar">
        <FormField Text="Search" ContainerClass="cda-economy-field">
            <TextBox @bind-Value="search" Immediate="true" Placeholder="Search BOs..." aria-label="Search gallery" />
        </FormField>

        <FormField Text="Type" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="TypeOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedType"
                      ValueChanged="@(value => selectedType = value ?? AllFilter)"
                      Placeholder="All types"
                      aria-label="Filter BO type" />
        </FormField>

        <FormField Text="Operation" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="OperationOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedOperation"
                      ValueChanged="@(value => selectedOperation = value ?? AllFilter)"
                      Placeholder="All operations"
                      aria-label="Filter BO operation" />
        </FormField>
    </Grid>

    @if (FeaturedTags.Count > 0)
    {
        <div class="cda-vef-tag-strip">
            @foreach (string tag in FeaturedTags)
            {
                <button type="button" @onclick="@(() => ApplyTag(tag))">#@tag</button>
            }
        </div>
    }

    <div class="cda-vef-card-deck">
        @foreach (IBusinessObjectView item in FilteredItems)
        {
            <BusinessObjectGalleryCard Item="item"
                                       Workspace="Workspace"
                                       OpenRequested="OpenDetails" />
        }
    </div>
</section>

@code {
    private const string AllFilter = "__all";
    private string search = string.Empty;
    private string selectedType = AllFilter;
    private string selectedOperation = AllFilter;

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback<IBusinessObjectView> SendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> SetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> EditRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> TransactionDetailsRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketVerificationRequest, Task<BusinessObjectTicketVerificationResult>>? TicketVerificationRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectTicketUseRequest, Task<EconomyTransactionExecutionResult>>? TicketUseRequested { get; set; }

    private string ActiveTabLabel => $"AT - {Workspace.AccountName}";

    private IReadOnlyList<IBusinessObjectView> GalleryItems
        => Workspace.BusinessObjects
            .Where(IsGalleryItem)
            .ToArray();

    private IReadOnlyList<IBusinessObjectView> FilteredItems
        => GalleryItems
            .Where(MatchesFilters)
            .OrderByDescending(item => BusinessObjectCardDisplay.SortTimestampFor(item, Workspace))
            .ThenBy(item => BusinessObjectCardDisplay.TransactionOrderFor(item, Workspace))
            .ThenByDescending(item => item.Version)
            .ThenByDescending(item => item.CurrentOutPoint.TxId.Value, StringComparer.Ordinal)
            .ThenByDescending(item => item.CurrentOutPoint.OutputIndex)
            .ToArray();

    private IReadOnlyList<FilterOption> TypeOptions
        => FilterOptions(GalleryItems.Select(item => item.ObjectType));

    private IReadOnlyList<FilterOption> OperationOptions
        => FilterOptions(GalleryItems.Select(item => item.Operation.ToString()));

    private IReadOnlyList<string> FeaturedTags
        => GalleryItems
            .SelectMany(BusinessObjectCardDisplay.TagsFor)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();

    private void ApplyTag(string tag)
    {
        search = tag;
    }

    private Task OpenDetails(IBusinessObjectView item)
        => DialogService.OpenAsync<BusinessObjectLedgerDetailsDialogContent>(
            $"{BusinessObjectCardDisplay.DisplayName(item)} - Details",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectLedgerDetailsDialogContent.Object)] = item,
                [nameof(BusinessObjectLedgerDetailsDialogContent.ViewedAtUtc)] = Workspace.ViewedAtUtc,
                [nameof(BusinessObjectLedgerDetailsDialogContent.Workspace)] = Workspace,
                [nameof(BusinessObjectLedgerDetailsDialogContent.SendRequested)] = SendRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.SetPriceRequested)] = SetPriceRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.EditRequested)] = EditRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.TransactionDetailsRequested)] = TransactionDetailsRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.TicketVerificationRequested)] = TicketVerificationRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.TicketUseRequested)] = TicketUseRequested
            },
            new DialogOptions
            {
                Subtitle = item.ObjectType,
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-vef-dialog cda-vef-dialog--details cda-vef-dialog--bo-detail",
                TestId = "cda-bo-details-dialog"
            });

    private bool MatchesFilters(IBusinessObjectView item)
    {
        if (selectedType != AllFilter && !item.ObjectType.Equals(selectedType, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (selectedOperation != AllFilter && !item.Operation.ToString().Equals(selectedOperation, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        string probe = string.Join(
            ' ',
            BusinessObjectCardDisplay.DisplayName(item),
            item.ObjectId.Value,
            item.ObjectType,
            item.Operation,
            BusinessObjectCardDisplay.StateText(item),
            string.Join(' ', BusinessObjectCardDisplay.TagsFor(item)),
            string.Join(' ', BusinessObjectCardDisplay.FactsFor(item).Select(fact => $"{fact.Label} {fact.Value}")));

        return probe.Contains(search.TrimStart('#'), StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsGalleryItem(IBusinessObjectView item)
    {
        if (item is ICommerceBusinessObjectView commerce
            && (commerce.Commerce.Payment is not null
                || commerce.Commerce.Purchase is not null
                || commerce.Commerce.Receipt is not null))
        {
            return false;
        }

        return !IsHiddenGalleryObject(item);
    }

    private static bool IsHiddenGalleryObject(IBusinessObjectView item)
        => IsHiddenGalleryObjectType(item.ObjectType)
            || StateDeclaresSecureMessage(item.StateJson);

    private static bool IsHiddenGalleryObjectType(string objectType)
        => string.Equals(objectType, "payment", StringComparison.OrdinalIgnoreCase)
            || string.Equals(objectType, "purchase", StringComparison.OrdinalIgnoreCase)
            || string.Equals(objectType, "receipt", StringComparison.OrdinalIgnoreCase)
            || string.Equals(objectType, SecureLedgerMessages.ObjectType, StringComparison.OrdinalIgnoreCase);

    private static bool StateDeclaresSecureMessage(string? stateJson)
    {
        if (string.IsNullOrWhiteSpace(stateJson))
        {
            return false;
        }

        try
        {
            using System.Text.Json.JsonDocument document = System.Text.Json.JsonDocument.Parse(stateJson);
            return ElementDeclaresSecureMessage(document.RootElement);
        }
        catch (System.Text.Json.JsonException)
        {
            return false;
        }
    }

    private static bool ElementDeclaresSecureMessage(System.Text.Json.JsonElement element)
    {
        if (element.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return false;
        }

        if (ElementStringEquals(element, "objectType", SecureLedgerMessages.ObjectType)
            || ElementStringEquals(element, "format", SecureLedgerMessages.Format))
        {
            return true;
        }

        if (!element.TryGetProperty("stateJson", out System.Text.Json.JsonElement nested))
        {
            return false;
        }

        if (nested.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            return ElementDeclaresSecureMessage(nested);
        }

        if (nested.ValueKind == System.Text.Json.JsonValueKind.String
            && nested.GetString() is { Length: > 0 } nestedJson)
        {
            return StateDeclaresSecureMessage(nestedJson);
        }

        return false;
    }

    private static bool ElementStringEquals(
        System.Text.Json.JsonElement element,
        string propertyName,
        string expected)
        => element.TryGetProperty(propertyName, out System.Text.Json.JsonElement property)
            && property.ValueKind == System.Text.Json.JsonValueKind.String
            && string.Equals(property.GetString(), expected, StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<FilterOption> FilterOptions(IEnumerable<string> values)
        => new[] { new FilterOption(AllFilter, "All") }
            .Concat(values
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
                .Select(value => new FilterOption(value, value)))
            .ToArray();

    private sealed record FilterOption(string Value, string Text);
}
