@namespace CanDoItAll.Economy.Components
@using System.Text.Json
@inject DialogService DialogService

<section class="cda-vef-gallery" data-testid="ssr-bo-gallery">
    <div class="cda-vef-gallery-header">
        <Stack GapScale="LayoutGap.Tiny">
            <h2>My Business Objects</h2>
            <p>@Workspace.Address.Value</p>
        </Stack>
        <Cluster Gap="LayoutGap.Small" Class="cda-vef-gallery-title-actions">
            <Button Text="@ActiveTabLabel" Icon="account_circle" Variant="Variant.Outlined" />
            <Button Icon="star" Variant="Variant.Text" aria-label="Bookmark address" />
        </Cluster>
    </div>

    <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-vef-gallery-toolbar">
        <FormField Text="Search" ContainerClass="cda-economy-field">
            <TextBox @bind-Value="search" Immediate="true" Placeholder="Search BOs..." aria-label="Search gallery" />
        </FormField>

        <FormField Text="Type" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="TypeOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedType"
                      ValueChanged="@(value => selectedType = value ?? AllFilter)"
                      Placeholder="All types"
                      aria-label="Filter BO type" />
        </FormField>

        <FormField Text="Operation" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="OperationOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedOperation"
                      ValueChanged="@(value => selectedOperation = value ?? AllFilter)"
                      Placeholder="All operations"
                      aria-label="Filter BO operation" />
        </FormField>
    </Grid>

    @if (FeaturedTags.Count > 0)
    {
        <div class="cda-vef-tag-strip">
            @foreach (string tag in FeaturedTags)
            {
                <button type="button" @onclick="@(() => ApplyTag(tag))">#@tag</button>
            }
        </div>
    }

    <div class="cda-vef-card-deck">
        @foreach (IBusinessObjectView item in FilteredItems)
        {
            BusinessObjectDataItem? previewImage = ImageFor(item);
            <article class="cda-vef-gallery-card">
                @if (previewImage is not null)
                {
                    <button type="button" class="cda-vef-gallery-preview cda-vef-gallery-preview--media" @onclick="@(() => OpenDetails(item))">
                        <BusinessObjectDataItemPreview Item="previewImage" />
                    </button>
                }
                else
                {
                    <button type="button" class="@PreviewClass(item)" @onclick="@(() => OpenDetails(item))">
                        <span class="material-icons" aria-hidden="true">@PreviewIcon(item)</span>
                    </button>
                }
                <div class="cda-vef-gallery-card-body">
                    <h3>@DisplayName(item)</h3>
                    <p>@Description(item)</p>
                    <div class="cda-vef-badges">
                        <span>@item.Operation</span>
                        <span>BO</span>
                        <span>@item.ObjectType</span>
                    </div>
                    <div class="cda-vef-gallery-meta">
                        <span>@ShortObjectId(item.ObjectId)</span>
                        <span>@item.CreatedAt.ToString("MM.dd.yyyy")</span>
                    </div>
                    <div class="cda-vef-tags">
                        @foreach (string tag in TagsFor(item))
                        {
                            <span>#@tag</span>
                        }
                    </div>
                </div>
                <button type="button" class="cda-vef-info-button" @onclick="@(() => OpenDetails(item))" aria-label="Open BO details">
                    <span class="material-icons" aria-hidden="true">info</span>
                </button>
            </article>
        }
    </div>
</section>

@code {
    private const string AllFilter = "__all";
    private string search = string.Empty;
    private string selectedType = AllFilter;
    private string selectedOperation = AllFilter;
    private static readonly JsonSerializerOptions PayloadOptions = new(JsonSerializerDefaults.Web)
    {
        PropertyNameCaseInsensitive = true
    };

    [Parameter, EditorRequired]
    public BusinessObjectWorkspaceModel Workspace { get; set; } = default!;

    [Parameter]
    public EventCallback<IBusinessObjectView> SendRequested { get; set; }

    [Parameter]
    public EventCallback<IBusinessObjectView> SetPriceRequested { get; set; }

    [Parameter]
    public EventCallback<TxId> TransactionDetailsRequested { get; set; }

    private string ActiveTabLabel => $"AT - {Workspace.AccountName}";

    private IReadOnlyList<IBusinessObjectView> FilteredItems
        => Workspace.BusinessObjects
            .Where(MatchesFilters)
            .OrderByDescending(item => item.CreatedAt)
            .ToArray();

    private IReadOnlyList<FilterOption> TypeOptions
        => FilterOptions(Workspace.BusinessObjects.Select(item => item.ObjectType));

    private IReadOnlyList<FilterOption> OperationOptions
        => FilterOptions(Workspace.BusinessObjects.Select(item => item.Operation.ToString()));

    private IReadOnlyList<string> FeaturedTags
        => Workspace.BusinessObjects
            .SelectMany(TagsFor)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();

    private void ApplyTag(string tag)
    {
        search = tag;
    }

    private Task OpenDetails(IBusinessObjectView item)
        => DialogService.OpenAsync<BusinessObjectLedgerDetailsDialogContent>(
            $"{DisplayName(item)} - Details",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectLedgerDetailsDialogContent.Object)] = item,
                [nameof(BusinessObjectLedgerDetailsDialogContent.ViewedAtUtc)] = Workspace.ViewedAtUtc,
                [nameof(BusinessObjectLedgerDetailsDialogContent.SendRequested)] = SendRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.SetPriceRequested)] = SetPriceRequested,
                [nameof(BusinessObjectLedgerDetailsDialogContent.TransactionDetailsRequested)] = TransactionDetailsRequested
            },
            new DialogOptions
            {
                Subtitle = item.ObjectType,
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-vef-dialog cda-vef-dialog--details cda-vef-dialog--bo-detail",
                TestId = "cda-bo-details-dialog"
            });

    private bool MatchesFilters(IBusinessObjectView item)
    {
        if (selectedType != AllFilter && !item.ObjectType.Equals(selectedType, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (selectedOperation != AllFilter && !item.Operation.ToString().Equals(selectedOperation, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        string probe = string.Join(
            ' ',
            DisplayName(item),
            item.ObjectId.Value,
            item.ObjectType,
            item.Operation,
            StateText(item),
            string.Join(' ', TagsFor(item)));

        return probe.Contains(search.TrimStart('#'), StringComparison.OrdinalIgnoreCase);
    }

    private static IReadOnlyList<FilterOption> FilterOptions(IEnumerable<string> values)
        => new[] { new FilterOption(AllFilter, "All") }
            .Concat(values
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
                .Select(value => new FilterOption(value, value)))
            .ToArray();

    private static string DisplayName(IBusinessObjectView item)
    {
        BusinessObjectMediaPayload? payload = PayloadFor(item);
        return string.IsNullOrWhiteSpace(payload?.Name)
            ? item.ObjectId.Value
            : payload.Name;
    }

    private static string Description(IBusinessObjectView item)
    {
        BusinessObjectMediaPayload? payload = PayloadFor(item);
        string state = !string.IsNullOrWhiteSpace(payload?.Description)
            ? payload.Description
            : !string.IsNullOrWhiteSpace(payload?.Text)
                ? payload.Text
                : StateText(item);

        return state.Length > 120 ? $"{state[..120]}..." : state;
    }

    private static string StateText(IBusinessObjectView item)
        => item.StateJson ?? string.Empty;

    private static IReadOnlyList<string> TagsFor(IBusinessObjectView item)
    {
        BusinessObjectMediaPayload? payload = PayloadFor(item);
        IEnumerable<string> payloadTags = string.IsNullOrWhiteSpace(payload?.Tags)
            ? []
            : payload.Tags
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(tag => tag.TrimStart('#'));

        return payloadTags
            .Concat(item.ObjectType.Split(['-', ':', '.'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Concat([item.Operation.ToString(), $"v{item.Version}"])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToArray();
    }

    private static BusinessObjectDataItem? ImageFor(IBusinessObjectView item)
    {
        BusinessObjectMediaPayload? payload = PayloadFor(item);
        BusinessObjectDataItem? dataItem = payload?.DataItems?
            .OrderByDescending(dataItem => dataItem.IsMain)
            .FirstOrDefault(dataItem => dataItem.Type == BusinessObjectDataItemType.Image && dataItem.Uri is not null);

        if (dataItem is not null)
        {
            return dataItem;
        }

        if (!string.IsNullOrWhiteSpace(payload?.ImageLink)
            && Uri.TryCreate(payload.ImageLink, UriKind.Absolute, out Uri? uri))
        {
            return new BusinessObjectDataItem(
                "Image",
                BusinessObjectDataItemType.Image,
                BusinessObjectDataItemStorage.Url,
                uri.ToString(),
                uri,
                "image/*",
                IsMain: true);
        }

        return null;
    }

    private static BusinessObjectMediaPayload? PayloadFor(IBusinessObjectView item)
    {
        if (string.IsNullOrWhiteSpace(item.StateJson))
        {
            return null;
        }

        try
        {
            return JsonSerializer.Deserialize<BusinessObjectMediaPayload>(item.StateJson, PayloadOptions);
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static string PreviewIcon(IBusinessObjectView item)
        => item.ObjectType switch
        {
            "settings" or "account-settings" => "settings",
            "purchase-order" => "receipt_long",
            "inventory-lot" => "inventory_2",
            _ => "widgets"
        };

    private static string PreviewClass(IBusinessObjectView item)
        => item.ObjectType switch
        {
            "settings" or "account-settings" => "cda-vef-gallery-preview cda-vef-gallery-preview--icon cda-vef-gallery-preview--settings",
            "purchase-order" => "cda-vef-gallery-preview cda-vef-gallery-preview--icon cda-vef-gallery-preview--order",
            "inventory-lot" => "cda-vef-gallery-preview cda-vef-gallery-preview--icon cda-vef-gallery-preview--inventory",
            _ => "cda-vef-gallery-preview cda-vef-gallery-preview--icon"
        };

    private static string ShortObjectId(BusinessObjectId objectId)
        => objectId.Value.Length > 18 ? $"{objectId.Value[..10]}...{objectId.Value[^6..]}" : objectId.Value;

    private sealed record FilterOption(string Value, string Text);
}
