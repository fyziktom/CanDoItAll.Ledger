@namespace CanDoItAll.Economy.Components
@using System.Globalization

<section class="cda-vef-bo-preview-stage" data-testid="cda-bo-selected-preview">
    <div class="cda-vef-bo-preview-stage__toolbar">
        <div>
            <strong>@Item.Name</strong>
            <span>@Item.Type / @Item.Storage</span>
        </div>

        @if (Item.Type == BusinessObjectDataItemType.Image && PreviewUri is not null)
        {
            <div class="cda-vef-bo-preview-tools" aria-label="Image view controls">
                <button type="button" title="Zoom out" aria-label="Zoom out" @onclick="ZoomOut">
                    <span class="material-icons" aria-hidden="true">zoom_out</span>
                </button>
                <button type="button" title="Reset view" aria-label="Reset view" @onclick="ResetView">
                    <span class="material-icons" aria-hidden="true">center_focus_strong</span>
                </button>
                <button type="button" title="Zoom in" aria-label="Zoom in" @onclick="ZoomIn">
                    <span class="material-icons" aria-hidden="true">zoom_in</span>
                </button>
            </div>
        }
    </div>

    <div class="cda-vef-bo-preview-stage__canvas @CanvasClass"
         @onpointerdown="BeginPan"
         @onpointermove="MovePan"
         @onpointerup="EndPan"
         @onpointerleave="EndPan"
         @onwheel="HandleWheel"
         @onwheel:preventDefault="true">
        @if (Item.Type == BusinessObjectDataItemType.Image && PreviewUri is not null)
        {
            <img src="@PreviewUri"
                 alt="@Item.Name"
                 draggable="false"
                 style="@ImageTransformStyle" />
        }
        else if (Item.Type == BusinessObjectDataItemType.Pdf && PreviewUri is not null)
        {
            <iframe src="@PreviewUri" title="@Item.Name"></iframe>
        }
        else if (Item.Type == BusinessObjectDataItemType.Mermaid && MermaidSource is not null)
        {
            <MermaidDiagram Source="@MermaidSource"
                            PanZoomEnabled="true"
                            ShowControls="true"
                            Class="cda-vef-bo-mermaid-preview"
                            Style="height: 100%; --cda-mermaid-height: auto; --cda-mermaid-min-height: 0;" />
        }
        else if (IsVideo && PreviewUri is not null)
        {
            <video src="@PreviewUri" controls preload="metadata"></video>
        }
        else if (IsAudio && PreviewUri is not null)
        {
            <div class="cda-vef-bo-file-preview">
                <span class="material-icons" aria-hidden="true">graphic_eq</span>
                <strong>@Item.Name</strong>
                <audio src="@PreviewUri" controls preload="metadata"></audio>
            </div>
        }
        else
        {
            <div class="cda-vef-bo-file-preview">
                <span class="material-icons" aria-hidden="true">@Icon</span>
                <strong>@Label</strong>
                <small>@(Item.Description ?? Item.FileName ?? Item.Hash)</small>
            </div>
        }
    </div>
</section>

@code {
    private const double MinZoom = 0.6;
    private const double MaxZoom = 4.0;
    private double zoom = 1.0;
    private double panX;
    private double panY;
    private double lastX;
    private double lastY;
    private bool dragging;

    [Parameter, EditorRequired]
    public BusinessObjectDataItem Item { get; set; } = default!;

    protected override void OnParametersSet()
    {
        ResetView();
    }

    private string? PreviewUri
        => Item.Uri?.ToString()
            ?? (Item.Storage == BusinessObjectDataItemStorage.Ipfs && !string.IsNullOrWhiteSpace(Item.Hash)
                ? $"https://ipfs.io/ipfs/{Item.Hash}"
                : null);

    private string? MermaidSource
        => Item.Type == BusinessObjectDataItemType.Mermaid && Item.Storage == BusinessObjectDataItemStorage.Inline
            ? Item.Hash
            : null;

    private bool IsVideo
        => Item.Type == BusinessObjectDataItemType.AVMedia
            && (Item.ContentType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) == true);

    private bool IsAudio
        => Item.Type == BusinessObjectDataItemType.AVMedia
            && (Item.ContentType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) == true
                || Item.FileName?.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) == true);

    private string CanvasClass
        => Item.Type == BusinessObjectDataItemType.Image && PreviewUri is not null
            ? "is-draggable"
            : string.Empty;

    private string ImageTransformStyle
        => string.Create(
            CultureInfo.InvariantCulture,
            $"transform: translate3d({panX}px, {panY}px, 0) scale({zoom});");

    private string Icon
        => Item.Type switch
        {
            BusinessObjectDataItemType.Pdf => "picture_as_pdf",
            BusinessObjectDataItemType.Json => "data_object",
            BusinessObjectDataItemType.Html => "html",
            BusinessObjectDataItemType.Mermaid => "account_tree",
            BusinessObjectDataItemType.AVMedia => "movie",
            BusinessObjectDataItemType.Text => "article",
            _ => "insert_drive_file"
        };

    private string Label
        => Item.Type switch
        {
            BusinessObjectDataItemType.Pdf => "PDF",
            BusinessObjectDataItemType.Json => "JSON",
            BusinessObjectDataItemType.Html => "HTML",
            BusinessObjectDataItemType.Mermaid => "Mermaid",
            BusinessObjectDataItemType.AVMedia => "Media",
            BusinessObjectDataItemType.Text => "Text",
            _ => "File"
        };

    private void BeginPan(PointerEventArgs args)
    {
        if (Item.Type != BusinessObjectDataItemType.Image)
        {
            return;
        }

        dragging = true;
        lastX = args.ClientX;
        lastY = args.ClientY;
    }

    private void MovePan(PointerEventArgs args)
    {
        if (!dragging)
        {
            return;
        }

        panX += args.ClientX - lastX;
        panY += args.ClientY - lastY;
        lastX = args.ClientX;
        lastY = args.ClientY;
    }

    private void EndPan()
    {
        dragging = false;
    }

    private void HandleWheel(WheelEventArgs args)
    {
        if (Item.Type != BusinessObjectDataItemType.Image)
        {
            return;
        }

        SetZoom(zoom + (args.DeltaY < 0 ? 0.12 : -0.12));
    }

    private void ZoomIn()
        => SetZoom(zoom + 0.2);

    private void ZoomOut()
        => SetZoom(zoom - 0.2);

    private void SetZoom(double value)
    {
        zoom = Math.Clamp(value, MinZoom, MaxZoom);
    }

    private void ResetView()
    {
        zoom = 1;
        panX = 0;
        panY = 0;
        dragging = false;
    }
}
