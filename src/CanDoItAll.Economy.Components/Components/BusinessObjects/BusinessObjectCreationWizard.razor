    private async Task OpenRecipientAddressDirectoryAsync()
    {
        if (Workspace is null)
        {
            return;
        }

        object? result = await DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Select Ticket Recipient",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Workspace)] = Workspace,
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Select
            },
            new DialogOptions
            {
                Subtitle = "Choose own or external recipient",
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--address-directory",
                TestId = "cda-address-directory-dialog"
            });

        if (result is not AddressDirectoryEntry entry)
        {
            return;
        }

        if (entry.Kind == AddressDirectoryEntryKind.Own && Workspace.SubAccounts.Any(item => item.Address.Value == entry.Address))
