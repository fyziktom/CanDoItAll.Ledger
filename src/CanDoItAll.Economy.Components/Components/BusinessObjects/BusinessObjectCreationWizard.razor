    private async Task StageBusinessObjectAsync()
    {
        if (Workspace is null)
        {
            Notifications.Warning("Workspace unavailable", "Cannot stage a BO transaction before the workspace loads.", position: NotificationPosition.BottomCenter);
            return;
        }

        EconomyTokenOption? selectedToken = SelectedToken;
        if (selectedToken is not null && !selectedToken.IsMain && !selectedToken.HasReusableSource)
        {
            Notifications.Warning("Reusable source required", CreationAssetHint, position: NotificationPosition.BottomCenter);
            return;
        }

        BusinessObjectMediaPayload payload = CreatePayload();
        if (ShouldStageTicketBatch)
        {
            IReadOnlyList<Address> recipients = ResolveTicketMultimintRecipients();
            if (recipients.Count == 0)
            {
                Notifications.Warning("Recipients required", "Select a valid recipient target before staging the ticket batch.", position: NotificationPosition.BottomCenter);
                return;
            }

            BusinessObjectTransactionDraft[] drafts = recipients
                .Select((recipient, index) => CreateCreateDraft(
                    CreateTicketBatchPayload(payload, index, recipients.Count),
                    recipient,
                    selectedToken))
                .ToArray();

            if (drafts.Length == 1)
            {
                await StageBusinessObjectRequested.InvokeAsync(drafts[0]);
                return;
            }

            await StageBusinessObjectBatchRequested.InvokeAsync(new BusinessObjectBatchTransactionRequest(
                "Ticket multimint",
                drafts,
                $"{drafts.Length} ticket BO transaction(s) prepared.",
                recipientMode));
            return;
        }

        BusinessObjectTransactionDraft draft = CreateCreateDraft(payload, Workspace.Address, selectedToken);
        await StageBusinessObjectRequested.InvokeAsync(draft);
    }

    private BusinessObjectTransactionDraft CreateCreateDraft(
        BusinessObjectMediaPayload payload,
        Address ownerAddress,
        EconomyTokenOption? selectedToken)
    {
        string stateJson = BusinessObjectPayloadBuilder.Serialize(payload);
        Amount mainAmount = selectedToken?.IsMain == false ? Amount.Zero : Amount.FromInt64(1);
        string normalizedName = BusinessObjectCreateIdFactory.NormalizeName(payload.Name);
        BusinessObjectId objectId = BusinessObjectCreateIdFactory.CreateNewObjectId(selectedObjectType, payload.Name);
        return new BusinessObjectTransactionDraft(
            objectId,
            selectedObjectType,
            "1.0",
            ownerAddress,
            ownerAddress,
            ownerAddress,
            mainAmount,
            Amount.Zero,
            stateJson,
            $"preview://{selectedObjectType}/{normalizedName}/{objectId.Value}",
            BusinessObjectTransactionMode.Create,
            TokenId: selectedToken?.IsMain == true ? null : selectedToken?.TokenId,
            TokenAmount: selectedToken?.IsMain == true || selectedToken?.TokenId is null ? null : Amount.FromInt64(1));
    }

    private BusinessObjectMediaPayload CreateTicketBatchPayload(
        BusinessObjectMediaPayload template,
        int index,
        int total)
    {
        int number = index + 1;
        var fields = new Dictionary<string, string>(template.Fields ?? new Dictionary<string, string>(StringComparer.Ordinal), StringComparer.Ordinal)
        {
            ["ticketNumber"] = BuildTicketNumber(fieldsValue: FieldValue("ticketNumber"), number, total),
            ["batchIndex"] = number.ToString(System.Globalization.CultureInfo.InvariantCulture),
            ["batchSize"] = total.ToString(System.Globalization.CultureInfo.InvariantCulture)
        };

        return template with
        {
            Name = total <= 1 ? template.Name : $"{template.Name} #{number:000}",
            Fields = BusinessObjectPayloadBuilder.NormalizeFields(SelectedDefinition, fields)
        };
    }

    private IReadOnlyList<Address> ResolveTicketMultimintRecipients()
    {
        if (Workspace is null)
        {
            return [];
        }

        EnsureRecipientDefaults();

        if (IsManualRecipientMode)
        {
            Address[] manualRecipients = ParseRecipientList(recipientListText).Take(MaxTicketMultimintCount).ToArray();
            if (manualRecipients.Length == 1)
            {
                return RepeatAddress(manualRecipients[0], ResolvedTicketMultimintCount);
            }

            return manualRecipients;
        }

        Address? target = recipientMode switch
        {
            RecipientModeSubAccount => TryParseAddress(selectedSubAccountAddress),
            RecipientModeAddressBook => TryParseAddress(selectedAddressBookAddress),
            _ => Workspace.Address
        };

        return target is null ? [] : RepeatAddress(target.Value, ResolvedTicketMultimintCount);
    }

    private static IReadOnlyList<Address> RepeatAddress(Address address, int count)
        => Enumerable.Repeat(address, Math.Clamp(count, 1, MaxTicketMultimintCount)).ToArray();

    private static IReadOnlyList<Address> ParseRecipientList(string value)
        => value
            .Replace(',', '\n')
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(TryParseAddress)
            .Where(address => address is not null)
            .Select(address => address!.Value)
            .ToArray();

    private static Address? TryParseAddress(string? value)
        => Address.TryParse(value?.Trim(), out Address address) ? address : null;

    private static string BuildTicketNumber(string fieldsValue, int number, int total)
    {
        string prefix = string.IsNullOrWhiteSpace(fieldsValue) ? "ticket" : fieldsValue.Trim();
        if (total <= 1)
        {
            return prefix;
        }

        return $"{prefix}-{number:000}";
    }

    private IBusinessObjectView CreatePreviewBusinessObject()
    {
        DateTimeOffset viewedAt = Workspace?.ViewedAtUtc ?? DateTimeOffset.UtcNow;
        Address owner = Workspace?.Address ?? new Address("preview");
        BusinessObjectMediaPayload payload = CreatePayload();
        string stateJson = BusinessObjectPayloadBuilder.Serialize(payload);
        IReadOnlyDictionary<string, string> fields = BusinessObjectPayloadBuilder.NormalizeFields(SelectedDefinition, payload.Fields);

        return new GenericTypedBusinessObjectView(
            Workspace?.Context ?? new LedgerAccountContext(new LedgerId("preview"), null),
            new BusinessObjectId($"bo:preview:{selectedObjectType}:{BusinessObjectCreateIdFactory.NormalizeName(payload.Name)}"),
            selectedObjectType,
            "1.0",
            1,
            owner,
            BusinessObjectOperation.Create,
            new HashHex(new string('0', 64)),
            new OutPoint(new TxId("preview"), 0),
            stateJson,
            "preview://business-object",
            TransactionDataItemType.BusinessObject,
            viewedAt,
            viewedAt,
            payload.Name,
            payload.Description,
            payload.Text,
            payload.Author,
            payload.Link,
            payload.ImageLink,
            payload.TagList,
            payload.DataItems ?? Array.Empty<BusinessObjectDataItem>(),
            SelectedDefinition,
            fields,
            BusinessObjectPayloadBuilder.CreateFacts(SelectedDefinition, fields));
    }

    private string FinishIcon
        => SelectedDefinition.Icon;

    private BusinessObjectMediaPayload CreatePayload()
        => BusinessObjectPayloadBuilder.CreatePayload(
            SelectedDefinition,
            name,
            description,
            text,
            string.Join(' ', Tags.Select(tag => $"#{tag}")),
            DisplayDataItems,
            fieldValues);

    private static IReadOnlyList<string> ParseTags(string value)
        => value
            .Split([' ', ',', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(tag => AccountWorkspaceLocalServiceHelpers.NormalizeTag(tag))
            .Where(tag => tag is not null)
            .Cast<string>()
            .Distinct(StringComparer.Ordinal)
            .OrderBy(tag => tag, StringComparer.Ordinal)
            .ToArray();

    private static string ShortHash(string hash)
        => hash.Length > 18 ? $"{hash[..18]}..." : hash;

    private static string ShortAddress(string address)
        => address.Length > 18 ? $"{address[..10]}...{address[^6..]}" : address;

    private static string ShortType(string value)
        => value.Length > 18 ? $"{value[..18]}..." : value;

