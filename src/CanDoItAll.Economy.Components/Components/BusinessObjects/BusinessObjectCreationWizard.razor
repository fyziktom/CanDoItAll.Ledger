    private void ApplyTicketEvent(IBusinessObjectView eventObject)
    {
        if (!eventObject.ObjectType.Equals("event", StringComparison.OrdinalIgnoreCase))
        {
            Notifications.Warning("Invalid event", "The selected BO is not an event.", position: NotificationPosition.BottomCenter);
            return;
        }

        selectedTicketEvent = eventObject;
        EnsureFieldKeys();
        BusinessObjectTicketEventPrefill prefill = BusinessObjectTicketEventPrefill.FromEvent(eventObject);
        foreach ((string key, string value) in prefill.Fields)
        {
            SetTicketField(key, value, overwrite: key is not "status");
        }

        if (!string.IsNullOrWhiteSpace(prefill.EventName))
        {
            if (string.IsNullOrWhiteSpace(description)
                || description.Equals(SelectedDefinition.Description, StringComparison.Ordinal)
                || description.Equals(BusinessObjectFamilyCatalog.FindOrDefault("ticket").Description, StringComparison.Ordinal))
            {
                description = $"Ticket for {prefill.EventName}";
            }

            if (string.IsNullOrWhiteSpace(name)
                || name.Equals(BusinessObjectPayloadBuilder.DefaultName(SelectedDefinition), StringComparison.Ordinal))
            {
                name = $"Ticket for {prefill.EventName}";
            }
        }

        Notifications.Success("Event selected", "Ticket fields were preloaded from the selected event BO.", position: NotificationPosition.BottomCenter);
    }

    private void SetTicketField(string key, string? value, bool overwrite)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        if (overwrite || string.IsNullOrWhiteSpace(FieldValue(key)))
        {
            fieldValues[key] = value.Trim();
        }
    }

    private string FieldValue(string key)
        => fieldValues.TryGetValue(key, out string? value) ? value : string.Empty;

    private void SetFieldValue(string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            fieldValues.Remove(key);
            return;
        }

        fieldValues[key] = value.Trim();
    }

