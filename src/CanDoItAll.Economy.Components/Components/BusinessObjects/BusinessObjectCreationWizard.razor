    private async Task HandleUploadChangeAsync(InputFileChangeEventArgs args)
    {
        IBusinessObjectDataItemUploadService? uploadService = Services.GetService<IBusinessObjectDataItemUploadService>();
        if (uploadService is null)
        {
            Notifications.Error("IPFS storage missing", "Configure BusinessObjects:IpfsApiUrl and BusinessObjects:IpfsGatewayUrl before uploading BO files.", position: NotificationPosition.BottomCenter);
            return;
        }

        var items = new List<BusinessObjectDataItem>();
        uploadInProgress = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            foreach (IBrowserFile file in args.GetMultipleFiles(8))
            {
                try
                {
                    items.Add(await CreateIpfsDataItemAsync(uploadService, file, items.Count == 0));
                }
                catch (Exception exception)
                {
                    Notifications.Error("IPFS upload failed", $"{file.Name}: {exception.Message}", position: NotificationPosition.BottomCenter);
                }
            }

            uploadedItems = items;
            if (items.Count > 0)
            {
                Notifications.Success("Uploaded to IPFS", $"{items.Count} file(s) stored as CID-backed DataItems.", position: NotificationPosition.BottomCenter);
            }
        }
        finally
        {
            uploadInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static async Task<BusinessObjectDataItem> CreateIpfsDataItemAsync(
        IBusinessObjectDataItemUploadService uploadService,
        IBrowserFile file,
        bool isMain)
    {
        const long maxUploadBytes = 128 * 1024 * 1024;
        string contentType = string.IsNullOrWhiteSpace(file.ContentType)
            ? "application/octet-stream"
            : file.ContentType;
        await using Stream stream = file.OpenReadStream(maxUploadBytes);
        return await uploadService.SaveToIpfsAsync(
            new BusinessObjectDataItemUploadRequest(
                stream,
                file.Name,
                contentType,
                file.Size,
                isMain,
                "Uploaded through BO wizard"),
            CancellationToken.None);
    }

