    private bool IsEventSelected
        => selectedObjectType.Equals("event", StringComparison.OrdinalIgnoreCase);

    private bool IsEventOrTicketSelected
        => IsEventSelected || IsTicketSelected;

    private bool IsAutoMintAuthorField(BusinessObjectFieldDefinition field)
        => IsEventOrTicketSelected
            && field.Key.Equals("mintAuthorAddress", StringComparison.OrdinalIgnoreCase);

    private static bool IsDateTimeField(BusinessObjectFieldDefinition field)
        => field.Kind == BusinessObjectFieldKind.DateTime;

    private bool HasFieldOptions(BusinessObjectFieldDefinition field)
        => FieldOptions(field).Count > 0;

    private IReadOnlyList<FilterOption> FieldOptions(BusinessObjectFieldDefinition field)
        => field.Key switch
        {
            "eventClass" => EventClassOptions,
            "ticketClass" => TicketClassOptions,
            "ticketDuration" => TicketDurationOptions,
            "status" when IsTicketSelected => TicketStatusOptions,
            "status" when IsEventSelected => EventStatusOptions,
            "used" => BooleanStatusOptions,
            "musicInLink" => BooleanStatusOptions,
            _ => []
        };

    private void ApplyCreateDefaults()
    {
        if (IsEditMode || !IsEventOrTicketSelected || Workspace is null)
        {
            return;
        }

        SetDefaultField("mintAuthorAddress", Workspace.Address.Value);
        SetDefaultField("eventDate", FormatDateTimePayload(Workspace.ViewedAtUtc));

        if (IsEventSelected)
        {
            SetDefaultField("eventClass", EventClassOptions[0].Value);
            SetDefaultField("status", EventStatusOptions[0].Value);
            return;
        }

        SetDefaultField("ticketClass", TicketClassOptions[0].Value);
        SetDefaultField("ticketDuration", TicketDurationOptions[0].Value);
        SetDefaultField("used", BooleanStatusOptions[0].Value);
        SetDefaultField("status", TicketStatusOptions[0].Value);
    }

    private void SetDefaultField(string key, string value)
    {
        if (!fieldValues.TryGetValue(key, out string? current) || string.IsNullOrWhiteSpace(current))
        {
            fieldValues[key] = value;
        }
    }

    private string DateTimeInputValue(string key)
    {
        if (!DateTimeOffset.TryParse(
                FieldValue(key),
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out DateTimeOffset timestamp))
        {
            return string.Empty;
        }

        return timestamp.UtcDateTime.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void OnDateTimeFieldChanged(string key, ChangeEventArgs args)
    {
        string? value = Convert.ToString(args.Value, System.Globalization.CultureInfo.InvariantCulture);
        if (string.IsNullOrWhiteSpace(value))
        {
            fieldValues.Remove(key);
            return;
        }

        if (DateTimeOffset.TryParse(
                value,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out DateTimeOffset timestamp))
        {
            fieldValues[key] = FormatDateTimePayload(timestamp);
            return;
        }

        fieldValues[key] = value.Trim();
    }

    private static string FormatDateTimePayload(DateTimeOffset timestamp)
        => timestamp.UtcDateTime.ToString("yyyy-MM-ddTHH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);

