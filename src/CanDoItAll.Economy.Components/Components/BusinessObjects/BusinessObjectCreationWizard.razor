@namespace CanDoItAll.Economy.Components
@using Microsoft.Extensions.DependencyInjection
@inject DialogService DialogService
@inject NotificationService Notifications
@inject IServiceProvider Services
@inject ITagOccurrenceService TagOccurrences

<Stack Section="true" GapScale="LayoutGap.Small" Class="cda-venft-wizard cda-venft-wizard--compact" data-testid="bo-create-wizard">
    <section class="cda-venft-wizard-command">
        <Steps Value="@(currentStep - 1)"
               ValueChanged="SetStepIndex"
               CanSelect="true"
               Class="cda-venft-compact-steps"
               aria-label="Create BusinessObject steps">
            <StepsItem Text="Upload" Icon="upload_file" />
            <StepsItem Text="Data Info" Icon="edit_note" />
            <StepsItem Text="Finish" Icon="flag" />
        </Steps>

        <Cluster Gap="LayoutGap.Small" Class="cda-venft-wizard-actions cda-venft-wizard-actions--compact">
            <Button Text="Load Template" Icon="folder_open" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" />
            <Button Text="Back" Icon="arrow_back" Size="ButtonSize.Small" Variant="Variant.Outlined" Disabled="@(currentStep == 1)" Click="@PreviousStep" />
            <Button Text="@NextButtonText" Icon="@NextButtonIcon" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="@NextStepAsync" />
        </Cluster>
    </section>

    @if (currentStep == 1)
    {
        <section class="cda-vef-panel cda-venft-wizard-panel cda-venft-upload-panel">
            <div class="cda-vef-panel-header">
                <Stack GapScale="LayoutGap.Tiny">
                    <span>Upload Data Items</span>
                    <small>Images, media, PDF, JSON, HTML, and Mermaid files can become BO payload data.</small>
                </Stack>
                <span class="cda-vef-source-pill cda-vef-source-pill--source">@DisplayDataItems.Count item(s)</span>
            </div>
            <div class="cda-vef-panel-body">
                <Grid ColumnsLg="2"
                      ColumnTemplateLg="minmax(18rem, 0.8fr) minmax(0, 1.2fr)"
                      Gap="LayoutGap.Medium"
                      Class="cda-venft-upload-layout">
                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <div class="cda-venft-info-alert cda-venft-info-alert--compact">Files are uploaded to IPFS immediately. The BO transaction stores only CIDs and metadata.</div>
                        <FileUpload PrimaryText="Drop or choose files"
                                    SecondaryText="PNG, JPEG, MP3, MP4, JSON, PDF, HTML, or MMD."
                                    ButtonText="Choose files"
                                    Compact="true"
                                    Disabled="@uploadInProgress"
                                    Multiple="true"
                                    Change="HandleUploadChangeAsync"
                                    Accept="image/*,.pdf,.json,.html,.mmd,.mp3,.mp4"
                                    InputTestHookId="bo-upload-input"
                                    RootTestHookId="bo-upload"
                                    DropZoneTestHookId="bo-upload-zone" />
                        <Grid ColumnsMd="3" Gap="LayoutGap.Small" Class="cda-venft-upload-facts">
                            <div class="cda-economy-fact"><span>Type</span><strong>@SelectedDefinition.DisplayName</strong></div>
                            <div class="cda-economy-fact"><span>Main</span><strong>@(MainDataItem?.Name ?? "none")</strong></div>
                            <div class="cda-economy-fact"><span>Loaded</span><strong>@DisplayDataItems.Count</strong></div>
                            <div class="cda-economy-fact"><span>Storage</span><strong>@UploadStorageLabel</strong></div>
                        </Grid>
                    </Stack>

                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <Grid ColumnsLg="2" ColumnTemplateLg="minmax(0, 0.9fr) minmax(0, 1.1fr)" Gap="LayoutGap.Small" Class="cda-venft-upload-preview-grid">
                            <section class="cda-venft-preview-tile">
                                <div class="cda-venft-preview-tile__header">
                                    <span>Selected Preview</span>
                                    <strong>@(LastUploadedItem?.Name ?? "No file")</strong>
                                </div>
                                @if (LastUploadedItem is not null)
                                {
                                    <BusinessObjectDataItemPreview Item="LastUploadedItem" Large="true" />
                                }
                                else
                                {
                                    <div class="cda-venft-empty-preview">
                                        <span class="material-icons" aria-hidden="true">upload_file</span>
                                        <strong>No preview yet</strong>
                                    </div>
                                }
                            </section>

                            <section class="cda-venft-loaded-panel">
                                <div class="cda-venft-preview-tile__header">
                                    <span>Loaded DataItems</span>
                                    <strong>@DisplayDataItems.Count total</strong>
                                </div>
                                @if (DisplayDataItems.Count == 0)
                                {
                                    <p class="cda-vef-empty-line">Choose files to prepare BO data items.</p>
                                }
                                else
                                {
                                    <div class="cda-venft-dataitem-strip cda-venft-dataitem-strip--compact">
                                        @foreach (BusinessObjectDataItem item in DisplayDataItems)
                                        {
                                            <article class="cda-venft-dataitem-card cda-venft-dataitem-card--compact">
                                                <BusinessObjectDataItemPreview Item="item" />
                                                <div>
                                                    <strong><HashDisplay Value="@item.Hash" /></strong>
                                                    <Stack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" GapScale="LayoutGap.XSmall" Class="cda-economy-check-row">
                                                        <CheckBox TValue="bool" Value="@item.IsMain" Disabled="true" />
                                                        <span>Main</span>
                                                    </Stack>
                                                </div>
                                            </article>
                                        }
                                    </div>
                                }
                            </section>
                        </Grid>
                    </Stack>
                </Grid>
            </div>
        </section>
    }
    else if (currentStep == 2)
    {
        <section class="cda-vef-panel cda-venft-wizard-panel">
            <div class="cda-vef-panel-header">Information about the data</div>
            <div class="cda-vef-panel-body">
                <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-venft-data-info-layout">
                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <FormField Text="Type">
                            <DropDown TValue="string"
                                      Data="ObjectTypeOptions"
                                      TextProperty="Text"
                                      ValueProperty="Value"
                                      Value="@selectedObjectType"
                                      ValueChanged="SelectObjectType"
                                      aria-label="BusinessObject type" />
                        </FormField>
                        <FormField Text="Name">
                            <TextBox Value="@name" ValueChanged="@(value => name = value ?? string.Empty)" Immediate="true" aria-label="BusinessObject name" />
                        </FormField>
                        <FormField Text="Tags">
                            <TagEditor Value="@tagValues"
                                       ValueChanged="UpdateTagsAsync"
                                       Suggestions="@tagSuggestions"
                                       Placeholder="Add tag"
                                       InputTestId="bo-tag-editor-input"
                                       TestId="bo-tag-editor" />
                        </FormField>
                        <div class="cda-venft-tag-row">
                            @foreach (string tag in Tags)
                            {
                                <TagBadge Tag="@tag" AccountScope="@TagAccountScope" TestId="bo-tag-badge" />
                            }
                        </div>
                        <FormField Text="Short description">
                            <TextBox Value="@description" ValueChanged="@(value => description = value ?? string.Empty)" Immediate="true" aria-label="BusinessObject description" />
                        </FormField>
                        @if (IsTicketSelected)
                        {
                            <section class="cda-ticket-event-panel" data-testid="cda-ticket-event-panel">
                                <div>
                                    <span class="material-icons" aria-hidden="true">event</span>
                                    <div>
                                        <strong>@(selectedTicketEvent is null ? "No event selected" : TicketEventDisplayName)</strong>
                                        <small>@(selectedTicketEvent?.ObjectId.Value ?? "Select an event BO or load it by transaction hash.")</small>
                                    </div>
                                </div>
                                <Button Text="Select Event"
                                        Icon="travel_explore"
                                        Size="ButtonSize.Small"
                                        ButtonStyle="ButtonStyle.Secondary"
                                        Click="OpenTicketEventPickerAsync"
                                        data-testid="cda-ticket-select-event" />
                            </section>
                            <section class="cda-ticket-multimint-panel" data-testid="cda-ticket-multimint-panel">
                                <label class="cda-economy-check-row">
                                    <input type="checkbox"
                                           @bind="multimintEnabled"
                                           data-testid="cda-ticket-multimint-enabled" />
                                    <span>Multimint tickets</span>
                                </label>
                                @if (multimintEnabled)
                                {
                                    <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                        @if (!IsManualRecipientMode)
                                        {
                                            <FormField Text="Ticket count" ContainerClass="cda-economy-field">
                                                <input type="number"
                                                       class="cda-ticket-multimint-number"
                                                       min="1"
                                                       max="100"
                                                       value="@ticketMultimintCount"
                                                       @oninput="OnTicketMultimintCountInput"
                                                       data-testid="cda-ticket-multimint-count" />
                                            </FormField>
                                        }
                                        <FormField Text="Recipients" ContainerClass="cda-economy-field">
                                            <select class="cda-ticket-multimint-select"
                                                    value="@recipientMode"
                                                    @onchange="OnRecipientModeChanged"
                                                    aria-label="Ticket multimint recipients"
                                                    data-testid="cda-ticket-multimint-recipient-mode">
                                                @foreach (FilterOption option in RecipientModeOptions)
                                                {
                                                    <option value="@option.Value">@option.Text</option>
                                                }
                                            </select>
                                        </FormField>
                                        @if (IsSubAccountRecipientMode)
                                        {
                                            <FormField Text="Subaccount" ContainerClass="cda-economy-field cda-economy-field--wide">
                                                @if (SubAccountOptions.Count == 0)
                                                {
                                                    <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                                        No linked subaccounts are available in this workspace.
                                                    </Alert>
                                                }
                                                else
                                                {
                                                    <select class="cda-ticket-multimint-select"
                                                            value="@selectedSubAccountAddress"
                                                            @onchange="OnSubAccountAddressChanged"
                                                            aria-label="Ticket multimint subaccount"
                                                            data-testid="cda-ticket-multimint-subaccount">
                                                        @foreach (FilterOption option in SubAccountOptions)
                                                        {
                                                            <option value="@option.Value">@option.Text</option>
                                                        }
                                                    </select>
                                                }
                                            </FormField>
                                        }
                                        else if (IsAddressBookRecipientMode)
                                        {
                                            <FormField Text="Address book" ContainerClass="cda-economy-field cda-economy-field--wide">
                                                @if (AddressBookOptions.Count == 0)
                                                {
                                                    <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                                        No address-book entries are available in this workspace.
                                                    </Alert>
                                                }
                                                else
                                                {
                                                    <select class="cda-ticket-multimint-select"
                                                            value="@selectedAddressBookAddress"
                                                            @onchange="OnAddressBookAddressChanged"
                                                            aria-label="Ticket multimint address book"
                                                            data-testid="cda-ticket-multimint-address-book">
                                                        @foreach (FilterOption option in AddressBookOptions)
                                                        {
                                                            <option value="@option.Value">@option.Text</option>
                                                        }
                                                    </select>
                                                }
                                                <PageHeaderActionButton Icon="contacts"
                                                                        Label="Directory"
                                                                        TooltipText="Choose recipient from address directory"
                                                                        Variant="Variant.Outlined"
                                                                        Click="OpenRecipientAddressDirectoryAsync"
                                                                        TestId="cda-ticket-multimint-address-directory" />
                                            </FormField>
                                        }
                                        else if (IsManualRecipientMode)
                                        {
                                            <FormField Text="Recipient addresses" ContainerClass="cda-economy-field cda-economy-field--wide">
                                                <TextArea Value="@recipientListText"
                                                          ValueChanged="@(value => recipientListText = value ?? string.Empty)"
                                                          Immediate="true"
                                                          Rows="4"
                                                          Placeholder="One address per line. A single address repeats by ticket count."
                                                          aria-label="Ticket multimint recipient addresses"
                                                          data-testid="cda-ticket-multimint-recipient-list" />
                                            </FormField>
                                        }
                                        <div class="cda-economy-fact cda-economy-fact--wide" data-testid="cda-ticket-multimint-summary">
                                            <span>Batch preview</span>
                                            <strong>@TicketMultimintSummary</strong>
                                        </div>
                                    </Grid>
                                }
                            </section>
                        }
                    </Stack>
                    <Stack GapScale="LayoutGap.Small" Class="min-w-0">
                        <FormField Text="Long description" ContainerClass="cda-economy-field cda-economy-field--wide">
                            <TextArea Value="@text" ValueChanged="@(value => text = value ?? string.Empty)" Immediate="true" Rows="10" aria-label="BusinessObject text" />
                        </FormField>
                        @if (SelectedDefinition.Fields.Count > 0)
                        {
                            <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                @foreach (BusinessObjectFieldDefinition field in SelectedDefinition.Fields)
                                {
                                    <FormField Text="@field.Label" ContainerClass="cda-economy-field">
                                        @if (field.Kind == BusinessObjectFieldKind.LongText)
                                        {
                                            <TextArea Value="@FieldValue(field.Key)"
                                                      ValueChanged="@(value => SetFieldValue(field.Key, value))"
                                                      Immediate="true"
                                                      Rows="4"
                                                      aria-label="@field.Label" />
                                        }
                                        else
                                        {
                                            <TextBox Value="@FieldValue(field.Key)"
                                                     ValueChanged="@(value => SetFieldValue(field.Key, value))"
                                                     Immediate="true"
                                                     Placeholder="@field.Placeholder"
                                                     aria-label="@field.Label" />
                                        }
                                    </FormField>
                                }
                            </Grid>
                        }
                    </Stack>
                </Grid>
            </div>
        </section>
    }
    else
    {
        <section class="cda-vef-panel cda-venft-wizard-panel">
            <div class="cda-vef-panel-header">Finish</div>
            <div class="cda-vef-panel-body">
                <Grid ColumnsLg="2" ColumnTemplateLg="minmax(0, 1.4fr) minmax(320px, 0.8fr)" Gap="LayoutGap.Large" Class="cda-venft-finish-layout">
                    <Stack GapScale="LayoutGap.Medium" Class="min-w-0">
                        <button type="button" class="cda-vef-gallery-preview cda-venft-finish-preview-card" @onclick="OpenFinishDetailsAsync">
                            @if (LastUploadedItem is not null)
                            {
                                <BusinessObjectDataItemPreview Item="LastUploadedItem" Large="true" />
                            }
                            else
                            {
                                <span class="material-icons" aria-hidden="true">@FinishIcon</span>
                                <strong>@ShortType(selectedObjectType)</strong>
                            }
                        </button>
                        <Stack GapScale="LayoutGap.Small" Class="cda-venft-finish-copy">
                            <h3>@name</h3>
                            <p>@description</p>
                            <div class="cda-vef-badges">
                                <span>VENFT</span>
                                <span>BO</span>
                                <span>@selectedObjectType</span>
                            </div>
                            <div class="cda-vef-tags">
                                @foreach (string tag in Tags)
                                {
                                    <TagBadge Tag="@tag" AccountScope="@TagAccountScope" />
                                }
                            </div>
                        </Stack>
                    </Stack>

                    <Stack GapScale="LayoutGap.Medium" Class="cda-venft-finish-inspector min-w-0">
                        <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                            <div class="cda-economy-fact"><span>Type</span><strong>@SelectedDefinition.DisplayName</strong></div>
                            <div class="cda-economy-fact"><span>DataItems</span><strong>@DisplayDataItems.Count</strong></div>
                            <div class="cda-economy-fact cda-economy-fact--wide"><span>Name</span><strong>@name</strong></div>
                        </Grid>
                        @if (TypedFacts.Count > 0)
                        {
                            <Grid ColumnsMd="2" Gap="LayoutGap.Small">
                                @foreach (BusinessObjectDisplayFact fact in TypedFacts.Take(4))
                                {
                                    <div class="cda-economy-fact"><span>@fact.Label</span><strong>@fact.Value</strong></div>
                                }
                            </Grid>
                        }
                        @if (Workspace is not null)
                        {
                            <AvailableTokenSelector Options="Workspace.TokenOptions"
                                                    SelectedKey="@selectedTokenKey"
                                                    SelectedKeyChanged="@(key => selectedTokenKey = key)"
                                                    Label="Creation asset"
                                                    DataTestId="bo-create-token-selector" />
                            <div class="cda-economy-fact">
                                <span>Source status</span>
                                <strong>@CreationAssetHint</strong>
                            </div>
                        }
                        <Cluster Gap="LayoutGap.Small">
                            <Button Text="Stage BO Transaction" Icon="receipt_long" ButtonStyle="ButtonStyle.Secondary" Disabled="@(!CanStageSelectedAsset)" Click="StageBusinessObjectAsync" />
                            <Button Text="Preview Details" Icon="info" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="OpenFinishDetailsAsync" />
                        </Cluster>
                    </Stack>
                </Grid>
            </div>
        </section>
    }
</Stack>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectCreationWizardModel Model { get; set; } = default!;

    [Parameter]
    public BusinessObjectWorkspaceModel? Workspace { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> StageBusinessObjectRequested { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectBatchTransactionRequest> StageBusinessObjectBatchRequested { get; set; }

    [Parameter]
    public Func<BusinessObjectEventLookupRequest, Task<BusinessObjectEventLookupResult>>? EventBusinessObjectLookupRequested { get; set; }

    private const string RecipientModeOwn = "own";
    private const string RecipientModeSubAccount = "subaccount";
    private const string RecipientModeAddressBook = "addressbook";
    private const string RecipientModeManual = "manual";
    private const int MaxTicketMultimintCount = 100;
    private int currentStep = 1;
    private string? currentModelKey;
    private string? selectedTokenKey = EconomyTokenOption.MainKey;
    private string selectedObjectType = "post";
    private string name = string.Empty;
    private IReadOnlyList<string> tagValues = [];
    private IReadOnlyList<string> tagSuggestions = [];
    private string description = string.Empty;
    private string text = string.Empty;
    private Dictionary<string, string> fieldValues = new(StringComparer.Ordinal);
    private IReadOnlyList<BusinessObjectDataItem> uploadedItems = [];
    private bool uploadInProgress;
    private IBusinessObjectView? selectedTicketEvent;
    private bool multimintEnabled;
    private int ticketMultimintCount = 5;
    private string recipientMode = RecipientModeOwn;
    private string selectedSubAccountAddress = string.Empty;
    private string selectedAddressBookAddress = string.Empty;
    private string recipientListText = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        string modelKey = $"{Model.ObjectType}:{Model.Name}";
        if (currentModelKey == modelKey)
        {
            await LoadTagSuggestionsAsync();
            return;
        }

        currentModelKey = modelKey;
        currentStep = Math.Clamp(Model.Step, 1, 3);
        BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(Model.ObjectType);
        if (!definition.IsUserMintable)
        {
            definition = BusinessObjectFamilyCatalog.UserMintableFamilies.First();
        }

        selectedObjectType = definition.ObjectType;
        name = Model.Name;
        tagValues = ParseTags(Model.Tags);
        description = Model.Description;
        text = Model.Text;
        fieldValues = new Dictionary<string, string>(
            BusinessObjectPayloadBuilder.NormalizeFields(definition, null),
            StringComparer.Ordinal);
        EnsureFieldKeys();
        selectedTicketEvent = null;
        multimintEnabled = false;
        ticketMultimintCount = 5;
        recipientMode = RecipientModeOwn;
        selectedSubAccountAddress = string.Empty;
        selectedAddressBookAddress = string.Empty;
        recipientListText = string.Empty;
        selectedTokenKey ??= Workspace?.TokenOptions.FirstOrDefault()?.Key ?? EconomyTokenOption.MainKey;
        await LoadTagSuggestionsAsync();
    }

    private IReadOnlyList<BusinessObjectDataItem> DisplayDataItems
        => uploadedItems.Count == 0 ? Model.DataItems : uploadedItems.Concat(Model.DataItems).ToArray();

    private BusinessObjectDataItem? LastUploadedItem
        => uploadedItems.FirstOrDefault() ?? Model.LastUploadedItem;

    private BusinessObjectDataItem? MainDataItem
        => DisplayDataItems.FirstOrDefault(item => item.IsMain) ?? DisplayDataItems.FirstOrDefault();

    private BusinessObjectFamilyDefinition SelectedDefinition
        => BusinessObjectFamilyCatalog.FindOrDefault(selectedObjectType);

    private IReadOnlyList<BusinessObjectDisplayFact> TypedFacts
        => BusinessObjectPayloadBuilder.CreateFacts(SelectedDefinition, fieldValues);

    private IReadOnlyList<FilterOption> ObjectTypeOptions
        => BusinessObjectFamilyCatalog.UserMintableFamilies
            .Select(family => new FilterOption(family.ObjectType, family.DisplayName))
            .ToArray();

    private IReadOnlyList<FilterOption> RecipientModeOptions
        =>
        [
            new(RecipientModeOwn, "Own account"),
            new(RecipientModeSubAccount, "Subaccount"),
            new(RecipientModeAddressBook, "Address book"),
            new(RecipientModeManual, "Recipient list")
        ];

    private IReadOnlyList<FilterOption> SubAccountOptions
        => Workspace?.SubAccounts
            .OrderBy(item => item.Name, StringComparer.Ordinal)
            .Select(item => new FilterOption(item.Address.Value, $"{item.Name} - {ShortAddress(item.Address.Value)}"))
            .ToArray()
            ?? [];

    private IReadOnlyList<FilterOption> AddressBookOptions
        => Workspace?.AddressBookmarks
            .Select(item => new FilterOption(item.Address.Value, $"{item.Name} - {ShortAddress(item.Address.Value)}"))
            .DistinctBy(item => item.Value)
            .ToArray()
            ?? [];

    private EconomyTokenOption? SelectedToken
        => Workspace?.TokenOptions.FirstOrDefault(option => option.Key == selectedTokenKey);

    private bool CanStageSelectedAsset
        => SelectedToken is null || SelectedToken.IsMain || SelectedToken.HasReusableSource;

    private string CreationAssetHint
        => SelectedToken is null || SelectedToken.IsMain
            ? "Main amount only"
            : SelectedToken.HasReusableSource
                ? $"Uses reusable source UTXO automatically ({SelectedToken.SourceAmount} across {SelectedToken.SourceUtxoCount} source UTXO(s))."
                : $"No reusable source UTXO for {SelectedToken.AssetLabel}; unique token cards cannot be reused as sources.";

    private string UploadStorageLabel
        => uploadInProgress
            ? "IPFS uploading"
            : DisplayDataItems.Count == 0
                ? "IPFS required"
                : "IPFS CID";

    private bool IsTicketSelected
        => selectedObjectType.Equals("ticket", StringComparison.OrdinalIgnoreCase);

    private bool IsSubAccountRecipientMode
        => recipientMode.Equals(RecipientModeSubAccount, StringComparison.Ordinal);

    private bool IsAddressBookRecipientMode
        => recipientMode.Equals(RecipientModeAddressBook, StringComparison.Ordinal);

    private bool IsManualRecipientMode
        => recipientMode.Equals(RecipientModeManual, StringComparison.Ordinal);

    private bool ShouldStageTicketBatch
        => IsTicketSelected && multimintEnabled;

    private int ResolvedTicketMultimintCount
        => Math.Clamp(ticketMultimintCount, 1, MaxTicketMultimintCount);

    private string TicketMultimintSummary
    {
        get
        {
            IReadOnlyList<Address> recipients = ResolveTicketMultimintRecipients();
            if (recipients.Count == 0)
            {
                return "No valid recipients selected.";
            }

            Address[] distinctRecipients = recipients.Distinct().ToArray();
            return distinctRecipients.Length == 1
                ? $"{recipients.Count} ticket(s) to {ShortAddress(distinctRecipients[0].Value)}"
                : $"{recipients.Count} ticket(s) to {distinctRecipients.Length} recipient(s)";
        }
    }

    private string TicketEventDisplayName
        => selectedTicketEvent is ITypedBusinessObjectView typed && !string.IsNullOrWhiteSpace(typed.Name)
            ? typed.Name
            : selectedTicketEvent?.ObjectId.Value ?? "No event selected";

    private IReadOnlyList<IBusinessObjectView> AvailableEvents
        => Workspace?.BusinessObjects
            .Where(item => item.ObjectType.Equals("event", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(item => item.CreatedAt)
            .ThenByDescending(item => item.ObjectId.Value, StringComparer.Ordinal)
            .ToArray()
            ?? [];

    private IReadOnlyList<string> Tags
        => tagValues;

    private string TagAccountScope => Workspace?.Address.Value ?? "bo-wizard";

    private string NextButtonText
        => currentStep == 3 ? "Stage BO" : "Next";

    private string NextButtonIcon
        => currentStep == 3 ? "receipt_long" : "arrow_forward";

    private void SetStepIndex(int stepIndex)
    {
        currentStep = Math.Clamp(stepIndex + 1, 1, 3);
    }

    private void PreviousStep()
    {
        currentStep = Math.Max(1, currentStep - 1);
    }

    private void SelectObjectType(string? objectType)
    {
        BusinessObjectFamilyDefinition previous = SelectedDefinition;
        BusinessObjectFamilyDefinition next = BusinessObjectFamilyCatalog.FindOrDefault(objectType);
        if (!next.IsUserMintable)
        {
            next = BusinessObjectFamilyCatalog.UserMintableFamilies.First();
        }

        selectedObjectType = next.ObjectType;
        if (!next.ObjectType.Equals("ticket", StringComparison.OrdinalIgnoreCase))
        {
            selectedTicketEvent = null;
            multimintEnabled = false;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Equals(BusinessObjectPayloadBuilder.DefaultName(previous), StringComparison.Ordinal))
        {
            name = BusinessObjectPayloadBuilder.DefaultName(next);
        }

        if (string.IsNullOrWhiteSpace(description) || description.Equals(previous.Description, StringComparison.Ordinal))
        {
            description = next.Description;
        }

        EnsureFieldKeys();
    }

    private async Task OpenTicketEventPickerAsync()
    {
        object? result = await DialogService.OpenAsync<BusinessObjectEventPickerDialogContent>(
            "Select Event",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectEventPickerDialogContent.Events)] = AvailableEvents,
                [nameof(BusinessObjectEventPickerDialogContent.LookupRequested)] = EventBusinessObjectLookupRequested
            },
            new DialogOptions
            {
                Subtitle = "Load an event BO and prefill ticket details.",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--details cda-event-picker-dialog",
                TestId = "cda-event-picker-dialog"
            }).ConfigureAwait(false);

        if (result is IBusinessObjectView eventObject)
