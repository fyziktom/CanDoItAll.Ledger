    private void SelectObjectType(string? objectType)
    {
        BusinessObjectFamilyDefinition previous = SelectedDefinition;
        BusinessObjectFamilyDefinition next = BusinessObjectFamilyCatalog.FindOrDefault(objectType);
        if (!next.IsUserMintable)
        {
            next = BusinessObjectFamilyCatalog.UserMintableFamilies.First();
        }

        selectedObjectType = next.ObjectType;
        if (!next.ObjectType.Equals("ticket", StringComparison.OrdinalIgnoreCase))
        {
            selectedTicketEvent = null;
            multimintEnabled = false;
        }

        if (string.IsNullOrWhiteSpace(name) || name.Equals(BusinessObjectPayloadBuilder.DefaultName(previous), StringComparison.Ordinal))
        {
            name = BusinessObjectPayloadBuilder.DefaultName(next);
        }

        if (string.IsNullOrWhiteSpace(description) || description.Equals(previous.Description, StringComparison.Ordinal))
        {
            description = next.Description;
        }

        EnsureFieldKeys();
        ApplyCreateDefaults();
    }

