@namespace CanDoItAll.Economy.Components

<section class="cda-venft-gallery" data-testid="bo-gallery">
    <div class="cda-venft-gallery-toolbar">
        <Cluster Gap="LayoutGap.Small">
            <Button Text="My Gallery" Icon="photo_library" ButtonStyle="ButtonStyle.Secondary" />
            <Button Text="New Tab" Icon="open_in_new" Variant="Variant.Outlined" />
        </Cluster>
        <div class="cda-venft-address">Address: @AddressLine</div>
        <TextBox @bind-Value="search" Immediate="true" Placeholder="Search..." aria-label="Search gallery" />
        <div class="cda-venft-tag-row">
            @foreach (string tag in FeaturedTags)
            {
                <button type="button" @onclick="@(() => ApplyTag(tag))">#@tag</button>
            }
        </div>
    </div>

    <div class="cda-venft-card-grid">
        @foreach (BusinessObjectGalleryItem item in FilteredItems)
        {
            <article class="cda-venft-card" style="--accent:@item.Accent">
                <button type="button" class="cda-venft-card-image" @onclick="@(() => OpenDetails(item))">
                    <img src="@item.PreviewUrl" alt="@item.Object.Name" />
                </button>
                <div class="cda-venft-card-body">
                    <h2>@item.Object.Name</h2>
                    <p>@item.Object.Description</p>
                    <div class="cda-venft-badges">
                        <span>BO</span>
                        <span>@item.Object.ObjectType</span>
                        @if (item.Object.DataItems.Count > 1)
                        {
                            <span>Gallery</span>
                        }
                    </div>
                    <div class="cda-venft-card-tags">
                        @foreach (string tag in item.Object.Tags.Take(8))
                        {
                            <span>#@tag</span>
                        }
                    </div>
                </div>
                <button type="button" class="cda-venft-info-button" @onclick="@(() => OpenDetails(item))" aria-label="Open BO details">
                    <span class="material-icons">info</span>
                </button>
            </article>
        }
    </div>
</section>

<BusinessObjectDetailsDialog Item="selectedItem"
                             IsOpen="@detailsOpen"
                             OnClose="@CloseDetails" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<BusinessObjectGalleryItem> Items { get; set; } = default!;

    private string search = string.Empty;
    private BusinessObjectGalleryItem? selectedItem;
    private bool detailsOpen;

    private string AddressLine
        => Items.FirstOrDefault()?.Object.OwnerAddress.Value ?? "account";

    private IReadOnlyList<string> FeaturedTags
        => Items.SelectMany(item => item.Object.Tags)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(6)
            .ToArray();

    private IEnumerable<BusinessObjectGalleryItem> FilteredItems
        => string.IsNullOrWhiteSpace(search)
            ? Items
            : Items.Where(item => Matches(item, search));

    private static bool Matches(BusinessObjectGalleryItem item, string searchText)
    {
        string probe = $"{item.Object.Name} {item.Object.Description} {item.Object.ObjectType} {string.Join(' ', item.Object.Tags)}";
        return probe.Contains(searchText, StringComparison.OrdinalIgnoreCase);
    }

    private void ApplyTag(string tag)
    {
        search = tag;
    }

    private void OpenDetails(BusinessObjectGalleryItem item)
    {
        selectedItem = item;
        detailsOpen = true;
    }

    private Task CloseDetails()
    {
        detailsOpen = false;
        return Task.CompletedTask;
    }
}
