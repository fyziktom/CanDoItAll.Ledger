@namespace CanDoItAll.Economy.Components
@using System.Globalization
@inject DialogService DialogService
@inject NotificationService Notifications

<SectionCard Title="Set Price" Description="@Object?.ObjectId.Value">
    <Stack GapScale="LayoutGap.Medium">
        <AvailableTokenSelector Options="TokenOptions"
                                SelectedKey="@selectedTokenKey"
                                SelectedKeyChanged="@(key => selectedTokenKey = key)"
                                Label="Price asset"
                                DataTestId="bo-price-token-selector" />

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
            <FormField Text="Price amount" ContainerClass="cda-economy-field">
                <TextBox Value="@priceAmount"
                         ValueChanged="@(value => priceAmount = value ?? string.Empty)"
                         Immediate="true"
                         Placeholder="100"
                         aria-label="Price amount" />
            </FormField>
            <div class="cda-economy-fact">
                <span>Transaction</span>
                <strong>self-send price update</strong>
            </div>
        </Grid>

        <Cluster Gap="LayoutGap.Small">
            <Button Text="Set Price" Icon="attach_money" Click="SubmitAsync" />
            <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="CancelAsync" />
        </Cluster>
    </Stack>
</SectionCard>

@code {
    private string priceAmount = "100";
    private string? selectedTokenKey = EconomyTokenOption.MainKey;

    [Parameter]
    public IBusinessObjectView? Object { get; set; }

    [Parameter]
    public IReadOnlyList<EconomyTokenOption> TokenOptions { get; set; } = [];

    [Parameter]
    public EventCallback<BusinessObjectPriceRequest> SubmitRequested { get; set; }

    protected override void OnParametersSet()
    {
        selectedTokenKey ??= TokenOptions.FirstOrDefault()?.Key ?? EconomyTokenOption.MainKey;
    }

    private async Task SubmitAsync()
    {
        if (Object is null)
        {
            Notifications.Error("Cannot set price", "No BusinessObject is selected.", position: NotificationPosition.BottomCenter);
            return;
        }

        if (!decimal.TryParse(priceAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsed) || parsed <= 0m)
        {
            Notifications.Warning("Price required", "Enter a positive price amount.", position: NotificationPosition.BottomCenter);
            return;
        }

        TokenId? tokenId = TokenOptions.FirstOrDefault(option => option.Key == selectedTokenKey)?.TokenId;
        var request = new BusinessObjectPriceRequest(
            Object.ObjectId,
            new Amount(parsed),
            tokenId,
            Object.StateJson ?? "{}");

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private Task CancelAsync() => DialogService.CloseAsync();
}
