@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-bo-state-viewer">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Business object state</span>
            <h2>@(Object?.ObjectId.Value ?? "No object")</h2>
        </div>
        @if (Object is not null)
        {
            <StatusBadge Text="@($"v{Object.Version}")" Tone="info" />
        }
    </header>

    @if (Object is null)
    {
        <p class="cda-sdk-muted">Select a business object to inspect state.</p>
    }
    else
    {
        <div class="cda-sdk-fact-grid">
            <div><span>Type</span><strong>@Object.ObjectType</strong></div>
            <div><span>Schema</span><strong>@Object.SchemaVersion</strong></div>
            <div><span>Operation</span><strong>@Object.Operation</strong></div>
            <div><span>Owner</span><strong><CopyableMonoValue Value="@Object.OwnerAddress.Value" StartChars="10" EndChars="6" AriaLabel="Copy owner address" /></strong></div>
            <div><span>OutPoint</span><strong><CopyableMonoValue Value="@Object.CurrentOutPoint.ToString()" StartChars="10" EndChars="6" AriaLabel="Copy object outpoint" /></strong></div>
            <div><span>Created</span><strong>@Object.CreatedAt.ToString("MM.dd HH:mm")</strong></div>
        </div>
        <div class="cda-sdk-hash-block">
            <span>Data hash</span>
            <HashDisplay Value="@Object.DataHash.Value" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Object.StateJson))
        {
            <pre class="cda-sdk-code">@Object.StateJson</pre>
        }
    }
</section>

@code {
    [Parameter]
    public IBusinessObjectView? Object { get; set; }
}
