@namespace CanDoItAll.Economy.Components

<DialogScaffold Eyebrow="Dialog system"
                Title="Composable ledger mutation dialog"
                Description="Header, context rail, work surface, review panel, validation, and sticky footer are provided by BaseLib."
                ContextRail="@RenderContext"
                ReviewPanel="@RenderReview"
                ValidationContent="@RenderValidation"
                Footer="@RenderFooter"
                data-testid="cda-sdk-dialog-system">
    <Stack GapScale="LayoutGap.Medium">
        <Grid ColumnsMd="2" Gap="LayoutGap.Medium">
            <FormField Text="Destination">
                <TextBox @bind-Value="destination" Placeholder="Address or bookmark" />
            </FormField>
            <FormField Text="Amount">
                <TextBox @bind-Value="amount" Placeholder="125.00" />
            </FormField>
        </Grid>
        <FormField Text="Memo">
            <TextArea @bind-Value="memo" Rows="4" />
        </FormField>
    </Stack>
</DialogScaffold>

@code {
    private string destination = "Operations approval";
    private string amount = "250";
    private string memo = "Two-step approval transfer";

    private RenderFragment RenderContext => builder =>
    {
        builder.OpenComponent<StatusCheckList>(0);
        builder.AddAttribute(1, nameof(StatusCheckList.Title), "Context");
        builder.AddAttribute(2, nameof(StatusCheckList.Items), new[]
        {
            new StatusCheckItem { Label = "Account selected", Status = "Ready", Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Source UTXO", Status = "Ready", Tone = "success", Complete = true },
            new StatusCheckItem { Label = "Node session", Status = "Guarded", Tone = "warning" }
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderReview => builder =>
    {
        builder.OpenComponent<ActionReviewPanel>(0);
        builder.AddAttribute(1, nameof(ActionReviewPanel.Title), "Review before signing");
        builder.AddAttribute(2, nameof(ActionReviewPanel.Description), "The user can inspect sources, receiver, and impact before the signing boundary.");
        builder.AddAttribute(3, nameof(ActionReviewPanel.Items), new[]
        {
            new ActionReviewFact("Destination", destination),
            new ActionReviewFact("Amount", amount),
            new ActionReviewFact("Memo", memo)
        });
        builder.CloseComponent();
    };

    private RenderFragment RenderValidation => builder =>
    {
        builder.OpenComponent<Alert>(0);
        builder.AddAttribute(1, nameof(Alert.AlertStyle), AlertStyle.Info);
        builder.AddAttribute(2, nameof(Alert.ChildContent), (RenderFragment)(content =>
        {
            content.AddMarkupContent(0, "<strong>Signing guard</strong><span>Unsupported modes stay visible but disabled with a reason.</span>");
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderFooter => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddAttribute(1, nameof(Button.Text), "Save draft");
        builder.AddAttribute(2, nameof(Button.Icon), "save");
        builder.AddAttribute(3, nameof(Button.Variant), Variant.Outlined);
        builder.CloseComponent();
        builder.OpenComponent<Button>(4);
        builder.AddAttribute(5, nameof(Button.Text), "Review transaction");
        builder.AddAttribute(6, nameof(Button.Icon), "fact_check");
        builder.CloseComponent();
    };
}
