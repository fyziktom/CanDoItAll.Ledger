@namespace CanDoItAll.Economy.Components

<div data-testid="cda-tx-data-payload-viewer">
<SectionCard Title="@(Data?.ItemType.ToString() ?? "No data item")" Description="Payload">
    <HeaderActions>
        <StatusBadge Text="@(Data?.ContentType ?? "none")" Tone="neutral" />
    </HeaderActions>
    <ChildContent>
        @if (Data is null)
        {
            <EmptyState Eyebrow="Payload" Title="No data item" Description="No transaction payload is attached." />
        }
        else
        {
            <Grid ColumnsLg="2" Gap="LayoutGap.Small">
                <SurfaceCard Soft="true">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="External ref" />
                        <CopyableMonoValue Value="@Data.ExternalRef" EmptyText="none" StartChars="18" EndChars="10" AriaLabel="Copy external reference" />
                    </Stack>
                </SurfaceCard>
                <SurfaceCard Soft="true">
                    <Stack GapScale="LayoutGap.Tiny">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Hash" />
                        <HashDisplay Value="@(Data.DataHash?.Value)" EmptyText="none" />
                    </Stack>
                </SurfaceCard>
            </Grid>
            @if (!string.IsNullOrWhiteSpace(Data.InlineJson))
            {
                <pre class="cda-sdk-code" data-testid="tx-payload-inline-json">@TransactionRawJsonFormatter.FormatInlineJson(Data.InlineJson)</pre>
            }
        }
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter]
    public TransactionData? Data { get; set; }
}
