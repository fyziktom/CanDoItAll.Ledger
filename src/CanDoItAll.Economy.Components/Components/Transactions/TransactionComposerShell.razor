@using System.Globalization
@namespace CanDoItAll.Economy.Components

<SectionCard Title="@ComposerTitle" Description="@ComposerDescription">
    <Stack GapScale="LayoutGap.Large">
        <SecondaryTabs Items="ModeItems"
                       SelectedKey="@selectedModeKey"
                       SelectedKeyChanged="SelectModeAsync"
                       Dense="true" />

        <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-economy-tab-panel">
            @switch (SelectedMode)
            {
                case BusinessObjectTransactionMode.Create:
                    @RenderObjectId("Object id", "Create object id")
                    @RenderText("Object type", ActiveDraft.ObjectType, SetObjectTypeAsync, "purchase-order")
                    @RenderText("Schema version", ActiveDraft.SchemaVersion, SetSchemaVersionAsync, "1.0")
                    @RenderAddress("Owner address", ActiveDraft.OwnerAddress.Value, SetOwnerAddressAsync, "acct:operations:primary")
                    @RenderAmount("Main amount", ActiveDraft.MainAmount, SetMainAmountAsync, "100")
                    <div class="cda-economy-field cda-economy-field--wide">
                        <AvailableTokenSelector Options="TokenOptions"
                                                SelectedKey="@CreateAssetKey"
                                                SelectedKeyChanged="SetCreateAssetKeyAsync"
                                                Label="Asset to attach"
                                                DataTestId="composer-create-token-selector" />
                    </div>
                    @if (CreateAssetKey != EconomyTokenOption.MainKey)
                    {
                        @RenderNullableAmount("Token amount", ActiveDraft.TokenAmount, SetTokenAmountAsync, "1")
                    }
                    @RenderText("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "erp://purchase-orders/1043")
                    @RenderStateJson("State JSON", "Create state JSON", 7)
                    break;

                case BusinessObjectTransactionMode.TransferObject:
                    @RenderObjectId("Object id", "Transfer object id")
                    @RenderAddress("Receiver address", ActiveDraft.ReceiverAddress.Value, SetReceiverAddressAsync, "acct:operations:approval")
                    @RenderAmount("Main amount", ActiveDraft.MainAmount, SetMainAmountAsync, "25")
                    @RenderText("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "ledger://transfer")
                    @RenderStateJson("State after transfer", "Transfer state JSON", 6)
                    break;

                case BusinessObjectTransactionMode.UpdateObject:
                    @RenderObjectId("Object id", "Update object id")
                    @RenderText("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "erp://purchase-orders/1043")
                    @RenderStateJson("Next state JSON", "Update state JSON", 8)
                    break;

                case BusinessObjectTransactionMode.CloseObject:
                    @RenderObjectId("Object id", "Close object id")
                    @RenderText("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "erp://purchase-orders/1043")
                    @RenderStateJson("Closing state JSON", "Close state JSON", 7)
                    break;

                case BusinessObjectTransactionMode.CloneObject:
                    @RenderOptionalObjectId("Source object id", ActiveDraft.SourceObjectId, SetSourceObjectIdAsync, "bo:purchase-order:1042")
                    @RenderOptionalObjectId("Target object id", ActiveDraft.TargetObjectId, SetTargetObjectIdAsync, "bo:purchase-order:1043-copy")
                    @RenderText("Object type", ActiveDraft.ObjectType, SetObjectTypeAsync, "purchase-order")
                    @RenderText("Schema version", ActiveDraft.SchemaVersion, SetSchemaVersionAsync, "1.0")
                    @RenderStateJson("Cloned state JSON", "Clone state JSON", 7)
                    break;

                case BusinessObjectTransactionMode.MergeObjects:
                    @RenderOptionalObjectId("First source object id", ActiveDraft.SourceObjectId, SetSourceObjectIdAsync, "bo:purchase-order:1042")
                    @RenderOptionalObjectId("Second source object id", ActiveDraft.SecondObjectId, SetSecondObjectIdAsync, "bo:purchase-order:1043")
                    @RenderOptionalObjectId("Target object id", ActiveDraft.TargetObjectId, SetTargetObjectIdAsync, "bo:purchase-order:merged")
                    @RenderText("External reference", ActiveDraft.ExternalRef, SetExternalRefAsync, "erp://purchase-orders/merged")
                    @RenderStateJson("Merged state JSON", "Merge state JSON", 7)
                    break;

                case BusinessObjectTransactionMode.SplitBusinessObjectPayment:
                    @RenderObjectId("Object id", "Split payment object id")
                    @RenderAddress("First receiver", ActiveDraft.PaymentReceiverAddress.Value, SetPaymentReceiverAddressAsync, "acct:supplier:acme")
                    @RenderAmount("First amount", ActiveDraft.PaymentAmount, SetPaymentAmountAsync, "250")
                    @RenderAddress("Second receiver", ActiveDraft.ReceiverAddress.Value, SetReceiverAddressAsync, "acct:operations:approval")
                    @RenderNullableAmount("Second amount", ActiveDraft.SecondaryPaymentAmount, SetSecondaryPaymentAmountAsync, "125")
                    @RenderStateJson("State after payment", "Split payment state JSON", 6)
                    break;

                case BusinessObjectTransactionMode.MainPayment:
                    @RenderAddress("Payment receiver", ActiveDraft.PaymentReceiverAddress.Value, SetPaymentReceiverAddressAsync, "acct:supplier:acme")
                    @RenderAmount("Payment amount", ActiveDraft.PaymentAmount, SetPaymentAmountAsync, "250")
                    @RenderText("Memo", ActiveDraft.ExternalRef, SetExternalRefAsync, "operations payment")
                    break;

                case BusinessObjectTransactionMode.TokenTransfer:
                    <div class="cda-economy-field cda-economy-field--wide">
                        <AvailableTokenSelector Options="TransferTokenOptions"
                                                SelectedKey="@SelectedTokenKey"
                                                SelectedKeyChanged="SetSelectedTokenKeyAsync"
                                                Label="Token to send"
                                                DataTestId="composer-token-selector" />
                    </div>
                    @RenderNullableAmount("Token amount", ActiveDraft.TokenAmount, SetTokenAmountAsync, "25")
                    @RenderAddress("Payment receiver", ActiveDraft.PaymentReceiverAddress.Value, SetPaymentReceiverAddressAsync, "acct:supplier:acme")
                    @RenderAmount("Main amount", ActiveDraft.MainAmount, SetMainAmountAsync, "1")
                    break;
            }
        </Grid>

        <Grid ColumnsLg="3" Gap="LayoutGap.Small">
            <div class="cda-economy-fact">
                <span>Mode</span>
                <strong>@ModeLabel</strong>
            </div>
            <div class="cda-economy-fact">
                <span>Receiver</span>
                <strong>@PreviewReceiver</strong>
            </div>
            <div class="cda-economy-fact">
                <span>Amount</span>
                <strong>@PreviewAmount</strong>
            </div>
        </Grid>

        <Cluster Gap="LayoutGap.Small">
            <Button Text="Submit transaction" Icon="send" Click="SubmitAsync" />
            <Button Text="Assemble" Icon="build" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="AssembleRequested" />
            <Button Text="Refresh after broadcast" Icon="refresh" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Text" Click="BroadcastRequested" />
        </Cluster>
    </Stack>
</SectionCard>

@code {
    private static readonly IReadOnlyList<SecondaryTabItem> ModeItems =
    [
        new(nameof(BusinessObjectTransactionMode.Create), "Create", Description: "Create a business object UTXO with owner, schema, and state."),
        new(nameof(BusinessObjectTransactionMode.TransferObject), "Transfer", Description: "Move a business object to another account while carrying updated state."),
        new(nameof(BusinessObjectTransactionMode.UpdateObject), "Update", Description: "Write a new state version for a held business object."),
        new(nameof(BusinessObjectTransactionMode.CloseObject), "Close", Description: "Close a business object and record the final state."),
        new(nameof(BusinessObjectTransactionMode.CloneObject), "Clone", Description: "Create a new object from an existing source object."),
        new(nameof(BusinessObjectTransactionMode.MergeObjects), "Merge", Description: "Combine two source objects into a target object."),
        new(nameof(BusinessObjectTransactionMode.SplitBusinessObjectPayment), "Split pay", Description: "Pay multiple receivers out of a business object holding."),
        new(nameof(BusinessObjectTransactionMode.MainPayment), "Payment", Description: "Send a plain main-currency payment from the account."),
        new(nameof(BusinessObjectTransactionMode.TokenTransfer), "Token", Description: "Transfer a token balance with the required main amount.")
    ];

    private BusinessObjectTransactionDraft? localDraft;
    private string selectedModeKey = nameof(BusinessObjectTransactionMode.Create);

    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> SubmitRequested { get; set; }

    [Parameter]
    public EventCallback AssembleRequested { get; set; }

    [Parameter]
    public EventCallback BroadcastRequested { get; set; }

    [Parameter]
    public bool Dense { get; set; }

    [Parameter]
    public IReadOnlyList<EconomyTokenOption> TokenOptions { get; set; } = [];

    private BusinessObjectTransactionDraft ActiveDraft => localDraft ?? Draft;

    private string? ComposerTitle => Dense ? null : "Transaction composer";

    private string? ComposerDescription
        => Dense ? null : "Compose and submit the ledger operations covered by the SDK account client";

    private BusinessObjectTransactionMode SelectedMode
        => Enum.TryParse<BusinessObjectTransactionMode>(selectedModeKey, out var mode)
            ? mode
            : BusinessObjectTransactionMode.Create;

    private string ModeLabel => ModeItems.First(item => item.Key == selectedModeKey).Label;

    private string PreviewReceiver
        => SelectedMode switch
        {
            BusinessObjectTransactionMode.Create => ActiveDraft.OwnerAddress.Value,
            BusinessObjectTransactionMode.MainPayment => ActiveDraft.PaymentReceiverAddress.Value,
            BusinessObjectTransactionMode.TokenTransfer => ActiveDraft.PaymentReceiverAddress.Value,
            BusinessObjectTransactionMode.SplitBusinessObjectPayment => $"{ActiveDraft.PaymentReceiverAddress.Value}, {ActiveDraft.ReceiverAddress.Value}",
            _ => ActiveDraft.ReceiverAddress.Value
        };

    private string PreviewAmount
        => SelectedMode switch
        {
            BusinessObjectTransactionMode.MainPayment => ActiveDraft.PaymentAmount.ToString(),
            BusinessObjectTransactionMode.TokenTransfer => $"{ActiveDraft.TokenAmount?.ToString() ?? "0"} {ActiveDraft.TokenId?.Value ?? "token"}",
            BusinessObjectTransactionMode.SplitBusinessObjectPayment => $"{ActiveDraft.PaymentAmount} + {ActiveDraft.SecondaryPaymentAmount?.ToString() ?? "0"}",
            _ => ActiveDraft.MainAmount.ToString()
        };

    private string? SelectedTokenKey
        => ActiveDraft.TokenId?.Value
            ?? TransferTokenOptions.FirstOrDefault()?.Key;

    private string? CreateAssetKey
        => ActiveDraft.TokenId?.Value ?? EconomyTokenOption.MainKey;

    private IReadOnlyList<EconomyTokenOption> TransferTokenOptions
        => TokenOptions.Where(option => !option.IsMain).ToArray();

    protected override void OnParametersSet()
    {
        localDraft = Draft;
        selectedModeKey = Draft.SelectedMode.ToString();
    }

    private async Task SelectModeAsync(string key)
    {
        selectedModeKey = key;
        await UpdateDraftAsync(ActiveDraft with { SelectedMode = SelectedMode });
    }

    private Task SubmitAsync()
        => SubmitRequested.InvokeAsync(ActiveDraft with { SelectedMode = SelectedMode });

    private Task SetObjectIdAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ObjectId = new BusinessObjectId(value ?? string.Empty) });

    private Task SetSourceObjectIdAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { SourceObjectId = ToNullableObjectId(value) });

    private Task SetSecondObjectIdAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { SecondObjectId = ToNullableObjectId(value) });

    private Task SetTargetObjectIdAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { TargetObjectId = ToNullableObjectId(value) });

    private Task SetObjectTypeAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ObjectType = value ?? string.Empty });

    private Task SetSchemaVersionAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { SchemaVersion = value ?? string.Empty });

    private Task SetOwnerAddressAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { OwnerAddress = new Address(value ?? string.Empty) });

    private Task SetReceiverAddressAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetPaymentReceiverAddressAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { PaymentReceiverAddress = new Address(value ?? string.Empty) });

    private Task SetMainAmountAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { MainAmount = ParseAmount(value) });

    private Task SetPaymentAmountAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { PaymentAmount = ParseAmount(value) });

    private Task SetTokenIdAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { TokenId = ToNullableTokenId(value) });

    private Task SetSelectedTokenKeyAsync(string? value)
    {
        EconomyTokenOption? selected = TransferTokenOptions.FirstOrDefault(option => option.Key == value);
        return UpdateDraftAsync(ActiveDraft with { TokenId = selected?.TokenId ?? ToNullableTokenId(value) });
    }

    private Task SetCreateAssetKeyAsync(string? value)
    {
        EconomyTokenOption? selected = TokenOptions.FirstOrDefault(option => option.Key == value);
        return UpdateDraftAsync(ActiveDraft with
        {
            TokenId = selected?.IsMain == true ? null : selected?.TokenId ?? ToNullableTokenId(value),
            TokenAmount = selected?.IsMain == true ? null : ActiveDraft.TokenAmount ?? Amount.FromInt64(1)
        });
    }

    private Task SetTokenAmountAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { TokenAmount = ParseNullableAmount(value) });

    private Task SetSecondaryPaymentAmountAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { SecondaryPaymentAmount = ParseNullableAmount(value) });

    private Task SetStateJsonAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { StateJson = value ?? string.Empty });

    private Task SetExternalRefAsync(string? value)
        => UpdateDraftAsync(ActiveDraft with { ExternalRef = value ?? string.Empty });

    private async Task UpdateDraftAsync(BusinessObjectTransactionDraft nextDraft)
    {
        localDraft = nextDraft;
        await DraftChanged.InvokeAsync(nextDraft);
    }

    private RenderFragment RenderObjectId(string label, string ariaLabel)
        => RenderText(label, ActiveDraft.ObjectId.Value, SetObjectIdAsync, "bo:purchase-order:1043", ariaLabel);

    private RenderFragment RenderOptionalObjectId(
        string label,
        BusinessObjectId? value,
        Func<string?, Task> changed,
        string placeholder)
        => RenderText(label, value?.Value ?? string.Empty, changed, placeholder);

    private RenderFragment RenderToken(string label, TokenId? value, Func<string?, Task> changed, string placeholder)
        => RenderText(label, value?.Value ?? string.Empty, changed, placeholder);

    private RenderFragment RenderAddress(
        string label,
        string value,
        Func<string?, Task> changed,
        string placeholder)
        => RenderText(label, value, changed, placeholder);

    private RenderFragment RenderAmount(
        string label,
        Amount value,
        Func<string?, Task> changed,
        string placeholder)
        => RenderText(label, value.ToString(), changed, placeholder);

    private RenderFragment RenderNullableAmount(
        string label,
        Amount? value,
        Func<string?, Task> changed,
        string placeholder)
        => RenderText(label, value?.ToString() ?? string.Empty, changed, placeholder);

    private RenderFragment RenderText(
        string label,
        string? value,
        Func<string?, Task> changed,
        string placeholder,
        string? ariaLabel = null)
        => @<FormField Text="@label" ContainerClass="cda-economy-field">
            <TextBox Value="@value"
                     ValueChanged="@(EventCallback.Factory.Create<string?>(this, changed))"
                     Immediate="true"
                     Placeholder="@placeholder"
                     aria-label="@(ariaLabel ?? label)" />
        </FormField>;

    private RenderFragment RenderStateJson(string label, string ariaLabel, int rows)
        => @<FormField Text="@label" ContainerClass="cda-economy-field cda-economy-field--wide">
            <TextArea Value="@ActiveDraft.StateJson"
                      ValueChanged="@(EventCallback.Factory.Create<string?>(this, SetStateJsonAsync))"
                      Immediate="true"
                      Rows="@(Dense ? Math.Min(rows, 4) : rows)"
                      aria-label="@ariaLabel" />
        </FormField>;

    private static BusinessObjectId? ToNullableObjectId(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : new BusinessObjectId(value.Trim());

    private static TokenId? ToNullableTokenId(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : new TokenId(value.Trim());

    private static Amount ParseAmount(string? value)
        => decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsed) && parsed >= 0m
            ? new Amount(parsed)
            : Amount.Zero;

    private static Amount? ParseNullableAmount(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : ParseAmount(value);
}
