@namespace CanDoItAll.Economy.Components

<article class="@CardClass" data-testid="@TestId">
    <button type="button"
            class="cda-transaction-bo-picker-card__select"
            @onclick="SelectedChanged"
            disabled="@(!Interactive)"
            aria-pressed="@(Selected ? "true" : "false")"
            aria-describedby="@RestrictionId"
            title="@DisabledReason"
            aria-label="@SelectionLabel">
        @if (PreviewImage is not null)
        {
            <span class="cda-transaction-bo-picker-card__preview cda-transaction-bo-picker-card__preview--media">
                <BusinessObjectDataItemPreview Item="PreviewImage" />
            </span>
        }
        else
        {
            <span class="@PreviewClass">
                <span class="material-icons" aria-hidden="true">@BusinessObjectCardDisplay.PreviewIcon(Item)</span>
            </span>
        }

        <span class="cda-transaction-bo-picker-card__body">
            <span class="cda-transaction-bo-picker-card__heading">
                <strong>@DisplayTitle</strong>
                <span class="material-icons" aria-hidden="true">@SelectionIcon</span>
            </span>
            <span class="cda-transaction-bo-picker-card__description">@Summary</span>
            @if (!string.IsNullOrWhiteSpace(DisabledReason))
            {
                <span id="@RestrictionId" class="cda-transaction-bo-picker-card__restriction">@DisabledReason</span>
            }
            <span class="cda-transaction-bo-picker-card__meta">
                <span>@Item.ObjectType</span>
                <span>@($"v{Item.Version}")</span>
                <span>@Item.Operation</span>
            </span>
            @if (Tags.Count > 0)
            {
                <span class="cda-transaction-bo-picker-card__tags">
                    @foreach (string tag in Tags.Take(3))
                    {
                        <span>#@tag</span>
                    }
                </span>
            }
        </span>
    </button>
</article>

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Item { get; set; } = default!;

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback SelectedChanged { get; set; }

    [Parameter]
    public bool Interactive { get; set; } = true;

    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private string CardClass
        => CssClassBuilder.Join(
            "cda-transaction-bo-picker-card",
            Selected ? "is-selected" : null,
            Interactive ? null : "is-readonly",
            string.IsNullOrWhiteSpace(DisabledReason) ? null : "is-incompatible");

    private string SelectionIcon
        => !string.IsNullOrWhiteSpace(DisabledReason)
            ? "block"
            : Selected ? "check_circle" : "radio_button_unchecked";

    private string SelectionLabel => $"{(Selected ? "Deselect" : "Select")} {DisplayTitle}";

    private string? RestrictionId
        => string.IsNullOrWhiteSpace(DisabledReason)
            ? null
            : $"bo-card-restriction-{SafeId(Item.ObjectId.Value)}";

    private string PreviewClass
        => BusinessObjectCardDisplay.PreviewClass(Item)
            .Replace("cda-vef-gallery-preview", "cda-transaction-bo-picker-card__preview", StringComparison.Ordinal);

    private BusinessObjectDataItem? PreviewImage
        => BusinessObjectCardDisplay.ImageFor(Item);

    private IReadOnlyList<string> Tags
        => BusinessObjectCardDisplay.TagsFor(Item);

    private string DisplayTitle
        => string.IsNullOrWhiteSpace(Item.ObjectId.Value)
            ? "Unnamed business object"
            : BusinessObjectCardDisplay.DisplayName(Item);

    private string Summary => BusinessObjectCardDisplay.Description(Item);

    private static string SafeId(string value)
        => new(value.Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray());
}
