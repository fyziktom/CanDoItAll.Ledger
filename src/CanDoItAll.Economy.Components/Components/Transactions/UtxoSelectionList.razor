@namespace CanDoItAll.Economy.Components

<section class="cda-utxo-selector cda-economy-field--wide" data-testid="@TestId">
    <div class="cda-utxo-selector__summary">
        <div>
            <span>@Label</span>
            <strong>@SelectedCount selected</strong>
            <small>@EligibleOutputs.Count matching of @AllEligibleOutputs.Count eligible plain UTXO(s)</small>
        </div>
        <Cluster Gap="LayoutGap.XSmall">
            <StatusBadge Text="@($"{SelectedTotal} selected")" Tone="info" />
            <StatusBadge Text="@($"{AllEligibleTotal} available")" Tone="neutral" />
        </Cluster>
    </div>

    <FormField Text="Search UTXOs" ContainerClass="cda-economy-field cda-economy-field--wide cda-utxo-selector__search">
        <TextBox Value="@filter"
                 ValueChanged="@(EventCallback.Factory.Create<string?>(this, value => filter = value ?? string.Empty))"
                 Immediate="true"
                 Placeholder="Transaction ID, outpoint, address, or amount"
                 aria-label="Search UTXOs"
                 data-testid="@($"{TestId}-filter")" />
    </FormField>

    @if (EligibleOutputs.Count == 0)
    {
        <EmptyState Eyebrow="UTXO" Title="No eligible UTXOs" Description="Only plain main-currency outputs without token or BO references can be selected." />
    }
    else
    {
        <div class="cda-sdk-list cda-utxo-selector__list">
            @foreach (LedgerSpendableOutput output in EligibleOutputs)
            {
                bool selected = IsSelected(output.OutPoint);
                <article class="cda-sdk-list__row cda-utxo-selector__row @(selected ? "cda-sdk-list__row--selected" : null)"
                         data-testid="@($"{TestId}-row")">
                    <CheckBox TValue="bool"
                              Value="@selected"
                              ValueChanged="@((bool value) => ToggleAsync(output.OutPoint, value))"
                              aria-label="@($"Select UTXO {output.OutPoint}")" />
                    <span class="material-icons" aria-hidden="true">receipt_long</span>
                    <div>
                        <strong>@output.OutPoint</strong>
                        <span>@output.MainAmount main</span>
                        <small>@Short(output.Address.Value)</small>
                    </div>
                    <CopyableMonoValue Value="@output.OutPointKey.Value.Value" />
                </article>
            }
        </div>
    }
</section>

@code {
    private string filter = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Selected inputs";

    [Parameter]
    public IReadOnlyList<LedgerSpendableOutput> Outputs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<OutPoint> SelectedOutPoints { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<OutPoint>> SelectedOutPointsChanged { get; set; }

    [Parameter]
    public string TestId { get; set; } = "cda-utxo-selector";

    private IReadOnlyList<LedgerSpendableOutput> AllEligibleOutputs
        => Outputs
            .Where(output => output.BusinessObject is null && output.Token is null)
            .OrderBy(output => output.CreatedAt)
            .ThenBy(output => output.OutPoint.TxId.Value, StringComparer.Ordinal)
            .ThenBy(output => output.OutPoint.OutputIndex)
            .ToArray();

    private IReadOnlyList<LedgerSpendableOutput> EligibleOutputs
        => AllEligibleOutputs.Where(MatchesFilter).ToArray();

    private decimal AllEligibleTotal
        => AllEligibleOutputs.Sum(output => output.MainAmount.Value);

    private decimal SelectedTotal
        => AllEligibleOutputs
            .Where(output => IsSelected(output.OutPoint))
            .Sum(output => output.MainAmount.Value);

    private int SelectedCount
        => AllEligibleOutputs.Count(output => IsSelected(output.OutPoint));

    private bool MatchesFilter(LedgerSpendableOutput output)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        string probe = $"{output.OutPoint} {output.OutPoint.TxId.Value} {output.OutPoint.OutputIndex} {output.Address.Value} {output.MainAmount}";
        return probe.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsSelected(OutPoint outPoint)
        => SelectedOutPoints.Contains(outPoint);

    private async Task ToggleAsync(OutPoint outPoint, bool selected)
    {
        var next = SelectedOutPoints
            .Where(IsEligible)
            .Distinct()
            .ToList();
        if (selected)
        {
            if (!next.Contains(outPoint))
            {
                next.Add(outPoint);
            }
        }
        else
        {
            next.RemoveAll(item => item == outPoint);
        }

        await SelectedOutPointsChanged.InvokeAsync(next);
    }

    private bool IsEligible(OutPoint outPoint)
        => AllEligibleOutputs.Any(output => output.OutPoint == outPoint);

    private static string Short(string value)
        => value.Length > 18 ? $"{value[..10]}...{value[^6..]}" : value;
}
