@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel cda-sdk-panel--compact" data-testid="cda-tx-signature-card">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Input #@Input.InputIndex</span>
            <h2>Signatures</h2>
        </div>
        <StatusBadge Text="@($"{Input.SignatureBundle.Signatures.Count} recorded")" Tone="info" />
    </header>

    @if (Input.SignatureBundle.Signatures.Count == 0)
    {
        <p class="cda-sdk-muted">No input signatures were recorded.</p>
    }
    else
    {
        <div class="cda-sdk-list">
            @foreach (SignatureEnvelope signature in Input.SignatureBundle.Signatures)
            {
                <article class="cda-sdk-list__row">
                    <span class="material-icons" aria-hidden="true">key</span>
                    <div>
                        <strong>@signature.Algorithm</strong>
                        <span>@signature.KeyId</span>
                        <small>@signature.SignatureBytes.Length signature bytes</small>
                        <HashDisplay Value="@signature.PublicKeyHash.Value" />
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public EconomyTransactionInputDetails Input { get; set; } = default!;
}
