@namespace CanDoItAll.Economy.Components

<div data-testid="cda-tx-signature-card">
    <TransactionSignatureList Inputs="@SingleInput"
                              Description="@($"Input #{Input.InputIndex}")"
                              TestId="@($"cda-tx-signature-list-{Input.InputIndex}")" />
</div>

@code {
    [Parameter, EditorRequired]
    public EconomyTransactionInputDetails Input { get; set; } = default!;

    private IReadOnlyList<EconomyTransactionInputDetails> SingleInput
        => [Input];
}
