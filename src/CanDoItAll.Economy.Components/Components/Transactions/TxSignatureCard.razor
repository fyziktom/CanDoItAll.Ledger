@namespace CanDoItAll.Economy.Components

<div data-testid="cda-tx-signature-card">
<SectionCard Title="Signatures" Description="@($"Input #{Input.InputIndex}")">
    <HeaderActions>
        <StatusBadge Text="@($"{Input.SignatureBundle.Signatures.Count} recorded")" Tone="info" />
    </HeaderActions>
    <ChildContent>
        @if (Input.SignatureBundle.Signatures.Count == 0)
        {
            <EmptyState Eyebrow="Signatures" Title="No signatures" Description="No input signatures were recorded." />
        }
        else
        {
            <Stack GapScale="LayoutGap.Small" AlignItems="AlignItems.Stretch">
                @foreach (SignatureEnvelope signature in Input.SignatureBundle.Signatures)
                {
                    <SurfaceCard Soft="true">
                        <Cluster AlignItems="AlignItems.Start" Wrap="FlexWrap.NoWrap">
                            <Icon Name="key" />
                            <Stack GapScale="LayoutGap.Tiny">
                                <TextBlock TextStyle="TextStyle.Subtitle2" Value="@signature.Algorithm.ToString()" />
                                <TextBlock TextStyle="TextStyle.Mono" Value="@signature.KeyId" />
                                <TextBlock TextStyle="TextStyle.Caption">@signature.SignatureBytes.Length signature bytes</TextBlock>
                                <HashDisplay Value="@signature.PublicKeyHash.Value" />
                            </Stack>
                        </Cluster>
                    </SurfaceCard>
                }
            </Stack>
        }
    </ChildContent>
</SectionCard>
</div>

@code {
    [Parameter, EditorRequired]
    public EconomyTransactionInputDetails Input { get; set; } = default!;
}
