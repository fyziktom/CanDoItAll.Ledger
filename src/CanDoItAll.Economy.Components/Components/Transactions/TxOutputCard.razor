@namespace CanDoItAll.Economy.Components

<article class="cda-sdk-mini-card cda-vef-tx-io-card cda-vef-tx-output-card" data-testid="cda-tx-output-card">
    <div class="cda-sdk-mini-card__top">
        <strong>Output #@Output.OutputIndex</strong>
        <Cluster Gap="LayoutGap.XSmall">
            @if (!string.IsNullOrWhiteSpace(RoleLabel))
            {
                <StatusBadge Text="@RoleLabel" Tone="@RoleTone" />
            }
            <StatusBadge Text="@FormatToken(Output.Token)" Tone="neutral" />
        </Cluster>
    </div>
    <div class="cda-sdk-fact-grid cda-sdk-fact-grid--tight cda-vef-output-fact-grid">
        <div><span>Main</span><strong>@Output.MainAmount</strong></div>
        <div><span>Token</span><strong>@FormatToken(Output.Token)</strong></div>
        <div>
            <span>Metadata</span>
            <strong>
                @if (Output.MetadataHash is not null)
                {
                    <HashDisplay Value="@Output.MetadataHash.Value.Value" />
                }
                else
                {
                    <span>none</span>
                }
            </strong>
        </div>
    </div>
    <div class="cda-vef-io-address-line">
        <span>Recipient</span>
        <CopyableMonoValue Value="@Output.Address.Value" />
    </div>
    @if (Output.BusinessObject is not null)
    {
        <small class="cda-sdk-muted">BO <CopyableMonoValue Value="@OutputBusinessObjectId" Truncate="false" AriaLabel="Copy business object UTXO id" /> v@(Output.BusinessObject.Version) (@Output.BusinessObject.Operation)</small>
    }
    @if (!string.IsNullOrWhiteSpace(SupportingText))
    {
        <p class="cda-sdk-muted cda-vef-io-card-note">@SupportingText</p>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public EconomyTransactionOutputDetails Output { get; set; } = default!;

    [Parameter]
    public TxId? TransactionId { get; set; }

    [Parameter]
    public string? RoleLabel { get; set; }

    [Parameter]
    public string RoleTone { get; set; } = "neutral";

    [Parameter]
    public string? SupportingText { get; set; }

    private static string FormatToken(TokenTransfer? token)
        => token is null ? "none" : $"{token.Amount} {token.TokenId.Value}";

    private string OutputBusinessObjectId
        => TransactionId is { } txId
            ? BusinessObjectId.FromOutPoint(txId, Output.OutputIndex).Value
            : "Assigned after confirmation";
}
