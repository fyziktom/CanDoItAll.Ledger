@namespace CanDoItAll.Economy.Components

<Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch" Class="cda-transaction-bo-search" data-testid="bo-selection-step">
    <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-transaction-bo-search__toolbar">
        <FormField Text="Search" ContainerClass="cda-economy-field">
            <TextBox Value="@filter"
                     ValueChanged="@(EventCallback.Factory.Create<string?>(this, value => filter = value ?? string.Empty))"
                     Immediate="true"
                     Placeholder="Name, outpoint, tag, type or state"
                     aria-label="Filter business objects"
                     data-testid="bo-selection-filter" />
        </FormField>

        <FormField Text="Object type" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="TypeOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedType"
                      ValueChanged="@(value => selectedType = value ?? AllFilter)"
                      aria-label="Filter business object type"
                      data-testid="bo-selection-type" />
        </FormField>

        <div class="cda-transaction-bo-search__selection-count">
            <span>Selection</span>
            <strong>@Selected.Count of @MaximumSelections</strong>
            <small>@FilteredItems.Count matching object(s)</small>
        </div>
    </Grid>

    @if (FeaturedTags.Count > 0)
    {
        <div class="cda-transaction-bo-search__tags" role="group" aria-label="Filter by tag">
            <button type="button"
                    class="@(string.IsNullOrWhiteSpace(selectedTag) ? "is-active" : null)"
                    aria-pressed="@(string.IsNullOrWhiteSpace(selectedTag) ? "true" : "false")"
                    data-testid="bo-tag-all"
                    @onclick="@(() => selectedTag = string.Empty)">All tags</button>
            @foreach (string tag in FeaturedTags)
            {
                <button type="button"
                        class="@(selectedTag.Equals(tag, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)"
                        aria-pressed="@(selectedTag.Equals(tag, StringComparison.OrdinalIgnoreCase) ? "true" : "false")"
                        data-testid="@($"bo-tag-{SafeTestId(tag)}")"
                        @onclick="@(() => selectedTag = tag)">#@tag</button>
            }
        </div>
    }

    @if (RequireCompatibleSelection && Selected.Count > 0)
    {
        <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
            The first object fixes the required type and schema. Incompatible objects remain visible but cannot be selected.
        </Alert>
    }

    @if (FilteredItems.Count == 0)
    {
        <EmptyState Eyebrow="Business objects" Title="No matching objects" Description="Change the search text, type, or tag filter." />
    }
    else
    {
        <div class="cda-transaction-bo-grid" role="group" aria-label="Business objects available for selection">
            @foreach (IBusinessObjectView item in FilteredItems)
            {
                <BusinessObjectSelectionCard Item="item"
                                             Selected="@IsSelected(item)"
                                             Interactive="@CanSelect(item)"
                                             DisabledReason="@DisabledReason(item)"
                                             SelectedChanged="@(() => ToggleAsync(item))"
                                             TestId="@($"bo-select-{SafeTestId(item.CurrentOutPoint.ToString())}")" />
            }
        </div>
    }
</Stack>

@code {
    private const string AllFilter = "__all";
    private string filter = string.Empty;
    private string selectedType = AllFilter;
    private string selectedTag = string.Empty;

    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Items { get; set; } = [];

    [Parameter]
    public IReadOnlyList<IBusinessObjectView> Selected { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<IBusinessObjectView>> SelectedChanged { get; set; }

    [Parameter]
    public int MaximumSelections { get; set; } = 1;

    [Parameter]
    public bool RequireCompatibleSelection { get; set; }

    private IReadOnlyList<IBusinessObjectView> FilteredItems
        => Items
            .Where(MatchesFilters)
            .OrderByDescending(item => item.CreatedAt)
            .ToArray();

    private IReadOnlyList<FilterOption> TypeOptions
        => new[] { new FilterOption(AllFilter, "All types") }
            .Concat(Items
                .Select(item => item.ObjectType)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
                .Select(value => new FilterOption(value, value)))
            .ToArray();

    private IReadOnlyList<string> FeaturedTags
        => Items
            .SelectMany(BusinessObjectCardDisplay.TagsFor)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToArray();

    private bool MatchesFilters(IBusinessObjectView item)
    {
        if (selectedType != AllFilter && !item.ObjectType.Equals(selectedType, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        IReadOnlyList<string> tags = BusinessObjectCardDisplay.TagsFor(item);
        if (!string.IsNullOrWhiteSpace(selectedTag)
            && !tags.Any(tag => tag.Equals(selectedTag, StringComparison.OrdinalIgnoreCase)))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        string probe = string.Join(
            ' ',
            BusinessObjectCardDisplay.DisplayName(item),
            item.CurrentOutPoint.ToString(),
            item.ObjectType,
            item.Operation,
            item.StateJson,
            string.Join(' ', tags),
            string.Join(' ', BusinessObjectCardDisplay.FactsFor(item).Select(fact => $"{fact.Label} {fact.Value}")));

        return probe.Contains(filter.Trim().TrimStart('#'), StringComparison.OrdinalIgnoreCase);
    }

    private bool IsSelected(IBusinessObjectView item)
        => Selected.Any(selected => selected.CurrentOutPoint == item.CurrentOutPoint);

    private Task ToggleAsync(IBusinessObjectView item)
    {
        if (!CanSelect(item))
        {
            return Task.CompletedTask;
        }

        List<IBusinessObjectView> next = Selected.ToList();
        int existingIndex = next.FindIndex(selected => selected.CurrentOutPoint == item.CurrentOutPoint);
        if (existingIndex >= 0)
        {
            next.RemoveAt(existingIndex);
        }
        else if (MaximumSelections == 1)
        {
            next = [item];
        }
        else if (next.Count < MaximumSelections)
        {
            next.Add(item);
        }

        return SelectedChanged.InvokeAsync(next);
    }

    private bool CanSelect(IBusinessObjectView item)
        => DisabledReason(item) is null;

    private string? DisabledReason(IBusinessObjectView item)
    {
        if (IsSelected(item))
        {
            return null;
        }

        if (RequireCompatibleSelection && Selected.Count > 0)
        {
            IBusinessObjectView anchor = Selected[0];
            bool compatible = anchor.ObjectType.Equals(item.ObjectType, StringComparison.OrdinalIgnoreCase)
                              && anchor.SchemaVersion.Equals(item.SchemaVersion, StringComparison.OrdinalIgnoreCase);
            if (!compatible)
            {
                return "Different object type or schema";
            }
        }

        return Selected.Count >= MaximumSelections
            ? $"Selection limit reached ({MaximumSelections}). Deselect another object to choose this one."
            : null;
    }

    private static string SafeTestId(string value)
        => new(value.Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray());

    private sealed record FilterOption(string Value, string Text);
}
