@namespace CanDoItAll.Economy.Components

<section class="cda-sdk-panel" data-testid="cda-transaction-history-browser">
    <header class="cda-sdk-panel__header">
        <div>
            <span>Transactions</span>
            <h2>History browser</h2>
        </div>
        <StatusBadge Text="@($"{Transactions.Count} rows")" Tone="info" />
    </header>

    <TransactionFilterToolbar />

    @if (Transactions.Count == 0)
    {
        <EmptyState Eyebrow="History" Title="No transactions" Description="Submitted transactions will appear here." />
    }
    else
    {
        <div class="cda-sdk-list">
            @foreach (LedgerTransactionSummary item in Transactions.OrderByDescending(item => item.Timestamp))
            {
                <article class="cda-sdk-list__row">
                    <span class="material-icons" aria-hidden="true">@IconFor(item.Kind)</span>
                    <div>
                        <strong><CopyableMonoValue Value="@item.TxId.Value" StartChars="10" EndChars="6" AriaLabel="Copy transaction id" /></strong>
                        <span>@item.Kind - @item.Status - @item.Timestamp.ToString("MM.dd HH:mm")</span>
                        <small>@item.Inputs.Count input(s), @item.Outputs.Count output(s)</small>
                    </div>
                    <StatusBadge Text="@item.Status.ToString()" Tone="@(item.Status == TransactionStatus.Confirmed ? "success" : "warning")" />
                </article>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    private static string IconFor(TransactionKind kind)
        => kind switch
        {
            TransactionKind.Mint => "token",
            TransactionKind.BusinessObject => "inventory_2",
            TransactionKind.Transfer => "sync_alt",
            _ => "receipt_long"
        };
}
