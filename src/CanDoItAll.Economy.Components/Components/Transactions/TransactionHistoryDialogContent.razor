@namespace CanDoItAll.Economy.Components

<Stack GapScale="LayoutGap.Medium" Class="cda-vef-transaction-browser" data-testid="tx-history-dialog">
    <Grid ColumnsLg="4" Gap="LayoutGap.Medium">
        <div class="cda-economy-fact"><span>Total</span><strong>@Transactions.Count</strong></div>
        <div class="cda-economy-fact"><span>Visible</span><strong>@FilteredTransactions.Count</strong></div>
        <div class="cda-economy-fact"><span>Account</span><strong><CopyableMonoValue Value="@(AccountAddress?.Value)" EmptyText="current" StartChars="12" EndChars="8" AriaLabel="Copy account address" /></strong></div>
        <div class="cda-economy-fact"><span>Newest</span><strong>@NewestLabel</strong></div>
    </Grid>

    <Grid ColumnsLg="3" Gap="LayoutGap.Medium" Class="cda-vef-transaction-browser-toolbar">
        <FormField Text="Search" ContainerClass="cda-economy-field">
            <TextBox @bind-Value="search" Immediate="true" Placeholder="Search tx id, address, kind..." aria-label="Search transactions" />
        </FormField>

        <FormField Text="Kind" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="KindOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedKind"
                      ValueChanged="@(value => selectedKind = value ?? AllFilter)"
                      Placeholder="All kinds"
                      aria-label="Filter transaction kind" />
        </FormField>

        <FormField Text="Status" ContainerClass="cda-economy-field">
            <DropDown TValue="string"
                      Data="StatusOptions"
                      TextProperty="Text"
                      ValueProperty="Value"
                      Value="@selectedStatus"
                      ValueChanged="@(value => selectedStatus = value ?? AllFilter)"
                      Placeholder="All statuses"
                      aria-label="Filter transaction status" />
        </FormField>
    </Grid>

    @if (FilteredTransactions.Count == 0)
    {
        <EmptyState Eyebrow="Transactions" Title="No matching transactions" Description="Adjust the search text or filters to show ledger activity." />
    }
    else
    {
        <div class="cda-economy-ledger-table-wrap cda-vef-transaction-browser-grid">
            <table class="cda-economy-ledger-table">
                <thead>
                    <tr>
                        <th>Tx id</th>
                        <th>Route</th>
                        <th>Kind</th>
                        <th>Status</th>
                        <th>Inputs</th>
                        <th>Outputs</th>
                        <th>Data</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (LedgerTransactionSummary transaction in FilteredTransactions)
                    {
                        <tr tabindex="0"
                            data-testid="tx-history-row"
                            @ondblclick="@(() => OpenDetailsAsync(transaction))"
                            @onkeydown="@(args => HandleRowKeyAsync(args, transaction))">
                            <td><CopyableMonoValue Value="@transaction.TxId.Value" StartChars="10" EndChars="6" AriaLabel="Copy transaction id" /></td>
                            <td><CopyableMonoValue Value="@FormatRoute(transaction)" StartChars="18" EndChars="10" AriaLabel="Copy transaction route" /></td>
                            <td>@transaction.Kind</td>
                            <td><span class="cda-economy-pill">@transaction.Status</span></td>
                            <td>@transaction.Inputs.Count</td>
                            <td>@transaction.Outputs.Count</td>
                            <td>@(transaction.Data is null ? "none" : transaction.Data.ItemType)</td>
                            <td>@transaction.Timestamp.ToString("MM.dd.yyyy HH:mm:ss")</td>
                            <td>
                                <Button Text="Details" Icon="info" Size="ButtonSize.Small" Variant="Variant.Outlined" Click="@(() => OpenDetailsAsync(transaction))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</Stack>

@code {
    private const string AllFilter = "__all";
    private string search = string.Empty;
    private string selectedKind = AllFilter;
    private string selectedStatus = AllFilter;

    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public Address? AccountAddress { get; set; }

    [Parameter]
    public EventCallback<LedgerTransactionSummary> TransactionDetailsRequested { get; set; }

    private IReadOnlyList<FilterOption> KindOptions
        => FilterOptions(Transactions.Select(transaction => transaction.Kind.ToString()));

    private IReadOnlyList<FilterOption> StatusOptions
        => FilterOptions(Transactions.Select(transaction => transaction.Status.ToString()));

    private IReadOnlyList<LedgerTransactionSummary> FilteredTransactions
        => Transactions
            .Where(MatchesFilters)
            .OrderByDescending(transaction => transaction.Timestamp)
            .ToArray();

    private string NewestLabel
        => Transactions.Count == 0
            ? "none"
            : Transactions.Max(transaction => transaction.Timestamp).ToString("MM.dd.yyyy HH:mm");

    private Task OpenDetailsAsync(LedgerTransactionSummary transaction)
        => TransactionDetailsRequested.InvokeAsync(transaction);

    private Task HandleRowKeyAsync(KeyboardEventArgs args, LedgerTransactionSummary transaction)
        => args.Key is "Enter" or " "
            ? OpenDetailsAsync(transaction)
            : Task.CompletedTask;

    private bool MatchesFilters(LedgerTransactionSummary transaction)
    {
        if (selectedKind != AllFilter && !transaction.Kind.ToString().Equals(selectedKind, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (selectedStatus != AllFilter && !transaction.Status.ToString().Equals(selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        string probe = string.Join(
            ' ',
            transaction.TxId.Value,
            transaction.Kind,
            transaction.Status,
            FormatRoute(transaction),
            transaction.Inputs.Count,
            transaction.Outputs.Count,
            transaction.Data?.ItemType.ToString() ?? "none");

        return probe.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static IReadOnlyList<FilterOption> FilterOptions(IEnumerable<string> values)
        => new[] { new FilterOption(AllFilter, "All") }
            .Concat(values
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(value => value, StringComparer.OrdinalIgnoreCase)
                .Select(value => new FilterOption(value, value)))
            .ToArray();

    private static string FormatRoute(LedgerTransactionSummary transaction)
    {
        string inputs = transaction.InputAddresses.Count == 0
            ? "genesis/mint"
            : string.Join(", ", transaction.InputAddresses.Select(address => address.Value));
        string outputs = transaction.OutputAddresses.Count == 0
            ? "none"
            : string.Join(", ", transaction.OutputAddresses.Select(address => address.Value));

        return $"{inputs} \u2192 {outputs}";
    }

    private sealed record FilterOption(string Value, string Text);
}
