@namespace CanDoItAll.Economy.Components

<ActionReviewPanel Title="@ReviewTitle"
                   Description="@ReviewDescription"
                   Items="Facts"
                   data-testid="cda-transaction-review-panel" />

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    private string ReviewTitle
        => Draft.SelectedMode switch
        {
            BusinessObjectTransactionMode.MainPayment => "Review payment",
            BusinessObjectTransactionMode.TokenTransfer => "Review token transfer",
            BusinessObjectTransactionMode.UtxoMerge => "Review UTXO merge",
            BusinessObjectTransactionMode.UtxoSplit => "Review UTXO split",
            BusinessObjectTransactionMode.Create => "Review new object",
            BusinessObjectTransactionMode.TransferObject => "Review object transfer",
            BusinessObjectTransactionMode.UpdateObject => "Review object update",
            BusinessObjectTransactionMode.CloseObject => "Confirm object closure",
            BusinessObjectTransactionMode.CloneObject => "Review object clone",
            BusinessObjectTransactionMode.MergeObjects => "Review object merge",
            BusinessObjectTransactionMode.SplitBusinessObjectPayment => "Review object allocation",
            _ => "Transaction review"
        };

    private string ReviewDescription
        => Draft.SelectedMode switch
        {
            BusinessObjectTransactionMode.CloseObject => "Closing is final. Verify the object and final state before submission.",
            BusinessObjectTransactionMode.UtxoMerge or BusinessObjectTransactionMode.UtxoSplit => "Verify the selected inputs and resulting output plan before submission.",
            BusinessObjectTransactionMode.CreateRuleToken => "Token creation continues in the authority-aware creator.",
            _ => "Verify the transaction effects before signing and submission."
        };

    private IReadOnlyList<ActionReviewFact> Facts
        => Draft.SelectedMode switch
        {
            BusinessObjectTransactionMode.MainPayment =>
            [
                new("Receiver", Draft.PaymentReceiverAddress.Value),
                new("Amount", Draft.PaymentAmount.ToString()),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.TokenTransfer =>
            [
                new("Token", Draft.TokenId?.Value ?? "Not selected"),
                new("Receiver", Draft.PaymentReceiverAddress.Value),
                new("Token amount", Draft.TokenAmount?.ToString() ?? "0"),
                new("Attached main amount", Draft.MainAmount.ToString()),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.UtxoMerge =>
            [
                new("Inputs", $"{Draft.SelectedUtxosOrEmpty.Count} selected"),
                new("Result", "1 plain output"),
                new("Output address", Draft.PaymentReceiverAddress.Value),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.UtxoSplit =>
            [
                new("Inputs", $"{Draft.SelectedUtxosOrEmpty.Count} selected"),
                new("Outputs", Draft.UtxoSplitOutputsOrEmpty.Count.ToString()),
                new("Allocated", Draft.UtxoSplitOutputsOrEmpty.Sum(output => output.Amount.Value).ToString()),
                new("Receivers", Draft.UtxoSplitOutputsOrEmpty.Select(output => output.ReceiverAddress).Distinct().Count().ToString()),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.Create =>
            [
                new("Object ID", Draft.ObjectId.Value),
                new("Type", Draft.ObjectType),
                new("Schema", Draft.SchemaVersion),
                new("Owner", Draft.OwnerAddress.Value),
                new("Main amount", Draft.MainAmount.ToString()),
                new("Token", TokenSummary),
                new("State", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.TransferObject =>
            [
                new("Object", Draft.ObjectId.Value),
                new("New owner", Draft.ReceiverAddress.Value),
                new("Main amount", Draft.MainAmount.ToString()),
                new("State", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.UpdateObject =>
            [
                new("Object", Draft.ObjectId.Value),
                new("Operation", "Publish next state"),
                new("State", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.CloseObject =>
            [
                new("Object", Draft.ObjectId.Value),
                new("Operation", "Close permanently"),
                new("Final state", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.CloneObject =>
            [
                new("Source", Draft.SourceObjectId?.Value ?? "Not selected"),
                new("New object", Draft.TargetObjectId?.Value ?? "Not set"),
                new("Type", Draft.ObjectType),
                new("Schema", Draft.SchemaVersion),
                new("State", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.MergeObjects =>
            [
                new("First object", Draft.SourceObjectId?.Value ?? "Not selected"),
                new("Second object", Draft.SecondObjectId?.Value ?? "Not selected"),
                new("Result object", Draft.TargetObjectId?.Value ?? "Not set"),
                new("Result state", StateSummary),
                new("Reference", Reference)
            ],
            BusinessObjectTransactionMode.SplitBusinessObjectPayment =>
            [
                new("Object", Draft.ObjectId.Value),
                new("Primary receiver", Draft.PaymentReceiverAddress.Value),
                new("Primary amount", Draft.PaymentAmount.ToString()),
                new("Secondary receiver", Draft.ReceiverAddress.Value),
                new("Secondary amount", Draft.SecondaryPaymentAmount?.ToString() ?? "0"),
                new("Total allocation", (Draft.PaymentAmount.Value + (Draft.SecondaryPaymentAmount?.Value ?? 0m)).ToString()),
                new("Reference", Reference)
            ],
            _ =>
            [
                new("Mode", Draft.SelectedMode.ToString()),
                new("Reference", Reference)
            ]
        };

    private string Reference
        => string.IsNullOrWhiteSpace(Draft.ExternalRef) ? "Not provided" : Draft.ExternalRef;

    private string StateSummary
        => string.IsNullOrWhiteSpace(Draft.StateJson) ? "No state payload" : "Validated inline JSON";

    private string TokenSummary
        => Draft.TokenId is null
            ? "None"
            : $"{Draft.TokenAmount?.ToString() ?? "0"} {Draft.TokenId.Value.Value}";
}
