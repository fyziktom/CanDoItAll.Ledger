@namespace CanDoItAll.Economy.Components

<ActionReviewPanel Title="Transaction review"
                   Description="Review mode, addresses, amount, and payload before signing."
                   Items="Facts"
                   data-testid="cda-transaction-review-panel" />

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    private IReadOnlyList<ActionReviewFact> Facts
        =>
        [
            new("Mode", Draft.SelectedMode.ToString()),
            new("Owner", Draft.OwnerAddress.Value),
            new("Receiver", Draft.ReceiverAddress.Value),
            new("Payment receiver", Draft.PaymentReceiverAddress.Value),
            new("Main amount", Draft.MainAmount.ToString()),
            new("Payment amount", Draft.PaymentAmount.ToString()),
            new("Object", Draft.ObjectId.Value),
            new("Payload", string.IsNullOrWhiteSpace(Draft.StateJson) ? "none" : "inline state")
        ];
}
