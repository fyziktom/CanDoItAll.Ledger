@namespace CanDoItAll.Economy.Components
@using System.Globalization
@inject DialogService DialogService
@inject NotificationService Notifications

<Stack GapScale="LayoutGap.Medium"
       AlignItems="AlignItems.Stretch"
       Class="cda-transaction-wizard cda-token-creation-wizard"
       data-testid="token-creation-wizard">
    <Steps Value="currentStep"
           CanSelect="false"
           Linear="true"
           ShowDescriptions="true"
           class="cda-transaction-workflow-steps">
        <StepsItem Text="Authority" Icon="verified_user" Description="Choose the issuing namespace">
            @if (Authorities.Count == 0)
            {
                <EmptyState Eyebrow="Token authority"
                            Title="No creation authority available"
                            Description="This account needs a token creation authority before it can mint a new token." />
            }
            else
            {
                <Grid ColumnTemplateXl="minmax(22rem,.85fr) minmax(0,1.15fr)"
                      Gap="LayoutGap.Medium"
                      AlignItems="AlignItems.Stretch">
                    <FormSection Title="Issuing authority" Description="The namespace controls which token identifiers this account may create.">
                        <FormField Text="Namespace" ContainerClass="cda-economy-field">
                            <DropDown TValue="string"
                                      Data="AuthorityOptions"
                                      TextProperty="Text"
                                      ValueProperty="Value"
                                      Value="@selectedAuthorityKey"
                                      ValueChanged="@(value => selectedAuthorityKey = value)"
                                      Placeholder="Select namespace"
                                      aria-label="Token namespace"
                                      data-testid="token-creation-namespace" />
                        </FormField>
                    </FormSection>

                    <SurfaceCard Soft="true">
                        <Stack GapScale="LayoutGap.Small">
                            <TextBlock TextStyle="TextStyle.Eyebrow" Value="What this controls" />
                            <TextBlock TextStyle="TextStyle.H3" Value="Authority is checked before minting" />
                            <TextBlock TextStyle="TextStyle.Body2"
                                       Value="The ledger verifies the selected namespace and the account's current permission before it accepts the token definition." />
                            <Grid Columns="2" Gap="LayoutGap.Small">
                                <SummaryTile Label="Available namespaces" Value="@Authorities.Count.ToString()" Compact="true" />
                                <SummaryTile Label="Selected" Value="@(SelectedAuthority?.Namespace ?? "None")" Compact="true" />
                            </Grid>
                        </Stack>
                    </SurfaceCard>
                </Grid>
            }
        </StepsItem>

        <StepsItem Text="Definition" Icon="tune" Description="Name the token and set supply">
            <Grid ColumnTemplateXl="minmax(0,1.25fr) minmax(22rem,.75fr)"
                  Gap="LayoutGap.Medium"
                  AlignItems="AlignItems.Stretch">
                <FormSection Title="Token definition" Description="Use a concise name and enter the initial supply to mint.">
                    <Grid ColumnTemplateLg="minmax(14rem,1fr) minmax(10rem,.55fr)" Gap="LayoutGap.Medium">
                        <FormField Text="Token name" ContainerClass="cda-economy-field">
                            <TextBox Value="@tokenName"
                                     ValueChanged="@(value => tokenName = value ?? string.Empty)"
                                     Immediate="true"
                                     Placeholder="voucher"
                                     aria-label="Token name"
                                     data-testid="token-creation-name" />
                        </FormField>
                        <FormField Text="Initial supply" ContainerClass="cda-economy-field">
                            <TextBox Value="@tokenAmount"
                                     ValueChanged="@(value => tokenAmount = value ?? string.Empty)"
                                     Immediate="true"
                                     Placeholder="1000"
                                     aria-label="Token amount"
                                     data-testid="token-creation-amount" />
                        </FormField>
                        <FormField Text="Description" ContainerClass="cda-economy-field cda-economy-field--wide">
                            <TextArea Value="@description"
                                      ValueChanged="@(value => description = value ?? string.Empty)"
                                      Immediate="true"
                                      Rows="4"
                                      aria-label="Token description"
                                      data-testid="token-creation-description" />
                        </FormField>
                    </Grid>
                </FormSection>

                <SurfaceCard Soft="true">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Identifier preview" />
                        <TextBlock TextStyle="TextStyle.H3" Value="@TokenIdentifierPreview" />
                        <TextBlock TextStyle="TextStyle.Body2"
                                   Value="The namespace and token name form the identifier shown to users in balances and transfer screens." />
                        @if (!DefinitionIsValid)
                        {
                            <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                Enter a token name and a positive initial supply to continue.
                            </Alert>
                        }
                    </Stack>
                </SurfaceCard>
            </Grid>
        </StepsItem>

        <StepsItem Text="Review" Icon="fact_check" Description="Verify authority and supply">
            <Grid ColumnTemplateXl="minmax(0,1.2fr) minmax(22rem,.8fr)"
                  Gap="LayoutGap.Medium"
                  AlignItems="AlignItems.Stretch">
                <FormSection Title="Token to be created" Description="Confirm the values that will be sent to the ledger.">
                    <Grid Columns="2" Gap="LayoutGap.Small">
                        <SummaryTile Label="Namespace" Value="@(SelectedAuthority?.Namespace ?? "None")" Compact="true" />
                        <SummaryTile Label="Permission UTXO" Value="@SelectedAuthorityLabel" Compact="true" />
                        <SummaryTile Label="Token" Value="@TokenIdentifierPreview" Compact="true" />
                        <SummaryTile Label="Initial supply" Value="@tokenAmount" Compact="true" />
                        <SummaryTile Label="Description" Value="@description" Compact="true" />
                    </Grid>
                </FormSection>

                <SurfaceCard Soft="true">
                    <Stack GapScale="LayoutGap.Small">
                        <TextBlock TextStyle="TextStyle.Eyebrow" Value="Ready to create" />
                        <TextBlock TextStyle="TextStyle.H3" Value="Authority and definition are complete" />
                        <TextBlock TextStyle="TextStyle.Body2"
                                   Value="Creating the token submits a mint request. Review the namespace and supply once more before continuing." />
                        <StatusBadge Text="Ready" Tone="success" />
                    </Stack>
                </SurfaceCard>
            </Grid>
        </StepsItem>
    </Steps>

    <Split Breakpoint="LayoutBreakpoint.None" Gap="LayoutGap.Small" Class="cda-transaction-wizard-nav">
        <Cluster Gap="LayoutGap.Small">
            <Button Text="Cancel"
                    Icon="close"
                    Variant="Variant.Outlined"
                    ButtonStyle="ButtonStyle.Secondary"
                    Click="CancelAsync"
                    data-testid="token-creation-cancel" />
            <Button Text="Back"
                    Icon="arrow_back"
                    Disabled="@(currentStep == 0)"
                    Variant="Variant.Outlined"
                    ButtonStyle="ButtonStyle.Secondary"
                    Click="PreviousStep"
                    data-testid="token-creation-back" />
        </Cluster>

        @if (currentStep < 2)
        {
            <Button Text="@(currentStep == 0 ? "Define token" : "Review token")"
                    Icon="arrow_forward"
                    Disabled="@(!CanContinue)"
                    Click="NextStep"
                    data-testid="token-creation-next" />
        }
        else
        {
            <Button Text="Create token"
                    Icon="add_circle"
                    Click="SubmitAsync"
                    data-testid="token-creation-submit" />
        }
    </Split>
</Stack>

@code {
    private int currentStep;
    private string? selectedAuthorityKey;
    private string tokenName = "voucher";
    private string tokenAmount = "1000";
    private string description = "Created from the economy account app.";

    [Parameter]
    public IReadOnlyList<EconomyTokenCreationAuthority> Authorities { get; set; } = [];

    [Parameter]
    public EventCallback<EconomyTokenCreationRequest> SubmitRequested { get; set; }

    private IReadOnlyList<AuthorityOption> AuthorityOptions
        => Authorities
            .Select(authority => new AuthorityOption(CreateAuthorityKey(authority), CreateAuthorityLabel(authority)))
            .ToArray();

    private EconomyTokenCreationAuthority? SelectedAuthority
        => Authorities.FirstOrDefault(authority => string.Equals(
            CreateAuthorityKey(authority),
            selectedAuthorityKey,
            StringComparison.Ordinal));

    private string SelectedAuthorityLabel
        => SelectedAuthority is null ? "Not selected" : CreateAuthorityLabel(SelectedAuthority);

    private bool DefinitionIsValid
        => !string.IsNullOrWhiteSpace(tokenName) && TryParseAmount(out _);

    private bool CanContinue
        => currentStep switch
        {
            0 => SelectedAuthority is not null,
            1 => DefinitionIsValid,
            _ => true
        };

    private string TokenIdentifierPreview
        => $"{(SelectedAuthority?.Namespace ?? "namespace")}.{(string.IsNullOrWhiteSpace(tokenName) ? "token" : tokenName.Trim())}";

    protected override void OnParametersSet()
    {
        if (SelectedAuthority is null)
        {
            selectedAuthorityKey = Authorities.FirstOrDefault() is { } authority
                ? CreateAuthorityKey(authority)
                : null;
        }
    }

    private void PreviousStep() => currentStep = Math.Max(0, currentStep - 1);

    private void NextStep()
    {
        if (CanContinue)
        {
            currentStep = Math.Min(2, currentStep + 1);
        }
    }

    private async Task SubmitAsync()
    {
        EconomyTokenCreationAuthority? authority = SelectedAuthority;
        if (currentStep != 2 || authority is null)
        {
            return;
        }

        if (!TryParseAmount(out decimal parsedTokens))
        {
            Notifications.Warning("Token amount required", "Enter a positive token amount.", position: NotificationPosition.BottomCenter);
            return;
        }

        var request = new EconomyTokenCreationRequest(
            authority.Namespace,
            tokenName.Trim(),
            new Amount(parsedTokens),
            Amount.Zero,
            description.Trim(),
            authority.SourceOutPoint);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private bool TryParseAmount(out decimal parsedTokens)
        => decimal.TryParse(tokenAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out parsedTokens)
           && parsedTokens > 0m;

    private Task CancelAsync() => DialogService.CloseAsync();

    private static string CreateAuthorityKey(EconomyTokenCreationAuthority authority)
        => authority.SourceOutPoint?.ToString() ?? authority.GrantObjectId.Value;

    private static string CreateAuthorityLabel(EconomyTokenCreationAuthority authority)
    {
        string source = authority.SourceOutPoint?.ToString() ?? authority.GrantObjectId.Value;
        string shortSource = source.Length <= 18 ? source : $"{source[..10]}…{source[^7..]}";
        string mode = authority.Repeatable ? "reusable" : "single use";
        return $"{authority.Namespace} · {shortSource} · {mode}";
    }

    private sealed record AuthorityOption(string Value, string Text);
}
