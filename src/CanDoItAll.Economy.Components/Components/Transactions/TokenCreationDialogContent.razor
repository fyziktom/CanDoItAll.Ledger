@namespace CanDoItAll.Economy.Components
@using System.Globalization
@inject DialogService DialogService
@inject NotificationService Notifications

<SectionCard Title="Create Token" Description="Mint a new token under an available authority namespace.">
    <Stack GapScale="LayoutGap.Medium">
        @if (Authorities.Count == 0)
        {
            <Alert AlertStyle="AlertStyle.Warning">This account has no token creation authority.</Alert>
        }
        else
        {
            <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                <FormField Text="Namespace" ContainerClass="cda-economy-field">
                    <DropDown TValue="string"
                              Data="AuthorityOptions"
                              TextProperty="Text"
                              ValueProperty="Value"
                              Value="@selectedNamespace"
                              ValueChanged="@(value => selectedNamespace = value)"
                              Placeholder="Select namespace"
                              aria-label="Token namespace" />
                </FormField>
                <FormField Text="Token name" ContainerClass="cda-economy-field">
                    <TextBox Value="@tokenName" ValueChanged="@(value => tokenName = value ?? string.Empty)" Immediate="true" Placeholder="voucher" aria-label="Token name" />
                </FormField>
                <FormField Text="Token amount" ContainerClass="cda-economy-field">
                    <TextBox Value="@tokenAmount" ValueChanged="@(value => tokenAmount = value ?? string.Empty)" Immediate="true" Placeholder="1000" aria-label="Token amount" />
                </FormField>
                <FormField Text="Description" ContainerClass="cda-economy-field cda-economy-field--wide">
                    <TextArea Value="@description" ValueChanged="@(value => description = value ?? string.Empty)" Immediate="true" Rows="3" aria-label="Token description" />
                </FormField>
            </Grid>
        }

        <Cluster Gap="LayoutGap.Small">
            <Button Text="Create Token" Icon="add_circle" Disabled="@(Authorities.Count == 0)" Click="SubmitAsync" />
            <Button Text="Cancel" Icon="close" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Secondary" Click="CancelAsync" />
        </Cluster>
    </Stack>
</SectionCard>

@code {
    private string? selectedNamespace;
    private string tokenName = "voucher";
    private string tokenAmount = "1000";
    private string description = "Created from the SSR economy UI.";

    [Parameter]
    public IReadOnlyList<EconomyTokenCreationAuthority> Authorities { get; set; } = [];

    [Parameter]
    public EventCallback<EconomyTokenCreationRequest> SubmitRequested { get; set; }

    private IReadOnlyList<AuthorityOption> AuthorityOptions
        => Authorities.Select(authority => new AuthorityOption(authority.Namespace, authority.Namespace)).ToArray();

    protected override void OnParametersSet()
    {
        selectedNamespace ??= Authorities.FirstOrDefault()?.Namespace;
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedNamespace))
        {
            Notifications.Warning("Namespace required", "Select a token creation namespace.", position: NotificationPosition.BottomCenter);
            return;
        }

        if (!decimal.TryParse(tokenAmount, NumberStyles.Number, CultureInfo.InvariantCulture, out decimal parsedTokens) || parsedTokens <= 0m)
        {
            Notifications.Warning("Token amount required", "Enter a positive token amount.", position: NotificationPosition.BottomCenter);
            return;
        }

        var request = new EconomyTokenCreationRequest(
            selectedNamespace,
            tokenName,
            new Amount(parsedTokens),
            Amount.Zero,
            description);

        await SubmitRequested.InvokeAsync(request);
        await DialogService.CloseAsync(request);
    }

    private Task CancelAsync() => DialogService.CloseAsync();

    private sealed record AuthorityOption(string Value, string Text);
}
