@namespace CanDoItAll.Economy.Components
@inject DialogService DialogService
@inject NotificationService Notifications

<FormField Text="@Label" ContainerClass="@ContainerClass">
    <div class="cda-address-input-row">
        <TextBox Value="@Value"
                 ValueChanged="@(EventCallback.Factory.Create<string?>(this, ValueChanged))"
                 Immediate="true"
                 Placeholder="@Placeholder"
                 aria-label="@Label"
                 data-testid="@TestId" />
        <PageHeaderActionButton Icon="contacts"
                                Label="Choose address"
                                TooltipText="Choose from address directory"
                                Variant="Variant.Outlined"
                                Click="OpenAddressDirectoryAsync"
                                TestId="@($"{TestId}-directory")" />
        <QrScanButton Label="Scan address"
                      TooltipText="Scan address QR"
                      Scanned="ApplyAddressScanAsync"
                      TestId="@($"{TestId}-scan")" />
    </div>
</FormField>

@code {
    [Parameter]
    public string Label { get; set; } = "Address";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "cdia1...";

    [Parameter]
    public string ContainerClass { get; set; } = "cda-economy-field";

    [Parameter]
    public IReadOnlyList<EconomyAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-composer";

    [Parameter]
    public string DialogSubtitle { get; set; } = "Transaction";

    [Parameter]
    public string TestId { get; set; } = "cda-transaction-address";

    private async Task OpenAddressDirectoryAsync()
    {
        object? result = await DialogService.OpenAsync<AddressDirectoryDialogContent>(
            "Select Address",
            new Dictionary<string, object?>
            {
                [nameof(AddressDirectoryDialogContent.Bookmarks)] = Bookmarks,
                [nameof(AddressDirectoryDialogContent.AccountScope)] = AccountScope,
                [nameof(AddressDirectoryDialogContent.Mode)] = AddressDirectoryDialogMode.Select
            },
            new DialogOptions
            {
                Subtitle = DialogSubtitle,
                Size = ModalSize.Full,
                DenseChrome = true,
                Class = "cda-ledger-dialog cda-ledger-dialog--address-directory",
                TestId = "cda-address-directory-dialog"
            });

        if (result is AddressDirectoryEntry entry)
        {
            await ValueChanged.InvokeAsync(entry.Address);
        }
    }

    private async Task ApplyAddressScanAsync(QrScanResult scan)
    {
        if (scan.IsValid)
        {
            await ValueChanged.InvokeAsync(scan.Text);
            return;
        }

        Notifications.Warning("QR scan ignored", scan.Error ?? "Scanned address payload is invalid.", position: NotificationPosition.BottomCenter);
    }
}
