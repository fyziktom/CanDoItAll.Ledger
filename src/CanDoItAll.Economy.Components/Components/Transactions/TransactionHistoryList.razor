@namespace CanDoItAll.Economy.Components

<SectionCard Title="Transaction history" Description="Recent account-visible ledger activity">
    <Stack GapScale="LayoutGap.Small" Class="cda-economy-list">
        @foreach (LedgerTransactionSummary transaction in Items)
        {
            <div class="cda-economy-list-item">
                    <Split Breakpoint="LayoutBreakpoint.Md" AlignItems="AlignItems.Start" Gap="LayoutGap.Small">
                        <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
                        <strong><CopyableMonoValue Value="@transaction.TxId.Value" StartChars="10" EndChars="6" AriaLabel="Copy transaction id" /></strong>
                        <CopyableMonoValue Value="@FormatRoute(transaction)" StartChars="18" EndChars="10" AriaLabel="Copy transaction route" />
                    </Stack>
                    <Cluster Gap="LayoutGap.Small">
                        <span class="cda-economy-pill">@transaction.Kind</span>
                        <span class="cda-economy-pill">@transaction.Status</span>
                        <span class="cda-economy-pill">@transaction.Timestamp.ToString("g")</span>
                    </Cluster>
                </Split>
            </div>
        }
    </Stack>
</SectionCard>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Items { get; set; } = [];

    private static string FormatRoute(LedgerTransactionSummary transaction)
    {
        string inputs = transaction.InputAddresses.Count == 0
            ? "mint"
            : string.Join(", ", transaction.InputAddresses.Select(address => address.Value));
        string outputs = transaction.OutputAddresses.Count == 0
            ? "none"
            : string.Join(", ", transaction.OutputAddresses.Select(address => address.Value));

        return $"{inputs} \u2192 {outputs}";
    }
}
