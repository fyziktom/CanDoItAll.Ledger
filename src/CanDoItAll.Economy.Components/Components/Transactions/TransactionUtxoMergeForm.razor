@namespace CanDoItAll.Economy.Components

<UtxoSelectionList Outputs="SpendableOutputs"
                   SelectedOutPoints="Draft.SelectedUtxosOrEmpty"
                   SelectedOutPointsChanged="SetSelectedUtxosAsync"
                   Label="Merge inputs"
                   TestId="cda-merge-utxo-selector" />

<TransactionAddressInput Label="Output address"
                         Value="@Draft.PaymentReceiverAddress.Value"
                         ValueChanged="SetReceiverAddressAsync"
                         Placeholder="@Draft.OwnerAddress.Value"
                         ContainerClass="cda-economy-field cda-economy-field--wide"
                         Bookmarks="Bookmarks"
                         AccountScope="@AccountScope"
                         DialogSubtitle="Merge"
                         TestId="cda-merge-output-address" />

<div class="cda-economy-fact" data-testid="cda-merge-selected-total">
    <span>Selected total</span>
    <strong>@SelectedTotal</strong>
</div>

<div class="cda-economy-fact" data-testid="cda-merge-output-count">
    <span>Outputs</span>
    <strong>1</strong>
</div>

@code {
    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter]
    public EventCallback<BusinessObjectTransactionDraft> DraftChanged { get; set; }

    [Parameter]
    public IReadOnlyList<LedgerSpendableOutput> SpendableOutputs { get; set; } = [];

    [Parameter]
    public IReadOnlyList<EconomyAddressBookmark> Bookmarks { get; set; } = [];

    [Parameter]
    public string AccountScope { get; set; } = "transaction-composer";

    private decimal SelectedTotal
        => SpendableOutputs
            .Where(output => Draft.SelectedUtxosOrEmpty.Contains(output.OutPoint))
            .Sum(output => output.MainAmount.Value);

    private Task SetSelectedUtxosAsync(IReadOnlyList<OutPoint> selected)
        => DraftChanged.InvokeAsync(Draft with { SelectedUtxos = selected });

    private Task SetReceiverAddressAsync(string? value)
        => DraftChanged.InvokeAsync(Draft with { PaymentReceiverAddress = new Address(value ?? string.Empty) });
}
