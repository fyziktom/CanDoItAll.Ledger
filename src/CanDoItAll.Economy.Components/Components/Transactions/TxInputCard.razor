@namespace CanDoItAll.Economy.Components

<article class="cda-sdk-mini-card cda-vef-tx-io-card cda-vef-tx-input-card" data-testid="cda-tx-input-card">
    <div class="cda-sdk-mini-card__top">
        <strong>Input #@Input.InputIndex</strong>
        <Cluster Gap="LayoutGap.XSmall">
            @if (!string.IsNullOrWhiteSpace(RoleLabel))
            {
                <StatusBadge Text="@RoleLabel" Tone="@RoleTone" />
            }
            <StatusBadge Text="@($"{Input.SignatureCount} sig")" Tone="info" />
        </Cluster>
    </div>
    <div class="cda-sdk-fact-grid cda-sdk-fact-grid--tight cda-vef-input-fact-grid">
        <div><span>Previous</span><strong><span class="cda-vef-outpoint-value" title="@Input.PreviousOutPoint.ToString()">@ShortOutPoint(Input.PreviousOutPoint.ToString())</span></strong></div>
        <div><span>Main</span><strong>@(Input.MainAmount?.ToString() ?? "unknown")</strong></div>
        <div><span>Token</span><strong>@FormatToken(Input.Token)</strong></div>
    </div>
    <div class="cda-vef-io-address-line">
        <span>Source address</span>
        <CopyableMonoValue Value="@Input.Address.Value" />
    </div>
    @if (Input.BusinessObject is not null)
    {
        <small class="cda-sdk-muted">BO <CopyableMonoValue Value="@Input.PreviousOutPoint.ToString()" Truncate="false" AriaLabel="Copy source business object UTXO id" /> v@(Input.BusinessObject.Version)</small>
    }
    @if (!string.IsNullOrWhiteSpace(SupportingText))
    {
        <p class="cda-sdk-muted cda-vef-io-card-note">@SupportingText</p>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public EconomyTransactionInputDetails Input { get; set; } = default!;

    [Parameter]
    public string? RoleLabel { get; set; }

    [Parameter]
    public string RoleTone { get; set; } = "info";

    [Parameter]
    public string? SupportingText { get; set; }

    private static string FormatToken(TokenTransfer? token)
        => token is null ? "none" : $"{token.Amount} {token.TokenId.Value}";

    private static string ShortOutPoint(string value)
        => value.Length <= 19 ? value : $"{value[..10]}...{value[^6..]}";
}
