@namespace CanDoItAll.Economy.Components

<Stack GapScale="LayoutGap.Small"
       AlignItems="AlignItems.Stretch"
       Class="w-full"
       data-testid="transaction-details-review-wizard">
    <CompactWorkflowProgress Value="currentStep"
                             Steps="@ReviewSteps"
                             aria-label="Transaction details and review steps" />

    <div class="min-w-0 w-full">
        @if (currentStep == 0)
        {
            @ChildContent
        }
        else
        {
            <TransactionReviewPanel Draft="Draft" />
        }
    </div>

    <Split Breakpoint="LayoutBreakpoint.None"
           Gap="LayoutGap.Small"
           AlignItems="AlignItems.Center"
           JustifyContent="JustifyContent.SpaceBetween"
           Class="w-full border-t border-slate-200 pt-2">
        <Button Text="Back"
                Icon="arrow_back"
                Size="ButtonSize.Small"
                Disabled="@(currentStep == 0)"
                ButtonStyle="ButtonStyle.Secondary"
                Variant="Variant.Outlined"
                Click="PreviousStep"
                data-testid="transaction-details-back" />
        @if (currentStep == 0)
        {
            <Button Text="Review transaction"
                    Icon="arrow_forward"
                    Size="ButtonSize.Small"
                    Disabled="@(!Validation.IsValid)"
                    Click="NextStep"
                    data-testid="transaction-details-next" />
        }
    </Split>
</Stack>

@code {
    private static readonly IReadOnlyList<string> ReviewSteps = ["Details", "Review"];

    private int currentStep;
    private BusinessObjectTransactionMode? observedMode;

    [Parameter, EditorRequired]
    public BusinessObjectTransactionMode Mode { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectTransactionDraft Draft { get; set; } = default!;

    [Parameter, EditorRequired]
    public TransactionFlowValidation Validation { get; set; } = TransactionFlowValidation.Valid;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public EventCallback<bool> ReviewReadyChanged { get; set; }

    protected override void OnParametersSet()
    {
        if (observedMode == Mode)
        {
            return;
        }

        observedMode = Mode;
        currentStep = 0;
    }

    private async Task PreviousStep()
    {
        currentStep = 0;
        await ReviewReadyChanged.InvokeAsync(false);
    }

    private async Task NextStep()
    {
        if (!Validation.IsValid)
        {
            return;
        }

        currentStep = 1;
        await ReviewReadyChanged.InvokeAsync(true);
    }
}
