@namespace CanDoItAll.Economy.Components

<div data-testid="cda-transaction-timeline">
<SectionCard Title="Transaction timeline" Description="Timeline">
    <Timeline Items="Items" AriaLabel="Transaction timeline" />
</SectionCard>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LedgerTransactionSummary> Transactions { get; set; } = [];

    [Parameter]
    public EconomyTransactionDetailsModel? Details { get; set; }

    private IReadOnlyList<TimelineItem> Items
        => Details is not null
            ? BuildDetailsTimeline()
            : LedgerTransactionOrdering
                .NewestFirst(Transactions)
                .Select(item => new TimelineItem
                {
                    Label = item.TxId.Value,
                    Description = $"{item.Kind} - {item.Status}",
                    Timestamp = item.Timestamp,
                    Icon = item.Kind == TransactionKind.BusinessObject ? "inventory_2" : "receipt_long",
                    Tone = item.Status == TransactionStatus.Confirmed ? "success" : "warning"
                })
                .ToArray();

    private IReadOnlyList<TimelineItem> BuildDetailsTimeline()
        =>
        [
            new TimelineItem
            {
                Label = "Created",
                Description = $"{Details!.Kind} transaction assembled.",
                Timestamp = Details.Timestamp,
                Icon = "edit_note",
                Tone = "info"
            },
            new TimelineItem
            {
                Label = "Signed",
                Description = $"{Details.Inputs.Sum(input => input.SignatureCount)} input signature(s).",
                Timestamp = Details.Timestamp.AddSeconds(8),
                Icon = "draw",
                Tone = "success"
            },
            new TimelineItem
            {
                Label = Details.Status.ToString(),
                Description = $"Hash {ShortenIdentifier(Details.TxHash?.Value ?? Details.TxId.Value)}",
                Timestamp = Details.Timestamp.AddSeconds(18),
                Icon = "verified",
                Tone = Details.Status == TransactionStatus.Confirmed ? "success" : "warning"
            }
        ];

    private static string ShortenIdentifier(string value)
        => value.Length <= 18 ? value : $"{value[..10]}...{value[^6..]}";
}
