<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Economy.Components</AssemblyName>
    <RootNamespace>CanDoItAll.Economy.Components</RootNamespace>
