<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Economy.Components</AssemblyName>
    <RootNamespace>CanDoItAll.Economy.Components</RootNamespace>
    <ComponentsRepoRoot Condition="'$(ComponentsRepoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\CanDoItAll.Components</ComponentsRepoRoot>
    <ComponentsWebGlLibProject>$(ComponentsRepoRoot)\src\CanDoItAll.Components.WebGlLib\CanDoItAll.Components.WebGlLib.csproj</ComponentsWebGlLibProject>
    <ComponentsWebGlRunLibProject>$(ComponentsRepoRoot)\src\CanDoItAll.Components.WebGlRunLib\CanDoItAll.Components.WebGlRunLib.csproj</ComponentsWebGlRunLibProject>
    <UseComponentsWebGlPackages Condition="'$(UseComponentsWebGlPackages)' == ''">false</UseComponentsWebGlPackages>
    <ComponentsWebGlLibPackageVersion Condition="'$(ComponentsWebGlLibPackageVersion)' == ''">$(CanDoItAllComponentsPackageVersion)</ComponentsWebGlLibPackageVersion>
    <ComponentsWebGlRunLibPackageVersion Condition="'$(ComponentsWebGlRunLibPackageVersion)' == ''">$(CanDoItAllComponentsPackageVersion)</ComponentsWebGlRunLibPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.Economy.BusinessObjects\CanDoItAll.Economy.BusinessObjects.csproj" />
    <ProjectReference Include="..\CanDoItAll.Economy.Cryptography\CanDoItAll.Economy.Cryptography.csproj" />
    <ProjectReference Include="..\CanDoItAll.Economy.Ledger\CanDoItAll.Economy.Ledger.csproj" />
    <ProjectReference Include="..\CanDoItAll.Economy.Sdk\CanDoItAll.Economy.Sdk.csproj" />
    <ProjectReference Include="..\CanDoItAll.Economy.Storage.InMemory\CanDoItAll.Economy.Storage.InMemory.csproj" />
    <ProjectReference Condition="'$(UseComponentsWebGlPackages)' != 'true' and Exists('$(ComponentsWebGlLibProject)')" Include="$(ComponentsWebGlLibProject)" />
    <ProjectReference Condition="'$(UseComponentsWebGlPackages)' != 'true' and Exists('$(ComponentsWebGlRunLibProject)')" Include="$(ComponentsWebGlRunLibProject)" />
    <PackageReference Include="CanDoItAll.Components.BaseLib" Version="$(CanDoItAllComponentsPackageVersion)" />
    <PackageReference Include="CanDoItAll.Components.Charts" Version="$(CanDoItAllComponentsPackageVersion)" />
    <PackageReference Include="CanDoItAll.Components.Mermaid" Version="$(CanDoItAllComponentsPackageVersion)" />
    <PackageReference Condition="'$(UseComponentsWebGlPackages)' == 'true'" Include="CanDoItAll.Components.WebGlLib" Version="$(ComponentsWebGlLibPackageVersion)" />
    <PackageReference Condition="'$(UseComponentsWebGlPackages)' == 'true'" Include="CanDoItAll.Components.WebGlRunLib" Version="$(ComponentsWebGlRunLibPackageVersion)" />
  </ItemGroup>
  <Target Name="ValidateComponentsWebGlLibReference" BeforeTargets="ResolveReferences" Condition="'$(UseComponentsWebGlPackages)' != 'true' and !Exists('$(ComponentsWebGlLibProject)')">
    <Error Text="CanDoItAll.Components.WebGlLib project reference was not found at '$(ComponentsWebGlLibProject)'. Set ComponentsRepoRoot to the local CanDoItAll.Components checkout or set UseComponentsWebGlPackages=true." />
  </Target>
  <Target Name="ValidateComponentsWebGlRunLibReference" BeforeTargets="ResolveReferences" Condition="'$(UseComponentsWebGlPackages)' != 'true' and !Exists('$(ComponentsWebGlRunLibProject)')">
    <Error Text="CanDoItAll.Components.WebGlRunLib project reference was not found at '$(ComponentsWebGlRunLibProject)'. Set ComponentsRepoRoot to the local CanDoItAll.Components checkout or set UseComponentsWebGlPackages=true." />
  </Target>
</Project>
