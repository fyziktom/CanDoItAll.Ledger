# Copy to ignored .env for local development, or pass this example explicitly
# to validation commands. Replace the placeholder passwords before shared use.
COMPOSE_PROJECT_NAME=candoitall-ledger
CDA_BIND_ADDRESS=127.0.0.1
CDA_COMPONENTS_PACKAGE_VERSION=0.1.4

POSTGRES_IMAGE_TAG=16-alpine
POSTGRES_DB=candoitall_ledger
POSTGRES_USER=candoitall
POSTGRES_PASSWORD=replace-for-local-development
LEDGER_POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=candoitall_ledger;Username=candoitall;Password=replace-for-local-development
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
POSTGRES_PID_LIMIT=256

LEDGER_NODE_IMAGE=candoitall-ledger-node:dev
LEDGER_NODE_PORT=8080
LEDGER_NODE_MEMORY_LIMIT=1g
LEDGER_NODE_CPU_LIMIT=1.0
LEDGER_NODE_PID_LIMIT=256

ACCOUNTAPP_IMAGE=candoitall-ledger-accountapp:dev
ACCOUNTAPP_ALICE_PORT=5081
ACCOUNTAPP_BOB_PORT=5082
ACCOUNTAPP_LAB_PORT=5083
ACCOUNTAPP_MEMORY_LIMIT=256m
ACCOUNTAPP_CPU_LIMIT=0.50
ACCOUNTAPP_PID_LIMIT=128

DEMO_SEEDER_IMAGE=candoitall-ledger-demo-seeder:dev
DEMO_SEEDER_MEMORY_LIMIT=512m
DEMO_SEEDER_CPU_LIMIT=1.0
DEMO_SEEDER_PID_LIMIT=128
LEDGER_ACCOUNT_BACKUP_PASSWORD=replace-for-local-development
