@page "/buy-bo/{ObjectId}"
@page "/buy-bo/tx/{TransactionHash}"
@page "/buy-bo/tx/{TransactionHash}/{OutputIndex:int}"
@inject AccountAppSession Session
@inject ILedgerReadClient LedgerReadClient
@inject IBusinessObjectCastRegistry CastRegistry
@inject NavigationManager Navigation
@inject NotificationService Notifications

<PageTitle>Buy BusinessObject</PageTitle>

<main class="buy-bo-page">
<PageScaffold data-testid="buy-bo-page">
    <Header>
        <PageHeader Eyebrow="Buy BusinessObject"
                    Title="@DisplayTitle"
                    Description="Review the listing, unlock a buyer vault, and submit the payment through the configured ledger node." />
    </Header>

    <ChildContent>
        <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined" data-testid="buy-bo-node-api">
        Node API: @Session.Options.NodeBaseUri / @Session.Options.ApiBasePath / @Session.Options.LedgerId / @(Session.Options.ScenarioId ?? "live")
    </Alert>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <Alert AlertStyle="AlertStyle.Danger" data-testid="buy-bo-error">
            @errorMessage
        </Alert>
    }

    @if (isLoading)
    {
        <SectionCard Title="Loading listing" Description="Reading the canonical BusinessObject and sale terms from the ledger." data-testid="buy-bo-loading">
            <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
                Loading the listing and canonical sale terms...
            </Alert>
        </SectionCard>
    }
    else if (targetView is not null && saleTerms is not null)
    {
        <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
            <Grid ColumnsLg="2" Gap="LayoutGap.Large">
                <section data-testid="buy-bo-listing">
                <BusinessObjectLedgerDetailsDialogContent Object="targetView"
                                                          ViewedAtUtc="targetHolding?.CreatedAt"
                                                          ShowActions="false" />
                </section>

                <SectionCard Title="@(Session.IsUnlocked ? "Buyer account" : "Unlock buyer account")"
                             Description="Sale terms and the local browser vault used to authorize payment."
                             data-testid="buy-bo-account">
                    <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                        <SummaryTiles>
                            <SummaryTile Label="Mode" Value="@saleTerms.Mode.ToString()" Compact="true" />
                            <SummaryTile Label="Price" Value="@FormatPrice(saleTerms.PriceAmount, saleTerms.TokenId)" Tone="info" Compact="true" />
                            <SummaryTile Label="Seller" Value="@saleTerms.SellerAddress" Compact="true" />
                            @if (saleTerms.MaxClones is not null)
                            {
                                <SummaryTile Label="Copies" Value="@($"{saleTerms.SoldCount} / {saleTerms.MaxClones}")" Compact="true" />
                            }
                            @if (Session.IsUnlocked)
                            {
                                <SummaryTile Label="Buyer" Value="@Session.Account?.Address.Value" Compact="true" />
                                <SummaryTile Label="Vault" Value="@Session.Account?.DisplayName" Compact="true" />
                            }
                        </SummaryTiles>

                        @if (Session.IsUnlocked)
                        {
                            <Button Text="Submit payment"
                                    Icon="payments"
                                    Disabled="@(!CanSubmitPurchase)"
                                    Click="SubmitPurchaseAsync"
                                    data-testid="buy-bo-submit" />
                        }
                        else
                        {
                            <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                @Session.StatusMessage
                            </Alert>
                            <FormField Text="Vault password">
                                <TextBox type="password"
                                         Immediate="true"
                                         @bind-Value="Session.UnlockPassword"
                                         autocomplete="current-password"
                                         data-testid="buy-unlock-password" />
                            </FormField>
                            <Button Text="Unlock vault"
                                    Icon="vpn_key"
                                    Disabled="@(!Session.HasStoredVault)"
                                    Click="UnlockAccountAsync"
                                    data-testid="buy-unlock-account" />
                        }
                    </Stack>
                </SectionCard>
            </Grid>

            @if (!Session.IsUnlocked)
            {
                <SectionCard Title="Import encrypted backup"
                             Description="Restore an existing account into a new encrypted browser vault."
                             data-testid="buy-import-backup">
                    <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                        <FormField Text="Backup JSON">
                            <TextArea Rows="8"
                                      Immediate="true"
                                      @bind-Value="Session.ImportBackupJson"
                                      data-testid="buy-backup-import-json" />
                        </FormField>
                        <Grid ColumnsLg="3" Gap="LayoutGap.Medium">
                            <FormField Text="Backup password">
                                <TextBox type="password"
                                         Immediate="true"
                                         @bind-Value="Session.ImportBackupPassword"
                                         data-testid="buy-backup-import-password" />
                            </FormField>
                            <FormField Text="New vault password">
                                <TextBox type="password"
                                         Immediate="true"
                                         @bind-Value="Session.ImportNewPassword"
                                         data-testid="buy-backup-new-password" />
                            </FormField>
                            <FormField Text="Confirm new password">
                                <TextBox type="password"
                                         Immediate="true"
                                         @bind-Value="Session.ImportConfirmPassword"
                                         data-testid="buy-backup-confirm-password" />
                            </FormField>
                        </Grid>
                        <Button Text="Import and unlock"
                                Icon="restore"
                                Click="ImportBackupAsync"
                                data-testid="buy-import-backup-submit" />
                    </Stack>
                </SectionCard>
            }
        </Stack>
    }

    @if (purchaseResult is not null)
    {
        <SectionCard Title="@(purchaseResult.Accepted ? "Payment submitted" : "Payment rejected")"
                     Description="@purchaseResult.Message"
                     data-testid="buy-bo-payment-result">
            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                @if (purchaseResult.TxId is not null)
                {
                    <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined">
                        Transaction: @purchaseResult.TxId.Value
                    </Alert>
                }
                @if (purchaseResult.ResultBusinessObjectId is { } paymentObjectId)
                {
                    <Alert AlertStyle="AlertStyle.Success" Variant="Variant.Outlined">
                        Payment BO: @paymentObjectId.Value
                    </Alert>
                }
                @if (purchaseResult.Accepted)
                {
                    <Button Text="Open gallery"
                            Icon="photo_library"
                            Click="OpenGallery"
                            data-testid="buy-bo-open-gallery" />
                }
            </Stack>
        </SectionCard>
    }
    </ChildContent>
</PageScaffold>
</main>

@code {
    [Parameter]
    public string? ObjectId { get; set; }

    [Parameter]
    public string? TransactionHash { get; set; }

    [Parameter]
    public int? OutputIndex { get; set; }

    private LedgerBusinessObjectHolding? targetHolding;
    private IBusinessObjectView? targetView;
    private BusinessObjectSaleTerms? saleTerms;
    private EconomyTransactionExecutionResult? purchaseResult;
    private string? errorMessage;
    private bool isLoading = true;

    private LedgerAccountContext Context
        => new(new LedgerId(Session.Options.LedgerId), string.IsNullOrWhiteSpace(Session.Options.ScenarioId) ? null : new ScenarioId(Session.Options.ScenarioId));

    private string DisplayTitle
        => targetView is IMediaBusinessObjectView media && !string.IsNullOrWhiteSpace(media.Name)
            ? media.Name
            : targetView?.ObjectId.Value ?? ObjectId ?? TransactionHash ?? "BusinessObject listing";

    private bool CanSubmitPurchase
        => Session.IsUnlocked
            && saleTerms is { Status: BusinessObjectSaleStatus.Listed }
            && string.IsNullOrWhiteSpace(saleTerms.TokenId)
            && purchaseResult?.Accepted != true;

    protected override async Task OnParametersSetAsync()
    {
        await Session.InitializeAsync();
        await LoadListingAsync();
    }

    private async Task LoadListingAsync()
    {
        isLoading = true;
        errorMessage = null;
        purchaseResult = null;
        try
        {
            targetHolding = string.IsNullOrWhiteSpace(TransactionHash)
                ? await LoadHoldingByObjectIdAsync()
                : await LoadHoldingByTransactionAsync();
            if (targetHolding is null)
            {
                throw new InvalidOperationException("The requested BusinessObject was not found.");
            }

            targetView = await CastRegistry.CastAsync(
                new BusinessObjectCastSource(
                    Context,
                    targetHolding.ObjectId,
                    targetHolding.ObjectType,
                    targetHolding.SchemaVersion,
                    targetHolding.Version,
                    targetHolding.OwnerAddress,
                    targetHolding.Operation,
                    targetHolding.DataHash,
                    targetHolding.CurrentOutPoint,
                    targetHolding.StateJson,
                    targetHolding.ExternalRef,
                    targetHolding.ItemType,
                    targetHolding.CreatedAt),
                CancellationToken.None);

            if (!BusinessObjectCommercePayloadBuilder.TryGetSaleTerms(targetHolding.StateJson, out saleTerms)
                || saleTerms is not { Status: BusinessObjectSaleStatus.Listed })
            {
                throw new InvalidOperationException("This BusinessObject is not currently listed for sale.");
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            targetHolding = null;
            targetView = null;
            saleTerms = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<LedgerBusinessObjectHolding?> LoadHoldingByObjectIdAsync()
    {
        if (string.IsNullOrWhiteSpace(ObjectId))
        {
            throw new InvalidOperationException("BusinessObject id or transaction hash is required.");
        }

        var objectId = new BusinessObjectId(Uri.UnescapeDataString(ObjectId).Trim());
        if (!objectId.IsCanonicalOutPointId())
        {
            throw new InvalidOperationException(
                "BusinessObject id must be a confirmed UTXO id in '64-character transaction-hash:output-index' format.");
        }

        return await LedgerReadClient.GetBusinessObjectAsync(
            new LedgerBusinessObjectQuery(Context, ObjectId: objectId),
            CancellationToken.None);
    }

    private async Task<LedgerBusinessObjectHolding?> LoadHoldingByTransactionAsync()
    {
        string txHash = Uri.UnescapeDataString(TransactionHash ?? string.Empty);
        if (string.IsNullOrWhiteSpace(txHash))
        {
            throw new InvalidOperationException("Transaction hash is required.");
        }

        LedgerTransactionSummary? transaction = await LedgerReadClient.GetTransactionAsync(
            Context,
            new TxId(txHash),
            includeData: true,
            CancellationToken.None);
        if (transaction is null)
        {
            throw new InvalidOperationException("The requested BusinessObject transaction was not found.");
        }

        LedgerTransactionOutputSummary output = ResolveBusinessObjectOutput(transaction);
        if (!output.HasBusinessObject)
        {
            throw new InvalidOperationException("The requested transaction output does not contain a BusinessObject.");
        }
        BusinessObjectId objectId = BusinessObjectId.FromOutPoint(transaction.TxId, output.OutputIndex);

        return await LedgerReadClient.GetBusinessObjectAsync(
            new LedgerBusinessObjectQuery(Context, ObjectId: objectId),
            CancellationToken.None);
    }

    private LedgerTransactionOutputSummary ResolveBusinessObjectOutput(LedgerTransactionSummary transaction)
    {
        if (OutputIndex is int outputIndex)
        {
            LedgerTransactionOutputSummary? output = transaction.Outputs
                .FirstOrDefault(item => item.OutputIndex == outputIndex);
            if (output is null)
            {
                throw new InvalidOperationException($"Transaction output {outputIndex} was not found.");
            }

            if (!output.HasBusinessObject)
            {
                throw new InvalidOperationException($"Transaction output {outputIndex} does not contain a BusinessObject.");
            }

            return output;
        }

        LedgerTransactionOutputSummary? businessObjectOutput = transaction.Outputs
            .Where(output => output.HasBusinessObject)
            .OrderBy(output => output.OutputIndex)
            .FirstOrDefault();

        return businessObjectOutput
            ?? throw new InvalidOperationException("The requested transaction does not contain a BusinessObject output.");
    }

    private async Task UnlockAccountAsync()
    {
        await Session.UnlockAccountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ImportBackupAsync()
    {
        await Session.ImportVaultBackupAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SubmitPurchaseAsync()
    {
        errorMessage = null;
        try
        {
            if (targetHolding is null || saleTerms is null || Session.Account is null)
            {
                throw new InvalidOperationException("A listed BusinessObject and unlocked buyer account are required.");
            }

            if (!string.IsNullOrWhiteSpace(saleTerms.TokenId))
            {
                throw new InvalidOperationException("Token-priced BO purchases are not enabled in this AccountApp flow yet.");
            }

            if (!Address.TryParse(saleTerms.SellerAddress, out Address sellerAddress))
            {
                throw new InvalidOperationException("The seller address in sale terms is invalid.");
            }

            DateTimeOffset now = DateTimeOffset.UtcNow;
            BusinessObjectPaymentRecord payment = BusinessObjectCommercePayloadBuilder.CreatePaymentRecord(
                Session.Account.Address,
                sellerAddress,
                targetHolding.ObjectId,
                targetHolding.Version,
                targetHolding.CurrentOutPoint,
                new Amount(saleTerms.PriceAmount),
                saleTerms.Mode,
                paymentTxId: null,
                now,
                tokenId: null,
                saleTerms.MaxClones);

            string paymentState = BusinessObjectPayloadBuilder.Serialize(
                BusinessObjectCommercePayloadBuilder.CreatePaymentPayload(payment));
            string paymentRequestId = Guid.NewGuid().ToString("N");
            var draft = BusinessObjectCarrierTokenPolicy.WithDefaultCarrierToken(new BusinessObjectTransactionDraft(
                default,
                "payment",
                "1.0",
                sellerAddress,
                sellerAddress,
                sellerAddress,
                new Amount(saleTerms.PriceAmount),
                new Amount(saleTerms.PriceAmount),
                paymentState,
                $"bo-commerce://payment/request/{paymentRequestId}",
                BusinessObjectTransactionMode.Create),
                Session.Workspace?.TokenOptions,
                allowBalanceFallback: true);

            purchaseResult = await Session.WorkspaceAdapter.SubmitTransactionAsync(draft);
            Session.ApplyTransactionResult(purchaseResult);
            if (purchaseResult.Accepted)
            {
                Notifications.Success(
                    "Payment submitted",
                    "Payment was accepted. Open Gallery to watch the purchase record and delivered BO.",
                    position: NotificationPosition.BottomCenter);
                await Session.RefreshWorkspaceAsync();
            }
            else
            {
                Notifications.Error(
                    "Payment rejected",
                    purchaseResult.Message,
                    position: NotificationPosition.BottomCenter);
            }
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
            Notifications.Error("Purchase failed", exception.Message, position: NotificationPosition.BottomCenter);
        }
    }

    private void OpenGallery()
        => Navigation.NavigateTo("/?view=gallery");

    private static string FormatPrice(decimal amount, string? tokenId)
        => $"{amount:0.#############################} {(string.IsNullOrWhiteSpace(tokenId) ? BusinessObjectCommercePayloadBuilder.MainCurrencyCode : tokenId)}";
}
