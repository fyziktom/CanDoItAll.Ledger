@page "/"
@inject AccountAppSession Session
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>CanDoItAll AccountApp</PageTitle>

<div class="account-app @(Session.IsUnlocked ? "account-app--unlocked" : "account-app--locked")" data-testid="account-app-root">
    @if (Session.IsUnlocked)
    {
        <header class="account-app__workspace-frame" data-testid="unlocked-account">
            <div class="account-app__identity">
                <div class="account-app__avatar" aria-hidden="true">@AccountInitials</div>
                <div>
                    <span class="account-app__eyebrow">AccountApp WASM PWA</span>
                    <h1>@(Session.Account?.DisplayName ?? "Browser account workspace")</h1>
                    <CopyableMonoValue Value="@(Session.Account?.Address.Value ?? string.Empty)"
                                       StartChars="12"
                                       EndChars="6"
                                       AriaLabel="Copy account address" />
                </div>
            </div>

            <div class="account-app__frame-facts">
                <div>
                    <span>Node</span>
                    <strong>@Session.Options.NodeBaseUri</strong>
                </div>
                <div>
                    <span>Ledger</span>
                    <strong>@Session.Options.LedgerId / @(Session.Options.ScenarioId ?? "live")</strong>
                </div>
                <div>
                    <span>Signing</span>
                    <strong>Browser WebCrypto</strong>
                </div>
            </div>

            <Toolbar Class="account-app__frame-actions" data-testid="account-actions">
                <PageHeaderActionButton Icon="refresh"
                                        Label="Refresh API data"
                                        TooltipText="Refresh API data"
                                        Click="RefreshWorkspaceAsync"
                                        TestId="refresh-workspace" />
                <PageHeaderActionButton Icon="info"
                                        Label="Load latest detail"
                                        TooltipText="Load latest transaction detail"
                                        Click="LoadTransactionDetailsAsync"
                                        TestId="load-transaction-detail" />
                <PageHeaderActionButton Icon="send"
                                        Label="Sign and broadcast"
                                        TooltipText="Sign and broadcast a smoke payment"
                                        ButtonStyle="ButtonStyle.Secondary"
                                        Click="SubmitSignedPaymentAsync"
                                        TestId="submit-signed-payment" />
                <PageHeaderActionButton Icon="download"
                                        Label="Export encrypted backup"
                                        TooltipText="Export encrypted account vault backup"
                                        Click="ExportBackupAsync"
                                        TestId="export-backup" />
                <PageHeaderActionButton Icon="archive"
                                        Label="Settings backup"
                                        TooltipText="Import or export browser-local settings"
                                        Click="OpenSettingsBackupAsync"
                                        TestId="settings-backup" />
            </Toolbar>
        </header>
    }
    else
    {
        <header class="account-app__topbar">
            <div>
                <span class="account-app__eyebrow">AccountApp WASM PWA</span>
                <h1>Browser account workspace</h1>
            </div>
            <div class="account-app__connection" data-testid="node-api-connection">
                <span class="material-icons" aria-hidden="true">hub</span>
                <div>
                    <strong>@Session.Options.NodeBaseUri</strong>
                    <span>@Session.Options.ApiBasePath / @Session.Options.LedgerId / @(Session.Options.ScenarioId ?? "live")</span>
                </div>
            </div>
        </header>

        <section class="account-app__status" data-testid="account-status">
            <span class="material-icons" aria-hidden="true">encrypted</span>
            <div>
                <strong>Locked browser vault</strong>
                <span>@Session.StatusMessage</span>
            </div>
        </section>
    }

    @if (Session.ErrorMessage is not null)
    {
        <section class="account-app__alert" data-testid="account-error">
            <span class="material-icons" aria-hidden="true">error</span>
            <span>@Session.ErrorMessage</span>
        </section>
    }

    @if (!Session.IsUnlocked)
    {
        <section class="account-app__setup-grid" data-testid="first-run-account-flow">
            <article class="account-card">
                <header>
                    <span class="material-icons" aria-hidden="true">person_add</span>
                    <h2>Create account</h2>
                </header>
                <label>
                    <span>Account name</span>
                    <input data-testid="account-name" @bind="Session.AccountName" autocomplete="username" />
                </label>
                <label>
                    <span>Private key password</span>
                    <input data-testid="create-password" type="password" @bind="Session.CreatePassword" autocomplete="new-password" />
                </label>
                <label>
                    <span>Confirm password</span>
                    <input data-testid="create-confirm-password" type="password" @bind="Session.CreateConfirmPassword" autocomplete="new-password" />
                </label>
                <button data-testid="create-account" class="account-button account-button--primary" @onclick="CreateAccountAsync">
                    <span class="material-icons" aria-hidden="true">check_circle</span>
                    <span>Create encrypted vault</span>
                </button>
            </article>

            <article class="account-card">
                <header>
                    <span class="material-icons" aria-hidden="true">lock_open</span>
                    <h2>Unlock account</h2>
                </header>
                <p class="account-card__hint">Use the password for the encrypted vault stored in this browser.</p>
                <label>
                    <span>Vault password</span>
                    <input data-testid="unlock-password" type="password" @bind="Session.UnlockPassword" autocomplete="current-password" />
                </label>
                <button data-testid="unlock-account" class="account-button" disabled="@(!Session.HasStoredVault)" @onclick="UnlockAccountAsync">
                    <span class="material-icons" aria-hidden="true">vpn_key</span>
                    <span>Unlock vault</span>
                </button>
            </article>

            <article class="account-card account-card--wide">
                <header>
                    <span class="material-icons" aria-hidden="true">upload_file</span>
                    <h2>Import encrypted backup</h2>
                </header>
                <label>
                    <span>Backup JSON</span>
                    <textarea data-testid="backup-import-json" rows="8" @bind="Session.ImportBackupJson"></textarea>
                </label>
                <div class="account-form-grid">
                    <label>
                        <span>Backup password</span>
                        <input data-testid="backup-import-password" type="password" @bind="Session.ImportBackupPassword" />
                    </label>
                    <label>
                        <span>New vault password</span>
                        <input data-testid="backup-new-password" type="password" @bind="Session.ImportNewPassword" />
                    </label>
                    <label>
                        <span>Confirm new password</span>
                        <input data-testid="backup-confirm-password" type="password" @bind="Session.ImportConfirmPassword" />
                    </label>
                </div>
                <button data-testid="import-backup" class="account-button" @onclick="ImportBackupAsync">
                    <span class="material-icons" aria-hidden="true">restore</span>
                    <span>Import and re-encrypt</span>
                </button>
            </article>

            <article class="account-card account-card--wide">
                <header>
                    <span class="material-icons" aria-hidden="true">key</span>
                    <h2>Import pasted key pair</h2>
                </header>
                <div class="account-form-grid account-form-grid--two">
                    <label>
                        <span>Display name</span>
                        <input data-testid="pasted-key-name" @bind="Session.PastedKeyName" />
                    </label>
                    <label>
                        <span>New vault password</span>
                        <input data-testid="pasted-key-password" type="password" @bind="Session.PastedKeyPassword" />
                    </label>
                    <label>
                        <span>Confirm password</span>
                        <input data-testid="pasted-key-confirm-password" type="password" @bind="Session.PastedKeyConfirmPassword" />
                    </label>
                </div>
                <label>
                    <span>Public key material base64</span>
                    <textarea data-testid="pasted-public-key" rows="3" @bind="Session.PastedPublicKeyBase64"></textarea>
                </label>
                <label>
                    <span>Private key material base64</span>
                    <textarea data-testid="pasted-private-key" rows="3" @bind="Session.PastedPrivateKeyBase64"></textarea>
                </label>
                <button data-testid="import-pasted-key" class="account-button" @onclick="ImportPastedKeyAsync">
                    <span class="material-icons" aria-hidden="true">input</span>
                    <span>Import key pair</span>
                </button>
            </article>
        </section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Session.BackupJson))
        {
            <section class="account-card account-card--wide" data-testid="backup-export">
                <header>
                    <span class="material-icons" aria-hidden="true">shield</span>
                    <h2>Encrypted backup</h2>
                </header>
                <p class="account-card__hint">@Session.BackupStatus</p>
                <textarea readonly rows="10">@Session.BackupJson</textarea>
            </section>
        }

        <section data-testid="wasm-workspace">
            <EconomyAccountWorkspaceAdapterHost Adapter="Session.WorkspaceAdapter"
                                                UseFullAppShell="true"
                                                InitialView="@View"
                                                WorkspaceLoaded="OnWorkspaceLoaded"
                                                TransactionSubmitted="OnTransactionSubmitted" />
        </section>

        @if (Session.SelectedTransactionDetails is not null)
        {
            <section class="account-card account-card--wide" data-testid="transaction-detail">
                <TransactionDetailsDialogContent Details="Session.SelectedTransactionDetails" />
            </section>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    protected override async Task OnInitializedAsync()
        => await Session.InitializeAsync();

    private string AccountInitials
    {
        get
        {
            string name = Session.Account?.DisplayName ?? Session.AccountName;
            string initials = string.Concat(name
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));
            return string.IsNullOrWhiteSpace(initials) ? "AA" : initials;
        }
    }

    private async Task CreateAccountAsync()
        => await InvokeSessionAsync(Session.CreateAccountAsync, "Account created");

    private async Task UnlockAccountAsync()
        => await InvokeSessionAsync(Session.UnlockAccountAsync, "Vault unlocked");

    private async Task ImportBackupAsync()
        => await InvokeSessionAsync(Session.ImportVaultBackupAsync, "Backup imported");

    private async Task ImportPastedKeyAsync()
        => await InvokeSessionAsync(Session.ImportPastedKeyPairAsync, "Key pair imported");

    private async Task RefreshWorkspaceAsync()
        => await InvokeSessionAsync(Session.RefreshWorkspaceAsync, "Workspace refreshed");

    private async Task LoadTransactionDetailsAsync()
        => await InvokeSessionAsync(Session.LoadLatestTransactionDetailsAsync, "Transaction detail loaded");

    private async Task SubmitSignedPaymentAsync()
        => await InvokeSessionAsync(Session.SubmitSignedPaymentSmokeAsync, "Signed payment submitted");

    private async Task ExportBackupAsync()
        => await InvokeSessionAsync(Session.ExportVaultBackupAsync, "Encrypted backup exported");

    private Task OpenSettingsBackupAsync()
        => DialogService.OpenAsync<SettingsBackupDialogContent>(
            "Browser Settings Backup",
            new Dictionary<string, object?>
            {
                [nameof(SettingsBackupDialogContent.AccountScope)] = Session.Account?.Address.Value ?? "default"
            },
            new DialogOptions
            {
                Subtitle = "Import/export browser-local preferences and UI metadata.",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-vef-dialog cda-vef-dialog--settings-backup",
                TestId = "cda-settings-backup-dialog"
            });

    private void OnWorkspaceLoaded(BusinessObjectWorkspaceModel workspace)
        => Session.ApplyWorkspace(workspace);

    private void OnTransactionSubmitted(EconomyTransactionExecutionResult result)
        => Session.ApplyTransactionResult(result);

    private async Task InvokeSessionAsync(Func<CancellationToken, Task> action, string successTitle)
    {
        await action(CancellationToken.None);
        if (Session.ErrorMessage is null)
        {
            Notifications.Success(successTitle, Session.StatusMessage, position: NotificationPosition.BottomCenter);
        }
        else
        {
            Notifications.Error("Account action failed", Session.ErrorMessage, position: NotificationPosition.BottomCenter);
        }

        await InvokeAsync(StateHasChanged);
    }
}
