@page "/"
@inject AccountAppSession Session
@inject DialogService DialogService
@inject NotificationService Notifications

<PageTitle>CanDoItAll AccountApp</PageTitle>

<div class="account-app @(Session.IsUnlocked ? "account-app--unlocked" : "account-app--locked")" data-testid="account-app-root">
    @if (!Session.IsUnlocked)
    {
        <main class="account-entry" data-testid="account-entry">
            <PageScaffold>
            @if (Session.HasStoredVault)
            {
                <div class="account-entry__center-shell account-entry__center-shell--login" data-testid="stored-vault-login">
                    <PageHeader Eyebrow="AccountApp WASM PWA"
                                Title="Unlock account"
                                Description="@Session.StatusMessage" />

                    @if (Session.ErrorMessage is not null)
                    {
                        <Alert AlertStyle="AlertStyle.Danger" data-testid="account-error">
                            @Session.ErrorMessage
                        </Alert>
                    }

                    <FormSection Title="Stored browser vault"
                                 Icon="lock_open"
                                 Description="Use the password for the encrypted account stored in this browser.">
                        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                            <FormField Text="Vault password">
                                <TextBox type="password"
                                         Immediate="true"
                                         @bind-Value="Session.UnlockPassword"
                                         autocomplete="current-password"
                                         data-testid="unlock-password" />
                            </FormField>
                            <Cluster Gap="LayoutGap.Small">
                                <Button Text="Unlock vault"
                                        Icon="vpn_key"
                                        Click="UnlockAccountAsync"
                                        data-testid="unlock-account" />
                                <Button Text="Cancel"
                                        Variant="Variant.Outlined"
                                        ButtonStyle="ButtonStyle.Secondary"
                                        Click="CancelUnlockAsync"
                                        data-testid="unlock-cancel" />
                            </Cluster>
                            @if (!string.IsNullOrWhiteSpace(recoveryHint))
                            {
                                <Alert AlertStyle="AlertStyle.Info" Variant="Variant.Outlined" data-testid="reset-recovery-hint">
                                    @recoveryHint
                                </Alert>
                            }
                        </Stack>
                    </FormSection>
                </div>

                @if (showResetRecoveryDialog)
                {
                    <Dialog IsOpen="true"
                            Eyebrow="Local recovery"
                            Title="Reset stored browser vault"
                            Subtitle="This action affects only the encrypted vault stored in this browser."
                            Size="ModalSize.Compact"
                            CloseOnBackdrop="false"
                            ShowCloseButton="false"
                            OnClose="CloseResetRecoveryDialog"
                            TestId="reset-recovery-dialog">
                        <HeaderActions>
                            <Button Text="Keep account"
                                    Icon="close"
                                    Variant="Variant.Text"
                                    ButtonStyle="ButtonStyle.Secondary"
                                    Click="CloseResetRecoveryDialog"
                                    aria-label="Keep account"
                                    data-testid="reset-recovery-close" />
                        </HeaderActions>
                        <ChildContent>
                            <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                                <Alert AlertStyle="AlertStyle.Warning" Variant="Variant.Outlined">
                                    Ledger history and node data are not deleted.
                                </Alert>

                                <section class="account-entry__countdown" data-testid="reset-recovery-countdown">
                                    <strong>@(resetCountdownRemaining > 0 ? resetCountdownRemaining.ToString() : "Ready")</strong>
                                    <span>@(resetCountdownRemaining > 0 ? "Wait before the next confirmation." : "You can continue this recovery step.")</span>
                                </section>

                                @if (resetRecoveryStep == 1)
                                {
                                    <label class="account-entry__reset-check">
                                        <CheckBox TValue="bool"
                                                  @bind-Value="Session.ResetAcknowledged"
                                                  Disabled="@ResetCountdownActive"
                                                  aria-label="Acknowledge local reset"
                                                  data-testid="reset-acknowledge" />
                                        <span>I understand this is a local browser reset and not an account recovery service.</span>
                                    </label>
                                    <Cluster Gap="LayoutGap.Small">
                                        <Button Text="Continue reset check"
                                                Icon="timer"
                                                ButtonStyle="ButtonStyle.Danger"
                                                Disabled="@(!CanContinueResetRecovery)"
                                                Click="ContinueResetRecovery"
                                                data-testid="reset-recovery-continue" />
                                        <Button Text="Keep account"
                                                Variant="Variant.Outlined"
                                                ButtonStyle="ButtonStyle.Secondary"
                                                Click="CloseResetRecoveryDialog" />
                                    </Cluster>
                                }
                                else
                                {
                                    <FormField Text="@ResetConfirmationPrompt">
                                        <TextBox Immediate="true"
                                                 @bind-Value="Session.ResetConfirmation"
                                                 Disabled="@ResetCountdownActive"
                                                 autocomplete="off"
                                                 data-testid="reset-confirmation" />
                                    </FormField>
                                    <label class="account-entry__reset-check">
                                        <CheckBox TValue="bool"
                                                  @bind-Value="resetFinalAcknowledged"
                                                  Disabled="@ResetCountdownActive"
                                                  aria-label="Confirm local vault reset"
                                                  data-testid="reset-final-acknowledge" />
                                        <span>I confirm this browser should forget the stored encrypted vault now.</span>
                                    </label>
                                    <Cluster Gap="LayoutGap.Small">
                                        <Button Text="Reset local vault"
                                                Icon="delete_forever"
                                                ButtonStyle="ButtonStyle.Danger"
                                                Disabled="@(!CanExecuteResetRecovery)"
                                                Click="ExecuteResetRecoveryAsync"
                                                data-testid="reset-local-vault" />
                                        <Button Text="Keep account"
                                                Variant="Variant.Outlined"
                                                ButtonStyle="ButtonStyle.Secondary"
                                                Click="CloseResetRecoveryDialog" />
                                    </Cluster>
                                }
                            </Stack>
                        </ChildContent>
                    </Dialog>
                }
            }
            else
            {
                <div class="account-entry__center-shell account-entry__center-shell--first-run" data-testid="first-run-account-flow">
                    <PageHeader Eyebrow="AccountApp WASM PWA"
                                Title="Browser account workspace"
                                Description="@Session.StatusMessage" />

                    @if (Session.ErrorMessage is not null)
                    {
                        <Alert AlertStyle="AlertStyle.Danger" data-testid="account-error">
                            @Session.ErrorMessage
                        </Alert>
                    }

                    <FormSection Title="Create account"
                                 Icon="person_add"
                                 Description="Create a new encrypted browser vault for this device. There is no third-party password recovery.">
                        <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
                            <Grid ColumnsLg="3" Gap="LayoutGap.Medium">
                                <FormField Text="Account name">
                                    <TextBox Immediate="true"
                                             @bind-Value="Session.AccountName"
                                             autocomplete="username"
                                             data-testid="account-name" />
                                </FormField>
                                <FormField Text="Private key password">
                                    <TextBox type="password"
                                             Immediate="true"
                                             @bind-Value="Session.CreatePassword"
                                             autocomplete="new-password"
                                             data-testid="create-password" />
                                </FormField>
                                <FormField Text="Confirm password">
                                    <TextBox type="password"
                                             Immediate="true"
                                             @bind-Value="Session.CreateConfirmPassword"
                                             autocomplete="new-password"
                                             data-testid="create-confirm-password" />
                                </FormField>
                            </Grid>
                            <Button Text="Create encrypted vault"
                                    Icon="check_circle"
                                    Click="CreateAccountAsync"
                                    data-testid="create-account" />
                        </Stack>
                    </FormSection>

                    <div class="account-entry__divider">
                        <span>Or import an existing account</span>
                    </div>

                    <FormSection Title="Import account"
                                 Icon="upload_file"
                                 Description="Bring an existing AccountApp backup or pasted key pair into a new encrypted browser vault.">
                        <Steps @bind-Value="importStep"
                               CanSelect="false"
                               CanChange="CanChangeImportStepAsync"
                               NavigationPosition="StepsNavigationPosition.Bottom"
                               NextText="Next step"
                               PreviousText="Previous step"
                               NextButtonTestId="import-steps-next"
                               PreviousButtonTestId="import-steps-previous"
                               data-testid="import-account-steps">
                            <StepsItem Text="Import" Icon="upload_file" Description="Choose the source material and paste it into the browser.">
                                <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
                                    <div class="account-entry__mode-grid" role="radiogroup" aria-label="Import source">
                                        <label class="account-entry__mode-option @(importMode == AccountImportMode.Backup ? "account-entry__mode-option--selected" : null)">
                                            <input data-testid="import-mode-backup"
                                                   type="radio"
                                                   name="account-import-mode"
                                                   checked="@(importMode == AccountImportMode.Backup)"
                                                   @onchange="@(() => SelectImportMode(AccountImportMode.Backup))" />
                                            <span class="material-icons" aria-hidden="true">inventory_2</span>
                                            <strong>Encrypted backup</strong>
                                            <small>Paste a JSON backup exported from AccountApp.</small>
                                        </label>
                                        <label class="account-entry__mode-option @(importMode == AccountImportMode.KeyPair ? "account-entry__mode-option--selected" : null)">
                                            <input data-testid="import-mode-keypair"
                                                   type="radio"
                                                   name="account-import-mode"
                                                   checked="@(importMode == AccountImportMode.KeyPair)"
                                                   @onchange="@(() => SelectImportMode(AccountImportMode.KeyPair))" />
                                            <span class="material-icons" aria-hidden="true">key</span>
                                            <strong>Pasted key pair</strong>
                                            <small>Paste public and private key material directly.</small>
                                        </label>
                                    </div>

                                    @if (importMode == AccountImportMode.Backup)
                                    {
                                        <FormField Text="Backup JSON">
                                            <TextArea Rows="10"
                                                      Immediate="true"
                                                      @bind-Value="Session.ImportBackupJson"
                                                      data-testid="backup-import-json" />
                                        </FormField>
                                    }
                                    else
                                    {
                                        <Grid ColumnsLg="2" Gap="LayoutGap.Medium">
                                            <FormField Text="Display name">
                                                <TextBox Immediate="true"
                                                         @bind-Value="Session.PastedKeyName"
                                                         data-testid="pasted-key-name" />
                                            </FormField>
                                            <FormField Text="Public key material base64">
                                                <TextArea Rows="5"
                                                          Immediate="true"
                                                          @bind-Value="Session.PastedPublicKeyBase64"
                                                          data-testid="pasted-public-key" />
                                            </FormField>
                                        </Grid>
                                        <FormField Text="Private key material base64">
                                            <TextArea Rows="6"
                                                      Immediate="true"
                                                      @bind-Value="Session.PastedPrivateKeyBase64"
                                                      data-testid="pasted-private-key" />
                                        </FormField>
                                    }
                                </Stack>
                            </StepsItem>

                            <StepsItem Text="Password" Icon="lock" Description="Unlock the source if needed, then choose the new browser-vault password.">
                                <Grid ColumnsLg="3" Gap="LayoutGap.Medium">
                                    @if (importMode == AccountImportMode.Backup)
                                    {
                                        <FormField Text="Backup password">
                                            <TextBox type="password"
                                                     Immediate="true"
                                                     @bind-Value="Session.ImportBackupPassword"
                                                     autocomplete="current-password"
                                                     data-testid="backup-import-password" />
                                        </FormField>
                                        <FormField Text="New vault password">
                                            <TextBox type="password"
                                                     Immediate="true"
                                                     @bind-Value="Session.ImportNewPassword"
                                                     autocomplete="new-password"
                                                     data-testid="backup-new-password" />
                                        </FormField>
                                        <FormField Text="Confirm new password">
                                            <TextBox type="password"
                                                     Immediate="true"
                                                     @bind-Value="Session.ImportConfirmPassword"
                                                     autocomplete="new-password"
                                                     data-testid="backup-confirm-password" />
                                        </FormField>
                                    }
                                    else
                                    {
                                        <FormField Text="New vault password">
                                            <TextBox type="password"
                                                     Immediate="true"
                                                     @bind-Value="Session.PastedKeyPassword"
                                                     autocomplete="new-password"
                                                     data-testid="pasted-key-password" />
                                        </FormField>
                                        <FormField Text="Confirm password">
                                            <TextBox type="password"
                                                     Immediate="true"
                                                     @bind-Value="Session.PastedKeyConfirmPassword"
                                                     autocomplete="new-password"
                                                     data-testid="pasted-key-confirm-password" />
                                        </FormField>
                                    }
                                </Grid>

                                <Alert AlertStyle="@(HasImportPasswordStep ? AlertStyle.Success : AlertStyle.Warning)"
                                       Variant="Variant.Outlined"
                                       data-testid="import-password-status">
                                    @ImportPasswordStatus
                                </Alert>
                            </StepsItem>

                            <StepsItem Text="Finish" Icon="check_circle" Description="Review the selected source and import it into the encrypted browser vault.">
                                <Stack GapScale="LayoutGap.Large" AlignItems="AlignItems.Stretch">
                                    <SummaryTiles data-testid="import-review">
                                        <SummaryTile Label="Import source" Value="@ImportModeLabel" Compact="true" />
                                        <SummaryTile Label="Material status"
                                                     Value="@(HasImportMaterial ? "Ready" : "Missing")"
                                                     Tone="@(HasImportMaterial ? "success" : "warning")"
                                                     Compact="true" />
                                        <SummaryTile Label="Password status"
                                                     Value="@(HasImportPasswordStep ? "Ready" : "Needs attention")"
                                                     Tone="@(HasImportPasswordStep ? "success" : "warning")"
                                                     Compact="true" />
                                    </SummaryTiles>
                                    <Button Text="@ImportButtonText"
                                            Icon="restore"
                                            Disabled="@(!CanSubmitImport)"
                                            Click="ImportSelectedAccountAsync"
                                            data-testid="import-account-submit" />
                                </Stack>
                            </StepsItem>
                        </Steps>
                    </FormSection>
                </div>
            }
            </PageScaffold>
        </main>
    }
    else
    {
        @if (ShowBackupDialog)
        {
            <Dialog IsOpen="true"
                    Eyebrow="Account backup"
                    Title="Encrypted backup"
                    Subtitle="@Session.BackupStatus"
                    Size="ModalSize.Wide"
                    OnClose="DismissBackupDialog"
                    TestId="backup-export">
                <ChildContent>
                    <TextArea Value="@Session.BackupJson" ReadOnly="true" Rows="10" />
                </ChildContent>
            </Dialog>
        }

        <section data-testid="wasm-workspace">
            <EconomyAccountWorkspaceAdapterHost Adapter="Session.WorkspaceAdapter"
                                                UseFullAppShell="true"
                                                InitialView="@View"
                                                WorkspaceLoaded="OnWorkspaceLoaded"
                                                TransactionSubmitted="OnTransactionSubmitted" />
        </section>

        @if (ShowTransactionDetailsDialog)
        {
            <Dialog IsOpen="true"
                    Eyebrow="Confirmed ledger transaction"
                    Title="Transaction detail"
                    Subtitle="Review the confirmed ledger outputs."
                    Size="ModalSize.Full"
                    DenseChrome="true"
                    CloseOnBackdrop="false"
                    OnClose="DismissTransactionDetailsDialog"
                    TestId="transaction-detail">
                <ChildContent>
                    <TransactionDetailsDialogContent Details="Session.SelectedTransactionDetails" />
                </ChildContent>
            </Dialog>
        }
    }
</div>

@code {
    private const int ResetRevealCancelCount = 5;
    private const int ResetCountdownSeconds = 5;

    private enum AccountImportMode
    {
        Backup,
        KeyPair
    }

    [SupplyParameterFromQuery(Name = "view")]
    public string? View { get; set; }

    private int importStep;
    private AccountImportMode importMode = AccountImportMode.Backup;
    private int unlockCancelCount;
    private string? recoveryHint;
    private bool showResetRecoveryDialog;
    private int resetRecoveryStep = 1;
    private int resetCountdownRemaining;
    private int resetCountdownToken;
    private bool resetFinalAcknowledged;
    private string? dismissedBackupJson;
    private EconomyTransactionDetailsModel? dismissedTransactionDetails;

    protected override async Task OnInitializedAsync()
        => await Session.InitializeAsync();

    private bool HasBackupMaterial
        => !string.IsNullOrWhiteSpace(Session.ImportBackupJson);

    private bool ShowBackupDialog
        => !string.IsNullOrWhiteSpace(Session.BackupJson)
            && !string.Equals(Session.BackupJson, dismissedBackupJson, StringComparison.Ordinal);

    private bool ShowTransactionDetailsDialog
        => Session.SelectedTransactionDetails is not null
            && !ReferenceEquals(Session.SelectedTransactionDetails, dismissedTransactionDetails);

    private void DismissBackupDialog()
        => dismissedBackupJson = Session.BackupJson;

    private void DismissTransactionDetailsDialog()
        => dismissedTransactionDetails = Session.SelectedTransactionDetails;

    private bool HasPastedKeyMaterial
        => !string.IsNullOrWhiteSpace(Session.PastedPublicKeyBase64)
            && !string.IsNullOrWhiteSpace(Session.PastedPrivateKeyBase64);

    private bool HasImportMaterial
        => importMode == AccountImportMode.Backup ? HasBackupMaterial : HasPastedKeyMaterial;

    private bool HasBackupPasswords
        => !string.IsNullOrWhiteSpace(Session.ImportBackupPassword)
            && PasswordsMatch(Session.ImportNewPassword, Session.ImportConfirmPassword);

    private bool HasPastedKeyPasswords
        => PasswordsMatch(Session.PastedKeyPassword, Session.PastedKeyConfirmPassword);

    private bool HasImportPasswordStep
        => importMode == AccountImportMode.Backup ? HasBackupPasswords : HasPastedKeyPasswords;

    private bool CanSubmitImport
        => HasImportMaterial && HasImportPasswordStep;

    private bool ResetCountdownActive
        => resetCountdownRemaining > 0;

    private bool CanContinueResetRecovery
        => showResetRecoveryDialog
            && resetRecoveryStep == 1
            && !ResetCountdownActive
            && Session.ResetAcknowledged;

    private bool CanExecuteResetRecovery
        => showResetRecoveryDialog
            && resetRecoveryStep == 2
            && !ResetCountdownActive
            && resetFinalAcknowledged
            && Session.CanResetLocalVault;

    private string ImportModeLabel
        => importMode == AccountImportMode.Backup ? "Encrypted backup" : "Pasted key pair";

    private string ImportButtonText
        => importMode == AccountImportMode.Backup ? "Import encrypted backup" : "Import pasted key pair";

    private string ImportPasswordStatus
        => HasImportPasswordStep
            ? "Password fields are ready for import."
            : "Complete the required password fields before finishing import.";

    private static string ResetConfirmationPrompt
        => $"Type {AccountAppSession.ResetConfirmationPhrase} to enable reset";

    private static bool PasswordsMatch(string password, string confirmation)
        => !string.IsNullOrWhiteSpace(password)
            && string.Equals(password, confirmation, StringComparison.Ordinal);

    private void SelectImportMode(AccountImportMode mode)
    {
        importMode = mode;
        importStep = 0;
    }

    private Task<bool> CanChangeImportStepAsync(int targetStep)
    {
        if (targetStep <= importStep)
        {
            return Task.FromResult(true);
        }

        return Task.FromResult(targetStep switch
        {
            1 => HasImportMaterial,
            2 => HasImportMaterial && HasImportPasswordStep,
            _ => false
        });
    }

    private async Task CreateAccountAsync()
        => await InvokeSessionAsync(Session.CreateAccountAsync, "Account created");

    private async Task UnlockAccountAsync()
    {
        unlockCancelCount = 0;
        recoveryHint = null;
        await InvokeSessionAsync(Session.UnlockAccountAsync, "Vault unlocked");
    }

    private async Task CancelUnlockAsync()
    {
        Session.UnlockPassword = string.Empty;
        unlockCancelCount++;

        if (unlockCancelCount >= ResetRevealCancelCount)
        {
            OpenResetRecoveryDialog();
            await InvokeAsync(StateHasChanged);
            return;
        }

        int remaining = ResetRevealCancelCount - unlockCancelCount;
        recoveryHint = remaining == 1
            ? "Press Cancel one more time to open local recovery."
            : $"Press Cancel {remaining} more times to open local recovery.";
        await InvokeAsync(StateHasChanged);
    }

    private void OpenResetRecoveryDialog()
    {
        unlockCancelCount = 0;
        recoveryHint = null;
        showResetRecoveryDialog = true;
        resetRecoveryStep = 1;
        resetFinalAcknowledged = false;
        Session.ResetAcknowledged = false;
        Session.ResetConfirmation = string.Empty;
        StartResetCountdown();
    }

    private void CloseResetRecoveryDialog()
    {
        showResetRecoveryDialog = false;
        resetRecoveryStep = 1;
        resetFinalAcknowledged = false;
        resetCountdownRemaining = 0;
        resetCountdownToken++;
        Session.ResetAcknowledged = false;
        Session.ResetConfirmation = string.Empty;
    }

    private void ContinueResetRecovery()
    {
        if (!CanContinueResetRecovery)
        {
            return;
        }

        resetRecoveryStep = 2;
        resetFinalAcknowledged = false;
        Session.ResetConfirmation = string.Empty;
        StartResetCountdown();
    }

    private async Task ExecuteResetRecoveryAsync()
    {
        if (!CanExecuteResetRecovery)
        {
            return;
        }

        await ResetLocalVaultAsync();
        CloseResetRecoveryDialog();
    }

    private void StartResetCountdown()
    {
        int token = ++resetCountdownToken;
        resetCountdownRemaining = ResetCountdownSeconds;
        _ = RunResetCountdownAsync(token);
    }

    private async Task RunResetCountdownAsync(int token)
    {
        while (showResetRecoveryDialog && token == resetCountdownToken && resetCountdownRemaining > 0)
        {
            await Task.Delay(TimeSpan.FromSeconds(1));
            if (!showResetRecoveryDialog || token != resetCountdownToken)
            {
                return;
            }

            resetCountdownRemaining--;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ImportSelectedAccountAsync()
    {
        if (!CanSubmitImport)
        {
            return;
        }

        if (importMode == AccountImportMode.Backup)
        {
            await ImportBackupAsync();
        }
        else
        {
            await ImportPastedKeyAsync();
        }
    }

    private async Task ImportBackupAsync()
        => await InvokeSessionAsync(Session.ImportVaultBackupAsync, "Backup imported");

    private async Task ImportPastedKeyAsync()
        => await InvokeSessionAsync(Session.ImportPastedKeyPairAsync, "Key pair imported");

    private async Task ResetLocalVaultAsync()
        => await InvokeSessionAsync(Session.ResetLocalVaultAsync, "Local vault reset");

    private async Task RefreshWorkspaceAsync()
        => await InvokeSessionAsync(Session.RefreshWorkspaceAsync, "Workspace refreshed");

    private async Task LoadTransactionDetailsAsync()
        => await InvokeSessionAsync(Session.LoadLatestTransactionDetailsAsync, "Transaction detail loaded");

    private async Task SubmitSignedPaymentAsync()
        => await InvokeSessionAsync(Session.SubmitSignedPaymentSmokeAsync, "Signed payment submitted");

    private async Task ExportBackupAsync()
        => await InvokeSessionAsync(Session.ExportVaultBackupAsync, "Encrypted backup exported");

    private Task OpenSettingsBackupAsync()
        => DialogService.OpenAsync<SettingsBackupDialogContent>(
            "Browser Settings Backup",
            new Dictionary<string, object?>
            {
                [nameof(SettingsBackupDialogContent.AccountScope)] = Session.Account?.Address.Value ?? "default"
            },
            new DialogOptions
            {
                Subtitle = "Import/export browser-local preferences and UI metadata.",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-ledger-dialog",
                TestId = "cda-settings-backup-dialog"
            });

    private void OnWorkspaceLoaded(BusinessObjectWorkspaceModel workspace)
        => Session.ApplyWorkspace(workspace);

    private void OnTransactionSubmitted(EconomyTransactionExecutionResult result)
        => Session.ApplyTransactionResult(result);

    private async Task InvokeSessionAsync(Func<CancellationToken, Task> action, string successTitle)
    {
        await action(CancellationToken.None);
        if (Session.ErrorMessage is null)
        {
            Notifications.Success(successTitle, Session.StatusMessage, position: NotificationPosition.BottomCenter);
        }
        else
        {
            Notifications.Error("Account action failed", Session.ErrorMessage, position: NotificationPosition.BottomCenter);
        }

        await InvokeAsync(StateHasChanged);
    }
}
