<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CanDoItAll.Ledger.AppHost</AssemblyName>
    <RootNamespace>CanDoItAll.Ledger.AppHost</RootNamespace>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>candoitall-ledger-apphost-20260506</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CanDoItAll.Ledger.AppHost.DcpProxy\CanDoItAll.Ledger.AppHost.DcpProxy.csproj"
                      IsAspireProjectResource="false"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\CanDoItAll.Ledger.Node\CanDoItAll.Ledger.Node.csproj"
                      IsAspireProjectResource="true"
                      AspireProjectMetadataTypeName="CanDoItAll_Ledger_Node" />
    <ProjectReference Include="..\CanDoItAll.Ledger.Components.Demo\CanDoItAll.Ledger.Components.Demo.csproj"
                      IsAspireProjectResource="true"
                      AspireProjectMetadataTypeName="CanDoItAll_Ledger_Components_Demo" />
    <ProjectReference Include="..\..\..\CanDoItAll.IPFS\src\CanDoItAll.IPFS.Engine\CanDoItAll.IPFS.Engine.csproj"
                      IsAspireProjectResource="true"
                      AspireProjectMetadataTypeName="CanDoItAll_IPFS_Engine" />
    <ProjectReference Include="..\..\..\CanDoItAll.IPFS\src\CanDoItAll.IPFS.NodeControl\CanDoItAll.IPFS.NodeControl.csproj"
                      IsAspireProjectResource="true"
                      AspireProjectMetadataTypeName="CanDoItAll_IPFS_NodeControl" />
  </ItemGroup>

  <Target Name="CopyDcpProxyToOutput" AfterTargets="Build">
    <ItemGroup>
      <DcpProxyFiles Include="..\CanDoItAll.Ledger.AppHost.DcpProxy\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(DcpProxyFiles)"
          DestinationFiles="@(DcpProxyFiles->'$(OutDir)dcp-proxy\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
