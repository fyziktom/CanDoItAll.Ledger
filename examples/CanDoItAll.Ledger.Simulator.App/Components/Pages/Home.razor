@page "/"
@inject LedgerSimulatorProjectionPersistenceSelection PersistenceSelection
@inject ISimulationRunLifecycleService RunLifecycle
@inject ISimulationProjectWorkspaceService Workspace
@inject ISimulationProjectImportExportService ImportExport
@inject NavigationManager Navigation

<PageTitle>Ledger Simulator</PageTitle>

<LedgerSimulatorAppShell ActivePage="projects">
    <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950"
         role="status">
        <strong>Experimental work in progress.</strong>
        This Simulator is not production-ready, and its output is not
        authoritative financial, accounting, forecasting, or economic evidence.
    </div>
    <ProjectionStorageNotice />
    <LedgerSimulatorShell ViewModel="ViewModel"
                           ImportExportService="ImportExport"
                           RunRequested="StartRunAsync"
                           ProjectImported="ImportProjectAsync"
                           LaunchMessages="launchMessages"
                           IsRunLaunching="isStartingRun" />
</LedgerSimulatorAppShell>

@code {
    private IReadOnlyList<SimulationProjectValidationMessage> launchMessages = [];
    private bool isStartingRun;

    private SimulationProjectManagementViewModel ViewModel
    {
        get
        {
            string projectionStorageMode = PersistenceSelection.StorageModeName;
            IReadOnlyList<SimulationProjectSummary> projects = Workspace.ListProjects();
            IReadOnlyList<SimulationProjectState> projectStates = projects
                .Select(project => Workspace.GetProject(project.ProjectId))
                .Where(project => project is not null)
                .Cast<SimulationProjectState>()
                .ToArray();
            SimulationProjectState? selectedProject = projectStates.FirstOrDefault(project => string.Equals(project.Summary.ProjectId, "vef-financial-plan", StringComparison.Ordinal))
                ?? projectStates.FirstOrDefault()
                ?? LedgerSimulatorSampleData.CreateProjectState(projectionStorageMode);
            SimulationProjectExportManifest manifest = ImportExport.CreateManifest(selectedProject, DateTimeOffset.Parse("2026-05-15T12:00:00Z"));
            SimulationProjectImportPreview importPreview = ImportExport.PreviewImport(ImportExport.SerializeManifest(manifest));

            return new SimulationProjectManagementViewModel(
                projects.Count == 0 ? [selectedProject.Summary] : projects,
                selectedProject,
                manifest,
                importPreview)
            {
                ProjectStates = projectStates.Count == 0 ? [selectedProject] : projectStates
            };
        }
    }

    private async Task StartRunAsync(SimulationProjectRunRequest request)
    {
        if (isStartingRun)
        {
            return;
        }

        isStartingRun = true;
        launchMessages = [];
        try
        {
            await Task.Yield();
            SimulationRunCommandResult result = await RunLifecycle.StartRunAsync(request.Project, request.SetupId, mode: request.Mode);
            launchMessages = result.Messages;
            if (result.Succeeded && !string.IsNullOrWhiteSpace(result.RunId))
            {
                Navigation.NavigateTo($"/runs/{Uri.EscapeDataString(result.RunId)}");
            }
        }
        finally
        {
            isStartingRun = false;
        }
    }

    private Task ImportProjectAsync(SimulationProjectState project)
    {
        Workspace.UpsertProject(project);
        launchMessages = [];
        StateHasChanged();
        return Task.CompletedTask;
    }
}
