@page "/business-object-gallery-samples"

<PageTitle>Business Object Gallery Samples</PageTitle>

<PageScaffold MaxWidthClass="max-w-[1680px]">
    <ChildContent>
        <VenftSsrEconomyApp Workspace="workspace" InitialView="gallery" />
    </ChildContent>
</PageScaffold>

@code {
    private static readonly DateTimeOffset SampleNow = new(2026, 07, 08, 10, 00, 00, TimeSpan.Zero);
    private readonly BusinessObjectWorkspaceModel workspace = CreateGalleryWorkspace();

    private static BusinessObjectWorkspaceModel CreateGalleryWorkspace()
    {
        BusinessObjectWorkspaceModel source = EconomyComponentSampleData.CreateWorkspace() with
        {
            AccountName = "Gallery renderer samples",
            ConnectionLabel = "In-memory BO renderer sample workspace"
        };

        ITypedBusinessObjectView eventObject = CreateTypedObject(
            source.Context,
            source.Address,
            "event",
            "CanDoItAll Ledger Summit",
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["eventDate"] = "2026-09-18T09:00:00Z",
                ["eventClass"] = "Conference",
                ["location"] = "Berlin Main Hall",
                ["organizer"] = "CanDoItAll",
                ["status"] = "Confirmed"
            },
            [
                new BusinessObjectDataItem(
                    "Event stage thumbnail",
                    BusinessObjectDataItemType.Image,
                    BusinessObjectDataItemStorage.Url,
                    "event-stage-thumbnail",
                    new Uri("https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=960&q=80"),
                    "image/jpeg",
                    "event-stage-thumbnail.jpg",
                    256,
                    IsMain: true)
            ]);

        ITypedBusinessObjectView ticketObject = CreateTypedObject(
            source.Context,
            source.Address,
            "ticket",
            "Ledger Summit Ticket A12",
            new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["eventId"] = eventObject.ObjectId.Value,
                ["eventAddress"] = source.Address.Value,
                ["seat"] = "A12",
                ["ticketClass"] = "VIP",
                ["ticketDuration"] = "1 day",
                ["status"] = "Issued"
            });

        return source with
        {
            BusinessObjects = source.BusinessObjects.Concat([eventObject, ticketObject]).ToArray()
        };
    }

    private static ITypedBusinessObjectView CreateTypedObject(
        LedgerAccountContext context,
        Address owner,
        string objectType,
        string name,
        IReadOnlyDictionary<string, string> fields,
        IReadOnlyList<BusinessObjectDataItem>? dataItems = null)
    {
        BusinessObjectFamilyDefinition definition = BusinessObjectFamilyCatalog.FindOrDefault(objectType);
        BusinessObjectMediaPayload payload = BusinessObjectPayloadBuilder.CreatePayload(
            definition,
            name,
            $"{name} short description",
            $"{name} long description",
            $"#{objectType} #sample",
            dataItems ?? [],
            fields);
        string stateJson = BusinessObjectPayloadBuilder.Serialize(payload);
        BusinessObjectId objectId = new($"bo:{objectType}:{BusinessObjectCreateIdFactory.NormalizeName(name)}");

        return new GenericTypedBusinessObjectView(
            context,
            objectId,
            objectType,
            "1.0",
            1,
            owner,
            BusinessObjectOperation.Create,
            new HashHex(new string('7', 64)),
            new OutPoint(new TxId($"tx-{objectType}-{BusinessObjectCreateIdFactory.NormalizeName(name)}"), 0),
            stateJson,
            $"ledger://{objectId.Value}",
            TransactionDataItemType.BusinessObject,
            SampleNow,
            SampleNow,
            payload.Name,
            payload.Description,
            payload.Text,
            payload.Author,
            payload.Link,
            payload.ImageLink,
            payload.TagList,
            payload.DataItems ?? Array.Empty<BusinessObjectDataItem>(),
            definition,
            payload.Fields ?? new Dictionary<string, string>(StringComparer.Ordinal),
            BusinessObjectPayloadBuilder.CreateFacts(definition, payload.Fields));
    }
}
