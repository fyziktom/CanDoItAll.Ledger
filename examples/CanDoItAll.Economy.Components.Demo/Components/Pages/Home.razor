@page "/"
@implements IAsyncDisposable
@inject DialogService DialogService
@inject NotificationService Notifications
@inject EconomyNodeWorkspaceSession EconomySession
@inject EconomyDevelopmentWorkspaceSession DevelopmentSession
@inject NavigationManager Navigation

<PageTitle>Economy Components Demo</PageTitle>

@if (workspace is null)
{
    <PageScaffold MaxWidthClass="max-w-[1680px]">
        <ChildContent>
            <EmptyState Eyebrow="Economy demo"
                        Title="@LoadingTitle"
                        Description="@LoadingDescription" />
        </ChildContent>
    </PageScaffold>
}
else
{
    <EconomyAccountAppShell Workspace="workspace"
                        RefreshRequested="RefreshWorkspaceAsync"
                        CreateSubAccountRequested="OpenSubAccountDialogAsync"
                        OpenSendTransactionRequested="OpenSendTransactionDialogAsync"
                        ValidateRequested="OpenProfileEditDialogAsync"
                        CreateTokenRequested="OpenTokenCreationDialogAsync"
                        RuleTokenCreateRequested="SubmitRuleTokenCreationAsync"
                        TransactionDetailsRequested="OpenTransactionDetailsAsync"
                        BusinessObjectTransactionDetailsRequested="OpenTransactionDetailsByIdAsync"
                        BusinessObjectSendRequested="OpenBusinessObjectSendDialogAsync"
                        BusinessObjectSetPriceRequested="OpenBusinessObjectSetPriceDialogAsync"
                        BusinessObjectTicketVerificationRequested="CreateTicketVerificationAsync"
                        BusinessObjectTicketUseRequested="UseTicketAsync"
                        TransactionSubmitRequested="SubmitTransactionAsync"
                        MessageSignRequested="SignMessageAsync"
                        MessageVerifyRequested="VerifyMessageAsync"
                        MessageEncryptRequested="EncryptMessageAsync"
                        MessageDecryptRequested="DecryptMessageAsync" />
}

@code {
    private BusinessObjectWorkspaceModel? workspace;
    private EconomyTransactionExecutionResult? lastResult;
    private string activeAccount = "alice";
    private string? loadError;
    private bool usingDevelopmentWorkspace;
    private readonly HashSet<TxId> observedTransactionIds = [];
    private readonly SemaphoreSlim refreshLock = new(1, 1);
    private CancellationTokenSource? autoRefreshCancellation;
    private Task? autoRefreshTask;
    private string? refreshNotification;
    private static readonly TimeSpan AutoRefreshInterval = TimeSpan.FromSeconds(5);

    protected override async Task OnInitializedAsync()
    {
        activeAccount = ReadAccountFromQuery();
        await RefreshWorkspaceAsync();
        StartAutoRefreshLoop();
    }

    private async Task RefreshWorkspaceAsync()
        => await RefreshWorkspaceAsync(recordTransactionBaseline: true, CancellationToken.None);

    private async Task RefreshWorkspaceAsync(
        bool recordTransactionBaseline,
        CancellationToken cancellationToken)
    {
        await refreshLock.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            loadError = null;
            workspace = EnrichWorkspaceForGallery(await LoadWorkspaceSnapshotAsync(allowDevelopmentFallback: true, cancellationToken));
            if (recordTransactionBaseline)
            {
                SeedObservedTransactions(workspace.Transactions);
            }
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
            workspace = null;
        }
        finally
        {
            refreshLock.Release();
        }
    }

    private async Task SubmitTransactionAsync(BusinessObjectTransactionDraft draft)
    {
        await ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.SubmitTransactionAsync(draft)
                : EconomySession.SubmitTransactionAsync(activeAccount, draft),
            "Transaction submitted");
    }

    private Task OpenSendTransactionDialogAsync()
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<TransactionComposerDialogContent>(
            "Send Transaction",
            new Dictionary<string, object?>
            {
                [nameof(TransactionComposerDialogContent.Draft)] = workspace.TransactionDraft,
                [nameof(TransactionComposerDialogContent.TokenOptions)] = workspace.TokenOptions,
                [nameof(TransactionComposerDialogContent.SpendableOutputs)] = workspace.SpendableOutputsOrEmpty,
                [nameof(TransactionComposerDialogContent.Bookmarks)] = workspace.AddressBookmarks,
                [nameof(TransactionComposerDialogContent.AccountScope)] = workspace.Address.Value,
                [nameof(TransactionComposerDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectTransactionDraft>(this, SubmitTransactionAsync),
                [nameof(TransactionComposerDialogContent.AssembleRequested)] =
                    EventCallback.Factory.Create(this, RefreshWorkspaceAsync),
                [nameof(TransactionComposerDialogContent.BroadcastRequested)] =
                    EventCallback.Factory.Create(this, RefreshWorkspaceAsync)
            },
            new DialogOptions
            {
                Subtitle = $"{workspace.AccountName} - {workspace.Address.Value}",
                Size = ModalSize.Wide,
                DenseChrome = true,
                Class = "cda-ledger-dialog cda-ledger-dialog--send",
                TestId = "cda-send-transaction-dialog"
            });
    }

    private async Task OpenSubAccountDialogAsync()
    {
        if (workspace is null)
        {
            return;
        }

        object? result = await DialogService.OpenAsync<SubAccountCreateDialogContent>(
            "Add New SubAccount",
            new Dictionary<string, object?>
            {
                [nameof(SubAccountCreateDialogContent.ParentAddress)] = workspace.Address.Value
            },
            new DialogOptions
            {
                Subtitle = "Create a child account under the current SSR session.",
                Size = ModalSize.Medium,
                Class = "cda-ledger-dialog cda-ledger-dialog--form",
                ShowCloseButton = false,
                TestId = "cda-subaccount-dialog"
            });

        if (result is SubAccountCreateDialogResult)
        {
            workspace = EnrichWorkspaceForGallery(await LoadWorkspaceSnapshotAsync(allowDevelopmentFallback: true, CancellationToken.None));
            Notifications.Success("SubAccount staged", "The workspace was refreshed after the subaccount dialog.", position: NotificationPosition.BottomCenter);
        }
    }

    private async Task OpenTransactionDetailsAsync(LedgerTransactionSummary summary)
        => await OpenTransactionDetailsByIdAsync(summary.TxId);

    private async Task OpenTransactionDetailsByIdAsync(TxId txId)
    {
        EconomyTransactionDetailsModel? details = usingDevelopmentWorkspace
            ? await DevelopmentSession.GetTransactionDetailsAsync(txId)
            : await EconomySession.GetTransactionDetailsAsync(txId)
            ?? FallbackTransactionDetails(txId);
        if (details is null)
        {
            Notifications.Warning("Transaction not found", txId.Value, position: NotificationPosition.BottomCenter);
            return;
        }

        await DialogService.OpenAsync<TransactionDetailsDialogContent>(
            "Transaction Details",
            new Dictionary<string, object?>
            {
                [nameof(TransactionDetailsDialogContent.Details)] = details
            },
            new DialogOptions
            {
                Subtitle = $"{details.Kind} - {details.Status}",
                Size = ModalSize.Full,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog cda-ledger-dialog--details cda-ledger-dialog--tx-detail",
                TestId = "cda-transaction-details-dialog"
            });
    }

    private Task OpenBusinessObjectSendDialogAsync(IBusinessObjectView item)
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<BusinessObjectSendDialogContent>(
            "Send BusinessObject",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectSendDialogContent.Object)] = item,
                [nameof(BusinessObjectSendDialogContent.Bookmarks)] = workspace.AddressBookmarks,
                [nameof(BusinessObjectSendDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectSendRequest>(this, SubmitBusinessObjectSendAsync)
            },
            new DialogOptions
            {
                Subtitle = item.ObjectId.Value,
                Size = ModalSize.Medium,
                Class = "cda-ledger-dialog cda-ledger-dialog--form",
                TestId = "cda-bo-send-dialog"
            });
    }

    private Task OpenBusinessObjectSetPriceDialogAsync(IBusinessObjectView item)
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<BusinessObjectSetPriceDialogContent>(
            "Set BusinessObject Price",
            new Dictionary<string, object?>
            {
                [nameof(BusinessObjectSetPriceDialogContent.Object)] = item,
                [nameof(BusinessObjectSetPriceDialogContent.TokenOptions)] = workspace.TokenOptions,
                [nameof(BusinessObjectSetPriceDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<BusinessObjectPriceRequest>(this, SubmitBusinessObjectPriceAsync)
            },
            new DialogOptions
            {
                Subtitle = item.ObjectId.Value,
                Size = ModalSize.Medium,
                Class = "cda-ledger-dialog cda-ledger-dialog--form",
                TestId = "cda-bo-set-price-dialog"
            });
    }

    private Task OpenProfileEditDialogAsync()
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        IBusinessObjectView? profileObject = workspace.BusinessObjects.FirstOrDefault(item =>
            item.ObjectType.Equals("profile", StringComparison.OrdinalIgnoreCase));

        return DialogService.OpenAsync<ProfileEditDialogContent>(
            profileObject is null ? "Create Profile" : "Edit Profile",
            new Dictionary<string, object?>
            {
                [nameof(ProfileEditDialogContent.ProfileObject)] = profileObject,
                [nameof(ProfileEditDialogContent.AccountName)] = workspace.AccountName,
                [nameof(ProfileEditDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<ProfileEditRequest>(this, SubmitProfileEditAsync)
            },
            new DialogOptions
            {
                Subtitle = profileObject?.ObjectId.Value ?? "New profile BusinessObject",
                Size = ModalSize.Medium,
                Class = "cda-ledger-dialog cda-ledger-dialog--form",
                TestId = "cda-profile-edit-dialog"
            });
    }

    private Task OpenTokenCreationDialogAsync()
    {
        if (workspace is null)
        {
            return Task.CompletedTask;
        }

        return DialogService.OpenAsync<TokenCreationDialogContent>(
            "Create Token",
            new Dictionary<string, object?>
            {
                [nameof(TokenCreationDialogContent.Authorities)] = workspace.TokenCreationAuthorities,
                [nameof(TokenCreationDialogContent.SubmitRequested)] =
                    EventCallback.Factory.Create<EconomyTokenCreationRequest>(this, SubmitTokenCreationAsync)
            },
            new DialogOptions
            {
                Subtitle = "Authority-aware token mint",
                Size = ModalSize.Wide,
                DenseChrome = true,
                CloseOnBackdrop = false,
                Class = "cda-ledger-dialog cda-token-creation-modal",
                TestId = "cda-token-create-dialog"
            });
    }

    private Task SubmitBusinessObjectSendAsync(BusinessObjectSendRequest request)
        => ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.SendBusinessObjectAsync(request)
                : EconomySession.SendBusinessObjectAsync(activeAccount, request),
            "BusinessObject sent");

    private Task SubmitBusinessObjectPriceAsync(BusinessObjectPriceRequest request)
        => ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.SetBusinessObjectPriceAsync(request)
                : EconomySession.SetBusinessObjectPriceAsync(activeAccount, request),
            "Price updated");

    private Task SubmitProfileEditAsync(ProfileEditRequest request)
        => ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.UpdateProfileAsync(request)
                : EconomySession.UpdateProfileAsync(activeAccount, request),
            request.CreateNew ? "Profile created" : "Profile updated");

    private Task<BusinessObjectTicketVerificationResult> CreateTicketVerificationAsync(
        BusinessObjectTicketVerificationRequest request)
        => usingDevelopmentWorkspace
            ? DevelopmentSession.CreateTicketVerificationAsync(request)
            : EconomySession.CreateTicketVerificationAsync(activeAccount, request);

    private async Task<EconomyTransactionExecutionResult> UseTicketAsync(BusinessObjectTicketUseRequest request)
    {
        try
        {
            lastResult = await (usingDevelopmentWorkspace
                ? DevelopmentSession.UseTicketAsync(request)
                : EconomySession.UseTicketAsync(activeAccount, request));
            await refreshLock.WaitAsync(CancellationToken.None).ConfigureAwait(false);
            try
            {
                workspace = EnrichWorkspaceForGallery(await LoadWorkspaceSnapshotAsync(allowDevelopmentFallback: true, CancellationToken.None));
                SeedObservedTransactions(workspace.Transactions);
            }
            finally
            {
                refreshLock.Release();
            }

            if (lastResult.Accepted)
            {
                Notifications.Success("Ticket used", lastResult.Message, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Error("Ledger rejected transaction", lastResult.Message, position: NotificationPosition.BottomCenter);
            }

            return lastResult;
        }
        catch (Exception exception)
        {
            lastResult = new EconomyTransactionExecutionResult(
                BusinessObjectTransactionMode.UpdateObject,
                Accepted: false,
                TxId: null,
                LedgerSequence: null,
                exception.Message);
            Notifications.Error("Economy action failed", exception.Message, position: NotificationPosition.BottomCenter);
            return lastResult;
        }
    }

    private Task SubmitTokenCreationAsync(EconomyTokenCreationRequest request)
        => ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.CreateTokenAsync(request)
                : EconomySession.CreateTokenAsync(activeAccount, request),
            "Token created");

    private Task SubmitRuleTokenCreationAsync(EconomyRuleTokenCreationRequest request)
        => ExecuteAndRefreshAsync(
            () => usingDevelopmentWorkspace
                ? DevelopmentSession.CreateRuleTokenAsync(request)
                : EconomySession.CreateRuleTokenAsync(activeAccount, request),
            "Rule BO created");

    private Task<MessageSecurityActionResult> SignMessageAsync(MessageSecuritySignRequest request)
        => EconomySession.SignMessageAsync(request with { AccountAlias = activeAccount });

    private Task<MessageSecurityActionResult> VerifyMessageAsync(MessageSecurityVerifyRequest request)
        => EconomySession.VerifyMessageAsync(request with { AccountAlias = activeAccount });

    private Task<MessageSecurityActionResult> EncryptMessageAsync(MessageSecurityEncryptRequest request)
        => EconomySession.EncryptMessageAsync(request with { AccountAlias = activeAccount });

    private Task<MessageSecurityActionResult> DecryptMessageAsync(MessageSecurityDecryptRequest request)
        => EconomySession.DecryptMessageAsync(request with { AccountAlias = activeAccount });

    private async Task ExecuteAndRefreshAsync(
        Func<Task<EconomyTransactionExecutionResult>> action,
        string successSummary)
    {
        try
        {
            lastResult = await action();
            await refreshLock.WaitAsync(CancellationToken.None).ConfigureAwait(false);
            try
            {
                workspace = EnrichWorkspaceForGallery(await LoadWorkspaceSnapshotAsync(allowDevelopmentFallback: true, CancellationToken.None));
                SeedObservedTransactions(workspace.Transactions);
            }
            finally
            {
                refreshLock.Release();
            }

            if (lastResult.Accepted)
            {
                Notifications.Success(successSummary, lastResult.Message, position: NotificationPosition.BottomCenter);
            }
            else
            {
                Notifications.Error("Ledger rejected transaction", lastResult.Message, position: NotificationPosition.BottomCenter);
            }
        }
        catch (Exception exception)
        {
            lastResult = new EconomyTransactionExecutionResult(
                BusinessObjectTransactionMode.Create,
                Accepted: false,
                TxId: null,
                LedgerSequence: null,
                exception.Message);
            Notifications.Error("Economy action failed", exception.Message, position: NotificationPosition.BottomCenter);
        }
    }

    private void StartAutoRefreshLoop()
    {
        autoRefreshCancellation = new CancellationTokenSource();
        autoRefreshTask = RunAutoRefreshLoopAsync(autoRefreshCancellation.Token);
    }

    private async Task RunAutoRefreshLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(AutoRefreshInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken).ConfigureAwait(false))
            {
                try
                {
                    await AutoRefreshWorkspaceAsync(cancellationToken).ConfigureAwait(false);
                }
                catch (Exception exception) when (!cancellationToken.IsCancellationRequested)
                {
                    await InvokeAsync(() =>
                    {
                        loadError = exception.Message;
                        StateHasChanged();
                    }).ConfigureAwait(false);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task AutoRefreshWorkspaceAsync(CancellationToken cancellationToken)
    {
        await refreshLock.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            BusinessObjectWorkspaceModel refreshed = EnrichWorkspaceForGallery(
                await LoadWorkspaceSnapshotAsync(allowDevelopmentFallback: true, cancellationToken).ConfigureAwait(false));
            await InvokeAsync(() => ApplyAutoRefresh(refreshed)).ConfigureAwait(false);
        }
        finally
        {
            refreshLock.Release();
        }
    }

    private void ApplyAutoRefresh(BusinessObjectWorkspaceModel refreshed)
    {
        LedgerTransactionSummary[] newTransactions = refreshed.Transactions
            .Where(transaction => !observedTransactionIds.Contains(transaction.TxId))
            .ToArray();
        bool businessObjectsChanged = workspace is not null
            && !BusinessObjectKeys(workspace.BusinessObjects).SequenceEqual(BusinessObjectKeys(refreshed.BusinessObjects));

        workspace = refreshed;
        loadError = null;
        SeedObservedTransactions(refreshed.Transactions);

        if (newTransactions.Length > 0)
        {
            LedgerTransactionSummary newest = newTransactions[0];
            refreshNotification = $"{newTransactions.Length} new transaction(s) for {refreshed.AccountName}; newest {ShortIdentifier(newest.TxId.Value)}.";
            Notifications.Info("New transaction", refreshNotification, position: NotificationPosition.BottomCenter);
            StateHasChanged();
            return;
        }

        if (businessObjectsChanged)
        {
            refreshNotification = $"BusinessObject holdings refreshed for {refreshed.AccountName}.";
            StateHasChanged();
        }
    }

    private void SeedObservedTransactions(IEnumerable<LedgerTransactionSummary> transactions)
    {
        foreach (LedgerTransactionSummary transaction in transactions)
        {
            observedTransactionIds.Add(transaction.TxId);
        }
    }

    private static IReadOnlyList<string> BusinessObjectKeys(IEnumerable<IBusinessObjectView> businessObjects)
        => businessObjects
            .Select(item => $"{item.ObjectId.Value}|{item.Version}|{item.OwnerAddress.Value}|{item.DataHash.Value}|{item.CurrentOutPoint}")
            .OrderBy(value => value, StringComparer.Ordinal)
            .ToArray();

    private static string ShortIdentifier(string value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length <= 18)
        {
            return value;
        }

        return $"{value[..8]}...{value[^6..]}";
    }

    private string LoadingTitle
        => loadError is null
            ? $"Loading real-node workspace for {activeAccount}"
            : "Could not load real-node workspace";

    private string LoadingDescription
        => loadError is null
            ? "The economy demo is loading account keys outside the repo and querying the configured node. If unavailable, it falls back to a seeded development workspace."
            : $"{loadError} Falling back to a seeded development workspace when available.";

    private async Task<BusinessObjectWorkspaceModel> LoadWorkspaceSnapshotAsync(
        bool allowDevelopmentFallback,
        CancellationToken cancellationToken)
    {
        if (usingDevelopmentWorkspace)
        {
            return await DevelopmentSession.GetWorkspaceAsync(cancellationToken).ConfigureAwait(false);
        }

        try
        {
            BusinessObjectWorkspaceModel nodeWorkspace = await EconomySession
                .GetWorkspaceAsync(activeAccount, cancellationToken)
                .ConfigureAwait(false);
            usingDevelopmentWorkspace = false;
            return nodeWorkspace;
        }
        catch (Exception exception) when (allowDevelopmentFallback)
        {
            loadError = exception.Message;
            usingDevelopmentWorkspace = true;
            refreshNotification = $"Using seeded development workspace because the real node workspace did not load: {ShortIdentifier(exception.Message)}";
            return await DevelopmentSession.GetWorkspaceAsync(cancellationToken).ConfigureAwait(false);
        }
    }

    private string ReadAccountFromQuery()
    {
        var uri = new Uri(Navigation.Uri);
        string query = uri.Query.TrimStart('?');
        foreach (string part in query.Split('&', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            string[] pieces = part.Split('=', 2);
            if (pieces.Length == 2 && pieces[0].Equals("account", StringComparison.OrdinalIgnoreCase))
            {
                string value = Uri.UnescapeDataString(pieces[1]).Trim();
                if (!string.IsNullOrWhiteSpace(value))
                {
                    return value.ToLowerInvariant();
                }
            }
        }

        return "alice";
    }

    private static BusinessObjectWorkspaceModel EnrichWorkspaceForGallery(BusinessObjectWorkspaceModel source)
    {
        IBusinessObjectView[] gallerySamples = EconomyComponentSampleData.CreateWorkspace()
            .BusinessObjects
            .Where(item => item is IMediaBusinessObjectView media && media.DataItems.Count > 0)
            .Where(item => source.BusinessObjects.All(existing => !existing.ObjectId.Equals(item.ObjectId)))
            .ToArray();

        return gallerySamples.Length == 0
            ? source
            : source with { BusinessObjects = source.BusinessObjects.Concat(gallerySamples).ToArray() };
    }

    private static EconomyTransactionDetailsModel? FallbackTransactionDetails(TxId txId)
    {
        BusinessObjectWorkspaceModel sampleWorkspace = EconomyComponentSampleData.CreateWorkspace();
        if (!sampleWorkspace.BusinessObjects.Any(item => item.CurrentOutPoint.TxId.Equals(txId)))
        {
            return null;
        }

        EconomyTransactionDetailsModel details = EconomyComponentSampleData.CreateTransactionDetails() with
        {
            TxId = txId,
            Timestamp = sampleWorkspace.ViewedAtUtc.AddMinutes(-35)
        };

        return details with
        {
            Inputs = RepeatInputs(details, 12),
            Outputs = RepeatOutputs(details, 14)
        };
    }

    private static IReadOnlyList<EconomyTransactionInputDetails> RepeatInputs(EconomyTransactionDetailsModel details, int count)
    {
        EconomyTransactionInputDetails? seed = details.Inputs.FirstOrDefault();
        if (seed is null)
        {
            return [];
        }

        return Enumerable.Range(0, count)
            .Select(index => seed with
            {
                InputIndex = index,
                PreviousOutPoint = new OutPoint(new TxId($"{seed.PreviousOutPoint.TxId.Value}-{index + 1}"), seed.PreviousOutPoint.OutputIndex),
                MainAmount = Amount.FromInt64(900 + (index * 175))
            })
            .ToArray();
    }

    private static IReadOnlyList<EconomyTransactionOutputDetails> RepeatOutputs(EconomyTransactionDetailsModel details, int count)
    {
        EconomyTransactionOutputDetails? seed = details.Outputs.FirstOrDefault();
        if (seed is null)
        {
            return [];
        }

        return Enumerable.Range(0, count)
            .Select(index => seed with
            {
                OutputIndex = index,
                MainAmount = Amount.FromInt64(650 + (index * 125))
            })
            .ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        if (autoRefreshCancellation is null)
        {
            refreshLock.Dispose();
            return;
        }

        await autoRefreshCancellation.CancelAsync().ConfigureAwait(false);
        if (autoRefreshTask is not null)
        {
            await autoRefreshTask.ConfigureAwait(false);
        }

        autoRefreshCancellation.Dispose();
        refreshLock.Dispose();
    }
}
