@namespace CanDoItAll.Economy.Components.Demo.SampleDomain
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Economy.BusinessObjects
@using CanDoItAll.Economy.Components.Rendering
@using CanDoItAll.Economy.Core

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny" Class="cda-economy-renderer-summary">
        <strong>@PurchaseOrder.ObjectId</strong>
        <span>@PurchaseOrder.Supplier purchase order</span>
        <Cluster Gap="LayoutGap.Small">
            <span class="cda-economy-pill">@PurchaseOrder.Status</span>
            <span class="cda-economy-pill">@PurchaseOrder.TotalAmount</span>
        </Cluster>
    </Stack>
}
else
{
    <Grid ColumnsLg="2" Gap="LayoutGap.Medium" Class="cda-economy-purchase-order-renderer">
        <div class="cda-economy-fact">
            <span>Renderer</span>
            <strong>@Descriptor.DisplayName</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Status</span>
            <strong>@PurchaseOrder.Status</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Supplier</span>
            <strong>@PurchaseOrder.Supplier</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Total amount</span>
            <strong>@PurchaseOrder.TotalAmount</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Required by</span>
            <strong>@PurchaseOrder.RequiredByUtc.ToString("u")</strong>
        </div>
        <div class="cda-economy-fact">
            <span>Version</span>
            <strong>v@(PurchaseOrder.Version)</strong>
        </div>
        <div class="cda-economy-fact cda-economy-fact--wide">
            <span>Approval context</span>
            <strong>@PurchaseOrder.ObjectId is ready for two-step operations approval.</strong>
        </div>
        <div class="cda-economy-fact cda-economy-fact--wide">
            <span>State JSON</span>
            <pre>@DisplayState</pre>
        </div>
    </Grid>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private PurchaseOrderBusinessObjectView PurchaseOrder
        => Object as PurchaseOrderBusinessObjectView
            ?? new PurchaseOrderBusinessObjectView(
                Object.Context,
                Object.ObjectId,
                Object.ObjectType,
                Object.SchemaVersion,
                Object.Version,
                Object.OwnerAddress,
                Object.Operation,
                Object.DataHash,
                Object.CurrentOutPoint,
                Object.StateJson,
                "Unknown supplier",
                Amount.Zero,
                "Unknown",
                ViewedAtUtc ?? Object.ViewedAt,
                Object.CreatedAt,
                Object.ViewedAt);

    private string DisplayState
        => string.IsNullOrWhiteSpace(Object.StateJson)
            ? "{}"
            : Object.StateJson!;
}
