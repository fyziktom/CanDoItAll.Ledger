@namespace CanDoItAll.Economy.Components.Demo.SampleDomain
@using CanDoItAll.Components.BaseLib
@using CanDoItAll.Components.Common
@using CanDoItAll.Economy.BusinessObjects
@using CanDoItAll.Economy.Components.Rendering
@using CanDoItAll.Economy.Core

@if (Mode == BusinessObjectRenderMode.Summary)
{
    <Stack GapScale="LayoutGap.Tiny" Class="min-w-0">
        <TextBlock TextStyle="TextStyle.Subtitle2" Value="@PurchaseOrder.ObjectId.Value" />
        <TextBlock TextStyle="TextStyle.Body2">@PurchaseOrder.Supplier purchase order</TextBlock>
        <Cluster Gap="LayoutGap.Small">
            <Pill Text="@PurchaseOrder.Status" Tone="PillTone.Label" />
            <Pill Text="@PurchaseOrder.TotalAmount.ToString()" Tone="PillTone.Info" />
        </Cluster>
    </Stack>
}
else
{
    <Stack GapScale="LayoutGap.Medium" AlignItems="AlignItems.Stretch">
        <SummaryTiles ColumnsSm="2" ColumnsXl="2" GapScale="LayoutGap.Small">
            <SummaryTile Label="Renderer" Value="@Descriptor.DisplayName" />
            <SummaryTile Label="Status" Value="@PurchaseOrder.Status" Tone="info" />
            <SummaryTile Label="Supplier" Value="@PurchaseOrder.Supplier" />
            <SummaryTile Label="Total amount" Value="@PurchaseOrder.TotalAmount.ToString()" />
            <SummaryTile Label="Required by" Value="@PurchaseOrder.RequiredByUtc.ToString("u")" />
            <SummaryTile Label="Version" Value="@($"v{PurchaseOrder.Version}")" />
        </SummaryTiles>
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="Approval context" />
                <TextBlock TextStyle="TextStyle.Body2">@PurchaseOrder.ObjectId is ready for two-step operations approval.</TextBlock>
            </Stack>
        </SurfaceCard>
        <SurfaceCard Soft="true">
            <Stack GapScale="LayoutGap.Tiny">
                <TextBlock TextStyle="TextStyle.Eyebrow" Value="State JSON" />
                <pre>@DisplayState</pre>
            </Stack>
        </SurfaceCard>
    </Stack>
}

@code {
    [Parameter, EditorRequired]
    public IBusinessObjectView Object { get; set; } = default!;

    [Parameter]
    public BusinessObjectRenderMode Mode { get; set; } = BusinessObjectRenderMode.Detail;

    [Parameter]
    public DateTimeOffset? ViewedAtUtc { get; set; }

    [Parameter, EditorRequired]
    public BusinessObjectRendererDescriptor Descriptor { get; set; } = default!;

    private PurchaseOrderBusinessObjectView PurchaseOrder
        => Object as PurchaseOrderBusinessObjectView
            ?? new PurchaseOrderBusinessObjectView(
                Object.Context,
                Object.ObjectId,
                Object.ObjectType,
                Object.SchemaVersion,
                Object.Version,
                Object.OwnerAddress,
                Object.Operation,
                Object.DataHash,
                Object.CurrentOutPoint,
                Object.StateJson,
                "Unknown supplier",
                Amount.Zero,
                "Unknown",
                ViewedAtUtc ?? Object.ViewedAt,
                Object.CreatedAt,
                Object.ViewedAt);

    private string DisplayState
        => string.IsNullOrWhiteSpace(Object.StateJson)
            ? "{}"
            : Object.StateJson!;
}
